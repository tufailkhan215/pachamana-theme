[
  {
    "name": "theme_info",
    "theme_name": "Pacha Mana Theme",
    "theme_version": "1.0.0",
    "theme_author": "Pacha Mana",
    "theme_documentation_url": "https://pachamana.com",
    "theme_support_url": "https://pachamana.com"
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "colors_accent_1",
        "default": "#5C402F",
        "label": "Accent color 1"
      },
      {
        "type": "color",
        "id": "colors_accent_2",
        "default": "#E2AB43",
        "label": "Accent color 2"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_header_font",
        "default": "assistant_n4",
        "label": "Heading font",
        "info": "Select a font for headings"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "default": "assistant_n4",
        "label": "Body font",
        "info": "Select a font for body text"
      }
    ]
  },
  {
    "name": "Header",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo image"
      },
      {
        "type": "text",
        "id": "shop_url",
        "label": "Shop URL",
        "default": "https://pachamana.com",
        "info": "Base URL for the shop"
      }
    ]
  },
  {
    "name": "Footer",
    "settings": [
      {
        "type": "text",
        "id": "footer_copyright",
        "label": "Copyright text",
        "default": "© {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved."
      }
    ]
  },
  {
    "name": "Social Media",
    "settings": [
      {
        "type": "text",
        "id": "social_facebook_link",
        "label": "Facebook",
        "info": "https://www.facebook.com/shopify"
      },
      {
        "type": "text",
        "id": "social_instagram_link",
        "label": "Instagram",
        "info": "https://www.instagram.com/shopify"
      },
      {
        "type": "text",
        "id": "social_twitter_link",
        "label": "Twitter",
        "info": "https://twitter.com/shopify"
      },
      {
        "type": "text",
        "id": "social_pinterest_link",
        "label": "Pinterest",
        "info": "https://www.pinterest.com/shopify"
      }
    ]
  },
  {
    "name": "Product",
    "settings": [
      {
        "type": "checkbox",
        "id": "product_show_vendor",
        "label": "Show product vendor",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "product_show_sku",
        "label": "Show product SKU",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "product_enable_payment_button",
        "label": "Show dynamic checkout button",
        "info": "Lets customers check out directly using a familiar payment method. [Learn more](https://help.shopify.com/manual/using-themes/change-the-layout/dynamic-checkout)",
        "default": true
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "checkbox",
        "id": "cart_show_notes",
        "label": "Show cart notes",
        "default": true
      },
      {
        "type": "text",
        "id": "cart_continue_shopping_text",
        "label": "Continue shopping button text",
        "default": "Continue shopping"
      }
    ]
  },
  {
    "name": "Announcement Bar",
    "settings": [
      {
        "type": "checkbox",
        "id": "announcement_enabled",
        "label": "Show announcement bar",
        "default": false
      },
      {
        "type": "text",
        "id": "announcement_text",
        "label": "Announcement text",
        "default": "Free shipping on orders over $50"
      },
      {
        "type": "url",
        "id": "announcement_link",
        "label": "Announcement link"
      }
    ]
  },
  {
    "name": "Contact Popup",
    "settings": [
      {
        "type": "checkbox",
        "id": "contact_popup_enabled",
        "label": "Enable Contact Popup",
        "default": false,
        "info": "Show contact popup modal on the site"
      },
      {
        "type": "image_picker",
        "id": "contact_popup_logo",
        "label": "Popup Logo Image",
        "info": "Recommended: 400px width, transparent background"
      },
      {
        "type": "text",
        "id": "contact_popup_heading",
        "label": "Popup Heading",
        "default": "Contact us"
      },
      {
        "type": "richtext",
        "id": "contact_popup_text",
        "label": "Popup Text Content",
        "default": "<p>Fill out the form below, and we will be in touch shortly or,</p>"
      },
      {
        "type": "text",
        "id": "contact_popup_display_email",
        "label": "Display Email Address",
        "default": "pachamanacacao@gmail.com",
        "info": "Email address displayed in popup text (for urgent questions)"
      },
      {
        "type": "text",
        "id": "contact_popup_button_text",
        "label": "Submit Button Text",
        "default": "Send"
      },
      {
        "type": "text",
        "id": "contact_popup_success_message",
        "label": "Success Message",
        "default": "Thank you! We will be in touch shortly."
      }
    ]
  },
  {
    "name": "Newsletter Popup",
    "settings": [
      {
        "type": "checkbox",
        "id": "newsletter_popup_enabled",
        "label": "Enable Newsletter Popup",
        "default": true,
        "info": "Shows a discount signup popup on first visit (separate from Contact popup)"
      },
      {
        "type": "image_picker",
        "id": "newsletter_popup_logo",
        "label": "Popup logo",
        "info": "Sun/bean logo at top of popup"
      },
      {
        "type": "text",
        "id": "newsletter_popup_headline",
        "label": "Headline",
        "default": "New to ceremonial cacao?"
      },
      {
        "type": "text",
        "id": "newsletter_popup_offer",
        "label": "Offer text (bold)",
        "default": "Take 10% OFF",
        "info": "Main offer line, e.g. Take 10% OFF"
      },
      {
        "type": "text",
        "id": "newsletter_popup_offer_suffix",
        "label": "Offer suffix",
        "default": "your first order"
      },
      {
        "type": "text",
        "id": "newsletter_popup_placeholder",
        "label": "Email placeholder",
        "default": "Email Here"
      },
      {
        "type": "text",
        "id": "newsletter_popup_button",
        "label": "Button text",
        "default": "START MY JOURNEY"
      },
      {
        "type": "image_picker",
        "id": "newsletter_popup_background",
        "label": "Background image",
        "info": "Blurred image behind the popup (e.g. hands with cacao)"
      },
      {
        "type": "color",
        "id": "newsletter_popup_bg",
        "label": "Popup background",
        "default": "#F5F0EB"
      },
      {
        "type": "color",
        "id": "newsletter_popup_button_bg",
        "label": "Button background",
        "default": "#B99135"
      },
      {
        "type": "color",
        "id": "newsletter_popup_button_text",
        "label": "Button text color",
        "default": "#ffffff"
      },
      {
        "type": "range",
        "id": "newsletter_popup_delay",
        "label": "Show after delay (seconds)",
        "min": 0,
        "max": 10,
        "step": 1,
        "default": 3,
        "unit": "s"
      },
      {
        "type": "range",
        "id": "newsletter_popup_hide_days",
        "label": "Don't show again for (days)",
        "min": 1,
        "max": 30,
        "step": 1,
        "default": 7,
        "unit": "days"
      }
    ]
  }
]

