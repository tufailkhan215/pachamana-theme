{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-featured-product-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 4rem 2rem;
    background: linear-gradient(135deg, {{ block.settings.background_color_1 }} 0%, {{ block.settings.background_color_2 }} 100%);
    animation: ai-featured-product-fade-in-{{ ai_gen_id }} 0.8s ease-out;
  }

  @keyframes ai-featured-product-fade-in-{{ ai_gen_id }} {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .ai-featured-product-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 3rem;
    align-items: center;
  }

  .ai-featured-product-container-{{ ai_gen_id }}.image-right {
    direction: rtl;
  }

  .ai-featured-product-container-{{ ai_gen_id }}.image-right > * {
    direction: ltr;
  }

  .ai-featured-product-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
  }

  .ai-featured-product-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.4s ease;
  }

  .ai-featured-product-image-wrapper-{{ ai_gen_id }}:hover .ai-featured-product-image-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-featured-product-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-featured-product-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-featured-product-info-{{ ai_gen_id }} {
    position: relative;
    background: {{ block.settings.info_background_color }};
    padding: 2.5rem;
    border-radius: {{ block.settings.info_border_radius }}px;
    {% if block.settings.enable_diagonal_clip %}
      clip-path: polygon(0 0, 100% 0, 95% 100%, 0% 100%);
    {% endif %}
  }

  .ai-featured-product-badges-{{ ai_gen_id }} {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }

  .ai-featured-product-badge-{{ ai_gen_id }} {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.35rem 0.85rem;
    border-radius: 20px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .ai-featured-product-badge-new-{{ ai_gen_id }} {
    background-color: {{ block.settings.badge_new_color }};
    color: {{ block.settings.badge_new_text_color }};
  }

  .ai-featured-product-badge-limited-{{ ai_gen_id }} {
    background-color: {{ block.settings.badge_limited_color }};
    color: {{ block.settings.badge_limited_text_color }};
  }

  .ai-featured-product-badge-sale-{{ ai_gen_id }} {
    background-color: {{ block.settings.badge_sale_color }};
    color: {{ block.settings.badge_sale_text_color }};
  }

  .ai-featured-product-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 700;
    color: {{ block.settings.title_color }};
    margin: 0 0 1rem;
    line-height: 1.2;
  }

  .ai-featured-product-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    font-weight: 300;
    color: {{ block.settings.description_color }};
    margin: 0 0 1.5rem;
    line-height: 1.6;
  }

  .ai-featured-product-pricing-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .ai-featured-product-price-{{ ai_gen_id }} {
    font-size: 1.75rem;
    font-weight: 700;
    color: {{ block.settings.price_color }};
  }

  .ai-featured-product-price-original-{{ ai_gen_id }} {
    font-size: 1.25rem;
    font-weight: 400;
    color: {{ block.settings.price_original_color }};
    text-decoration: line-through;
  }

  .ai-featured-product-rating-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin-bottom: 1.5rem;
  }

  .ai-featured-product-star-{{ ai_gen_id }} {
    width: 20px;
    height: 20px;
    position: relative;
    display: inline-block;
  }

  .ai-featured-product-star-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
  }

  .ai-featured-product-star-empty-{{ ai_gen_id }} {
    fill: #e0e0e0;
  }

  .ai-featured-product-star-full-{{ ai_gen_id }} {
    fill: {{ block.settings.star_color }};
  }

  .ai-featured-product-star-half-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 50%;
    overflow: hidden;
  }

  .ai-featured-product-star-half-{{ ai_gen_id }} svg {
    fill: {{ block.settings.star_color }};
  }

  .ai-featured-product-rating-text-{{ ai_gen_id }} {
    font-size: 0.9rem;
    color: {{ block.settings.description_color }};
    margin-left: 0.5rem;
  }

  .ai-featured-product-button-{{ ai_gen_id }} {
    display: inline-block;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    padding: 0.875rem 2rem;
    border-radius: {{ block.settings.button_border_radius }}px;
    border: none;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.3s ease, transform 0.2s ease;
    text-align: center;
  }

  .ai-featured-product-button-{{ ai_gen_id }}:hover,
  .ai-featured-product-button-{{ ai_gen_id }}:focus {
    background-color: {{ block.settings.button_hover_color }};
    transform: translateY(-2px);
  }

  .ai-featured-product-empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 3rem 1rem;
    color: #666;
  }

  .ai-featured-product-empty-state-{{ ai_gen_id }} p {
    font-size: 1.1rem;
    margin: 1rem 0;
  }

  @media screen and (max-width: 768px) {
    .ai-featured-product-{{ ai_gen_id }} {
      padding: 2rem 1rem;
    }

    .ai-featured-product-container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .ai-featured-product-container-{{ ai_gen_id }}.image-right {
      direction: ltr;
    }

    .ai-featured-product-info-{{ ai_gen_id }} {
      padding: 1.5rem;
      clip-path: none;
    }

    .ai-featured-product-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.8);
    }

    .ai-featured-product-description-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.description_size }}px * 0.9);
    }

    .ai-featured-product-price-{{ ai_gen_id }} {
      font-size: 1.5rem;
    }

    .ai-featured-product-button-{{ ai_gen_id }} {
      width: 100%;
      padding: 1rem 2rem;
    }
  }
{% endstyle %}

<featured-product-{{ ai_gen_id }}
  class="ai-featured-product-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.product != blank %}
    {% assign product = block.settings.product %}
    {% assign show_badge_new = block.settings.show_badge_new %}
    {% assign show_badge_limited = block.settings.show_badge_limited %}
    {% assign show_badge_sale = block.settings.show_badge_sale %}
    
    <div class="ai-featured-product-container-{{ ai_gen_id }} {% if block.settings.image_position == 'right' %}image-right{% endif %}">
      <div class="ai-featured-product-image-wrapper-{{ ai_gen_id }}">
        {% if product.featured_image %}
          <img
            src="{{ product.featured_image | image_url: width: 800 }}"
            alt="{{ product.featured_image.alt | escape }}"
            class="ai-featured-product-image-{{ ai_gen_id }}"
            loading="lazy"
            width="{{ product.featured_image.width }}"
            height="{{ product.featured_image.height }}"
          >
        {% else %}
          <div class="ai-featured-product-image-placeholder-{{ ai_gen_id }}">
            {{ 'product-1' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>

      <div class="ai-featured-product-info-{{ ai_gen_id }}">
        {% if show_badge_new or show_badge_limited or show_badge_sale %}
          <div class="ai-featured-product-badges-{{ ai_gen_id }}">
            {% if show_badge_new %}
              <span class="ai-featured-product-badge-{{ ai_gen_id }} ai-featured-product-badge-new-{{ ai_gen_id }}">
                {{ block.settings.badge_new_text }}
              </span>
            {% endif %}
            {% if show_badge_limited %}
              <span class="ai-featured-product-badge-{{ ai_gen_id }} ai-featured-product-badge-limited-{{ ai_gen_id }}">
                {{ block.settings.badge_limited_text }}
              </span>
            {% endif %}
            {% if show_badge_sale and product.compare_at_price > product.price %}
              <span class="ai-featured-product-badge-{{ ai_gen_id }} ai-featured-product-badge-sale-{{ ai_gen_id }}">
                {{ block.settings.badge_sale_text }}
              </span>
            {% endif %}
          </div>
        {% endif %}

        <h2 class="ai-featured-product-title-{{ ai_gen_id }}">
          {{ product.title }}
        </h2>

        {% if block.settings.show_description and product.description != blank %}
          <div class="ai-featured-product-description-{{ ai_gen_id }}">
            {{ product.description | strip_html | truncate: 200 }}
          </div>
        {% endif %}

        <div class="ai-featured-product-pricing-{{ ai_gen_id }}">
          <span class="ai-featured-product-price-{{ ai_gen_id }}">
            {{ product.price | money }}
          </span>
          {% if product.compare_at_price > product.price %}
            <span class="ai-featured-product-price-original-{{ ai_gen_id }}">
              {{ product.compare_at_price | money }}
            </span>
          {% endif %}
        </div>

        {% if block.settings.show_rating %}
          <div
            class="ai-featured-product-rating-{{ ai_gen_id }}"
            aria-label="Rating: {{ block.settings.rating_value }} out of 5"
          >
            {% assign rating = block.settings.rating_value %}
            {% assign full_stars = rating | floor %}
            {% assign has_half = rating | modulo: 1 %}
            {% assign empty_stars = 5 | minus: full_stars %}
            {% if has_half >= 0.5 %}
              {% assign empty_stars = empty_stars | minus: 1 %}
            {% endif %}

            {% for i in (1..full_stars) %}
              <span class="ai-featured-product-star-{{ ai_gen_id }}">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="ai-featured-product-star-full-{{ ai_gen_id }}">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
              </span>
            {% endfor %}

            {% if has_half >= 0.5 %}
              <span class="ai-featured-product-star-{{ ai_gen_id }}">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="ai-featured-product-star-empty-{{ ai_gen_id }}">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
                <span class="ai-featured-product-star-half-{{ ai_gen_id }}">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                  </svg>
                </span>
              </span>
            {% endif %}

            {% for i in (1..empty_stars) %}
              <span class="ai-featured-product-star-{{ ai_gen_id }}">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="ai-featured-product-star-empty-{{ ai_gen_id }}">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
              </span>
            {% endfor %}

            <span class="ai-featured-product-rating-text-{{ ai_gen_id }}">
              ({{ rating }})
            </span>
          </div>
        {% endif %}

        <a
          href="{{ product.url }}"
          class="ai-featured-product-button-{{ ai_gen_id }}"
        >
          {{ block.settings.button_text }}
        </a>
      </div>
    </div>
  {% else %}
    <div class="ai-featured-product-empty-state-{{ ai_gen_id }}">
      <div class="ai-featured-product-image-placeholder-{{ ai_gen_id }}">
        {{ 'product-1' | placeholder_svg_tag }}
      </div>
      <p>Select a product to feature</p>
    </div>
  {% endif %}
</featured-product-{{ ai_gen_id }}>

<script>
  (function() {
    class FeaturedProduct{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.initializeAccessibility();
      }

      initializeAccessibility() {
        const button = this.querySelector('.ai-featured-product-button-{{ ai_gen_id }}');
        if (button) {
          button.addEventListener('keydown', function(e) {
            if (e.key === 'Enter' || e.key === ' ') {
              e.preventDefault();
              button.click();
            }
          });
        }
      }
    }

    customElements.define('featured-product-{{ ai_gen_id }}', FeaturedProduct{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Featured product",
  "settings": [
    {
      "type": "header",
      "content": "Product"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show description",
      "default": true
    },
    {
      "type": "header",
      "content": "Badges"
    },
    {
      "type": "checkbox",
      "id": "show_badge_new",
      "label": "Show new badge",
      "default": false
    },
    {
      "type": "text",
      "id": "badge_new_text",
      "label": "New badge text",
      "default": "New"
    },
    {
      "type": "color",
      "id": "badge_new_color",
      "label": "New badge background",
      "default": "#ff6f61"
    },
    {
      "type": "color",
      "id": "badge_new_text_color",
      "label": "New badge text",
      "default": "#ffffff"
    },
    {
      "type": "checkbox",
      "id": "show_badge_limited",
      "label": "Show limited edition badge",
      "default": false
    },
    {
      "type": "text",
      "id": "badge_limited_text",
      "label": "Limited badge text",
      "default": "Limited Edition"
    },
    {
      "type": "color",
      "id": "badge_limited_color",
      "label": "Limited badge background",
      "default": "#6b46c1"
    },
    {
      "type": "color",
      "id": "badge_limited_text_color",
      "label": "Limited badge text",
      "default": "#ffffff"
    },
    {
      "type": "checkbox",
      "id": "show_badge_sale",
      "label": "Show sale badge",
      "default": true,
      "info": "Only shows when product has a compare at price"
    },
    {
      "type": "text",
      "id": "badge_sale_text",
      "label": "Sale badge text",
      "default": "Sale"
    },
    {
      "type": "color",
      "id": "badge_sale_color",
      "label": "Sale badge background",
      "default": "#E2AB43"
    },
    {
      "type": "color",
      "id": "badge_sale_text_color",
      "label": "Sale badge text",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Rating"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show rating",
      "default": true
    },
    {
      "type": "range",
      "id": "rating_value",
      "label": "Rating value",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "default": 4.5
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star color",
      "default": "#E2AB43"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Shop Now"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button background",
      "default": "#5C402F"
    },
    {
      "type": "color",
      "id": "button_hover_color",
      "label": "Button hover background",
      "default": "#3d2a1f"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#ffffff"
    },
