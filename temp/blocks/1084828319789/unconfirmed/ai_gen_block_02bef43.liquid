{% doc %}
  @prompt
    i just want a simple divider between the 2 sections
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-section-divider-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: {{ block.settings.spacing }}px auto;
    border: 0;
    border-top: {{ block.settings.thickness }}px solid {{ block.settings.divider_color }};
  }
{% endstyle %}

<hr class="ai-section-divider-{{ ai_gen_id }}" aria-hidden="true" {{ block.shopify_attributes }}>

{% schema %}
{
  "name": "Simple divider",
  "settings": [
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider color",
      "default": "#5C402F"
    },
    {
      "type": "range",
      "id": "thickness",
      "label": "Line thickness",
      "min": 1,
      "max": 5,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "range",
      "id": "spacing",
      "label": "Space above and below",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Simple divider"
    }
  ],
  "tag": null,
  "class": "simple-divider-block"
}
{% endschema %}