{% doc %}
  @prompt
    i want an image section just to put my logo
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-logo-block-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.padding_top }}px 0 {{ block.settings.padding_bottom }}px;
  }

  .ai-logo-wrapper-{{ ai_gen_id }} {
    display: flex;
    justify-content: {{ block.settings.alignment }};
    align-items: center;
    width: 100%;
  }

  .ai-logo-image-{{ ai_gen_id }} {
    max-width: {{ block.settings.logo_width }}px;
    width: 100%;
    height: auto;
  }

  .ai-logo-placeholder-{{ ai_gen_id }} {
    max-width: {{ block.settings.logo_width }}px;
    width: 100%;
    background-color: #f4f4f4;
    border-radius: 8px;
    padding: 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
  }

  .ai-logo-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    max-width: 200px;
    height: auto;
    opacity: 0.3;
  }

  .ai-logo-empty-state-{{ ai_gen_id }} {
    font-size: 14px;
    color: #666;
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    .ai-logo-image-{{ ai_gen_id }},
    .ai-logo-placeholder-{{ ai_gen_id }} {
      max-width: {{ block.settings.logo_width_mobile }}px;
    }
  }
{% endstyle %}

<logo-block-{{ ai_gen_id }}
  class="ai-logo-block-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-logo-wrapper-{{ ai_gen_id }}">
    {% if block.settings.logo != blank %}
      <img
        src="{{ block.settings.logo | image_url: width: 1000 }}"
        alt="{{ block.settings.logo.alt | default: shop.name | escape }}"
        class="ai-logo-image-{{ ai_gen_id }}"
        width="{{ block.settings.logo.width }}"
        height="{{ block.settings.logo.height }}"
        loading="lazy"
      >
    {% else %}
      <div class="ai-logo-placeholder-{{ ai_gen_id }}">
        {{ 'image' | placeholder_svg_tag }}
        <div class="ai-logo-empty-state-{{ ai_gen_id }}">
          Add your logo image
        </div>
      </div>
    {% endif %}
  </div>
</logo-block-{{ ai_gen_id }}>

{% schema %}
{
  "name": "Logo image",
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width (desktop)",
      "min": 50,
      "max": 500,
      "step": 10,
      "unit": "px",
      "default": 200
    },
    {
      "type": "range",
      "id": "logo_width_mobile",
      "label": "Logo width (mobile)",
      "min": 50,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 150
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Logo image"
    }
  ]
}
{% endschema %}