{% doc %}
  @prompt
    Issue: People can't quickly figure out how many servings they're getting or price per cup 
    Add this box to every product page: 
    AT A GLANCE 
    • Weight: 8 oz (227g) 
    • Makes: ~11 cups (using 22g per serving) 
    • Price per cup: ~$2.45 
    • Best for: [Morning ritual / Sweet tooth / Focus & energy / etc.] 
    Why it works: Justifies the premium price and helps people budget. Reduces "how long will 
    this last?" questions.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-glance-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    padding: {{ block.settings.padding }}px;
  }

  .ai-product-glance__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 700;
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.spacing }}px 0;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .ai-product-glance__list-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.item_spacing }}px;
  }

  .ai-product-glance__item-{{ ai_gen_id }} {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.5;
  }

  .ai-product-glance__bullet-{{ ai_gen_id }} {
    color: {{ block.settings.bullet_color }};
    font-weight: 700;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .ai-product-glance__label-{{ ai_gen_id }} {
    font-weight: 600;
    color: {{ block.settings.label_color }};
  }

  .ai-product-glance__value-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-product-glance-{{ ai_gen_id }} {
      padding: {{ block.settings.padding | times: 0.75 }}px;
    }

    .ai-product-glance__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.9 }}px;
    }

    .ai-product-glance__item-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-product-glance-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <h3 class="ai-product-glance__title-{{ ai_gen_id }}">{{ block.settings.title }}</h3>
  
  <ul class="ai-product-glance__list-{{ ai_gen_id }}">
    {% if block.settings.show_weight and block.settings.weight_text != blank %}
      <li class="ai-product-glance__item-{{ ai_gen_id }}">
        <span class="ai-product-glance__bullet-{{ ai_gen_id }}">•</span>
        <span>
          <span class="ai-product-glance__label-{{ ai_gen_id }}">{{ block.settings.weight_label }}:</span>
          <span class="ai-product-glance__value-{{ ai_gen_id }}">{{ block.settings.weight_text }}</span>
        </span>
      </li>
    {% endif %}

    {% if block.settings.show_servings and block.settings.servings_text != blank %}
      <li class="ai-product-glance__item-{{ ai_gen_id }}">
        <span class="ai-product-glance__bullet-{{ ai_gen_id }}">•</span>
        <span>
          <span class="ai-product-glance__label-{{ ai_gen_id }}">{{ block.settings.servings_label }}:</span>
          <span class="ai-product-glance__value-{{ ai_gen_id }}">{{ block.settings.servings_text }}</span>
        </span>
      </li>
    {% endif %}

    {% if block.settings.show_price_per_serving and block.settings.price_per_serving_text != blank %}
      <li class="ai-product-glance__item-{{ ai_gen_id }}">
        <span class="ai-product-glance__bullet-{{ ai_gen_id }}">•</span>
        <span>
          <span class="ai-product-glance__label-{{ ai_gen_id }}">{{ block.settings.price_per_serving_label }}:</span>
          <span class="ai-product-glance__value-{{ ai_gen_id }}">{{ block.settings.price_per_serving_text }}</span>
        </span>
      </li>
    {% endif %}

    {% if block.settings.show_best_for and block.settings.best_for_text != blank %}
      <li class="ai-product-glance__item-{{ ai_gen_id }}">
        <span class="ai-product-glance__bullet-{{ ai_gen_id }}">•</span>
        <span>
          <span class="ai-product-glance__label-{{ ai_gen_id }}">{{ block.settings.best_for_label }}:</span>
          <span class="ai-product-glance__value-{{ ai_gen_id }}">{{ block.settings.best_for_text }}</span>
        </span>
      </li>
    {% endif %}
  </ul>
</div>

