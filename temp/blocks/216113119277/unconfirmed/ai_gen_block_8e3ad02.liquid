{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-bundle-section-{{ ai_gen_id }} {
    width: 100%;
    background: linear-gradient(135deg, {{ block.settings.gradient_start }} 0%, {{ block.settings.gradient_end }} 100%);
    position: relative;
    overflow: hidden;
  }

  .ai-bundle-section-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    {% if block.settings.background_image %}
      background-image: url('{{ block.settings.background_image | image_url: width: 2000 }}');
      background-size: cover;
      background-position: center;
      opacity: {{ block.settings.image_opacity }};
    {% endif %}
    pointer-events: none;
  }

  .ai-bundle-container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
    padding: 60px 20px;
    position: relative;
    z-index: 1;
  }

  .ai-bundle-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: center;
  }

  .ai-bundle-grid-{{ ai_gen_id }}.reverse {
    direction: rtl;
  }

  .ai-bundle-grid-{{ ai_gen_id }}.reverse > * {
    direction: ltr;
  }

  .ai-bundle-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    {% if block.settings.image_fit == 'cover' %}
      height: 600px;
    {% else %}
      height: auto;
    {% endif %}
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
    background-color: #f4f4f4;
  }

  .ai-bundle-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    {% if block.settings.image_fit == 'cover' %}
      object-fit: cover;
    {% else %}
      object-fit: contain;
    {% endif %}
    display: block;
  }

  .ai-bundle-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 600px;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-bundle-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 400px;
    max-height: 400px;
  }

  .ai-bundle-info-panel-{{ ai_gen_id }} {
    background: {{ block.settings.panel_background }};
    padding: {{ block.settings.panel_padding }}px;
    border-radius: {{ block.settings.panel_border_radius }}px;
  }

  .ai-bundle-badge-{{ ai_gen_id }} {
    display: inline-block;
    background: {{ block.settings.badge_background }};
    color: {{ block.settings.badge_text_color }};
    font-size: {{ block.settings.badge_font_size }}px;
    padding: 6px 12px;
    border-radius: 4px;
    margin-bottom: 16px;
    font-weight: 600;
  }

  .ai-bundle-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 16px 0;
    line-height: 1.2;
  }

  .ai-bundle-rating-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
  }

  .ai-bundle-stars-{{ ai_gen_id }} {
    display: flex;
    gap: 4px;
  }

  .ai-bundle-star-{{ ai_gen_id }} {
    width: {{ block.settings.star_size }}px;
    height: {{ block.settings.star_size }}px;
  }

  .ai-bundle-star-{{ ai_gen_id }}.filled {
    color: {{ block.settings.star_color }};
  }

  .ai-bundle-star-{{ ai_gen_id }}.empty {
    color: {{ block.settings.empty_star_color }};
  }

  .ai-bundle-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    margin-bottom: 20px;
    line-height: 1.6;
  }

  .ai-bundle-price-wrapper-{{ ai_gen_id }} {
    margin-bottom: 24px;
  }

  .ai-bundle-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_size }}px;
    color: {{ block.settings.price_color }};
    font-weight: 700;
    margin-right: 12px;
  }

  .ai-bundle-original-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.original_price_size }}px;
    color: {{ block.settings.original_price_color }};
    text-decoration: line-through;
  }

  .ai-bundle-benefits-wrapper-{{ ai_gen_id }} {
    margin-bottom: 32px;
    overflow: hidden;
  }

  .ai-bundle-benefits-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 24px;
    flex-wrap: wrap;
  }

  .ai-bundle-benefits-{{ ai_gen_id }}.scrolling {
    flex-wrap: nowrap;
    justify-content: flex-start;
    animation: ai-bundle-scroll-{{ ai_gen_id }} var(--scroll-speed) linear infinite;
  }

  @keyframes ai-bundle-scroll-{{ ai_gen_id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .ai-bundle-benefit-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    text-align: center;
    flex-shrink: 0;
  }

  .ai-bundle-benefit-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    background: {{ block.settings.icon_background }};
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: calc({{ block.settings.icon_size }}px * 0.5);
    overflow: hidden;
  }

  .ai-bundle-benefit-icon-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-bundle-benefit-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.benefit_text_size }}px;
    color: {{ block.settings.description_color }};
    font-weight: 500;
  }

  .ai-bundle-cta-{{ ai_gen_id }} {
    display: inline-block;
    width: 100%;
    text-align: center;
    background: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    font-size: {{ block.settings.button_font_size }}px;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    border-radius: {{ block.settings.button_border_radius }}px;
    text-decoration: none;
    font-weight: 600;
    transition: background 0.3s ease;
    border: none;
    cursor: pointer;
  }

  .ai-bundle-cta-{{ ai_gen_id }}:hover {
    background: {{ block.settings.button_hover_background }};
  }

  @media screen and (max-width: 768px) {
    .ai-bundle-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .ai-bundle-grid-{{ ai_gen_id }}.reverse {
      direction: ltr;
    }

    .ai-bundle-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.75);
    }

    .ai-bundle-price-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.price_size }}px * 0.85);
    }

    .ai-bundle-info-panel-{{ ai_gen_id }} {
      padding: 24px;
    }
  }
{% endstyle %}

<bundle-showcase-{{ ai_gen_id }} class="ai-bundle-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-bundle-container-{{ ai_gen_id }}">
    <div class="ai-bundle-grid-{{ ai_gen_id }} {% if block.settings.image_position == 'right' %}reverse{% endif %}">
      <div class="ai-bundle-image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.featured_product %}
          {% assign product = block.settings.featured_product %}
          {% if product.featured_image %}
            <img
              src="{{ product.featured_image | image_url: width: 1200 }}"
              alt="{{ product.featured_image.alt | escape }}"
              class="ai-bundle-image-{{ ai_gen_id }}"
              loading="lazy"
              width="{{ product.featured_image.width }}"
              height="{{ product.featured_image.height }}"
            >
          {% else %}
            <div class="ai-bundle-image-placeholder-{{ ai_gen_id }}">
              {{ 'product-1' | placeholder_svg_tag }}
            </div>
          {% endif %}
        {% else %}
          <div class="ai-bundle-image-placeholder-{{ ai_gen_id }}">
            {{ 'product-1' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>

      <div class="ai-bundle-info-panel-{{ ai_gen_id }}">
        {% if block.settings.show_badge %}
          <div class="ai-bundle-badge-{{ ai_gen_id }}">
            {{ block.settings.badge_text }}
          </div>
        {% endif %}

        <h2 class="ai-bundle-title-{{ ai_gen_id }}">
          {% if block.settings.featured_product %}
            {{ block.settings.featured_product.title }}
          {% else %}
            {{ block.settings.product_title }}
          {% endif %}
        </h2>

        {% if block.settings.show_rating %}
          <div class="ai-bundle-rating-{{ ai_gen_id }}">
            <div class="ai-bundle-stars-{{ ai_gen_id }}">
              {% for i in (1..5) %}
                <svg class="ai-bundle-star-{{ ai_gen_id }} {% if i <= block.settings.rating_value %}filled{% else %}empty{% endif %}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
              {% endfor %}
            </div>
          </div>
        {% endif %}

        <div class="ai-bundle-description-{{ ai_gen_id }}">
          {% if block.settings.featured_product and block.settings.featured_product.description != blank %}
            {{ block.settings.featured_product.description | strip_html | truncate: 200 }}
          {% else %}
            {{ block.settings.product_description }}
          {% endif %}
        </div>

        <div class="ai-bundle-price-wrapper-{{ ai_gen_id }}">
          {% if block.settings.featured_product %}
            <span class="ai-bundle-price-{{ ai_gen_id }}">{{ block.settings.featured_product.price | money }}</span>
            {% if block.settings.featured_product.compare_at_price > block.settings.featured_product.price %}
              <span class="ai-bundle-original-price-{{ ai_gen_id }}">{{ block.settings.featured_product.compare_at_price | money }}</span>
            {% endif %}
          {% else %}
            <span class="ai-bundle-price-{{ ai_gen_id }}">{{ block.settings.product_price }}</span>
            {% if block.settings.original_price != blank %}
              <span class="ai-bundle-original-price-{{ ai_gen_id }}">{{ block.settings.original_price }}</span>
            {% endif %}
          {% endif %}
        </div>

        {% if block.settings.show_benefits %}
          <div class="ai-bundle-benefits-wrapper-{{ ai_gen_id }}">
            <div 
              class="ai-bundle-benefits-{{ ai_gen_id }} {% if block.settings.enable_auto_scroll %}scrolling{% endif %}"
              style="--scroll-speed: {{ block.settings.scroll_speed }}s;"
              data-auto-scroll="{{ block.settings.enable_auto_scroll }}"
            >
              <div class="ai-bundle-benefit-{{ ai_gen_id }}">
                <div class="ai-bundle-benefit-icon-{{ ai_gen_id }}">
                  {% if block.settings.benefit_1_icon %}
                    <img src="{{ block.settings.benefit_1_icon | image_url: width: 100 }}" alt="{{ block.settings.benefit_1_text }}">
                  {% else %}
                    💰
                  {% endif %}
                </div>
                <div class="ai-bundle-benefit-text-{{ ai_gen_id }}">{{ block.settings.benefit_1_text }}</div>
              </div>
              <div class="ai-bundle-benefit-{{ ai_gen_id }}">
                <div class="ai-bundle-benefit-icon-{{ ai_gen_id }}">
                  {% if block.settings.benefit_2_icon %}
                    <img src="{{ block.settings.benefit_2_icon | image_url: width: 100 }}" alt="{{ block.settings.benefit_2_text }}">
                  {% else %}
                    🚚
                  {% endif %}
                </div>
                <div class="ai-bundle-benefit-text-{{ ai_gen_id }}">{{ block.settings.benefit_2_text }}</div>
              </div>
              <div class="ai-bundle-benefit-{{ ai_gen_id }}">
                <div class="ai-bundle-benefit-icon-{{ ai_gen_id }}">
                  {% if block.settings.benefit_3_icon %}
                    <img src="{{ block.settings.benefit_3_icon | image_url: width: 100 }}" alt="{{ block.settings.benefit_3_text }}">
                  {% else %}
                    🎁
                  {% endif %}
                </div>
                <div class="ai-bundle-benefit-text-{{ ai_gen_id }}">{{ block.settings.benefit_3_text }}</div>
              </div>
              {% if block.settings.enable_auto_scroll %}
                <div class="ai-bundle-benefit-{{ ai_gen_id }}">
                  <div class="ai-bundle-benefit-icon-{{ ai_gen_id }}">
                    {% if block.settings.benefit_1_icon %}
                      <img src="{{ block.settings.benefit_1_icon | image_url: width: 100 }}" alt="{{ block.settings.benefit_1_text }}">
                    {% else %}
                      💰
                    {% endif %}
                  </div>
                  <div class="ai-bundle-benefit-text-{{ ai_gen_id }}">{{ block.settings.benefit_1_text }}</div>
                </div>
                <div class="ai-bundle-benefit-{{ ai_gen_id }}">
                  <div class="ai-bundle-benefit-icon-{{ ai_gen_id }}">
                    {% if block.settings.benefit_2_icon %}
                      <img src="{{ block.settings.benefit_2_icon | image_url: width: 100 }}" alt="{{ block.settings.benefit_2_text }}">
                    {% else %}
                      🚚
                    {% endif %}
                  </div>
                  <div class="ai-bundle-benefit-text-{{ ai_gen_id }}">{{ block.settings.benefit_2_text }}</div>
                </div>
                <div class="ai-bundle-benefit-{{ ai_gen_id }}">
                  <div class="ai-bundle-benefit-icon-{{ ai_gen_id }}">
                    {% if block.settings.benefit_3_icon %}
                      <img src="{{ block.settings.benefit_3_icon | image_url: width: 100 }}" alt="{{ block.settings.benefit_3_text }}">
                    {% else %}
                      🎁
                    {% endif %}
                  </div>
                  <div class="ai-bundle-benefit-text-{{ ai_gen_id }}">{{ block.settings.benefit_3_text }}</div>
                </div>
              {% endif %}
            </div>
          </div>
        {% endif %}

        <a href="{% if block.settings.featured_product %}{{ block.settings.featured_product.url }}{% else %}{{ block.settings.cta_link }}{% endif %}" class="ai-bundle-cta-{{ ai_gen_id }}">
          {{ block.settings.cta_label }}
        </a>
      </div>
    </div>
  </div>
</bundle-showcase-{{ ai_gen_id }}>

<script>
  (function() {
    class BundleShowcase{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.benefitsContainer = null;
      }

      connectedCallback() {
        this.benefitsContainer = this.querySelector('.ai-bundle-benefits-{{ ai_gen_id }}');
        if (this.benefitsContainer && this.benefitsContainer.dataset.autoScroll === 'true') {
          this.setupAutoScroll();
        }
      }

      setupAutoScroll() {
        this.benefitsContainer.addEventListener('mouseenter', () => {
          this.benefitsContainer.style.animationPlayState = 'paused';
        });

        this.benefitsContainer.addEventListener('mouseleave', () => {
          this.benefitsContainer.style.animationPlayState = 'running';
        });
      }
    }

    customElements.define('bundle-showcase-{{ ai_gen_id }}', BundleShowcase{{ ai_gen_id }});
  })();
</script>

