{% doc %}
  @prompt
    Generate a privacy policy section with header and matching UI where I can place the content. 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-privacy-policy-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.section_padding }}px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-privacy-policy-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.content_max_width }}px;
    margin: 0 auto;
  }

  .ai-privacy-policy-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.header_alignment }};
    margin-bottom: {{ block.settings.header_spacing }}px;
    padding-bottom: {{ block.settings.header_spacing | divided_by: 2 }}px;
    border-bottom: {{ block.settings.divider_width }}px solid {{ block.settings.divider_color }};
  }

  .ai-privacy-policy-title-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.subtitle_spacing }}px 0;
    line-height: 1.2;
  }

  .ai-privacy-policy-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0;
    line-height: 1.5;
  }

  .ai-privacy-policy-content-{{ ai_gen_id }} {
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-weight: {{ block.settings.body_font.weight }};
    font-size: {{ block.settings.body_size }}px;
    color: {{ block.settings.body_color }};
    line-height: {{ block.settings.line_height }};
    background-color: {{ block.settings.content_background }};
    padding: {{ block.settings.content_padding }}px;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-privacy-policy-content-{{ ai_gen_id }} h2,
  .ai-privacy-policy-content-{{ ai_gen_id }} h3,
  .ai-privacy-policy-content-{{ ai_gen_id }} h4 {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    color: {{ block.settings.heading_color }};
    margin-top: {{ block.settings.section_spacing }}px;
    margin-bottom: {{ block.settings.paragraph_spacing }}px;
    line-height: 1.3;
  }

  .ai-privacy-policy-content-{{ ai_gen_id }} h2 {
    font-size: {{ block.settings.heading_size | times: 0.7 }}px;
  }

  .ai-privacy-policy-content-{{ ai_gen_id }} h3 {
    font-size: {{ block.settings.heading_size | times: 0.6 }}px;
  }

  .ai-privacy-policy-content-{{ ai_gen_id }} h4 {
    font-size: {{ block.settings.heading_size | times: 0.5 }}px;
  }

  .ai-privacy-policy-content-{{ ai_gen_id }} p {
    margin: 0 0 {{ block.settings.paragraph_spacing }}px 0;
  }

  .ai-privacy-policy-content-{{ ai_gen_id }} ul,
  .ai-privacy-policy-content-{{ ai_gen_id }} ol {
    margin: 0 0 {{ block.settings.paragraph_spacing }}px 0;
    padding-left: 30px;
  }

  .ai-privacy-policy-content-{{ ai_gen_id }} li {
    margin-bottom: {{ block.settings.paragraph_spacing | divided_by: 2 }}px;
  }

  .ai-privacy-policy-content-{{ ai_gen_id }} a {
    color: {{ block.settings.link_color }};
    text-decoration: underline;
  }

  .ai-privacy-policy-content-{{ ai_gen_id }} a:hover {
    color: {{ block.settings.link_hover_color }};
  }

  .ai-privacy-policy-empty-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: #999;
    font-style: italic;
  }

  @media screen and (max-width: 749px) {
    .ai-privacy-policy-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding | times: 0.6 }}px 16px;
    }

    .ai-privacy-policy-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
    }

    .ai-privacy-policy-subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_size | times: 0.9 }}px;
    }

    .ai-privacy-policy-content-{{ ai_gen_id }} {
      font-size: {{ block.settings.body_size | times: 0.9 }}px;
      padding: {{ block.settings.content_padding | times: 0.7 }}px;
    }

    .ai-privacy-policy-content-{{ ai_gen_id }} h2 {
      font-size: {{ block.settings.heading_size | times: 0.5 }}px;
    }

    .ai-privacy-policy-content-{{ ai_gen_id }} h3 {
      font-size: {{ block.settings.heading_size | times: 0.45 }}px;
    }

    .ai-privacy-policy-content-{{ ai_gen_id }} h4 {
      font-size: {{ block.settings.heading_size | times: 0.4 }}px;
    }
  }
{% endstyle %}

<div class="ai-privacy-policy-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-privacy-policy-container-{{ ai_gen_id }}">
    <div class="ai-privacy-policy-header-{{ ai_gen_id }}">
      {% if block.settings.title != blank %}
        <h1 class="ai-privacy-policy-title-{{ ai_gen_id }}">{{ block.settings.title }}</h1>
      {% endif %}
      {% if block.settings.subtitle != blank %}
        <p class="ai-privacy-policy-subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>
      {% endif %}
    </div>

    {% if block.settings.content != blank %}
      <div class="ai-privacy-policy-content-{{ ai_gen_id }}">
        {{ block.settings.content }}
      </div>
    {% else %}
      <div class="ai-privacy-policy-empty-{{ ai_gen_id }}">
        Add your privacy policy content in the block settings
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Privacy policy",
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Privacy Policy"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Last updated: April 1, 2026"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Privacy policy content",
      "default": "<h2>Introduction</h2><p>This Privacy Policy describes how we collect, use, and protect your personal information when you visit our website or make a purchase.</p><h2>Information We Collect</h2><p>We collect information you provide directly to us, such as when you create an account, make a purchase, or contact us for support.</p><h3>Personal Information</h3><ul><li>Name and contact information</li><li>Billing and shipping addresses</li><li>Payment information</li><li>Email address and phone number</li></ul><h2>How We Use Your Information</h2><p>We use the information we collect to process your orders, communicate with you, and improve our services.</p>"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Content max width",
      "min": 600,
      "max": 1200,
      "step": 50,
      "unit": "px",
      "default": 900
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "assistant_n4"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "default": "assistant_n4"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Title size",
      "min": 24,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "label": "Subtitle size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Body size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "line_height",
      "label": "Line height",
      "min": 1,
      "max": 2,
      "step": 0.1,
      "default": 1.6
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "content_background",
      "label": "Content background",
      "default": "#f9f9f9"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#5C402F"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Body text",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link",
      "default": "#E2AB43"
    },
    {
      "type": "color",
      "id": "link_hover_color",
      "label": "Link hover",
      "default": "#5C402F"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider",
      "default": "#e0e0e0"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Section padding",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "header_spacing",
      "label": "Header spacing",
      "min": 20,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "subtitle_spacing",
      "label": "Subtitle spacing",
      "min": 5,
      "max": 30,
      "step": 5,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "content_padding",
      "label": "Content padding",
      "min": 20,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "section_spacing",
      "label": "Section spacing",
      "min": 20,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "paragraph_spacing",
      "label": "Paragraph spacing",
      "min": 10,
      "max": 40,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Content border radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "divider_width",
      "label": "Divider width",
      "min": 0,
      "max": 5,
      "step": 1,
      "unit": "px",
      "default": 2
    }
  ],
  "presets": [
    {
      "name": "Privacy policy"
    }
  ]
}
{% endschema %}
