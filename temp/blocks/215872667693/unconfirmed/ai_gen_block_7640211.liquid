{% doc %}
  @prompt
    Create a mobile-friendly hero landing page section with these features:
    
    Background images that automatically change every 5 seconds.
    A setting to adjust the opacity of the background images.
    Centered overlay text with the heading:
    CEREMONIAL CACAO BUNDLES
    And the subtext:
    Explore Pacha Mana ceremonial cacao bundles — pure Chuncho cacao, botanical blends, and mushroom vitality. Curated sets for daily ritual, gifting, and sharing.
    Ensure the design is fully responsive and looks great on all screen sizes.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-hero-landing-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    min-height: {{ block.settings.section_height_desktop }}px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-hero-landing-backgrounds-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .ai-hero-landing-bg-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 1s ease-in-out;
  }

  .ai-hero-landing-bg-image-{{ ai_gen_id }}.active {
    opacity: {{ block.settings.background_opacity }};
  }

  .ai-hero-landing-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity }};
    z-index: 2;
  }

  .ai-hero-landing-content-{{ ai_gen_id }} {
    position: relative;
    z-index: 3;
    text-align: center;
    padding: 40px 20px;
    max-width: {{ block.settings.content_max_width }}px;
    width: 100%;
  }

  .ai-hero-landing-heading-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-style: {{ block.settings.heading_font.style }};
    font-size: {{ block.settings.heading_size_desktop }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_spacing }}px 0;
    line-height: 1.2;
    letter-spacing: {{ block.settings.heading_letter_spacing }}px;
  }

  .ai-hero-landing-subtext-{{ ai_gen_id }} {
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-weight: {{ block.settings.body_font.weight }};
    font-style: {{ block.settings.body_font.style }};
    font-size: {{ block.settings.subtext_size_desktop }}px;
    color: {{ block.settings.subtext_color }};
    margin: 0;
    line-height: 1.6;
  }

  @media screen and (max-width: 749px) {
    .ai-hero-landing-{{ ai_gen_id }} {
      min-height: {{ block.settings.section_height_mobile }}px;
    }

    .ai-hero-landing-content-{{ ai_gen_id }} {
      padding: 30px 20px;
    }

    .ai-hero-landing-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_mobile }}px;
    }

    .ai-hero-landing-subtext-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtext_size_mobile }}px;
    }
  }
{% endstyle %}

<hero-landing-{{ ai_gen_id }} class="ai-hero-landing-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-hero-landing-backgrounds-{{ ai_gen_id }}">
    {% if block.settings.background_image_1 %}
      <img
        src="{{ block.settings.background_image_1 | image_url: width: 2000 }}"
        alt="{{ block.settings.background_image_1.alt | escape }}"
        class="ai-hero-landing-bg-image-{{ ai_gen_id }} active"
        loading="eager"
        width="{{ block.settings.background_image_1.width }}"
        height="{{ block.settings.background_image_1.height }}"
      >
    {% endif %}
    {% if block.settings.background_image_2 %}
      <img
        src="{{ block.settings.background_image_2 | image_url: width: 2000 }}"
        alt="{{ block.settings.background_image_2.alt | escape }}"
        class="ai-hero-landing-bg-image-{{ ai_gen_id }}"
        loading="eager"
        width="{{ block.settings.background_image_2.width }}"
        height="{{ block.settings.background_image_2.height }}"
      >
    {% endif %}
    {% if block.settings.background_image_3 %}
      <img
        src="{{ block.settings.background_image_3 | image_url: width: 2000 }}"
        alt="{{ block.settings.background_image_3.alt | escape }}"
        class="ai-hero-landing-bg-image-{{ ai_gen_id }}"
        loading="eager"
        width="{{ block.settings.background_image_3.width }}"
        height="{{ block.settings.background_image_3.height }}"
      >
    {% endif %}
    {% if block.settings.background_image_4 %}
      <img
        src="{{ block.settings.background_image_4 | image_url: width: 2000 }}"
        alt="{{ block.settings.background_image_4.alt | escape }}"
        class="ai-hero-landing-bg-image-{{ ai_gen_id }}"
        loading="eager"
        width="{{ block.settings.background_image_4.width }}"
        height="{{ block.settings.background_image_4.height }}"
      >
    {% endif %}
    {% if block.settings.background_image_5 %}
      <img
        src="{{ block.settings.background_image_5 | image_url: width: 2000 }}"
        alt="{{ block.settings.background_image_5.alt | escape }}"
        class="ai-hero-landing-bg-image-{{ ai_gen_id }}"
        loading="eager"
        width="{{ block.settings.background_image_5.width }}"
        height="{{ block.settings.background_image_5.height }}"
      >
    {% endif %}
  </div>

  <div class="ai-hero-landing-overlay-{{ ai_gen_id }}"></div>

  <div class="ai-hero-landing-content-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h1 class="ai-hero-landing-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h1>
    {% endif %}
    {% if block.settings.subtext != blank %}
      <div class="ai-hero-landing-subtext-{{ ai_gen_id }}">{{ block.settings.subtext }}</div>
    {% endif %}
  </div>
</hero-landing-{{ ai_gen_id }}>

<script>
  (function() {
    class HeroLanding{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.images = [];
        this.intervalId = null;
      }

      connectedCallback() {
        this.images = Array.from(this.querySelectorAll('.ai-hero-landing-bg-image-{{ ai_gen_id }}'));
        
        if (this.images.length > 1) {
          this.startRotation();
        }
      }

      startRotation() {
        this.intervalId = setInterval(() => {
          this.images[this.currentIndex].classList.remove('active');
          this.currentIndex = (this.currentIndex + 1) % this.images.length;
          this.images[this.currentIndex].classList.add('active');
        }, 5000);
      }

      disconnectedCallback() {
        if (this.intervalId) {
          clearInterval(this.intervalId);
        }
      }
    }

    customElements.define('hero-landing-{{ ai_gen_id }}', HeroLanding{{ ai_gen_id }});
  })();
</script>

