{% doc %}
  @prompt
    Create an automatic photo carousel that scrolls through images every 3 seconds. The carousel should have a fixed vertical size and smoothly transition between photos.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-carousel-{{ ai_gen_id }} {
    display: block;
    position: relative;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    height: {{ block.settings.carousel_height }}px;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-carousel-track-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .ai-carousel-slide-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity {{ block.settings.transition_duration }}s ease-in-out;
  }

  .ai-carousel-slide-{{ ai_gen_id }}.active {
    opacity: 1;
    z-index: 1;
  }

  .ai-carousel-slide-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-carousel-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-carousel-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-carousel-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-carousel-controls-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 8px;
    z-index: 2;
  }

  .ai-carousel-dot-{{ ai_gen_id }} {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    opacity: 0.5;
    border: none;
    cursor: pointer;
    padding: 0;
    transition: opacity 0.3s ease;
  }

  .ai-carousel-dot-{{ ai_gen_id }}.active {
    opacity: 1;
  }

  .ai-carousel-dot-{{ ai_gen_id }}:hover {
    opacity: 0.8;
  }

  @media screen and (max-width: 749px) {
    .ai-carousel-{{ ai_gen_id }} {
      height: {{ block.settings.carousel_height | times: 0.7 }}px;
    }
  }
{% endstyle %}

<auto-carousel-{{ ai_gen_id }}
  class="ai-carousel-{{ ai_gen_id }}"
  data-interval="{{ block.settings.slide_interval }}"
  data-transition="{{ block.settings.transition_duration }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-carousel-track-{{ ai_gen_id }}">
    {% if block.settings.image_1 or block.settings.image_2 or block.settings.image_3 or block.settings.image_4 or block.settings.image_5 %}
      {% for i in (1..5) %}
        {% assign image_key = 'image_' | append: i %}
        {% assign image = block.settings[image_key] %}
        
        {% if image %}
          <div class="ai-carousel-slide-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}" data-slide="{{ forloop.index0 }}">
            <img
              src="{{ image | image_url: width: 2000 }}"
              alt="{{ image.alt | escape }}"
              loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
              width="{{ image.width }}"
              height="{{ image.height }}"
            >
          </div>
        {% endif %}
      {% endfor %}
    {% else %}
      <div class="ai-carousel-slide-{{ ai_gen_id }} active" data-slide="0">
        <div class="ai-carousel-placeholder-{{ ai_gen_id }}">
          {{ 'hero-apparel-1' | placeholder_svg_tag }}
          <div class="ai-carousel-empty-state-{{ ai_gen_id }}">
            Next, add images to the carousel
          </div>
        </div>
      </div>
    {% endif %}
  </div>

  {% if block.settings.show_dots %}
    <div class="ai-carousel-controls-{{ ai_gen_id }}">
      {% assign image_count = 0 %}
      {% for i in (1..5) %}
        {% assign image_key = 'image_' | append: i %}
        {% if block.settings[image_key] %}
          {% assign image_count = image_count | plus: 1 %}
        {% endif %}
      {% endfor %}

      {% if image_count > 0 %}
        {% for i in (1..image_count) %}
          <button
            class="ai-carousel-dot-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}"
            data-slide="{{ forloop.index0 }}"
            aria-label="Go to slide {{ forloop.index }}"
          ></button>
        {% endfor %}
      {% endif %}
    </div>
  {% endif %}
</auto-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class AutoCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 0;
        this.intervalId = null;
        this.isTransitioning = false;
      }

      connectedCallback() {
        this.slides = this.querySelectorAll('.ai-carousel-slide-{{ ai_gen_id }}');
        this.dots = this.querySelectorAll('.ai-carousel-dot-{{ ai_gen_id }}');
        this.interval = parseInt(this.dataset.interval) * 1000;
        this.transitionDuration = parseFloat(this.dataset.transition) * 1000;

        if (this.slides.length > 1) {
          this.startAutoPlay();
          this.setupDotControls();
        }
      }

      disconnectedCallback() {
        this.stopAutoPlay();
      }

      startAutoPlay() {
        this.intervalId = setInterval(() => {
          this.nextSlide();
        }, this.interval);
      }

      stopAutoPlay() {
        if (this.intervalId) {
          clearInterval(this.intervalId);
          this.intervalId = null;
        }
      }

      nextSlide() {
        if (this.isTransitioning) return;
        
        this.isTransitioning = true;
        const nextIndex = (this.currentSlide + 1) % this.slides.length;
        this.goToSlide(nextIndex);
        
        setTimeout(() => {
          this.isTransitioning = false;
        }, this.transitionDuration);
      }

      goToSlide(index) {
        this.slides[this.currentSlide].classList.remove('active');
        if (this.dots.length > 0) {
          this.dots[this.currentSlide].classList.remove('active');
        }

        this.currentSlide = index;

        this.slides[this.currentSlide].classList.add('active');
        if (this.dots.length > 0) {
          this.dots[this.currentSlide].classList.add('active');
        }
      }

      setupDotControls() {
        this.dots.forEach((dot, index) => {
          dot.addEventListener('click', () => {
            if (this.isTransitioning) return;
            
            this.stopAutoPlay();
            this.isTransitioning = true;
            this.goToSlide(index);
            
            setTimeout(() => {
              this.isTransitioning = false;
              this.startAutoPlay();
            }, this.transitionDuration);
          });
        });
      }
    }

    customElements.define('auto-carousel-{{ ai_gen_id }}', AutoCarousel{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Auto photo carousel",
  "settings": [
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image 1"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image 2"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Image 3"
    },
    {
      "type": "image_picker",
      "id": "image_4",
      "label": "Image 4"
    },
    {
      "type": "image_picker",
      "id": "image_5",
      "label": "Image 5"
    },
    {
      "type": "header",
      "content": "Carousel settings"
    },
    {
      "type": "range",
      "id": "carousel_height",
      "label": "Height",
      "min": 200,
      "max": 800,
      "step": 50,
      "unit": "px",
      "default": 500
    },
    {
      "type": "range",
      "id": "slide_interval",
      "label": "Slide interval",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 3
    },
    {
      "type": "range",
      "id": "transition_duration",
      "label": "Transition duration",
      "min": 0.5,
      "max": 2,
      "step": 0.5,
      "unit": "s",
      "default": 1
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Controls"
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show navigation dots",
      "default": true
    },
    {
      "type": "color",
      "id": "dot_color",
      "label": "Dot color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Auto photo carousel"
    }
  ]
}
{% endschema %}
