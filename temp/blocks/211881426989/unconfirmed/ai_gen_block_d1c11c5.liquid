{% doc %}
  @prompt
    Make it scannable:
    ✓ Ceremonial Grade Chuncho (Heirloom Variety)
    ✓ Regeneratively Grown in Peru
    ✓ Direct Trade from Family Farms
    ✓ Heavy Metal Tested (EU Standards)
    ✓ Organically Cultivated
    Why it works: Each claim gets proper weight and it's readable.
    make this into a scannable heading
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-scannable-list-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.padding }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    display: block;
  }

  .ai-scannable-list__heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.spacing }}px 0;
    font-weight: {{ block.settings.heading_weight }};
    text-align: {{ block.settings.text_align }};
  }

  .ai-scannable-list__items-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.item_spacing }}px;
  }

  .ai-scannable-list__item-{{ ai_gen_id }} {
    display: flex;
    align-items: {{ block.settings.item_align }};
    gap: {{ block.settings.icon_spacing }}px;
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.5;
  }

  .ai-scannable-list__icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    color: {{ block.settings.icon_color }};
  }

  .ai-scannable-list__text-{{ ai_gen_id }} {
    flex: 1;
  }

  @media screen and (max-width: 749px) {
    .ai-scannable-list__heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }

    .ai-scannable-list__item-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.text_size }}px * 0.9);
    }
  }
{% endstyle %}

<div class="ai-scannable-list-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <h2 class="ai-scannable-list__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
  {% endif %}

  <ul class="ai-scannable-list__items-{{ ai_gen_id }}">
    {% if block.settings.item_1 != blank %}
      <li class="ai-scannable-list__item-{{ ai_gen_id }}">
        <svg class="ai-scannable-list__icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        <span class="ai-scannable-list__text-{{ ai_gen_id }}">{{ block.settings.item_1 }}</span>
      </li>
    {% endif %}

    {% if block.settings.item_2 != blank %}
      <li class="ai-scannable-list__item-{{ ai_gen_id }}">
        <svg class="ai-scannable-list__icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        <span class="ai-scannable-list__text-{{ ai_gen_id }}">{{ block.settings.item_2 }}</span>
      </li>
    {% endif %}

    {% if block.settings.item_3 != blank %}
      <li class="ai-scannable-list__item-{{ ai_gen_id }}">
        <svg class="ai-scannable-list__icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        <span class="ai-scannable-list__text-{{ ai_gen_id }}">{{ block.settings.item_3 }}</span>
      </li>
    {% endif %}

    {% if block.settings.item_4 != blank %}
      <li class="ai-scannable-list__item-{{ ai_gen_id }}">
        <svg class="ai-scannable-list__icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        <span class="ai-scannable-list__text-{{ ai_gen_id }}">{{ block.settings.item_4 }}</span>
      </li>
    {% endif %}

    {% if block.settings.item_5 != blank %}
      <li class="ai-scannable-list__item-{{ ai_gen_id }}">
        <svg class="ai-scannable-list__icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        <span class="ai-scannable-list__text-{{ ai_gen_id }}">{{ block.settings.item_5 }}</span>
      </li>
    {% endif %}
  </ul>
</div>

{% schema %}
{
  "name": "Scannable list",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "item_1",
      "label": "Item 1",
      "default": "Ceremonial Grade Chuncho (Heirloom Variety)"
    },
    {
      "type": "text",
      "id": "item_2",
      "label": "Item 2",
      "default": "Regeneratively Grown in Peru"
    },
    {
      "type": "text",
      "id": "item_3",
      "label": "Item 3",
      "default": "Direct Trade from Family Farms"
    },
    {
      "type": "text",
      "id": "item_4",
      "label": "Item 4",
      "default": "Heavy Metal Tested (EU Standards)"
    },
    {
      "type": "text",
      "id": "item_5",
      "label": "Item 5",
      "default": "Organically Cultivated"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Padding",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "spacing",
      "label": "Heading spacing",
      "min": 10,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "item_spacing",
      "label": "Item spacing",
      "min": 5,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "icon_spacing",
      "label": "Icon spacing",
      "min": 5,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Heading alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "item_align",
      "label": "Item alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "flex-start"
    },
    {
      "type": "header",
      "content": "Heading style"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Size",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semibold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "600"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Item style"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#333333"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 12,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#5C402F"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Scannable list"
    }
  ]
}
{% endschema %}
