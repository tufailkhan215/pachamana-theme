{%- comment -%}
  Social sharing snippet
  Usage: {% render 'social-sharing', share_title: product.title, share_permalink: product.url, share_image: product.featured_image %}
{%- endcomment -%}

<div class="social-sharing">
  <span class="social-sharing__title">{{ 'general.social.share' | t | default: 'Share' }}</span>
  
  <ul class="social-sharing__list">
    <li>
      <a href="https://www.facebook.com/sharer/sharer.php?u={{ share_permalink | url_param_escape }}" 
         target="_blank" 
         rel="noopener" 
         class="social-sharing__link social-sharing__link--facebook"
         aria-label="{{ 'general.social.share_on_facebook' | t | default: 'Share on Facebook' }}">
        <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24">
          <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
        </svg>
      </a>
    </li>
    
    <li>
      <a href="https://twitter.com/intent/tweet?text={{ share_title | url_param_escape }}&url={{ share_permalink | url_param_escape }}" 
         target="_blank" 
         rel="noopener" 
         class="social-sharing__link social-sharing__link--twitter"
         aria-label="{{ 'general.social.share_on_twitter' | t | default: 'Share on Twitter' }}">
        <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24">
          <path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"/>
        </svg>
      </a>
    </li>
    
    <li>
      <a href="https://pinterest.com/pin/create/button/?url={{ share_permalink | url_param_escape }}&media={{ share_image | image_url: width: 1024 | url_param_escape }}&description={{ share_title | url_param_escape }}" 
         target="_blank" 
         rel="noopener" 
         class="social-sharing__link social-sharing__link--pinterest"
         aria-label="{{ 'general.social.share_on_pinterest' | t | default: 'Share on Pinterest' }}">
        <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10c1.54 0 3-.36 4.28-1.01L19.5 22l1.5-4.22c.5-1.5.75-3.1.75-4.78 0-5.52-4.48-10-10-10zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8c0 1.25-.29 2.43-.81 3.48l-1.06 2.96-2.96-1.06c-1.05.52-2.23.81-3.48.81z"/>
        </svg>
      </a>
    </li>
  </ul>
</div>

