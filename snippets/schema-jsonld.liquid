{%- comment -%}
  Structured data (JSON-LD).
  - Organization: every page. NAP matches /pages/contact (no phone by owner request).
  - Product: product pages, one Offer per variant.
  - BlogPosting: blog articles.
  - BreadcrumbList: product / collection / article pages.
{%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": {{ shop.url | append: '#organization' | json }},
  "name": {{ shop.name | json }},
  "url": {{ shop.url | json }},
  "email": "support@pachamana.com",
  "logo": "https://pachamana.com/cdn/shop/files/PACHA-MANA-STACKED-LOCKUP.svg?v=1766183706&width=500",
  "sameAs": ["https://www.instagram.com/pachamanacacao/"],
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "13321 Grass Valley Ave #14",
    "addressLocality": "Grass Valley",
    "addressRegion": "CA",
    "postalCode": "95945",
    "addressCountry": "US"
  }
}
</script>
{%- if request.page_type == 'product' and product -%}
{%- assign schema_reviews = product.metafields['app--195190554625'].yuko_review_info.value -%}
{%- assign schema_review_count = schema_reviews.total_reviews | default: 0 | plus: 0 -%}
{%- assign schema_rating_value = schema_reviews.average_rating | default: 0 | plus: 0 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ product.title | json }},
  "url": {{ request.origin | append: product.url | json }},
  {%- if product.featured_media %}
  "image": [
    {%- for media in product.media limit: 4 -%}
    {{ media | image_url: width: 1200 | prepend: "https:" | json }}{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ],
  {%- endif %}
  "description": {{ product.description | strip_html | truncate: 500 | json }},
  "brand": { "@type": "Brand", "name": {{ shop.name | json }} },
  {%- if schema_review_count > 0 and schema_rating_value > 0 %}
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": {{ schema_rating_value | json }},
    "reviewCount": {{ schema_review_count | json }},
    "bestRating": 5
  },
  {%- endif %}
  "offers": [
    {%- for variant in product.variants -%}
    {
      "@type": "Offer",
      "url": {{ request.origin | append: variant.url | json }},
      "priceCurrency": {{ cart.currency.iso_code | json }},
      "price": {{ variant.price | divided_by: 100.0 | json }},
      "itemCondition": "https://schema.org/NewCondition",
      "availability": {% if variant.available %}"https://schema.org/InStock"{% else %}"https://schema.org/OutOfStock"{% endif %}{% if variant.sku != blank %},
      "sku": {{ variant.sku | json }}{% endif %}
    }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}
{%- if request.page_type == 'article' and article -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": {{ article.title | json }},
  "url": {{ request.origin | append: article.url | json }},
  {%- if article.image %}
  "image": {{ article.image | image_url: width: 1200 | prepend: "https:" | json }},
  {%- endif %}
  "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
  "dateModified": {{ article.updated_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
  "author": { "@type": "Person", "name": {{ article.author | json }} },
  "publisher": { "@id": {{ shop.url | append: '#organization' | json }} },
  "description": {{ article.excerpt_or_content | strip_html | truncate: 300 | json }}
}
</script>
{%- endif -%}
{%- assign crumb_type = request.page_type -%}
{%- if crumb_type == 'product' or crumb_type == 'collection' or crumb_type == 'article' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ shop.url | json }} }
    {%- if crumb_type == 'product' -%}
      {%- if product.collections.first -%}
      ,{ "@type": "ListItem", "position": 2, "name": {{ product.collections.first.title | json }}, "item": {{ request.origin | append: product.collections.first.url | json }} }
      ,{ "@type": "ListItem", "position": 3, "name": {{ product.title | json }}, "item": {{ request.origin | append: product.url | json }} }
      {%- else -%}
      ,{ "@type": "ListItem", "position": 2, "name": {{ product.title | json }}, "item": {{ request.origin | append: product.url | json }} }
      {%- endif -%}
    {%- elsif crumb_type == 'collection' -%}
      ,{ "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": {{ request.origin | append: collection.url | json }} }
    {%- elsif crumb_type == 'article' -%}
      {%- if blog -%}
      ,{ "@type": "ListItem", "position": 2, "name": {{ blog.title | json }}, "item": {{ request.origin | append: blog.url | json }} }
      ,{ "@type": "ListItem", "position": 3, "name": {{ article.title | json }}, "item": {{ request.origin | append: article.url | json }} }
      {%- else -%}
      ,{ "@type": "ListItem", "position": 2, "name": {{ article.title | json }}, "item": {{ request.origin | append: article.url | json }} }
      {%- endif -%}
    {%- endif -%}
  ]
}
</script>
{%- endif -%}
