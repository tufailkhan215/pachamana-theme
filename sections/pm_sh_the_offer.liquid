{%- comment -%} Pacha Mana - Start page: The offer. Converted from start-here.html; every visible string, image and link is a setting. {%- endcomment -%}
{{ 'pm_landing.css' | asset_url | stylesheet_tag }}
<section class="pm-landing" style="position:relative;background:var(--gradient-cacao);color:var(--text-on-dark);padding:clamp(64px,8vw,112px) 20px;overflow:hidden;">
<div style="position:absolute;inset:0;background-image:url('https://pachamana.com/cdn/shop/files/Pattern_Website.png?v=1769670221&amp;width=1200');background-size:520px auto;opacity:.07;pointer-events:none;"></div>
<div style="position:relative;max-width:960px;margin:0 auto;display:flex;flex-direction:column;gap:36px;align-items:center;text-align:center;">
<div style="display:flex;flex-direction:column;gap:14px;align-items:center;">
<span class="pm-eyebrow pm-eyebrow--gold">{{ section.settings.eyebrow | escape }}</span>
<h2 style="font-family:var(--font-display);text-transform:uppercase;font-weight:400;letter-spacing:var(--tracking-display);font-size:clamp(32px,4.4vw,52px);line-height:1.05;color:var(--pm-pearl-white);margin:0;">{{ section.settings.heading | escape }}</h2>
<p style="margin:0;max-width:600px;font-size:18px;line-height:1.7;color:var(--pm-cacao-50);text-wrap:pretty;">{{ section.settings.text | escape }}</p>
</div>
<div style="width:100%;display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:14px;">
{%- for block in section.blocks -%}{%- if block.type == 'link' -%}<a {{ block.shopify_attributes }} href="{{ block.settings.link | escape }}" style="{% cycle "link_0_style": "text-decoration:none;color:var(--text-strong);background:var(--pm-tan-50);border-radius:20px;padding:26px 20px;display:flex;flex-direction:column;align-items:center;gap:6px;box-shadow:var(--shadow-md);outline:1.5px dashed var(--pm-gold-300);outline-offset:-9px;", "text-decoration:none;color:var(--text-strong);background:var(--pm-tan-50);border-radius:20px;padding:26px 20px;display:flex;flex-direction:column;align-items:center;gap:6px;box-shadow:var(--shadow-md);border:2px solid var(--pm-gold-400);outline:1.5px dashed var(--pm-gold-300);outline-offset:-9px;", "text-decoration:none;color:var(--text-strong);background:var(--pm-tan-50);border-radius:20px;padding:26px 20px;display:flex;flex-direction:column;align-items:center;gap:6px;box-shadow:var(--shadow-md);outline:1.5px dashed var(--pm-gold-300);outline-offset:-9px;" %}"><span style="font-family:var(--font-display);font-size:44px;line-height:1;">{{ block.settings.label | escape }}</span><span style="font-size:14px;color:var(--text-body);">{{ block.settings.label_2 | escape }}</span><span style="font-size:15px;font-weight:600;color:var(--pm-gold-700);">{{ block.settings.label_3 | escape }}</span></a>{%- endif -%}{%- endfor -%}


</div>
<p style="margin:0;font-size:16px;font-style:italic;color:var(--pm-gold-200);">{{ section.settings.text_2 | escape }}</p>
<div style="display:flex;gap:12px;align-items:center;padding:14px 18px;border-radius:12px;border:1px dashed rgba(235,189,94,.5);max-width:560px;text-align:left;">
<img alt="{{ section.settings.image_alt_text | escape }}" src="{%- if section.settings.image != blank -%}{{ section.settings.image | image_url: width: 1600 }}{%- else -%}{{ section.settings.image_url | escape }}{%- endif -%}" style="width:34px;height:34px;object-fit:contain;flex:0 0 34px;min-height:34px;max-height:34px;"/>
<span style="font-size:15px;line-height:1.5;color:var(--pm-pearl-white);">{{ section.settings.label | escape }}</span>
</div>
<a class="pm-btn pm-btn--primary pm-btn--lg" href="{{ section.settings.button_link | escape }}">{{ section.settings.button_label | escape }}</a>
<p style="margin:0;font-size:15px;line-height:1.6;color:var(--pm-cacao-50);text-wrap:balance;">{{ section.settings.text_3 }}</p>
</div>
</section>

{% schema %}
{
  "name": "Start: The offer",
  "tag": "div",
  "class": "pm-landing-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "text_2",
      "label": "Text 2"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_url",
      "label": "Image URL",
      "info": "Used when no image is picked above."
    },
    {
      "type": "text",
      "id": "image_alt_text",
      "label": "Image alt text",
      "info": "Leave blank for purely decorative images."
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label"
    },
    {
      "type": "text",
      "id": "button_link",
      "label": "Button link",
      "info": "A path like /pages/... or a full https:// address."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "html",
      "id": "text_3",
      "label": "Text 3",
      "info": "Keeps the design's inline styling. Edit the words, leave the tags."
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Bundle size",
      "settings": [
        {
          "type": "text",
          "id": "link",
          "label": "Link",
          "info": "A path like /pages/... or a full https:// address."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "text",
          "id": "label_2",
          "label": "Label 2"
        },
        {
          "type": "text",
          "id": "label_3",
          "label": "Label 3"
        }
      ]
    }
  ],
  "max_blocks": 50,
  "presets": [
    {
      "name": "Start: The offer"
    }
  ]
}
{% endschema %}
