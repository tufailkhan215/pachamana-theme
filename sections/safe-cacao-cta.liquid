<section class="pmw pmw-sc-cta" id="pmw-{{ section.id }}">
  {% render 'bulk-bg', section: section %}
  {%- if section.settings.mark_image != blank -%}
    {%- assign cta_mark_src = section.settings.mark_image | image_url: width: 600 -%}
  {%- else -%}
    {%- assign cta_mark_src = 'bulk-mark-gold.png' | asset_url -%}
  {%- endif -%}
  <img src="{{ cta_mark_src }}" alt="" class="pmw-sc-cta__mark" loading="lazy">

  <div class="pmw__inner pmw-sc-cta__inner">
    <h2 class="pmw-sc-cta__title">{{ section.settings.headline | newline_to_br }}</h2>
    {% if section.settings.subhead != blank %}<p class="pmw-sc-cta__sub">{{ section.settings.subhead }}</p>{% endif %}
    <div class="pmw-sc-cta__ctas">
      {% if section.settings.cta1_label != blank %}
        <a href="{{ section.settings.cta1_link | default: '#' }}" class="pmw-btn pmw-btn--primary">{{ section.settings.cta1_label }}</a>
      {% endif %}
      {% if section.settings.cta2_label != blank %}
        <a href="{{ section.settings.cta2_link | default: '#' }}" class="pmw-btn pmw-btn--outline">{{ section.settings.cta2_label }}</a>
      {% endif %}
    </div>
  </div>
</section>

<style>
  #pmw-{{ section.id }}.pmw-sc-cta { padding: 0; }
  #pmw-{{ section.id }} .pmw-sc-cta__inner { padding: 104px 64px; max-width: 680px; margin: 0 auto; text-align: center; }
  #pmw-{{ section.id }} .pmw-sc-cta__title { margin: 0; font-size: 50px; line-height: 1.02; color: var(--pm-cacao-800); }
  #pmw-{{ section.id }} .pmw-sc-cta__sub { margin: 22px auto 36px; max-width: 500px; font-size: 18px; line-height: 1.7; color: var(--pm-cacao-500); }
  #pmw-{{ section.id }} .pmw-sc-cta__ctas { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }
  #pmw-{{ section.id }} .pmw-sc-cta__mark { position: absolute; left: -110px; bottom: -110px; width: 320px; opacity: .16; pointer-events: none; z-index: 1; }
  @media (max-width: 768px) {
    #pmw-{{ section.id }} .pmw-sc-cta__inner { padding: 72px 20px; }
    #pmw-{{ section.id }} .pmw-sc-cta__title { font-size: 34px; }
  }
</style>

{% schema %}
{
  "name": "Safe Cacao — Final CTA",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Background" },
    { "type": "select", "id": "bg_type", "label": "Background type", "default": "color",
      "options": [{"value":"color","label":"Color / gradient"},{"value":"image","label":"Image"}] },
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#fee7be" },
    { "type": "image_picker", "id": "bg_image", "label": "Background image" },
    { "type": "range", "id": "bg_opacity", "label": "Background opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "color", "id": "bg_overlay_color", "label": "Image overlay color", "default": "#000000" },
    { "type": "range", "id": "bg_overlay_opacity", "label": "Image overlay opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 0 },
    { "type": "header", "content": "Content" },
    { "type": "textarea", "id": "headline", "label": "Headline (line breaks honored)", "default": "Enjoy Cacao\nWithout The Worry" },
    { "type": "textarea", "id": "subhead", "label": "Subhead", "default": "So, can you enjoy Pacha Mana cacao without worrying about heavy metals? Absolutely. Cheers." },
    { "type": "image_picker", "id": "mark_image", "label": "Decorative mark (defaults to bulk-mark-gold.png)" },
    { "type": "header", "content": "Calls to action" },
    { "type": "text", "id": "cta1_label", "label": "Primary CTA label", "default": "Shop Our Cacao" },
    { "type": "url", "id": "cta1_link", "label": "Primary CTA link" },
    { "type": "text", "id": "cta2_label", "label": "Secondary CTA label", "default": "Subscribe & Save" },
    { "type": "url", "id": "cta2_link", "label": "Secondary CTA link" }
  ],
  "presets": [{ "name": "Safe Cacao — Final CTA" }]
}
{% endschema %}
