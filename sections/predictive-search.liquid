{%- comment -%}
  Predictive search section
{%- endcomment -%}

<predictive-search id="predictive-search" class="predictive-search" aria-hidden="true">
  <div class="predictive-search__overlay" data-predictive-search-overlay></div>
  
  <div class="predictive-search__inner">
    <div class="predictive-search__header">
      <h2 class="predictive-search__title">{{ 'general.search.title' | t | default: 'Search' }}</h2>
      <button type="button" class="predictive-search__close" data-predictive-search-close aria-label="{{ 'accessibility.close' | t | default: 'Close' }}">
        {% render 'icon', icon: 'close' %}
      </button>
    </div>
    
    <form action="{{ routes.search_url }}" method="get" role="search" class="predictive-search__form">
      <div class="predictive-search__input-wrapper">
        <input
          type="search"
          name="q"
          class="predictive-search__input"
          placeholder="{{ 'general.search.placeholder' | t | default: 'Search...' }}"
          autocomplete="off"
          data-predictive-search-input
        >
        <button type="submit" class="predictive-search__submit" aria-label="{{ 'general.search.submit' | t | default: 'Search' }}">
          {% render 'icon', icon: 'search' %}
        </button>
      </div>
    </form>
    
    <div id="predictive-search-results" class="predictive-search__results" data-predictive-search-results></div>
  </div>
</predictive-search>

