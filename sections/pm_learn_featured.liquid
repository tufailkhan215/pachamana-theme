{%- comment -%} Pacha Mana — Learn guide: full-bleed featured image. {%- endcomment -%}
{{ 'pm_learn.css' | asset_url | stylesheet_tag }}

<section class="full-width pm-learn pm-learn-featured" id="pm-featured-{{ section.id }}"
  style="--pm-featured-h: {{ section.settings.height }}px;">
  {%- if section.settings.image != blank -%}
    <img src="{{ section.settings.image | image_url: width: 1800 }}" alt="{{ section.settings.alt | escape }}" width="1800" height="900">
  {%- elsif section.settings.image_url != blank -%}
    <img src="{{ section.settings.image_url }}" alt="{{ section.settings.alt | escape }}" loading="lazy">
  {%- else -%}
    <span class="pm-learn-featured__ph">{{ section.settings.alt }}</span>
  {%- endif -%}
</section>

{% stylesheet %}
/* Doubled class — see pm_learn_hero.liquid: .pm-learn's base background and
   overflow-x load later and would otherwise win on a specificity tie. */
.pm-learn.pm-learn-featured {
  width: 100%; height: var(--pm-featured-h, 480px);
  position: relative; overflow: hidden; background: var(--pm-tan-200);
}
/* A storefront app on this shop ships a global `img { height: auto !important }`.
   It beat `height: 100%` and let this photo render at its natural height —
   2880px inside a 480px band, covering the first ~2400px of the article text.
   min/max-height are what actually enforce the band: `height` alone loses to the
   override, and inset:0 does not help either, because an absolutely positioned
   replaced element with height:auto uses its intrinsic height and ignores
   `bottom`. Used height is always clamped by min/max, so these two survive. */
.pm-learn-featured img {
  position: absolute; inset: 0; display: block;
  width: 100%; height: 100%;
  min-height: 100%; max-height: 100%;
  object-fit: cover;
}
.pm-learn-featured__ph {
  position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
  padding: 24px; text-align: center; font-size: 15px; font-style: italic;
  color: var(--pm-cacao-300);
}
@media screen and (max-width: 749px) {
  .pm-learn-featured { height: calc(var(--pm-featured-h, 480px) * 0.58); }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Learn: featured image",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_url", "label": "Image URL" },
    { "type": "text", "id": "alt", "label": "Alt text" },
    { "type": "range", "id": "height", "label": "Height", "min": 240, "max": 720, "step": 20, "unit": "px", "default": 480 }
  ],
  "presets": [{ "name": "Learn: featured image" }]
}
{% endschema %}
