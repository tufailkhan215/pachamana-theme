{%- comment -%} Pacha Mana - Start page: Paste or ground. Converted from start-here.html; every visible string, image and link is a setting. {%- endcomment -%}
{{ 'pm_landing.css' | asset_url | stylesheet_tag }}
<section class="pm-landing" style="padding:clamp(64px,8vw,112px) 20px;">
<div style="max-width:1140px;margin:0 auto;display:flex;flex-direction:column;gap:40px;">
<div style="display:flex;flex-direction:column;gap:14px;align-items:center;text-align:center;">
<span class="pm-eyebrow pm-eyebrow--gold">{{ section.settings.eyebrow | escape }}</span>
<h2 style="font-family:var(--font-display);text-transform:uppercase;font-weight:400;letter-spacing:var(--tracking-display);font-size:clamp(30px,4vw,44px);line-height:1.1;color:var(--text-strong);margin:0;">{{ section.settings.heading | escape }}</h2>
<p style="margin:0;max-width:600px;font-size:17px;line-height:1.7;text-wrap:pretty;">{{ section.settings.text | escape }}</p>
</div>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(290px,1fr));gap:24px;">
{%- for block in section.blocks -%}{%- if block.type == 'card' -%}<div {{ block.shopify_attributes }} style="background:#fff;border:1px solid var(--border-soft);border-radius:28px;overflow:hidden;box-shadow:var(--shadow-md);display:flex;flex-direction:column;">
<div style="height:280px;background:var(--pm-tan-100);"><img alt="{{ block.settings.image_alt_text | escape }}" src="{%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 800 }}{%- else -%}{{ block.settings.image_url | escape }}{%- endif -%}" style="width:100%;height:100%;object-fit:cover;display:block;min-height:100%;max-height:100%;"/></div>
<div style="padding:28px;display:flex;flex-direction:column;gap:12px;">
<div style="display:flex;justify-content:space-between;align-items:baseline;gap:12px;flex-wrap:wrap;"><h3 style="font-family:var(--font-display);text-transform:uppercase;font-weight:400;letter-spacing:0.06em;font-size:24px;color:var(--text-strong);margin:0;">{{ block.settings.title | escape }}</h3><span style="font-size:15px;font-weight:600;color:var(--pm-gold-700);">{{ block.settings.label | escape }}</span></div>
<p style="margin:0;font-size:16px;line-height:1.7;">{{ block.settings.text | escape }}</p>
<p style="margin:0;font-size:15px;font-style:italic;color:var(--pm-gold-700);">{{ block.settings.text_2 | escape }}</p>
</div>
</div>{%- endif -%}{%- endfor -%}

</div>
</div>
</section>

{% schema %}
{
  "name": "Start: Paste or ground",
  "tag": "div",
  "class": "pm-landing-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Format",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_url",
          "label": "Image URL",
          "info": "Used when no image is picked above."
        },
        {
          "type": "text",
          "id": "image_alt_text",
          "label": "Image alt text",
          "info": "Leave blank for purely decorative images."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "text",
          "id": "text_2",
          "label": "Text 2"
        }
      ]
    }
  ],
  "max_blocks": 50,
  "presets": [
    {
      "name": "Start: Paste or ground"
    }
  ]
}
{% endschema %}
