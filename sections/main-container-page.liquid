<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
<script>
(function() {
  'use strict';
  
  function initMainPageSwiper() {
    var container = document.querySelector('.elementor-element-e3c6f55');
    if (!container) return;
    
    var slideshow = container.querySelector('.elementor-background-slideshow');
    if (!slideshow) return;
    
    // Check if Swiper is already initialized
    if (slideshow.swiper) return;
    
    // Get slides from DOM
    var slides = slideshow.querySelectorAll('.swiper-slide');
    if (slides.length === 0) {
      console.warn('No slideshow slides found');
      return;
    }
    
    // Check if Swiper library is available
    if (typeof Swiper === 'undefined') {
      // Wait for Swiper to load
      setTimeout(initMainPageSwiper, 200);
      return;
    }
    
    // Get settings from data attributes
    var slideDuration = parseInt(container.getAttribute('data-slide-duration')) || 5000;
    var transitionDuration = parseInt(container.getAttribute('data-transition-duration')) || 500;
    var loopEnabled = container.getAttribute('data-loop') !== 'false';
    var kenBurnsEnabled = container.getAttribute('data-ken-burns') !== 'false';
    var kenBurnsDirection = container.getAttribute('data-ken-burns-direction') || 'in';
    
    // Initialize Swiper - always initialize even with one slide
    var swiperConfig = {
      effect: 'fade',
      fadeEffect: {
        crossFade: true
      },
      loop: loopEnabled && slides.length > 1, // Only loop if more than one slide
      autoplay: slides.length > 1 ? {
        delay: slideDuration,
        disableOnInteraction: false
      } : false, // Disable autoplay for single slide
      speed: transitionDuration,
      slidesPerView: 1,
      spaceBetween: 0,
      watchSlidesProgress: true,
      allowTouchMove: false,
      direction: 'horizontal',
      rtl: true
    };
    
    var swiperInstance = new Swiper(slideshow, swiperConfig);
    
    // Apply Ken Burns effect if enabled - works for any number of slides
    if (kenBurnsEnabled) {
      // Function to activate Ken Burns on a slide
      function activateKenBurns(slide) {
        if (!slide) return;
        var image = slide.querySelector('.elementor-background-slideshow__slide__image');
        if (image) {
          // Remove active class from all images first
          var allImages = slideshow.querySelectorAll('.elementor-background-slideshow__slide__image');
          allImages.forEach(function(img) {
            img.classList.remove('elementor-ken-burns--active');
          });
          
          // Force reflow to restart animation
          void image.offsetWidth;
          
          // Add active class to current image
          image.classList.add('elementor-ken-burns--active');
        }
      }
      
      // Activate Ken Burns on initial slide - works for any number of slides
      var activeSlide = slideshow.querySelector('.swiper-slide-active') || slides[0];
      
      // For single slide, ensure Swiper initializes it properly
      if (slides.length === 1) {
        // Make sure the slide is marked as active
        if (!activeSlide.classList.contains('swiper-slide-active')) {
          activeSlide.classList.add('swiper-slide-active');
        }
        // Activate Ken Burns immediately
        activateKenBurns(activeSlide);
        // Force restart animation after a brief delay to ensure it triggers
        setTimeout(function() {
          var img = activeSlide.querySelector('.elementor-background-slideshow__slide__image');
          if (img) {
            img.classList.remove('elementor-ken-burns--active');
            void img.offsetWidth; // Force reflow
            img.classList.add('elementor-ken-burns--active');
          }
        }, 50);
      } else {
        // Multiple slides - activate on initial slide
        activateKenBurns(activeSlide);
        
        // Listen for slide changes
        swiperInstance.on('slideChange', function() {
          var currentSlide = slideshow.querySelector('.swiper-slide-active');
          activateKenBurns(currentSlide);
        });
      }
    }
  }
  
  // Initialize when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function() {
      setTimeout(initMainPageSwiper, 1000);
    });
  } else {
    setTimeout(initMainPageSwiper, 1000);
  }
  
  // Re-initialize after Elementor frontend loads
  if (typeof window.elementorFrontend !== 'undefined') {
    setTimeout(initMainPageSwiper, 2000);
    
    // Also listen for Elementor init event
    if (typeof jQuery !== 'undefined') {
      jQuery(document).on('elementor/frontend/init', function() {
        setTimeout(initMainPageSwiper, 1000);
      });
    }
  }
  
  // Re-initialize on section load (for Shopify theme editor)
  if (typeof Shopify !== 'undefined' && Shopify.designMode) {
    document.addEventListener('shopify:section:load', function() {
      setTimeout(initMainPageSwiper, 500);
    });
  }
  
  // Also try after window load
  window.addEventListener('load', function() {
    setTimeout(initMainPageSwiper, 1500);
  });
})();
</script>
{%- endif -%}

