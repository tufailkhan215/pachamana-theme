{%- liquid
  comment
    Build gallery array for data-settings JSON from section blocks
  endcomment
  assign slide_count = 0
  for block in section.blocks
    if block.settings.image != blank
      assign slide_count = slide_count | plus: 1
    endif
  endfor
  
  comment
    Get slideshow settings
  endcomment
  assign slide_duration = section.settings.slide_duration | default: 5000
  assign transition_duration = section.settings.transition_duration | default: 500
  assign loop_enabled = section.settings.loop | default: true
  assign ken_burns_enabled = section.settings.ken_burns | default: true
  assign ken_burns_dir = section.settings.ken_burns_direction | default: 'in'
-%}
{{ "Here" }}
<div data-elementor-type="wp-page" data-elementor-id="82" class="elementor elementor-82" data-elementor-post-type="page">
				<div class="elementor-element elementor-element-e3c6f55 e-flex e-con-boxed e-con e-parent e-lazyloaded" data-id="e3c6f55" data-element_type="container" data-slide-duration="{{ slide_duration }}" data-transition-duration="{{ transition_duration }}" data-loop="{{ loop_enabled }}" data-ken-burns="{{ ken_burns_enabled }}" data-ken-burns-direction="{{ ken_burns_dir }}">
					{%- if slide_count > 0 -%}
						<div class="elementor-background-slideshow swiper swiper-fade swiper-horizontal swiper-pointer-events swiper-rtl swiper-watch-progress" dir="rtl">
							<div class="swiper-wrapper" id="swiper-wrapper-main-page-{{ section.id }}" aria-live="off">
								{%- for block in section.blocks -%}
									{%- if block.settings.image != blank -%}
										{%- assign image_url = block.settings.image | image_url: width: 1920 -%}
										{%- assign slide_index = forloop.index0 -%}
										<div class="elementor-background-slideshow__slide swiper-slide{% if forloop.first %} swiper-slide-active{% endif %}" 
										     data-swiper-slide-index="{{ slide_index }}" 
										     role="group" 
										     aria-label="{{ forloop.index }} / {{ slide_count }}">
											<div class="elementor-background-slideshow__slide__image elementor-ken-burns elementor-ken-burns--{{ ken_burns_dir }}{% if forloop.first %} elementor-ken-burns--active{% endif %}" 
											     style="background-image: url('{{ image_url }}');"></div>
										</div>
									{%- endif -%}
								{%- endfor -%}
							</div>
							<span class="swiper-notification" aria-live="assertive" aria-atomic="true"></span>
						</div>
