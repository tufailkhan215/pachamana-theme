		{%- comment -%} Paginate collection products - 12 products per page {%- endcomment -%}
		{%- paginate collection.products by 12 -%}
			{%- comment -%} Loop through collection products {%- endcomment -%}
			{%- for product in collection.products -%}
				{%- render 'product-loop-item', product: product -%}
			{%- else -%}
				{%- comment -%} No products message {%- endcomment -%}
				<div class="no-products-message">
					<p>{{ 'collections.general.no_products' | t | default: 'No products found' }}</p>
				</div>
			{%- endfor -%}
				</div>
			</div>
			{%- comment -%} Pagination controls {%- endcomment -%}
			{%- if paginate.pages > 1 -%}
				<div class="elementor-element elementor-element-collection-pagination elementor-widget elementor-widget-text-editor" data-id="collection-pagination" data-element_type="widget" data-widget_type="text-editor.default">
					<div class="elementor-widget-container">
						{% render 'pagination', paginate: paginate %}
					</div>
				</div>
			{%- endif -%}
		{%- endpaginate -%}
		{%- comment -%} Collection Pagination Styles {%- endcomment -%}
		<style>
			/* Collection Pagination Styles */
			.elementor-element-collection-pagination .pagination {
				margin: 40px 0;
				text-align: center;
			}

			.elementor-element-collection-pagination .pagination__list {
				display: flex;
				justify-content: center;
				align-items: center;
				list-style: none;
				padding: 0;
				margin: 0;
				gap: 8px;
				flex-wrap: wrap;
			}

			.elementor-element-collection-pagination .pagination__item {
				margin: 0;
				padding: 0;
			}

			.elementor-element-collection-pagination .pagination__link {
				display: inline-block;
				padding: 10px 16px;
				min-width: 44px;
				text-align: center;
				text-decoration: none;
				border: 1px solid rgba(0, 0, 0, 0.2);
				border-radius: 4px;
				color: var(--e-global-color-secondary, #333);
				font-family: "Barlow", Sans-serif;
				font-size: 16px;
				transition: all 0.3s ease;
			}

			.elementor-element-collection-pagination .pagination__link:hover {
				background-color: var(--e-global-color-5abf1e8, #f5f5f5);
				border-color: var(--e-global-color-5abf1e8, #d4a574);
			}

			.elementor-element-collection-pagination .pagination__link--current {
				background-color: var(--e-global-color-secondary, #333);
				color: var(--e-global-color-5abf1e8, #fff);
				border-color: var(--e-global-color-secondary, #333);
				font-weight: 600;
				cursor: default;
			}

			.elementor-element-collection-pagination .pagination__link--prev,
			.elementor-element-collection-pagination .pagination__link--next {
				font-weight: 500;
			}

			@media (max-width: 768px) {
				.elementor-element-collection-pagination .pagination__link {
					padding: 8px 12px;
					min-width: 40px;
					font-size: 14px;
				}
			}
		</style>
