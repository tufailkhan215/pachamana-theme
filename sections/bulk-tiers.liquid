<section class="pmw pmw-tiers" id="pmw-{{ section.id }}">
  {% render 'bulk-bg', section: section %}
  <div class="pmw__inner">
    {% if section.settings.eyebrow != blank %}<div class="pmw-eyebrow" style="text-align:center;display:block;">{{ section.settings.eyebrow }}</div>{% endif %}
    <h2 class="pmw-tiers__title">{{ section.settings.headline }}</h2>
    {% if section.settings.subhead != blank %}<p class="pmw-tiers__sub">{{ section.settings.subhead }}</p>{% endif %}
    <div class="pmw-tiers__grid">
      {% for block in section.blocks %}
        {% if block.type == 'tier' %}
          <div class="pmw-tiers__card{% if block.settings.popular %} pmw-tiers__card--popular{% endif %}" {{ block.shopify_attributes }}>
            {% if block.settings.popular %}<span class="pmw-tiers__badge">{{ block.settings.popular_label | default: 'Most Loved' }}</span>{% endif %}
            <h3 class="pmw-tiers__name">{{ block.settings.name }}</h3>
            <p class="pmw-tiers__desc">{{ block.settings.description }}</p>
            <p class="pmw-tiers__min">{{ block.settings.min }}</p>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<style>
  #pmw-{{ section.id }}.pmw-tiers { padding: 92px 72px; }
  #pmw-{{ section.id }} .pmw-tiers__title { text-align: center; font-size: 40px; margin: 14px 0 10px; }
  #pmw-{{ section.id }} .pmw-tiers__sub { text-align: center; max-width: 580px; margin: 0 auto 48px; font-size: 17px; line-height: 1.7; color: var(--page-muted); }
  #pmw-{{ section.id }} .pmw-tiers__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 22px; max-width: 1140px; margin: 0 auto; }
  #pmw-{{ section.id }} .pmw-tiers__card { background: var(--card-bg); border: 1px solid var(--card-border); border-radius: 20px; padding: 36px 28px; box-shadow: var(--card-shadow); position: relative; }
  #pmw-{{ section.id }} .pmw-tiers__card--popular { border-color: var(--accent); box-shadow: 0 18px 50px rgba(226, 171, 67, .22); }
  #pmw-{{ section.id }} .pmw-tiers__badge { position: absolute; top: -12px; right: 24px; background: var(--accent); color: var(--pm-cacao-700); font-size: 11px; letter-spacing: .15em; text-transform: uppercase; padding: 5px 12px; border-radius: 999px; font-family: var(--font-display); }
  #pmw-{{ section.id }} .pmw-tiers__name { font-size: 28px; color: var(--pm-cacao-500); }
  #pmw-{{ section.id }} .pmw-tiers__desc { font-size: 16px; line-height: 1.7; color: var(--page-muted); margin: 12px 0 18px; }
  #pmw-{{ section.id }} .pmw-tiers__min { font-family: var(--font-display); font-size: 13px; letter-spacing: .08em; text-transform: uppercase; color: var(--pm-gold-600); padding-top: 18px; border-top: 1px solid var(--card-border); }
  @media (max-width: 768px) { #pmw-{{ section.id }}.pmw-tiers { padding: 64px 20px; } }
</style>

{% schema %}
{
  "name": "Bulk — Wholesale Tiers",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Background" },
    { "type": "select", "id": "bg_type", "label": "Background type", "default": "color",
      "options": [{"value":"color","label":"Color"},{"value":"image","label":"Image"}] },
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#f9f2ef" },
    { "type": "image_picker", "id": "bg_image", "label": "Background image" },
    { "type": "range", "id": "bg_opacity", "label": "Background opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "color", "id": "bg_overlay_color", "label": "Image overlay color", "default": "#000000" },
    { "type": "range", "id": "bg_overlay_opacity", "label": "Image overlay opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 0 },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Approved Partners" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "Wholesale Tiers" },
    { "type": "textarea", "id": "subhead", "label": "Subhead", "default": "Pricing scales with volume. Pick the tier that fits where you are now — you can grow into the next one." }
  ],
  "blocks": [
    { "type": "tier", "name": "Tier", "limit": 6, "settings": [
      { "type": "text", "id": "name", "label": "Name", "default": "Stockist" },
      { "type": "textarea", "id": "description", "label": "Description", "default": "Independent shops & cafés getting started with cacao." },
      { "type": "text", "id": "min", "label": "Minimum / footer line", "default": "Starts at a single case." },
      { "type": "checkbox", "id": "popular", "label": "Highlight as popular", "default": false },
      { "type": "text", "id": "popular_label", "label": "Popular badge label", "default": "Most Loved" }
    ]}
  ],
  "presets": [{
    "name": "Bulk — Wholesale Tiers",
    "blocks": [
      { "type": "tier", "settings": { "name": "Stockist", "description": "Independent shops & cafés getting started with cacao.", "min": "Starts at a single case.", "popular": false } },
      { "type": "tier", "settings": { "name": "Partner", "description": "Growing stores ordering on a regular cadence.", "min": "Recurring mid-volume orders.", "popular": true, "popular_label": "Most Loved" } },
      { "type": "tier", "settings": { "name": "Flagship", "description": "High-volume retailers, studios & distributors.", "min": "Dedicated account manager & freight pricing.", "popular": false } }
    ]
  }]
}
{% endschema %}
