<section class="pmw pmw-sc-full" id="pmw-{{ section.id }}">
  {% render 'bulk-bg', section: section %}
  <div class="pmw__inner pmw-sc-full__inner">
    <div class="pmw-sc-full__head">
      {% if section.settings.eyebrow != blank %}<span class="pmw-eyebrow">{{ section.settings.eyebrow }}</span>{% endif %}
      <h2 class="pmw-sc-full__title">{{ section.settings.headline }}</h2>
    </div>

    {% for block in section.blocks %}
      {% if block.type == 'panel' %}
        <div class="pmw-sc-full__panel" {{ block.shopify_attributes }}>
          <h3 class="pmw-sc-full__heading">{{ block.settings.heading }}</h3>
          {% if block.settings.body != blank %}<p class="pmw-sc-full__body">{{ block.settings.body }}</p>{% endif %}

          {% if block.settings.list_type == 'bullets' and block.settings.list_items != blank %}
            <ul class="pmw-sc-full__bullets">
              {% assign items = block.settings.list_items | newline_to_br | split: '<br />' %}
              {% for item in items %}
                {% assign trimmed = item | strip %}
                {% if trimmed != blank %}
                  <li><span class="pmw-sc-full__bullet">•</span><span>{{ trimmed }}</span></li>
                {% endif %}
              {% endfor %}
            </ul>
          {% elsif block.settings.list_type == 'pairs' and block.settings.list_items != blank %}
            <div class="pmw-sc-full__pairs">
              {% assign items = block.settings.list_items | newline_to_br | split: '<br />' %}
              {% for item in items %}
                {% assign trimmed = item | strip %}
                {% if trimmed != blank %}
                  {% assign parts = trimmed | split: '|' %}
                  <div class="pmw-sc-full__pair">
                    <span class="pmw-sc-full__pair-name">{{ parts[0] | strip }}</span>
                    <span>{{ parts[1] | strip }}</span>
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          {% endif %}

          {% if block.settings.outro != blank %}<p class="pmw-sc-full__outro">{{ block.settings.outro }}</p>{% endif %}

          {% if block.settings.image != blank %}
            <img src="{{ block.settings.image | image_url: width: 1400 }}" alt="" loading="lazy" class="pmw-sc-full__image">
          {% elsif block.settings.image_placeholder != blank %}
            <div class="pmw-sc-full__image-placeholder">{{ block.settings.image_placeholder }}</div>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
</section>

<style>
  #pmw-{{ section.id }}.pmw-sc-full { padding: 0; }
  #pmw-{{ section.id }} .pmw-sc-full__inner { padding: 96px 64px; max-width: 880px; margin: 0 auto; }
  #pmw-{{ section.id }} .pmw-sc-full__head { text-align: center; margin-bottom: 46px; }
  #pmw-{{ section.id }} .pmw-sc-full__title { margin: 14px 0 0; font-size: 38px; color: var(--pm-cacao-800); }
  #pmw-{{ section.id }} .pmw-sc-full__panel { border-top: 1px solid var(--card-border); padding: 30px 0; }
  #pmw-{{ section.id }} .pmw-sc-full__panel:last-child { border-bottom: 1px solid var(--card-border); }
  #pmw-{{ section.id }} .pmw-sc-full__heading { margin: 0 0 18px; font-size: 18px; letter-spacing: .04em; color: var(--pm-cacao-800); }
  #pmw-{{ section.id }} .pmw-sc-full__body { margin: 0 0 18px; font-size: 16px; line-height: 1.75; color: var(--pm-cacao-500); }
  #pmw-{{ section.id }} .pmw-sc-full__bullets { list-style: none; padding: 0; margin: 0; }
  #pmw-{{ section.id }} .pmw-sc-full__bullets li { display: flex; gap: 14px; padding: 9px 0; font-size: 15px; line-height: 1.65; color: var(--pm-cacao-500); }
  #pmw-{{ section.id }} .pmw-sc-full__bullet { color: var(--pm-sunshine-gold); flex: none; }
  #pmw-{{ section.id }} .pmw-sc-full__pairs { display: flex; flex-direction: column; }
  #pmw-{{ section.id }} .pmw-sc-full__pair { display: flex; gap: 14px; padding: 11px 0; border-bottom: 1px solid #f0e6da; font-size: 15px; line-height: 1.6; color: var(--pm-cacao-500); }
  #pmw-{{ section.id }} .pmw-sc-full__pair-name { font-family: var(--font-display); text-transform: uppercase; letter-spacing: .03em; font-size: 15px; color: var(--pm-cacao-800); min-width: 160px; flex: none; }
  #pmw-{{ section.id }} .pmw-sc-full__outro { margin: 20px 0 0; font-size: 16px; line-height: 1.75; color: var(--pm-cacao-500); }
  #pmw-{{ section.id }} .pmw-sc-full__image { display: block; width: 100%; max-height: 460px; object-fit: cover; border-radius: 16px; margin-top: 20px; }
  #pmw-{{ section.id }} .pmw-sc-full__image-placeholder { display: flex; align-items: center; justify-content: center; width: 100%; height: 460px; background: linear-gradient(160deg, #fef2e0, #f7d79b); border-radius: 16px; margin-top: 20px; font-family: var(--font-display); font-size: 13px; letter-spacing: .12em; text-transform: uppercase; color: var(--pm-cacao-300); padding: 0 20px; text-align: center; }
  @media (max-width: 768px) {
    #pmw-{{ section.id }} .pmw-sc-full__inner { padding: 64px 20px; }
    #pmw-{{ section.id }} .pmw-sc-full__pair-name { min-width: 120px; }
  }
</style>

{% schema %}
{
  "name": "Safe Cacao — Full Picture",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Background" },
    { "type": "select", "id": "bg_type", "label": "Background type", "default": "color",
      "options": [{"value":"color","label":"Color"},{"value":"image","label":"Image"}] },
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#f9f2ef" },
    { "type": "image_picker", "id": "bg_image", "label": "Background image" },
    { "type": "range", "id": "bg_opacity", "label": "Background opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "color", "id": "bg_overlay_color", "label": "Image overlay color", "default": "#000000" },
    { "type": "range", "id": "bg_overlay_opacity", "label": "Image overlay opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 0 },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Go Deeper" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "The Full Picture" }
  ],
  "blocks": [
    { "type": "panel", "name": "Panel", "limit": 8, "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Clearing Up Fear In The Cacao Market" },
      { "type": "textarea", "id": "body", "label": "Body paragraph" },
      { "type": "select", "id": "list_type", "label": "List type", "default": "bullets",
        "options": [{"value":"none","label":"No list"},{"value":"bullets","label":"Bullet list"},{"value":"pairs","label":"Name | description pairs"}] },
      { "type": "textarea", "id": "list_items", "label": "List items (one per line; for pairs use 'Name | description')" },
      { "type": "textarea", "id": "outro", "label": "Closing paragraph (optional)" },
      { "type": "image_picker", "id": "image", "label": "Panel image (optional)" },
      { "type": "text", "id": "image_placeholder", "label": "Placeholder text (when no image)" }
    ]}
  ],
  "presets": [{
    "name": "Safe Cacao — Full Picture",
    "blocks": [
      { "type": "panel", "settings": { "heading": "Clearing Up Fear In The Cacao Market", "body": "A rise in fear-based messaging followed a 2023 Consumer Reports article on heavy metals in chocolate — often shared without full context. A few things to watch out for:", "list_type": "bullets", "list_items": "Regulating to zero PPM — held up as an ideal, even though it is an impossible feat for any food.\nReporting heavy-metal levels without comparing them to actual safety thresholds, making safe products look risky.\nFailing to distinguish total metal content from bioavailability — not all metals present in food are absorbed.\nSwitching measurement units (PPM vs. PPB) so direct comparison gets confusing. PPM is the standard.\nCA Prop 65 uses a \"Threshold for Safety\" that over-regulates by a factor of 1000 — the strictest method there is." } },
      { "type": "panel", "settings": { "heading": "Everyday Foods Higher In Cadmium & Lead", "body": "Cacao gets singled out, yet many everyday foods carry cadmium and lead — without the fear campaigns. Sourced consciously, most are equally safe.", "list_type": "pairs", "list_items": "Spinach & Greens | A top source of cadmium, absorbed from high-phosphate soils.\nSunflower Seeds | Often higher in cadmium than cacao — a bioaccumulator grown in monoculture.\nShellfish | Lead and cadmium accumulate from ocean contamination.\nRice | Well known for arsenic and cadmium from wet, lowland growing conditions.\nBaking Powder | Some brands carry trace lead, rarely discussed — though safe options exist.", "outro": "What really matters is overall exposure, proper sourcing, and a healthy body — which eliminates most lead and cadmium on its own." } },
      { "type": "panel", "settings": { "heading": "Why High-Elevation Chuncho Is Cleaner", "body": "Cacao is a bioaccumulator — it draws metals and minerals from the soil. So where it grows is everything. High-altitude Chuncho grows where cadmium in the soil is naturally lower, in volcanic ground that resists metal absorption, isolated from the industrial pollutants and contaminated water that affect lowland cacao. Heavy metals, by their nature, settle to lower elevations with density and rain runoff.", "list_type": "none", "image_placeholder": "High-elevation farm / grove photo" } }
    ]
  }]
}
{% endschema %}
