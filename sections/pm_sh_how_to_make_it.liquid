{%- comment -%} Pacha Mana - Start page: How to make it. Converted from start-here.html; every visible string, image and link is a setting. {%- endcomment -%}
{{ 'pm_landing.css' | asset_url | stylesheet_tag }}
<section class="pm-landing" style="background:var(--pm-sandy-tan);padding:clamp(64px,8vw,112px) 20px;">
<div style="max-width:1140px;margin:0 auto;display:flex;flex-direction:column;gap:40px;">
<div style="display:flex;flex-direction:column;gap:14px;align-items:center;text-align:center;">
<span class="pm-eyebrow pm-eyebrow--cacao">{{ section.settings.eyebrow | escape }}</span>
<h2 style="font-family:var(--font-display);text-transform:uppercase;font-weight:400;letter-spacing:var(--tracking-display);font-size:clamp(30px,4vw,44px);line-height:1.1;color:var(--text-strong);margin:0;">{{ section.settings.heading | escape }}</h2>
<p style="margin:0;max-width:600px;font-size:17px;line-height:1.7;text-wrap:pretty;">{{ section.settings.text | escape }}</p>
</div>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:32px;">
{%- for block in section.blocks -%}{%- if block.type == 'card' -%}<div {{ block.shopify_attributes }} style="display:flex;flex-direction:column;gap:10px;"><span style="font-family:var(--font-display);font-size:40px;color:var(--pm-gold-600);line-height:1;">{{ block.settings.label | escape }}</span><h3 style="font-family:var(--font-display);text-transform:uppercase;font-weight:400;letter-spacing:0.06em;font-size:22px;color:var(--text-strong);margin:0;">{{ block.settings.title | escape }}</h3><p style="margin:0;font-size:16px;font-weight:600;color:var(--text-strong);">{{ block.settings.text | escape }}</p><p style="margin:0;font-size:15px;line-height:1.7;">{{ block.settings.text_2 | escape }}</p></div>{%- endif -%}{%- endfor -%}


</div>
</div>
</section>

{% schema %}
{
  "name": "Start: How to make it",
  "tag": "div",
  "class": "pm-landing-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "text",
          "id": "text_2",
          "label": "Text 2"
        }
      ]
    }
  ],
  "max_blocks": 50,
  "presets": [
    {
      "name": "Start: How to make it"
    }
  ]
}
{% endschema %}
