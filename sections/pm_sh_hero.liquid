{%- comment -%} Pacha Mana - Start page: Hero. Converted from start-here.html; every visible string, image and link is a setting. {%- endcomment -%}
{{ 'pm_landing.css' | asset_url | stylesheet_tag }}
<section class="pm-landing" id="pm-hero" style="position:relative;overflow:hidden;background:var(--gradient-sunrise);padding:clamp(36px,6vw,88px) 20px clamp(48px,6vw,88px);">
<div style="position:absolute;inset:0;background-image:url('https://pachamana.com/cdn/shop/files/Pattern_Website.png?v=1769670221&amp;width=1200');background-size:520px auto;opacity:.05;pointer-events:none;"></div>
<div style="position:relative;max-width:1140px;margin:0 auto;display:flex;flex-wrap:wrap;gap:clamp(28px,5vw,64px);align-items:center;">
<div style="flex:1 1 420px;min-width:0;display:flex;flex-direction:column;gap:22px;">
<span class="pm-eyebrow pm-eyebrow--gold"><span class="pm-eyebrow-rule"></span>{{ section.settings.eyebrow | escape }}</span>
<h1 style="font-family:var(--font-display);text-transform:uppercase;font-weight:400;letter-spacing:var(--tracking-display);font-size:clamp(40px,6.4vw,72px);line-height:1.02;color:var(--text-strong);margin:0;text-wrap:balance;">{{ section.settings.heading | escape }}</h1>
<p style="font-size:clamp(17px,1.6vw,20px);line-height:1.65;margin:0;max-width:56ch;text-wrap:pretty;">{{ section.settings.text | escape }}</p>
<div style="display:flex;flex-wrap:wrap;gap:12px;">
<a class="pm-btn pm-btn--primary pm-btn--lg" href="{{ section.settings.button_link | escape }}">{{ section.settings.button_label | escape }}</a>
<a class="pm-btn pm-btn--outline pm-btn--lg" href="{{ section.settings.button_link_2 }}">{{ section.settings.button_label_2 | escape }}</a>
</div>
<div style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;border-top:1px solid var(--border-medium);padding-top:20px;">
{%- for block in section.blocks -%}{%- if block.type == 'item' -%}<div {{ block.shopify_attributes }} style="display:flex;flex-direction:column;gap:4px;"><span style="font-family:var(--font-display);font-size:clamp(28px,3.4vw,40px);line-height:1;color:var(--pm-gold-600);">{{ block.settings.label | escape }}</span><span style="font-size:14px;line-height:1.4;color:var(--text-strong);">{{ block.settings.label_2 | escape }}</span></div>{%- endif -%}{%- endfor -%}


</div>
<p style="margin:0;font-size:13px;line-height:1.6;color:var(--pm-cacao-400);">{{ section.settings.text_2 | escape }}</p>
</div>
<div style="flex:1 1 380px;min-width:0;position:relative;padding:0 0 24px 24px;">
<div style="height:clamp(340px,44vw,560px);border-radius:28px;overflow:hidden;box-shadow:var(--shadow-lg);background:var(--pm-tan-200);">
<img alt="{{ section.settings.image_alt_text | escape }}" src="{%- if section.settings.image != blank -%}{{ section.settings.image | image_url: width: 2000 }}{%- else -%}{{ section.settings.image_url | escape }}{%- endif -%}" style="width:100%;height:100%;object-fit:cover;display:block;min-height:100%;max-height:100%;"/>
</div>
<img alt="{{ section.settings.image_alt_text_2 | escape }}" src="{%- if section.settings.image_2 != blank -%}{{ section.settings.image_2 | image_url: width: 1600 }}{%- else -%}{{ section.settings.image_url_2 | escape }}{%- endif -%}" style="position:absolute;left:-6px;bottom:0;width:clamp(120px,16vw,190px);height:auto;filter:drop-shadow(0 6px 12px rgba(92,64,47,.18));pointer-events:none;"/>
</div>
</div>
</section>

{% schema %}
{
  "name": "Start: Hero",
  "tag": "div",
  "class": "pm-landing-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "button_link",
      "label": "Button link",
      "info": "A path like /pages/... or a full https:// address."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Button link 2"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Button label 2"
    },
    {
      "type": "textarea",
      "id": "text_2",
      "label": "Text 2"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_url",
      "label": "Image URL",
      "info": "Used when no image is picked above."
    },
    {
      "type": "text",
      "id": "image_alt_text",
      "label": "Image alt text",
      "info": "Leave blank for purely decorative images."
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image 2"
    },
    {
      "type": "text",
      "id": "image_url_2",
      "label": "Image URL 2",
      "info": "Used when no image is picked above."
    },
    {
      "type": "text",
      "id": "image_alt_text_2",
      "label": "Image alt text 2",
      "info": "Leave blank for purely decorative images."
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Stat",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "text",
          "id": "label_2",
          "label": "Label 2"
        }
      ]
    }
  ],
  "max_blocks": 50,
  "presets": [
    {
      "name": "Start: Hero"
    }
  ]
}
{% endschema %}
