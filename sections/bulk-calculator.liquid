<section class="pmw pmw-price-model" id="pmw-{{ section.id }}">
  {% render 'bulk-bg', section: section %}

  <div class="pmw-price-model__inner">
    <div class="pmw-price-model__intro">
      {% if section.settings.eyebrow != blank %}
        <span class="pmw-price-model__eyebrow">{{ section.settings.eyebrow }}</span>
      {% endif %}

      {% if section.settings.headline != blank %}
        <h2 class="pmw-price-model__title">{{ section.settings.headline }}</h2>
      {% endif %}

      {% if section.settings.subhead != blank %}
        <p class="pmw-price-model__sub">{{ section.settings.subhead }}</p>
      {% endif %}
    </div>

    <div class="pmw-price-model__media">
      {% if section.settings.pricing_image != blank %}
        <img
          src="{{ section.settings.pricing_image | image_url: width: 2200 }}"
          srcset="
            {{ section.settings.pricing_image | image_url: width: 700 }} 700w,
            {{ section.settings.pricing_image | image_url: width: 1100 }} 1100w,
            {{ section.settings.pricing_image | image_url: width: 1600 }} 1600w,
            {{ section.settings.pricing_image | image_url: width: 2200 }} 2200w
          "
          sizes="(max-width: 768px) 100vw, 1080px"
          alt="{{ section.settings.pricing_image.alt | default: section.settings.headline | escape }}"
          loading="lazy"
          width="{{ section.settings.pricing_image.width }}"
          height="{{ section.settings.pricing_image.height }}"
        >
      {% else %}
        <div class="pmw-price-model__media-placeholder">
          <span>{{ section.settings.image_placeholder_text }}</span>
        </div>
      {% endif %}
    </div>

    <div class="pmw-price-model__ladders">
      <div class="pmw-price-model__card">
        <div class="pmw-price-model__card-head">
          {% if section.settings.bag_eyebrow != blank %}
            <h3 class="pmw-price-model__card-title">{{ section.settings.bag_eyebrow }}</h3>
          {% endif %}

          {% if section.settings.bag_copy != blank %}
            <p class="pmw-price-model__card-sub">{{ section.settings.bag_copy }}</p>
          {% endif %}

          {% if section.settings.bag_low_price != blank or section.settings.bag_from_price != blank %}
            <p class="pmw-price-model__card-price">
              As low as
              {% if section.settings.bag_low_price != blank %}
                <span>{{ section.settings.bag_low_price }}</span>
              {% endif %}
              / lb
              {% if section.settings.bag_from_price != blank %}
                <em>(from {{ section.settings.bag_from_price }})</em>
              {% endif %}
            </p>
          {% endif %}
        </div>

        {%- assign tier_blocks = section.blocks | where: 'type', 'tier' -%}

        {% if tier_blocks.size > 0 %}
          <div class="pmw-price-model__rows">
            {% for block in tier_blocks %}
              <div class="pmw-price-model__row{% if block.settings.highlight %} pmw-price-model__row--highlight{% endif %}" {{ block.shopify_attributes }}>
                <div class="pmw-price-model__row-left">
                  <div class="pmw-price-model__row-main">{{ block.settings.qty }}</div>
                  {% if block.settings.note != blank %}
                    <div class="pmw-price-model__row-note">{{ block.settings.note }}</div>
                  {% endif %}
                </div>

                <div class="pmw-price-model__row-discount">
                  {{ block.settings.save }}
                </div>
              </div>
            {% endfor %}
          </div>
        {% endif %}
      </div>

      <div class="pmw-price-model__card">
        <div class="pmw-price-model__card-head">
          {% if section.settings.case_eyebrow != blank %}
            <h3 class="pmw-price-model__card-title">{{ section.settings.case_eyebrow }}</h3>
          {% endif %}

          {% if section.settings.case_copy != blank %}
            <p class="pmw-price-model__card-sub">{{ section.settings.case_copy }}</p>
          {% endif %}

          {% if section.settings.case_low_price != blank or section.settings.case_from_price != blank %}
            <p class="pmw-price-model__card-price">
              As low as
              {% if section.settings.case_low_price != blank %}
                <span>{{ section.settings.case_low_price }}</span>
              {% endif %}
              / lb
              {% if section.settings.case_from_price != blank %}
                <em>(from {{ section.settings.case_from_price }})</em>
              {% endif %}
            </p>
          {% endif %}
        </div>

        {%- assign case_blocks = section.blocks | where: 'type', 'case_row' -%}

        {% if case_blocks.size > 0 %}
          <div class="pmw-price-model__rows">
            {% for block in case_blocks %}
              <div class="pmw-price-model__row" {{ block.shopify_attributes }}>
                <div class="pmw-price-model__row-left">
                  <div class="pmw-price-model__row-main">{{ block.settings.order }}</div>
                  {% if block.settings.save != blank %}
                    <div class="pmw-price-model__row-note">{{ block.settings.save }}</div>
                  {% endif %}
                </div>

                <div class="pmw-price-model__row-price">
                  <span>{{ block.settings.price }}</span>
                  <em>each</em>
                </div>
              </div>
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </div>

    {% if section.settings.cta_label != blank or section.settings.cart_note != blank %}
      <div class="pmw-price-model__primary-cta">
        {% if section.settings.cta_label != blank %}
          <a class="pmw-price-model__btn pmw-price-model__btn--primary" href="{{ section.settings.cta_link | default: '/collections/all' }}">
            {{ section.settings.cta_label }}
          </a>
        {% endif %}

        {% if section.settings.cart_note != blank %}
          <span>{{ section.settings.cart_note }}</span>
        {% endif %}
      </div>
    {% endif %}

    {% if section.settings.contact_title != blank or section.settings.contact_copy != blank %}
      <div class="pmw-price-model__contact">
        <div class="pmw-price-model__contact-copywrap">
          {% if section.settings.contact_eyebrow != blank %}
            <span class="pmw-price-model__contact-eyebrow">{{ section.settings.contact_eyebrow }}</span>
          {% endif %}

          {% if section.settings.contact_title != blank %}
            <h3 class="pmw-price-model__contact-title">{{ section.settings.contact_title }}</h3>
          {% endif %}

          {% if section.settings.contact_copy != blank %}
            <p>{{ section.settings.contact_copy }}</p>
          {% endif %}
        </div>

        {% if section.settings.contact_cta1 != blank %}
          <a class="pmw-price-model__btn pmw-price-model__btn--gold" href="{{ section.settings.contact_cta1_link | default: 'mailto:support@pachamana.com' }}">
            {{ section.settings.contact_cta1 }}
          </a>
        {% endif %}
      </div>
    {% endif %}

    <div class="pmw-price-model__perks">
      {% if section.settings.free_ship_text != blank %}
        <div class="pmw-price-model__pill pmw-price-model__pill--gold">
          <span>Free Shipping</span>
          <strong>{{ section.settings.free_ship_text }}</strong>
        </div>
      {% endif %}

      {% if section.settings.subscribe_text != blank %}
        <div class="pmw-price-model__pill pmw-price-model__pill--cacao">
          <span>{{ section.settings.subscribe_label }}</span>
          <strong>{{ section.settings.subscribe_text }}</strong>
        </div>
      {% endif %}
    </div>

    {% if section.settings.why_copy != blank %}
      <div class="pmw-price-model__why">
        {% if section.settings.why_eyebrow != blank %}
          <span class="pmw-price-model__eyebrow pmw-price-model__why-eyebrow">{{ section.settings.why_eyebrow }}</span>
        {% endif %}

        <p>{{ section.settings.why_copy }}</p>
      </div>
    {% endif %}

    {% if section.settings.fine_print != blank %}
      <p class="pmw-price-model__fine">{{ section.settings.fine_print }}</p>
    {% endif %}
  </div>
</section>

<style>
  #pmw-{{ section.id }}.pmw-price-model {
    position: relative;
    overflow: hidden;
    padding: 0;
    background: var(--pm-cream, #fdf8f3);
    color: var(--pm-cacao-900, #2b2521);
  }

  #pmw-{{ section.id }} .pmw-price-model__inner {
    position: relative;
    z-index: 2;
    max-width: 1080px;
    margin: 0 auto;
    padding: 88px 72px;
  }

  #pmw-{{ section.id }} .pmw-price-model__intro {
    max-width: 680px;
    margin-bottom: 40px;
  }

  #pmw-{{ section.id }} .pmw-price-model__eyebrow {
    display: inline-block;
    font-family: var(--font-display, Georgia, serif);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 13px;
    line-height: 1.2;
    color: var(--pm-gold-600, #ab7820);
  }

  #pmw-{{ section.id }} .pmw-price-model__title {
    margin: 14px 0 12px;
    font-family: var(--font-display, Georgia, serif);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    font-size: 44px;
    line-height: 1.04;
    font-weight: 400;
    color: var(--pm-cacao-900, #2b2521);
  }

  #pmw-{{ section.id }} .pmw-price-model__sub {
    margin: 0;
    font-size: 17px;
    line-height: 1.7;
    color: var(--pm-cacao-700, #5c402f);
  }

  #pmw-{{ section.id }} .pmw-price-model__sub strong {
    color: var(--pm-cacao-900, #2b2521);
    font-weight: 700;
  }

  #pmw-{{ section.id }} .pmw-price-model__media {
    width: 100%;
    height: 280px;
    margin-bottom: 40px;
    border: 1px solid var(--pm-border, #ece0d3);
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(92, 64, 47, 0.1);
    background: #fdf3e3;
  }

  #pmw-{{ section.id }} .pmw-price-model__media img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  #pmw-{{ section.id }} .pmw-price-model__media-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    text-align: center;
    background:
      radial-gradient(circle at 18% 20%, rgba(226, 171, 67, 0.22), transparent 30%),
      radial-gradient(circle at 82% 72%, rgba(92, 64, 47, 0.14), transparent 34%),
      #fdf3e3;
  }

  #pmw-{{ section.id }} .pmw-price-model__media-placeholder span {
    font-size: 14px;
    line-height: 1.5;
    color: #9a8a74;
  }

  #pmw-{{ section.id }} .pmw-price-model__ladders {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  #pmw-{{ section.id }} .pmw-price-model__card {
    background: #ffffff;
    border: 1px solid var(--pm-border, #ece0d3);
    border-radius: 18px;
    box-shadow: 0 10px 30px rgba(92, 64, 47, 0.1);
    overflow: hidden;
  }

  #pmw-{{ section.id }} .pmw-price-model__card-head {
    padding: 20px 26px;
    background: #fdf3e3;
    border-bottom: 1px solid var(--pm-border, #ece0d3);
  }

  #pmw-{{ section.id }} .pmw-price-model__card-title {
    margin: 0;
    font-family: var(--font-display, Georgia, serif);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 18px;
    line-height: 1.2;
    font-weight: 400;
    color: var(--pm-cacao-900, #2b2521);
  }

  #pmw-{{ section.id }} .pmw-price-model__card-sub {
    margin: 4px 0 0;
    font-size: 13px;
    line-height: 1.5;
    color: #9a8a74;
  }

  #pmw-{{ section.id }} .pmw-price-model__card-price {
    margin: 8px 0 0;
    font-size: 13px;
    line-height: 1.5;
    color: var(--pm-cacao-900, #2b2521);
    font-weight: 600;
  }

  #pmw-{{ section.id }} .pmw-price-model__card-price span {
    font-family: var(--font-display, Georgia, serif);
    font-size: 16px;
    font-weight: 400;
  }

  #pmw-{{ section.id }} .pmw-price-model__card-price em {
    color: #9a8a74;
    font-style: normal;
    font-weight: 400;
  }

  #pmw-{{ section.id }} .pmw-price-model__rows {
    background: #ffffff;
  }

  #pmw-{{ section.id }} .pmw-price-model__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 18px 26px;
    border-top: 1px solid #f0e7dc;
  }

  #pmw-{{ section.id }} .pmw-price-model__rows .pmw-price-model__row:first-child {
    border-top: 0;
  }

  #pmw-{{ section.id }} .pmw-price-model__row--highlight {
    background: linear-gradient(90deg, rgba(226, 171, 67, 0.13), rgba(226, 171, 67, 0.03));
  }

  #pmw-{{ section.id }} .pmw-price-model__row-left {
    min-width: 0;
  }

  #pmw-{{ section.id }} .pmw-price-model__row-main {
    font-family: var(--font-display, Georgia, serif);
    font-size: 22px;
    line-height: 1.1;
    color: var(--pm-cacao-900, #2b2521);
  }

  #pmw-{{ section.id }} .pmw-price-model__row-note {
    margin-top: 2px;
    font-size: 12.5px;
    line-height: 1.45;
    color: #9a8a74;
  }

  #pmw-{{ section.id }} .pmw-price-model__row-discount {
    flex: 0 0 auto;
    font-family: var(--font-display, Georgia, serif);
    font-size: 28px;
    line-height: 1;
    color: var(--pm-gold-600, #ab7820);
    white-space: nowrap;
  }

  #pmw-{{ section.id }} .pmw-price-model__row-price {
    flex: 0 0 auto;
    text-align: right;
    white-space: nowrap;
  }

  #pmw-{{ section.id }} .pmw-price-model__row-price span {
    display: block;
    font-family: var(--font-display, Georgia, serif);
    font-size: 28px;
    line-height: 1;
    color: var(--pm-cacao-900, #2b2521);
  }

  #pmw-{{ section.id }} .pmw-price-model__row-price em {
    display: block;
    margin-top: 1px;
    font-size: 11.5px;
    line-height: 1.3;
    font-style: normal;
    color: #9a8a74;
  }

  #pmw-{{ section.id }} .pmw-price-model__primary-cta {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-top: 28px;
    flex-wrap: wrap;
  }

  #pmw-{{ section.id }} .pmw-price-model__primary-cta span {
    font-size: 14.5px;
    line-height: 1.5;
    color: var(--pm-cacao-700, #5c402f);
  }

  #pmw-{{ section.id }} .pmw-price-model__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 14px 24px;
    border-radius: 999px;
    font-family: var(--font-display, Georgia, serif);
    text-transform: uppercase;
    letter-spacing: 0.09em;
    font-size: 12px;
    line-height: 1;
    text-decoration: none;
    border: 1px solid transparent;
    transition:
      transform 180ms ease,
      box-shadow 180ms ease,
      background 180ms ease,
      color 180ms ease,
      border-color 180ms ease;
  }

  #pmw-{{ section.id }} .pmw-price-model__btn:hover {
    transform: translateY(-1px);
    text-decoration: none;
  }

  #pmw-{{ section.id }} .pmw-price-model__btn--primary {
    background: var(--pm-sunshine-gold, #e2ab43);
    color: var(--pm-cacao-700, #38271d);
    box-shadow: 0 10px 30px rgba(226, 171, 67, 0.3);
  }

  #pmw-{{ section.id }} .pmw-price-model__btn--primary:hover {
    background: #cf962f;
    color: var(--pm-cacao-700, #38271d);
  }

  #pmw-{{ section.id }} .pmw-price-model__btn--gold {
    background: var(--pm-sunshine-gold, #e2ab43);
    color: var(--pm-cacao-700, #38271d);
    box-shadow: 0 10px 30px rgba(226, 171, 67, 0.22);
  }

  #pmw-{{ section.id }} .pmw-price-model__btn--gold:hover {
    background: #f0bf62;
    color: var(--pm-cacao-700, #38271d);
  }

  #pmw-{{ section.id }} .pmw-price-model__contact {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    flex-wrap: wrap;
    margin-top: 24px;
    padding: 30px 36px;
    border-radius: 18px;
    background: linear-gradient(165deg, #5c402f 0%, #38271d 100%);
    box-shadow: 0 14px 34px rgba(56, 39, 29, 0.18);
  }

  #pmw-{{ section.id }} .pmw-price-model__contact-copywrap {
    min-width: 280px;
    flex: 1;
  }

  #pmw-{{ section.id }} .pmw-price-model__contact-eyebrow {
    display: block;
    font-family: var(--font-display, Georgia, serif);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 18px;
    line-height: 1.2;
    color: var(--pm-sunshine-gold, #e2ab43);
  }

  #pmw-{{ section.id }} .pmw-price-model__contact-title {
    margin: 4px 0 0;
    font-family: var(--font-display, Georgia, serif);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 25px;
    line-height: 1.15;
    font-weight: 400;
    color: #f9f2ef;
  }

  #pmw-{{ section.id }} .pmw-price-model__contact p {
    max-width: 500px;
    margin: 8px 0 0;
    font-size: 15px;
    line-height: 1.6;
    color: #e4d4c6;
  }

  #pmw-{{ section.id }} .pmw-price-model__perks {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 32px;
  }

  #pmw-{{ section.id }} .pmw-price-model__pill {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    max-width: 100%;
    background: #ffffff;
    border-radius: 999px;
    padding: 10px 20px 10px 12px;
    box-shadow: 0 10px 30px rgba(92, 64, 47, 0.1);
  }

  #pmw-{{ section.id }} .pmw-price-model__pill--gold {
    border: 1.5px solid var(--pm-sunshine-gold, #e2ab43);
  }

  #pmw-{{ section.id }} .pmw-price-model__pill--cacao {
    border: 1.5px solid #cdb38a;
  }

  #pmw-{{ section.id }} .pmw-price-model__pill span {
    flex: 0 0 auto;
    font-family: var(--font-display, Georgia, serif);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 11px;
    line-height: 1;
    border-radius: 999px;
    padding: 6px 12px 5px;
  }

  #pmw-{{ section.id }} .pmw-price-model__pill--gold span {
    background: var(--pm-sunshine-gold, #e2ab43);
    color: var(--pm-cacao-700, #38271d);
  }

  #pmw-{{ section.id }} .pmw-price-model__pill--cacao span {
    background: var(--pm-cacao-700, #5c402f);
    color: #ffffff;
  }

  #pmw-{{ section.id }} .pmw-price-model__pill strong {
    font-size: 15px;
    line-height: 1.45;
    color: var(--pm-cacao-900, #2b2521);
    font-weight: 600;
  }

  #pmw-{{ section.id }} .pmw-price-model__why {
    max-width: 680px;
    margin-top: 30px;
  }

  #pmw-{{ section.id }} .pmw-price-model__why-eyebrow {
    letter-spacing: 0.14em;
    font-size: 12px;
  }

  #pmw-{{ section.id }} .pmw-price-model__why p {
    margin: 8px 0 0;
    font-size: 15px;
    line-height: 1.7;
    color: var(--pm-cacao-700, #5c402f);
    font-style: italic;
  }

  #pmw-{{ section.id }} .pmw-price-model__fine {
    margin: 24px 0 0;
    font-size: 14px;
    line-height: 1.65;
    color: var(--pm-cacao-700, #5c402f);
    opacity: 0.85;
  }

  @media (max-width: 980px) {
    #pmw-{{ section.id }} .pmw-price-model__inner {
      padding: 76px 40px;
    }

    #pmw-{{ section.id }} .pmw-price-model__ladders {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) {
    #pmw-{{ section.id }} .pmw-price-model__inner {
      padding: 64px 20px;
    }

    #pmw-{{ section.id }} .pmw-price-model__intro {
      margin-bottom: 30px;
    }

    #pmw-{{ section.id }} .pmw-price-model__title {
      font-size: clamp(32px, 11vw, 42px);
    }

    #pmw-{{ section.id }} .pmw-price-model__sub {
      font-size: 16px;
    }

    #pmw-{{ section.id }} .pmw-price-model__media {
      height: 210px;
      margin-bottom: 28px;
      border-radius: 16px;
    }

    #pmw-{{ section.id }} .pmw-price-model__card {
      border-radius: 16px;
    }

    #pmw-{{ section.id }} .pmw-price-model__card-head {
      padding: 20px;
    }

    #pmw-{{ section.id }} .pmw-price-model__row {
      padding: 17px 20px;
      gap: 14px;
    }

    #pmw-{{ section.id }} .pmw-price-model__row-main {
      font-size: 21px;
    }

    #pmw-{{ section.id }} .pmw-price-model__row-discount,
    #pmw-{{ section.id }} .pmw-price-model__row-price span {
      font-size: 25px;
    }

    #pmw-{{ section.id }} .pmw-price-model__primary-cta {
      align-items: flex-start;
      gap: 12px;
    }

    #pmw-{{ section.id }} .pmw-price-model__btn {
      width: 100%;
    }

    #pmw-{{ section.id }} .pmw-price-model__contact {
      padding: 28px 22px;
      border-radius: 16px;
    }

    #pmw-{{ section.id }} .pmw-price-model__contact-copywrap {
      min-width: 0;
    }

    #pmw-{{ section.id }} .pmw-price-model__perks {
      display: grid;
      grid-template-columns: 1fr;
    }

    #pmw-{{ section.id }} .pmw-price-model__pill {
      width: 100%;
      align-items: flex-start;
      border-radius: 18px;
      padding: 14px;
      flex-direction: column;
      gap: 10px;
    }

    #pmw-{{ section.id }} .pmw-price-model__pill span {
      width: fit-content;
    }
  }

  @media (max-width: 420px) {
    #pmw-{{ section.id }} .pmw-price-model__row {
      align-items: flex-start;
    }

    #pmw-{{ section.id }} .pmw-price-model__row-price,
    #pmw-{{ section.id }} .pmw-price-model__row-discount {
      padding-top: 2px;
    }
  }
</style>

{% schema %}
{
  "name": "Bulk — Pricing Model",
