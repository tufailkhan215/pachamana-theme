{%- comment -%} Pacha Mana - Start page: Origin. Converted from start-here.html; every visible string, image and link is a setting. {%- endcomment -%}
{{ 'pm_landing.css' | asset_url | stylesheet_tag }}
<section class="pm-landing" style="position:relative;overflow:hidden;background:var(--gradient-dusk);color:var(--text-on-dark);padding:clamp(64px,8vw,112px) 20px;">
<img alt="{{ section.settings.image_alt_text | escape }}" src="{%- if section.settings.image != blank -%}{{ section.settings.image | image_url: width: 1600 }}{%- else -%}{{ section.settings.image_url | escape }}{%- endif -%}" style="position:absolute;right:-40px;top:-10px;width:clamp(280px,40vw,560px);height:auto;filter:invert(1);opacity:.1;pointer-events:none;"/>
<div style="position:relative;max-width:1140px;margin:0 auto;display:flex;flex-wrap:wrap;gap:clamp(32px,5vw,64px);align-items:center;">
<div style="flex:1 1 380px;min-width:0;height:clamp(320px,40vw,540px);border-radius:28px;overflow:hidden;box-shadow:var(--shadow-lg);background:var(--pm-cacao-600);">
<img alt="{{ section.settings.image_alt_text_2 | escape }}" src="{%- if section.settings.image_2 != blank -%}{{ section.settings.image_2 | image_url: width: 1400 }}{%- else -%}{{ section.settings.image_url_2 | escape }}{%- endif -%}" style="width:100%;height:100%;object-fit:cover;display:block;min-height:100%;max-height:100%;"/>
</div>
<div style="flex:1 1 440px;min-width:0;display:flex;flex-direction:column;gap:20px;">
<span class="pm-eyebrow pm-eyebrow--gold"><span class="pm-eyebrow-rule"></span>{{ section.settings.eyebrow | escape }}</span>
<h2 style="font-family:var(--font-display);text-transform:uppercase;font-weight:400;letter-spacing:var(--tracking-display);font-size:clamp(30px,4vw,48px);line-height:1.08;color:var(--pm-pearl-white);margin:0;text-wrap:balance;">{{ section.settings.heading | escape }}</h2>
{%- for block in section.blocks -%}{%- if block.type == 'item' -%}<p {{ block.shopify_attributes }} style="{% cycle "item_0_style": "margin:0;font-size:17px;line-height:1.75;color:var(--pm-cacao-50);text-wrap:pretty;", "margin:6px 0 0;font-size:clamp(22px,2.4vw,28px);line-height:1.4;font-style:italic;color:var(--pm-gold-300);", "margin:0;font-size:14px;line-height:1.65;color:var(--pm-cacao-100);" %}">{{ block.settings.text | escape }}</p>{%- endif -%}{%- endfor -%}


<ul style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:10px;border-top:1px solid rgba(249,242,239,.16);padding-top:18px;">
{%- for block in section.blocks -%}{%- if block.type == 'item_2' -%}<li {{ block.shopify_attributes }} style="display:flex;gap:12px;font-size:15px;line-height:1.55;color:var(--pm-pearl-white);">{{ block.settings.list_item }}</li>{%- endif -%}{%- endfor -%}




</ul>
<div><a class="pm-btn pm-btn--primary pm-btn--md" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a></div>
</div>
</div>
</section>

{% schema %}
{
  "name": "Start: Origin",
  "tag": "div",
  "class": "pm-landing-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_url",
      "label": "Image URL",
      "info": "Used when no image is picked above."
    },
    {
      "type": "text",
      "id": "image_alt_text",
      "label": "Image alt text",
      "info": "Leave blank for purely decorative images."
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image 2"
    },
    {
      "type": "text",
      "id": "image_url_2",
      "label": "Image URL 2",
      "info": "Used when no image is picked above."
    },
    {
      "type": "text",
      "id": "image_alt_text_2",
      "label": "Image alt text 2",
      "info": "Leave blank for purely decorative images."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Paragraph",
      "settings": [
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        }
      ]
    },
    {
      "type": "item_2",
      "name": "Fact",
      "settings": [
        {
          "type": "html",
          "id": "list_item",
          "label": "List item",
          "info": "Keeps the design's inline styling. Edit the words, leave the tags."
        }
      ]
    }
  ],
  "max_blocks": 50,
  "presets": [
    {
      "name": "Start: Origin"
    }
  ]
}
{% endschema %}
