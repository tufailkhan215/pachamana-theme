{%- comment -%} Pacha Mana - Bundle page: What ceremonial cacao is. Converted from build-your-bundle.html; every visible string, image and link is a setting. {%- endcomment -%}
{{ 'pm_landing.css' | asset_url | stylesheet_tag }}
<section class="pm-landing" style="padding:clamp(64px,8vw,112px) 24px;">
<div style="max-width:720px;margin:0 auto;display:flex;flex-direction:column;gap:20px;text-align:center;align-items:center;">
<span class="pm-eyebrow pm-eyebrow--gold">{{ section.settings.eyebrow | escape }}</span>
<h2 style="font-family:var(--font-display);text-transform:uppercase;font-weight:400;letter-spacing:var(--tracking-display);font-size:clamp(30px,4vw,44px);line-height:1.1;color:var(--text-strong);margin:0;">{{ section.settings.heading | escape }}</h2>
{%- for block in section.blocks -%}{%- if block.type == 'item' -%}<p {{ block.shopify_attributes }} style="{% cycle "item_0_style": "font-size:19px;line-height:1.75;margin:0;text-wrap:pretty;", "font-size:19px;line-height:1.75;margin:0;font-style:italic;color:var(--pm-cacao-400);text-wrap:pretty;" %}">{{ block.settings.text | escape }}</p>{%- endif -%}{%- endfor -%}

</div>
</section>

{% schema %}
{
  "name": "Bundle: What ceremonial c",
  "tag": "div",
  "class": "pm-landing-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Paragraph",
      "settings": [
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "max_blocks": 50,
  "presets": [
    {
      "name": "Bundle: What ceremonial c"
    }
  ]
}
{% endschema %}
