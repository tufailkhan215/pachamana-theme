{%- comment -%}
  Main article section - matches WordPress blog post structure
  Based on: https://pachamana.com/health-benefits-ceremonial-cacao/
  This section is only used in article.json template, so article context is guaranteed
{%- endcomment -%}

{%- liquid
  assign next_article = null
  assign current_article_index = -1
  for article_in_blog in blog.articles
    if article_in_blog.id == article.id
      assign current_article_index = forloop.index0
    endif
  endfor
  if current_article_index >= 0 and current_article_index < blog.articles.size | minus: 1
    assign next_article = blog.articles[current_article_index | plus: 1]
  endif
-%}
  {%- comment -%} Article Content Container - Rounded box with gold border and light tan background {%- endcomment -%}
  <div class="elementor-element elementor-element-article-wrapper e-flex e-con-boxed e-con e-parent" data-id="article-wrapper" data-element_type="container">
    <div class="e-con-inner">
      {%- comment -%} Article Title {%- endcomment -%}
      <div class="elementor-element elementor-element-article-title elementor-widget elementor-widget-heading" data-id="article-title" data-element_type="widget" data-widget_type="heading.default">
        <div class="elementor-widget-container">
          <h1 class="article__title elementor-heading-title elementor-size-default">{{ article.title | escape | upcase }}</h1>
        </div>
      </div>
      
      {%- comment -%} Article Content {%- endcomment -%}
      <div class="elementor-element elementor-element-article-content elementor-widget elementor-widget-text-editor" data-id="article-content" data-element_type="widget" data-widget_type="text-editor.default">
        <div class="elementor-widget-container">
          <div class="article__content">
            {{ article.content }}
          </div>
        </div>
      </div>
      
      {%- comment -%} Next Article Navigation {%- endcomment -%}
      {%- if next_article != null -%}
        <div class="elementor-element elementor-element-article-next elementor-widget elementor-widget-button" data-id="article-next" data-element_type="widget" data-widget_type="button.default">
          <div class="elementor-widget-container">
            <div class="elementor-button-wrapper">
              <a class="elementor-button elementor-button-link elementor-size-md article-next-link" href="{{ next_article.url }}">
                <span class="elementor-button-content-wrapper">
                  <span class="elementor-button-text">NEXT ></span>
                </span>
                <span class="elementor-button-next-title">{{ next_article.title | escape }}</span>
              </a>
            </div>
          </div>
        </div>
      {%- endif -%}
      
      {%- comment -%} Related Articles Section {%- endcomment -%}
      {%- if section.settings.show_related_articles and blog.articles_count > 1 -%}
        <div class="elementor-element elementor-element-related-articles elementor-widget elementor-widget-heading" data-id="related-articles" data-element_type="widget" data-widget_type="heading.default">
          <div class="elementor-widget-container">
            <h2 class="elementor-heading-title elementor-size-default">Related</h2>
          </div>
        </div>
        <div class="elementor-element elementor-element-related-articles-grid e-flex e-con-boxed e-con e-parent" data-id="related-articles-grid" data-element_type="container">
          <div class="e-con-inner">
            <div class="related-articles-grid">
              {%- assign related_count = 0 -%}
              {%- for related_article in blog.articles -%}
                {%- if related_article.id != article.id and related_count < 3 -%}
                  {%- assign related_count = related_count | plus: 1 -%}
                  <article class="related-article">
                    {%- if related_article.image -%}
                      <div class="related-article__image">
                        <a href="{{ related_article.url }}">
                          <img 
                            src="{{ related_article.image | image_url: width: 400 }}" 
                            alt="{{ related_article.image.alt | default: related_article.title | escape }}"
                            loading="lazy"
                          >
                        </a>
                      </div>
                    {%- endif -%}
                    <div class="related-article__content">
                      <h3 class="related-article__title">
                        <a href="{{ related_article.url }}">{{ related_article.title | escape }}</a>
                      </h3>
                      {%- if related_article.excerpt != blank -%}
                        <div class="related-article__excerpt">
                          {{ related_article.excerpt | strip_html | truncatewords: 20 }}
                        </div>
                      {%- else -%}
                        <div class="related-article__excerpt">
                          {{ related_article.content | strip_html | truncatewords: 20 }}
                        </div>
                      {%- endif -%}
                      <div class="related-article__meta">
                        <time datetime="{{ related_article.published_at | date: '%Y-%m-%d' }}">
                          {{ related_article.published_at | date: format: 'abbreviated_date' }}
                        </time>
                        {%- if related_article.blog.title != blank -%}
                          <span class="related-article__category">In "{{ related_article.blog.title }}"</span>
                        {%- endif -%}
                      </div>
                    </div>
                  </article>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>

<style>
  /* Load OAXACA font - ensure font-face is defined */
  @font-face {
    font-family: 'OAXACA';
    font-style: normal;
    font-weight: normal;
    font-display: swap;
    src: url("{{ 'OaxacaRegular.woff2' | asset_url }}") format('woff2'),
         url("{{ 'OaxacaRegular.woff' | asset_url }}") format('woff'),
         url("{{ 'OaxacaRegular.ttf' | asset_url }}") format('truetype'),
         url("{{ 'OaxacaRegular.svg' | asset_url }}#OAXACA") format('svg');
  }

  /* Article wrapper - rounded box with gold border and light tan background */
  .elementor-63 .elementor-element.elementor-element-article-wrapper {
    background-color: var(--e-global-color-primary) !important;
    border: 2px solid var(--e-global-color-77302cc) !important;
    border-radius: 20px !important;
    padding: 60px 80px !important;
    margin: 40px auto !important;
    max-width: 1200px !important;
    box-shadow: 0px 0px 20px 0px rgba(0,0,0,0.1) !important;
  }

  /* Article title styling */
  .elementor-63 .elementor-element.elementor-element-article-title .article__title {
    font-family: "OAXACA", Sans-serif !important;
    font-size: 48px !important;
    letter-spacing: 3px !important;
    color: var(--e-global-color-secondary) !important;
    text-align: center !important;
    margin-bottom: 40px !important;
    font-weight: normal !important;
    line-height: 1.2 !important;
  }

  /* Article content styling */
  .elementor-63 .elementor-element.elementor-element-article-content .article__content {
    font-family: var(--e-global-typography-text-font-family), Sans-serif !important;
    font-size: 18px !important;
    line-height: 1.8 !important;
    color: var(--e-global-color-secondary) !important;
  }

  .elementor-63 .elementor-element.elementor-element-article-content .article__content p {
    margin-bottom: 25px !important;
  }

  .elementor-63 .elementor-element.elementor-element-article-content .article__content h2,
  .elementor-63 .elementor-element.elementor-element-article-content .article__content h3,
  .elementor-63 .elementor-element.elementor-element-article-content .article__content h4 {
    font-family: "OAXACA", Sans-serif !important;
    color: var(--e-global-color-secondary) !important;
    margin-top: 40px !important;
    margin-bottom: 20px !important;
    font-weight: normal !important;
  }

  .elementor-63 .elementor-element.elementor-element-article-content .article__content h2 {
    font-size: 36px !important;
    letter-spacing: 2px !important;
  }

  .elementor-63 .elementor-element.elementor-element-article-content .article__content h3 {
    font-size: 28px !important;
    letter-spacing: 1.5px !important;
  }

  .elementor-63 .elementor-element.elementor-element-article-content .article__content ul,
  .elementor-63 .elementor-element.elementor-element-article-content .article__content ol {
    margin-bottom: 25px !important;
    padding-left: 40px !important;
  }

  .elementor-63 .elementor-element.elementor-element-article-content .article__content li {
    margin-bottom: 12px !important;
    line-height: 1.7 !important;
  }

  .elementor-63 .elementor-element.elementor-element-article-content .article__content strong,
  .elementor-63 .elementor-element.elementor-element-article-content .article__content b {
    font-weight: 600 !important;
    color: var(--e-global-color-secondary) !important;
  }

  .elementor-63 .elementor-element.elementor-element-article-content .article__content a {
    color: var(--e-global-color-text) !important;
    text-decoration: underline !important;
  }

  .elementor-63 .elementor-element.elementor-element-article-content .article__content a:hover {
    color: var(--e-global-color-secondary) !important;
  }

  /* Next Article Navigation */
  .elementor-63 .elementor-element.elementor-element-article-next {
    margin-top: 50px !important;
    text-align: right !important;
  }

  .elementor-63 .elementor-element.elementor-element-article-next .article-next-link {
    display: inline-flex !important;
    flex-direction: column !important;
    align-items: flex-end !important;
    background: transparent !important;
    border: none !important;
    padding: 0 !important;
    text-decoration: none !important;
  }

  .elementor-63 .elementor-element.elementor-element-article-next .article-next-link .elementor-button-text {
    font-family: "OAXACA", Sans-serif !important;
    font-size: 20px !important;
    color: var(--e-global-color-secondary) !important;
    letter-spacing: 2px !important;
    margin-bottom: 5px !important;
  }

  .elementor-63 .elementor-element.elementor-element-article-next .article-next-link .elementor-button-next-title {
    font-family: var(--e-global-typography-text-font-family), Sans-serif !important;
    font-size: 16px !important;
    color: var(--e-global-color-text) !important;
    text-decoration: none !important;
  }

  .elementor-63 .elementor-element.elementor-element-article-next .article-next-link:hover .elementor-button-text,
  .elementor-63 .elementor-element.elementor-element-article-next .article-next-link:hover .elementor-button-next-title {
    color: var(--e-global-color-5abf1e8) !important;
  }

  /* Related Articles Section */
  .elementor-63 .elementor-element.elementor-element-related-articles {
    margin-top: 60px !important;
    margin-bottom: 30px !important;
  }

  .elementor-63 .elementor-element.elementor-element-related-articles .elementor-heading-title {
    font-family: "OAXACA", Sans-serif !important;
    font-size: 36px !important;
    letter-spacing: 2px !important;
    color: var(--e-global-color-secondary) !important;
    text-align: center !important;
    margin-bottom: 30px !important;
  }

  .elementor-63 .related-articles-grid {
    display: grid !important;
    grid-template-columns: repeat(3, 1fr) !important;
    gap: 30px !important;
    margin-top: 30px !important;
  }

  .elementor-63 .related-article {
    display: flex !important;
    flex-direction: column !important;
  }

  .elementor-63 .related-article__image {
    margin-bottom: 15px !important;
  }

  .elementor-63 .related-article__image img {
    width: 100% !important;
    height: auto !important;
    border-radius: 10px !important;
    display: block !important;
  }

  .elementor-63 .related-article__title {
    font-family: "OAXACA", Sans-serif !important;
    font-size: 20px !important;
    color: var(--e-global-color-secondary) !important;
    margin-bottom: 10px !important;
    line-height: 1.3 !important;
  }

  .elementor-63 .related-article__title a {
    color: var(--e-global-color-secondary) !important;
    text-decoration: none !important;
  }

  .elementor-63 .related-article__title a:hover {
    color: var(--e-global-color-text) !important;
  }

  .elementor-63 .related-article__excerpt {
    font-family: var(--e-global-typography-text-font-family), Sans-serif !important;
    font-size: 15px !important;
    line-height: 1.6 !important;
    color: var(--e-global-color-secondary) !important;
    margin-bottom: 15px !important;
  }

  .elementor-63 .related-article__meta {
    font-family: var(--e-global-typography-text-font-family), Sans-serif !important;
    font-size: 14px !important;
    color: var(--e-global-color-text) !important;
    margin-top: auto !important;
  }

  .elementor-63 .related-article__meta time,
  .elementor-63 .related-article__meta .related-article__category {
    display: inline-block !important;
    margin-right: 10px !important;
  }

  /* Responsive adjustments */
  @media (max-width: 1024px) {
    .elementor-63 .elementor-element.elementor-element-article-wrapper {
      padding: 40px 50px !important;
      margin: 30px 20px !important;
    }

    .elementor-63 .elementor-element.elementor-element-article-title .article__title {
      font-size: 36px !important;
    }

    .elementor-63 .related-articles-grid {
      grid-template-columns: repeat(2, 1fr) !important;
      gap: 25px !important;
    }
  }

  @media (max-width: 767px) {
    .elementor-63 .elementor-element.elementor-element-article-wrapper {
      padding: 30px 25px !important;
      margin: 20px 10px !important;
      border-radius: 15px !important;
    }

    .elementor-63 .elementor-element.elementor-element-article-title .article__title {
      font-size: 28px !important;
      letter-spacing: 2px !important;
    }

    .elementor-63 .elementor-element.elementor-element-article-content .article__content {
      font-size: 16px !important;
    }

    .elementor-63 .elementor-element.elementor-element-article-content .article__content h2 {
      font-size: 28px !important;
    }

    .elementor-63 .elementor-element.elementor-element-article-content .article__content h3 {
      font-size: 24px !important;
    }

    .elementor-63 .elementor-element.elementor-element-related-articles .elementor-heading-title {
      font-size: 28px !important;
    }

    .elementor-63 .related-articles-grid {
      grid-template-columns: 1fr !important;
      gap: 20px !important;
    }

    .elementor-63 .elementor-element.elementor-element-article-next {
      text-align: center !important;
    }
  }
</style>

{% schema %}
{
  "name": "Article",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_related_articles",
      "label": "Show related articles",
      "default": true
    }
  ]
}
{% endschema %}
