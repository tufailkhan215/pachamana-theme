        {%- comment -%} Related Articles Section - Dynamic from Shopify Blog {%- endcomment -%}
        {%- liquid
          assign related_count = 0
          assign max_related = 3
          
          comment
            Count how many related articles exist (excluding current article)
          endcomment
          if blog and blog.articles.size > 1
            for related_article in blog.articles
              if related_article.id != article.id
                assign related_count = related_count | plus: 1
              endif
            endfor
          endif
        -%}
        
        {%- if related_count > 0 -%}
          <div id="jp-relatedposts" class="jp-relatedposts" style="display: block !important;">
            <h3 class="jp-relatedposts-headline"><em>Related</em></h3>
            <div class="jp-relatedposts-items jp-relatedposts-items-minimal jp-relatedposts-grid">
              {%- assign related_index = 0 -%}
              {%- for related_article in blog.articles -%}
                {%- if related_article.id != article.id and related_index < max_related -%}
                  <p class="jp-relatedposts-post jp-relatedposts-post{{ related_index }}" data-post-id="{{ related_article.id }}" data-post-format="false">
                    <span class="jp-relatedposts-post-title">
                      <a class="jp-relatedposts-post-a" href="{{ related_article.url }}" title="{{ related_article.title | escape }}" data-origin="{{ article.id }}" data-position="{{ related_index }}">
                        {{ related_article.title | escape }}
                      </a>
                    </span>
                    <time class="jp-relatedposts-post-date" datetime="{{ related_article.published_at | date: '%B %d, %Y' }}" style="display: block;">
                      {{ related_article.published_at | date: '%B %d, %Y' }}
                    </time>
                    {%- if related_article.tags.size > 0 -%}
                      <span class="jp-relatedposts-post-context">In "{{ related_article.tags.first }}"</span>
                    {%- endif -%}
                  </p>
                  {%- assign related_index = related_index | plus: 1 -%}
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
