<section class="pmw pmw-savings" id="pmw-{{ section.id }}">
  {% render 'bulk-bg', section: section %}
  <div class="pmw__inner pmw-savings__inner">
    <div class="pmw-savings__head">
      {% if section.settings.eyebrow != blank %}<span class="pmw-eyebrow">{{ section.settings.eyebrow }}</span>{% endif %}
      <h2 class="pmw-savings__title">{{ section.settings.headline }}</h2>
      {% if section.settings.subhead != blank %}<p class="pmw-savings__sub">{{ section.settings.subhead }}</p>{% endif %}
    </div>
    <div class="pmw-savings__grid">
      {% for block in section.blocks %}
        {% if block.type == 'step' %}
          <div class="pmw-savings__card" {{ block.shopify_attributes }}>
            <div class="pmw-savings__num">{{ block.settings.number }}</div>
            <h3 class="pmw-savings__name">{{ block.settings.title }}</h3>
            <p class="pmw-savings__desc">{{ block.settings.description }}</p>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<style>
  #pmw-{{ section.id }}.pmw-savings { padding: 0; }
  #pmw-{{ section.id }} .pmw-savings__inner { padding: 90px 64px; max-width: 1120px; margin: 0 auto; }
  #pmw-{{ section.id }} .pmw-savings__head { text-align: center; margin-bottom: 54px; }
  #pmw-{{ section.id }} .pmw-savings__title { font-size: 42px; margin: 14px 0 0; }
  #pmw-{{ section.id }} .pmw-savings__sub { margin: 18px auto 0; max-width: 600px; font-size: 17px; line-height: 1.7; color: var(--page-muted); }
  #pmw-{{ section.id }} .pmw-savings__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 24px; }
  #pmw-{{ section.id }} .pmw-savings__card { background: var(--card-bg); border: 1px solid var(--card-border); border-radius: 18px; box-shadow: var(--card-shadow); padding: 38px 34px; }
  #pmw-{{ section.id }} .pmw-savings__num { font-family: var(--font-display); font-size: 38px; color: var(--pm-gold-600); line-height: 1; }
  #pmw-{{ section.id }} .pmw-savings__name { margin: 16px 0 10px; font-size: 19px; letter-spacing: .05em; color: var(--page-text); }
  #pmw-{{ section.id }} .pmw-savings__desc { margin: 0; font-size: 15px; line-height: 1.7; color: var(--page-muted); }
  @media (max-width: 768px) { #pmw-{{ section.id }} .pmw-savings__inner { padding: 64px 20px; } }
</style>

{% schema %}
{
  "name": "Bulk — Savings Explainer",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Background" },
    { "type": "select", "id": "bg_type", "label": "Background type", "default": "color",
      "options": [{"value":"color","label":"Color"},{"value":"image","label":"Image"}] },
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#f9f2ef" },
    { "type": "image_picker", "id": "bg_image", "label": "Background image" },
    { "type": "range", "id": "bg_opacity", "label": "Background opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "color", "id": "bg_overlay_color", "label": "Image overlay color", "default": "#000000" },
    { "type": "range", "id": "bg_overlay_opacity", "label": "Image overlay opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 0 },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "How It Works" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "Saving Is Automatic" },
    { "type": "textarea", "id": "subhead", "label": "Subhead (optional)" }
  ],
  "blocks": [
    { "type": "step", "name": "Step card", "limit": 6, "settings": [
      { "type": "text", "id": "number", "label": "Number", "default": "01" },
      { "type": "text", "id": "title", "label": "Title", "default": "Fill Your Cart" },
      { "type": "textarea", "id": "description", "label": "Description", "default": "Mix any sizes you like — half-pound, full-pound, or 5 lb bulk bag. Every gram counts toward your tier." }
    ]}
  ],
  "presets": [{
    "name": "Bulk — Savings Explainer",
    "blocks": [
      { "type": "step", "settings": { "number": "01", "title": "Fill Your Cart", "description": "Mix any sizes you like — half-pound, full-pound, or 5 lb bulk bag. Every gram counts toward your tier." } },
      { "type": "step", "settings": { "number": "02", "title": "Hit A Weight Tier", "description": "About 3 lb saves 5%. 6 lb saves 10%. 10 lb saves 15%. 20 lb saves 20%. The savings appear automatically." } },
      { "type": "step", "settings": { "number": "03", "title": "Check Out", "description": "Your discount applies at checkout. No code to enter, no application, no waiting on us." } }
    ]
  }]
}
{% endschema %}
