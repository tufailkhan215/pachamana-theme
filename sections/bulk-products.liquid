<section class="pmw pmw-products" id="pmw-{{ section.id }}">
  {% render 'bulk-bg', section: section %}
  <div class="pmw__inner">
    {% if section.settings.eyebrow != blank %}<div class="pmw-eyebrow" style="text-align:center;display:block;">{{ section.settings.eyebrow }}</div>{% endif %}
    <h2 class="pmw-products__title">{{ section.settings.headline }}</h2>
    {% if section.settings.subhead != blank %}<p class="pmw-products__sub">{{ section.settings.subhead }}</p>{% endif %}
    <div class="pmw-products__grid">
      {% for block in section.blocks %}
        {% if block.type == 'product_card' %}
          <div class="pmw-products__card" {{ block.shopify_attributes }}>
            <div class="pmw-products__media">
              {% if block.settings.image != blank %}
                <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.name | escape }}" loading="lazy">
              {% else %}
                <span class="pmw-products__placeholder">{{ block.settings.name }}</span>
              {% endif %}
            </div>
            {% if block.settings.badge != blank %}<span class="pmw-products__badge">{{ block.settings.badge }}</span>{% endif %}
            <h3 class="pmw-products__name">{{ block.settings.name }}</h3>
            <p class="pmw-products__origin">{{ block.settings.origin }}</p>
            <p class="pmw-products__price">{{ block.settings.price }}</p>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<style>
  #pmw-{{ section.id }}.pmw-products { padding: 92px 72px; }
  #pmw-{{ section.id }} .pmw-products__title { text-align: center; font-size: 40px; margin: 14px 0 10px; }
  #pmw-{{ section.id }} .pmw-products__sub { text-align: center; max-width: 580px; margin: 0 auto 48px; font-size: 17px; line-height: 1.7; color: var(--page-muted); }
  #pmw-{{ section.id }} .pmw-products__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 22px; max-width: 1140px; margin: 0 auto; }
  #pmw-{{ section.id }} .pmw-products__card { background: var(--card-bg); border: 1px solid var(--card-border); border-radius: 20px; padding: 24px; box-shadow: var(--card-shadow); position: relative; }
  #pmw-{{ section.id }} .pmw-products__media { aspect-ratio: 4 / 5; background: var(--hero-grad); border-radius: 14px; overflow: hidden; display: flex; align-items: center; justify-content: center; margin-bottom: 18px; }
  #pmw-{{ section.id }} .pmw-products__media img { width: 100%; height: 100%; object-fit: cover; }
  #pmw-{{ section.id }} .pmw-products__placeholder { font-family: var(--font-display); font-size: 14px; letter-spacing: .08em; text-transform: uppercase; color: var(--pm-cacao-300); text-align: center; padding: 0 16px; }
  #pmw-{{ section.id }} .pmw-products__badge { position: absolute; top: 36px; right: 36px; background: var(--pm-gold-100); color: var(--pm-gold-700); font-size: 10px; letter-spacing: .15em; text-transform: uppercase; padding: 4px 10px; border-radius: 999px; }
  #pmw-{{ section.id }} .pmw-products__name { font-size: 20px; color: var(--page-text); margin-bottom: 6px; }
  #pmw-{{ section.id }} .pmw-products__origin { font-size: 14px; color: var(--page-muted); line-height: 1.5; margin-bottom: 8px; font-style: italic; }
  #pmw-{{ section.id }} .pmw-products__price { font-family: var(--font-display); font-size: 13px; letter-spacing: .08em; text-transform: uppercase; color: var(--pm-gold-600); }
  @media (max-width: 768px) { #pmw-{{ section.id }}.pmw-products { padding: 64px 20px; } }
</style>

{% schema %}
{
  "name": "Bulk — Products",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Background" },
    { "type": "select", "id": "bg_type", "label": "Background type", "default": "color",
      "options": [{"value":"color","label":"Color"},{"value":"image","label":"Image"}] },
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#f9f2ef" },
    { "type": "image_picker", "id": "bg_image", "label": "Background image" },
    { "type": "range", "id": "bg_opacity", "label": "Background opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "color", "id": "bg_overlay_color", "label": "Image overlay color", "default": "#000000" },
    { "type": "range", "id": "bg_overlay_opacity", "label": "Image overlay opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 0 },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Lineup" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "What You'll Carry" },
    { "type": "textarea", "id": "subhead", "label": "Subhead", "default": "Single-origin Chuncho cacao, in every form your customers want." }
  ],
  "blocks": [
    { "type": "product_card", "name": "Product card", "limit": 8, "settings": [
      { "type": "image_picker", "id": "image", "label": "Product photo" },
      { "type": "text", "id": "name", "label": "Name", "default": "Chuncho Paste Block" },
      { "type": "text", "id": "origin", "label": "Origin / sub-line", "default": "Quillabamba, Peru" },
      { "type": "text", "id": "price", "label": "Price / size label", "default": "1 lb block" },
      { "type": "text", "id": "badge", "label": "Badge", "default": "Single Origin" }
    ]}
  ],
  "presets": [{
    "name": "Bulk — Products",
    "blocks": [
      { "type": "product_card", "settings": { "name": "Chuncho Paste Block", "origin": "Quillabamba, Peru", "price": "1 lb block", "badge": "Single Origin" } },
      { "type": "product_card", "settings": { "name": "Ground Chuncho", "origin": "Café & Studio", "price": "5 lb bag", "badge": "Bulk" } },
      { "type": "product_card", "settings": { "name": "Mushroom Vitality", "origin": "Cacao + Adaptogens", "price": "Ground", "badge": "Functional" } },
      { "type": "product_card", "settings": { "name": "Rose Vanilla", "origin": "Rose + Vanilla Bean", "price": "Ground", "badge": "Botanical" } }
    ]
  }]
}
{% endschema %}
