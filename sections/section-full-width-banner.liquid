{% comment %}
  Ora-style full-width banner: one image, content at bottom center (H1 + 2 lines + CTA).
  Optional overlay; mobile can stack content below image.
{% endcomment %}
{% assign bid = section.id | replace: '-', '' | replace: '_', '' | slice: 0, 12 %}

{% style %}
  .ora-banner-{{ bid }} {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .ora-banner-{{ bid }} .ora-banner__media-wrap {
    position: relative;
    width: 100%;
  }

  .ora-banner-{{ bid }} .ora-banner__media-wrap::before {
    content: '';
    display: block;
    padding-bottom: {{ section.settings.aspect_ratio }}%;
  }

  .ora-banner-{{ bid }} .ora-banner__media {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ora-banner-{{ bid }} .ora-banner__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ section.settings.overlay_color }};
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    pointer-events: none;
  }

  .ora-banner-{{ bid }} .ora-banner__content {
    display: flex;
    align-items: {{ section.settings.content_vertical }};
    justify-content: {{ section.settings.content_horizontal }};
    text-align: center;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 2rem 1.5rem;
    box-sizing: border-box;
  }

  .ora-banner-{{ bid }} .ora-banner__box {
    max-width: {{ section.settings.box_max_width }}px;
    width: 100%;
    background-color: {% if section.settings.box_background_image != blank %}transparent{% elsif section.settings.show_box_bg %}{{ section.settings.box_bg }}{% else %}transparent{% endif %};
    {% if section.settings.box_background_image != blank %}
    background-image: url({{ section.settings.box_background_image | image_url: width: 800 }});
    background-repeat: no-repeat;
    background-size: contain;
    background-position: center;
    {% endif %}
    padding: {{ section.settings.box_padding }}rem;
    border-radius: {{ section.settings.box_radius }}px;
    text-align: {{ section.settings.content_text_align }};
  }

  .ora-banner-{{ bid }} .ora-banner__heading {
    font-family: var(--font-heading-family), sans-serif;
    font-size: {{ section.settings.heading_size_mobile }}px;
    font-weight: 700;
    letter-spacing: {{ section.settings.heading_letter_spacing }}px;
    text-transform: uppercase;
    color: {{ section.settings.heading_color }};
    margin: 0 0 {{ section.settings.heading_spacing }}px;
    line-height: 1.2;
  }

  .ora-banner-{{ bid }} .ora-banner__text {
    font-size: {{ section.settings.text_size_mobile }}px;
    color: {{ section.settings.text_color }};
    margin: 0 0 {{ section.settings.text_spacing }}px;
    line-height: 1.5;
  }

  .ora-banner-{{ bid }} .ora-banner__text:last-of-type {
    margin-bottom: {{ section.settings.button_spacing }}px;
  }

  .ora-banner-{{ bid }} .ora-banner__btn {
    display: inline-block;
    padding: {{ section.settings.button_padding_y }}px {{ section.settings.button_padding_x }}px;
    background-color: {{ section.settings.button_bg }};
    color: {{ section.settings.button_text_color }};
    text-decoration: none;
    font-weight: 600;
    font-size: {{ section.settings.button_font_size }}px;
    border: 2px solid {{ section.settings.button_bg }};
    border-radius: {{ section.settings.button_radius }}px;
    transition: background-color 0.2s, color 0.2s, border-color 0.2s, transform 0.2s;
  }

  .ora-banner-{{ bid }} .ora-banner__btn:hover {
    background-color: {{ section.settings.button_hover_bg }};
    color: {{ section.settings.button_hover_text }};
    border-color: {{ section.settings.button_hover_bg }};
    transform: translateY(-2px);
  }

  .ora-banner-{{ bid }} .ora-banner__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin-top: 0;
  }

  @media screen and (min-width: 750px) {
    .ora-banner-{{ bid }} .ora-banner__heading {
      font-size: {{ section.settings.heading_size }}px;
    }
    .ora-banner-{{ bid }} .ora-banner__text {
      font-size: {{ section.settings.text_size }}px;
    }
    .ora-banner-{{ bid }} .ora-banner__content {
      padding: 3rem 2rem;
    }
  }

  {% if section.settings.mobile_stack %}
  @media screen and (max-width: 749px) {
    .ora-banner-{{ bid }} {
      display: flex;
      flex-direction: column;
    }
    .ora-banner-{{ bid }} .ora-banner__content {
      position: relative;
      order: 2;
      background-color: {{ section.settings.mobile_box_bg }};
      min-height: auto;
    }
    .ora-banner-{{ bid }} .ora-banner__media-wrap {
      order: 1;
    }
    .ora-banner-{{ bid }} .ora-banner__media-wrap::before {
      padding-bottom: {{ section.settings.mobile_aspect_ratio }}%;
    }
  }
  {% endif %}

  {% if section.settings.min_height_desktop > 0 %}
  @media screen and (min-width: 750px) {
    .ora-banner-{{ bid }} .ora-banner__media-wrap::before {
      display: none;
    }
    .ora-banner-{{ bid }} .ora-banner__media-wrap {
      min-height: {{ section.settings.min_height_desktop }}rem;
    }
  }
  {% endif %}

  .ora-banner-{{ bid }} .ora-banner__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .ora-banner-{{ bid }} .ora-banner__placeholder .placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.15;
  }
{% endstyle %}

<section class="shopify-section ora-banner-section ora-banner-{{ bid }}{% if section.settings.mobile_stack %} ora-banner--mobile-stack{% endif %}" {{ section.shopify_attributes }}>
  <div class="ora-banner__media-wrap">
    {% if section.settings.image != blank %}
      {% assign img = section.settings.image %}
      <img
        class="ora-banner__media"
        src="{{ img | image_url: width: 1500 }}"
        srcset="
          {{ img | image_url: width: 375 }} 375w,
          {{ img | image_url: width: 550 }} 550w,
          {{ img | image_url: width: 750 }} 750w,
          {{ img | image_url: width: 1100 }} 1100w,
          {{ img | image_url: width: 1500 }} 1500w,
          {{ img | image_url: width: 2000 }} 2000w,
          {{ img | image_url: width: 3000 }} 3000w,
          {{ img | image_url: width: 3840 }} 3840w
        "
        sizes="100vw"
        width="{{ img.width }}"
        height="{{ img.height }}"
        alt="{{ section.settings.image_alt | default: img.alt | escape }}"
        loading="{% if section.settings.hero_priority %}eager{% else %}lazy{% endif %}"
        fetchpriority="{% if section.settings.hero_priority %}high{% endif %}"
        decoding="async"
      >
    {% else %}
      <div class="ora-banner__media ora-banner__placeholder" style="background: {{ section.settings.placeholder_bg }}; width: 100%; height: 100%;">{{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
    {% endif %}
    {% if section.settings.show_overlay %}
      <div class="ora-banner__overlay" aria-hidden="true"></div>
    {% endif %}
  </div>

  <div class="ora-banner__content">
    <div class="ora-banner__box">
      {% if section.settings.heading != blank %}
        {% if section.settings.heading_tag == 'h2' %}
          <h2 class="ora-banner__heading">{{ section.settings.heading }}</h2>
        {% else %}
          <h1 class="ora-banner__heading">{{ section.settings.heading }}</h1>
        {% endif %}
      {% endif %}
      {% if section.settings.text_line_1 != blank %}
        <div class="ora-banner__text">{{ section.settings.text_line_1 }}</div>
      {% endif %}
      {% if section.settings.text_line_2 != blank %}
        <div class="ora-banner__text">{{ section.settings.text_line_2 }}</div>
      {% endif %}
      {% if section.settings.button_label != blank or section.settings.button_2_label != blank %}
        <div class="ora-banner__buttons">
          {% if section.settings.button_label != blank %}
            <a href="{{ section.settings.button_link | default: '#' }}" class="ora-banner__btn">{{ section.settings.button_label }}</a>
          {% endif %}
          {% if section.settings.button_2_label != blank %}
            <a href="{{ section.settings.button_2_link | default: '#' }}" class="ora-banner__btn">{{ section.settings.button_2_label }}</a>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Full width banner",
  "tag": "section",
  "class": "section section--full-width",
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Banner image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "info": "Override alt text for the image"
    },
    {
      "type": "checkbox",
      "id": "hero_priority",
      "label": "Prioritize image loading (use for first banner)",
      "default": true
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "CEREMONIAL CACAO"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" }
      ],
      "default": "h1",
      "info": "Use H2 for secondary banners (e.g. v1 layout)"
    },
    {
      "type": "textarea",
      "id": "text_line_1",
      "label": "Text line 1",
      "default": "Sustained energy. Uplifted mood. Nourished body."
    },
    {
      "type": "textarea",
      "id": "text_line_2",
      "label": "Text line 2",
      "default": "A magical drinking chocolate made from 100% pure, organic cacao."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop CACAO"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Second button label"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Second button link"
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "Show overlay over image",
      "default": false
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "content_vertical",
      "label": "Content vertical",
      "options": [
        { "value": "flex-start", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Bottom" }
      ],
      "default": "flex-end"
    },
    {
      "type": "select",
      "id": "content_horizontal",
      "label": "Content horizontal",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "aspect_ratio",
      "label": "Image aspect ratio (height %)",
      "min": 30,
      "max": 80,
      "step": 1,
      "unit": "%",
      "default": 52
    },
    {
      "type": "range",
      "id": "min_height_desktop",
      "label": "Min height desktop (rem)",
      "info": "Set to 0 to use aspect ratio only",
      "min": 0,
      "max": 60,
      "step": 2,
      "default": 0
    },
    {
      "type": "range",
      "id": "box_max_width",
      "label": "Content box max width",
      "min": 400,
      "max": 900,
      "step": 50,
      "unit": "px",
      "default": 600
    },
    {
      "type": "checkbox",
      "id": "show_box_bg",
      "label": "Show content box background",
      "default": true,
      "info": "Solid card behind text (like screenshot); turn off for text-only over image"
    },
    {
      "type": "color",
      "id": "box_bg",
      "label": "Content box background",
      "default": "#A0826D"
    },
    {
      "type": "range",
      "id": "box_padding",
      "label": "Content box padding",
      "min": 1.5,
      "max": 5,
      "step": 0.5,
      "unit": "rem",
      "default": 3
    },
    {
      "type": "range",
      "id": "box_radius",
      "label": "Content box corner radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "image_picker",
      "id": "box_background_image",
      "label": "Content box background image",
      "info": "Optional bean-shaped or decorative image behind content"
    },
    {
      "type": "select",
      "id": "content_text_align",
      "label": "Content text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "mobile_stack",
      "label": "Stack content below image on mobile",
      "default": true
    },
    {
      "type": "range",
      "id": "mobile_aspect_ratio",
      "label": "Mobile image aspect ratio (%)",
      "min": 40,
      "max": 100,
      "step": 5,
      "default": 60
    },
    {
      "type": "color",
      "id": "mobile_box_bg",
      "label": "Mobile content area background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "placeholder_bg",
      "label": "Placeholder background (no image)",
      "default": "#f5f0eb"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size (desktop)",
      "min": 24,
      "max": 56,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size (mobile)",
      "min": 20,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "heading_letter_spacing",
      "label": "Heading letter spacing",
      "min": 0,
      "max": 6,
      "step": 1,
      "unit": "px",
      "default": 3
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "label": "Spacing below heading",
      "min": 8,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size (desktop)",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "text_size_mobile",
      "label": "Text size (mobile)",
      "min": 14,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "text_spacing",
      "label": "Spacing between text lines",
      "min": 4,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "button_spacing",
      "label": "Spacing above button",
      "min": 12,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button background",
      "default": "#5C402F"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_hover_bg",
      "label": "Button hover background",
      "default": "#B99135"
    },
    {
      "type": "color",
      "id": "button_hover_text",
      "label": "Button hover text",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Button style"
    },
    {
      "type": "range",
      "id": "button_font_size",
      "label": "Button font size",
      "min": 14,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "button_padding_y",
      "label": "Button padding (vertical)",
      "min": 10,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "button_padding_x",
      "label": "Button padding (horizontal)",
      "min": 20,
      "max": 56,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "Button border radius",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Full width banner",
      "settings": {
        "heading": "CEREMONIAL CACAO",
