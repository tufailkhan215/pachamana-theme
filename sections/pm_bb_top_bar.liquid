{%- comment -%} Pacha Mana - Bundle page: Top bar. Converted from build-your-bundle.html; every visible string, image and link is a setting. {%- endcomment -%}
{{ 'pm_landing.css' | asset_url | stylesheet_tag }}
<div class="pm-landing" style="background:var(--pm-cacao-500);color:var(--text-on-dark);font-family:var(--font-display);text-transform:uppercase;letter-spacing:0.12em;font-size:13px;text-align:center;padding:10px 20px;line-height:1.5;text-wrap:balance;">{{ section.settings.text | escape }}</div>

{% schema %}
{
  "name": "Bundle: Top bar",
  "tag": "div",
  "class": "pm-landing-section",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text"
    }
  ],
  "presets": [
    {
      "name": "Bundle: Top bar"
    }
  ]
}
{% endschema %}
