{%- comment -%} Pacha Mana - Start page: Final call. Converted from start-here.html; every visible string, image and link is a setting. {%- endcomment -%}
{{ 'pm_landing.css' | asset_url | stylesheet_tag }}
<section class="pm-landing" style="background:var(--pm-tan-100);padding:clamp(64px,8vw,112px) 20px clamp(64px,8vw,112px);">
<div style="max-width:680px;margin:0 auto;display:flex;flex-direction:column;gap:22px;align-items:center;text-align:center;">
<img alt="{{ section.settings.image_alt_text | escape }}" src="{%- if section.settings.image != blank -%}{{ section.settings.image | image_url: width: 1600 }}{%- else -%}{{ section.settings.image_url | escape }}{%- endif -%}" style="width:72px;height:72px;object-fit:contain;min-height:72px;max-height:72px;"/>
<span class="pm-eyebrow pm-eyebrow--gold">{{ section.settings.eyebrow | escape }}</span>
<h2 style="font-family:var(--font-display);text-transform:uppercase;font-weight:400;letter-spacing:var(--tracking-display);font-size:clamp(32px,4.6vw,56px);line-height:1.05;color:var(--text-strong);margin:0;text-wrap:balance;">{{ section.settings.heading | escape }}</h2>
<p style="margin:0;font-size:18px;line-height:1.7;text-wrap:pretty;">{{ section.settings.text | escape }}</p>
<a class="pm-btn pm-btn--primary pm-btn--lg" href="{{ section.settings.button_link | escape }}">{{ section.settings.button_label | escape }}</a>
<p style="margin:12px 0 0;padding-top:22px;border-top:1px solid var(--border-medium);font-size:17px;line-height:1.75;font-style:italic;color:var(--text-strong);text-align:left;text-wrap:pretty;">{{ section.settings.text_2 | escape }}</p>
<p style="margin:10px 0 0;font-size:14px;">{{ section.settings.text_3 }}</p>
<p style="margin:0;font-size:12px;line-height:1.6;color:var(--pm-cacao-400);">{{ section.settings.text_4 | escape }}</p>
</div>
</section>

{% schema %}
{
  "name": "Start: Final call",
  "tag": "div",
  "class": "pm-landing-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_url",
      "label": "Image URL",
      "info": "Used when no image is picked above."
    },
    {
      "type": "text",
      "id": "image_alt_text",
      "label": "Image alt text",
      "info": "Leave blank for purely decorative images."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "button_link",
      "label": "Button link",
      "info": "A path like /pages/... or a full https:// address."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "textarea",
      "id": "text_2",
      "label": "Text 2"
    },
    {
      "type": "inline_richtext",
      "id": "text_3",
      "label": "Text 3"
    },
    {
      "type": "textarea",
      "id": "text_4",
      "label": "Text 4"
    }
  ],
  "presets": [
    {
      "name": "Start: Final call"
    }
  ]
}
{% endschema %}
