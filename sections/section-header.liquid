				</div>
				{%- endif -%}
					</div>
				</div>
					</div>
				</div>
				</div>
				</header>
{% schema %}
{
  "name": "Header",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image",
      "info": "Upload your logo. If not set, default logo will be used."
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation menu",
      "default": "main-menu",
      "info": "Select a menu from your navigation settings"
    },
    {
      "type": "checkbox",
      "id": "show_cart_icon",
      "label": "Show cart icon",
      "default": true
    },
    {
      "type": "select",
      "id": "cart_icon_action",
      "label": "Cart icon action",
      "options": [
        { "value": "drawer", "label": "Open cart drawer" },
        { "value": "page", "label": "Go to cart page" }
      ],
      "default": "drawer",
      "info": "If drawer doesn't open, the link will go to the cart page."
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image",
      "info": "If not set, defaults to peruvian_geometric_textile_pattern_3.png"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color (fallback)",
      "default": "#00000000"
    },
    {
      "type": "select",
      "id": "background_size",
      "label": "Background size",
      "default": "cover",
      "options": [
        { "value": "cover", "label": "Cover" },
        { "value": "contain", "label": "Contain" },
        { "value": "auto", "label": "Auto" }
      ]
    },
    {
      "type": "select",
      "id": "background_position",
