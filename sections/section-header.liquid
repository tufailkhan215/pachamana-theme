{%- liquid
  assign header_bg_image_url = blank
  if section.settings.background_image != blank
    assign header_bg_image_url = section.settings.background_image | image_url: width: 2400
  else
    comment
      Fallback to current hardcoded default (theme asset)
    endcomment
    assign header_bg_image_url = 'peruvian_geometric_textile_pattern_3.png' | asset_url
  endif

  assign header_bg_color = section.settings.background_color | default: 'transparent'
  assign header_bg_size = section.settings.background_size | default: 'cover'
  assign header_bg_position = section.settings.background_position | default: 'center center'
  assign header_bg_repeat = section.settings.background_repeat | default: 'no-repeat'
-%}

<style>
  /* Header background (Theme Editor configurable) */
  .section-header .elementor-element[data-id="f74e63a"]:not(.elementor-motion-effects-element-type-background),
  .section-header .elementor-element[data-id="f74e63a"] > .elementor-motion-effects-container > .elementor-motion-effects-layer {
    background-color: {{ header_bg_color }} !important;
    background-image: url("{{ header_bg_image_url }}") !important;
    background-size: {{ header_bg_size }} !important;
    background-position: {{ header_bg_position }} !important;
    background-repeat: {{ header_bg_repeat }} !important;
  }
  /* Nav-squeeze fix: tighten letter-spacing so more menu items fit without overflow.
     Original Elementor value (post-57.css) was 2.4px; this scaled it down for 6+ items. */
  .section-header .plus-navigation-menu .navbar-nav > li > a {
    letter-spacing: 1.4px !important;
  }
  .section-header .plus-navigation-menu .navbar-nav > li {
    padding-right: 10px !important;
  }
  @media (max-width: 1280px) {
    .section-header .plus-navigation-menu .navbar-nav > li > a {
      letter-spacing: 1.0px !important;
    }
    .section-header .plus-navigation-menu .navbar-nav > li {
      padding-right: 7px !important;
    }
  }
</style>

<header data-elementor-type="header" data-elementor-id="57" class="elementor elementor-57 elementor-location-header section-header">
			<div class="elementor-element elementor-element-f74e63a e-con-full e-flex e-con e-parent" data-id="f74e63a" data-element_type="container" data-settings="{&quot;background_background&quot;:&quot;classic&quot;,&quot;sticky&quot;:&quot;top&quot;,&quot;sticky_on&quot;:[&quot;desktop&quot;,&quot;tablet&quot;,&quot;mobile_extra&quot;,&quot;mobile&quot;],&quot;sticky_offset&quot;:0,&quot;sticky_effects_offset&quot;:0,&quot;sticky_anchor_link_offset&quot;:0}">
		<div class="elementor-element elementor-element-5d815ed e-flex e-con-boxed e-con e-child" data-id="5d815ed" data-element_type="container">
					<div class="e-con-inner">
		<div class="elementor-element elementor-element-7613303 e-con-full e-flex e-con e-child" data-id="7613303" data-element_type="container" data-settings="{&quot;background_background&quot;:&quot;classic&quot;}">
				<div class="elementor-element elementor-element-b8c96a2 elementor-invisible elementor-widget elementor-widget-theme-site-logo elementor-widget-image" data-id="b8c96a2" data-element_type="widget" data-settings="{&quot;_animation&quot;:&quot;tada&quot;}" data-widget_type="theme-site-logo.default">
				<div class="elementor-widget-container">
					<a href="{{ routes.root_url }}">
						{%- if section.settings.logo != blank -%}
							<img loading="lazy" 
								 width="{{ section.settings.logo.width }}" 
								 height="{{ section.settings.logo.height }}" 
								 src="{{ section.settings.logo | image_url: width: 196 }}" 
								 alt="{{ section.settings.logo.alt | default: shop.name }}" 
								 class="attachment-full size-full" />
						{%- else -%}
							<img loading="lazy" 
								 width="196" 
								 height="120" 
								 src="{{ "PACHA-MANA-STACKED-LOCKUP.svg" | asset_url }}" 
								 alt="{{ shop.name }}" 
								 class="attachment-full size-full" />
						{%- endif -%}
					</a>
				</div>
				</div>
				</div>
		<div class="elementor-element elementor-element-daad110 e-flex e-con-boxed e-con e-child" data-id="daad110" data-element_type="container" data-settings="{&quot;background_background&quot;:&quot;classic&quot;}">
					<div class="e-con-inner">
				<div class="elementor-element elementor-element-c185d14 elementor-widget elementor-widget-tp-navigation-menu-lite" data-id="c185d14" data-element_type="widget" data-widget_type="tp-navigation-menu-lite.default">
				<div class="elementor-widget-container">
					
		<div class="plus-navigation-wrap text-left nav-menu6943cf4a1aa93">
			<div class="plus-navigation-inner menu-click main-menu-indicator-none sub-menu-indicator-none " data-menu_transition="style-1">
				<div id="theplus-navigation-normal-menu" class="collapse navbar-collapse navbar-ex1-collapse">
	
					<div class="plus-navigation-menu menu-horizontal">
						<div class="plus-navigation-menu menu-horizontal">
							{%- if section.settings.menu != blank -%}
								{% render 'menu', menu: section.settings.menu %}
							{%- else -%}
								<ul id="menu-main" class="nav navbar-nav yamm menu-hover-none">
									<li class="menu-item"><a href="{{ routes.collections_url }}" data-text="Shop">Shop</a></li>
									<li class="menu-item"><a href="{{ routes.root_url }}" data-text="Home">Home</a></li>
								</ul>
							{%- endif -%}
						</div>
					</div>
				</div>

					<div class="plus-mobile-nav-toggle navbar-header mobile-toggle">
						<div class="mobile-plus-toggle-menu plus-collapsed toggle-style-1" data-target="#plus-mobile-nav-toggle-nav-menu6943cf4a1aa93">
														<ul class="toggle-lines">
								<li class="toggle-line"></li>
								<li class="toggle-line"></li>
							</ul>
													</div>
					</div>
				
					<div id="plus-mobile-nav-toggle-nav-menu6943cf4a1aa93"
						class="plus-mobile-menu collapse navbar-collapse navbar-ex1-collapse plus-mobile-menu-content ">
						<div class="plus-mobile-menu">
							{%- if section.settings.menu != blank -%}
								{% render 'menu', menu: section.settings.menu %}
							{%- else -%}
								<ul id="menu-main-1" class="nav navbar-nav">
									<li class="menu-item"><a href="{{ routes.collections_url }}" data-text="Shop">Shop</a></li>
									<li class="menu-item"><a href="{{ routes.root_url }}" data-text="Home">Home</a></li>
								</ul>
							{%- endif -%}
						</div>
					</div>
								
			</div>
		</div>
		 
