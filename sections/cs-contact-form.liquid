{% comment %} cs-contact-form.liquid — Pacha Mana Contact Section v2 {% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700;900&family=Cormorant+Garamond:ital,wght@0,300;1,400&family=Nunito+Sans:wght@300;400;600;700&display=swap" rel="stylesheet">


<section id="cs-{{ section.id }}">

  <div class="csc-bg">
    {%- if section.settings.bg_image != blank -%}
      <img src="{{ section.settings.bg_image | img_url: '1400x' }}" alt="" loading="lazy" aria-hidden="true">
    {%- endif -%}
  </div>

  <div class="csc-card">

    {%- if section.settings.logo != blank -%}
      <div class="csc-logo">
        <img
          src="{{ section.settings.logo | img_url: '300x' }}"
          alt="{{ shop.name }}"
          loading="lazy"
          height="{{ section.settings.logo_height | default: 68 }}"
        >
      </div>
    {%- endif -%}

    <h1 class="csc-heading">{{ section.settings.heading | default: 'Contact Us' }}</h1>

    <div class="csc-rule" aria-hidden="true">
      <span></span>
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <circle cx="12" cy="12" r="3" fill="currentColor"/>
        <circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.2"/>
      </svg>
      <span></span>
    </div>

    {%- if section.settings.subtext != blank or section.settings.contact_email != blank -%}
      <p class="csc-sub">
        {{ section.settings.subtext | default: 'Fill out the form below, and we will be in touch shortly or,' }}
        {%- if section.settings.contact_email != blank -%}
          <br>Email us directly at&nbsp;<a href="mailto:{{ section.settings.contact_email }}">{{ section.settings.contact_email }}</a>&nbsp;for urgent questions
        {%- endif -%}
      </p>
    {%- endif -%}

    <div class="csc-divider"></div>

    {%- form 'contact', id: 'csc-form-{{ section.id }}', class: 'csc-form' -%}

      <div class="csc-field">
        <label class="csc-label" for="csc-name-{{ section.id }}">Name</label>
        <input id="csc-name-{{ section.id }}" class="csc-input" type="text" name="contact[name]" placeholder="Your full name" autocomplete="name" required>
      </div>

      <div class="csc-field">
        <label class="csc-label" for="csc-email-{{ section.id }}">Email</label>
        <input id="csc-email-{{ section.id }}" class="csc-input" type="email" name="contact[email]" placeholder="your@email.com" autocomplete="email" required>
      </div>

      <div class="csc-field">
        <label class="csc-label" for="csc-msg-{{ section.id }}">Message</label>
        <textarea id="csc-msg-{{ section.id }}" class="csc-textarea" name="contact[body]" placeholder="How can we help you?" required></textarea>
      </div>

      {%- if form.posted_successfully? -%}
        <div class="csc-msg csc-msg--ok" role="alert">✓ Thank you! We'll be in touch shortly.</div>
      {%- elsif form.errors -%}
        <div class="csc-msg csc-msg--err" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}

      <button type="submit" class="csc-btn">{{ section.settings.button_label | default: 'Send Message' }}</button>

    {%- endform -%}

  </div>
</section>

<script>
(function () {
  var card = document.querySelector('#cs-{{ section.id }} .csc-card');
  if (!card) return;
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) { card.classList.add('rv'); return; }
  var obs = new IntersectionObserver(function (e) {
    e.forEach(function (x) { if (x.isIntersecting) { x.target.classList.add('rv'); obs.unobserve(x.target); } });
  }, { threshold: 0.1 });
  obs.observe(card);
})();
</script>

{% schema %}
{
  "name": "Contact Form",
  "tag": "div",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "image_picker", "id": "logo", "label": "Logo image" },
    { "type": "range", "id": "logo_height", "label": "Logo height (px)", "min": 40, "max": 120, "step": 4, "default": 68, "unit": "px" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Contact Us" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Fill out the form below, and we will be in touch shortly or," },
    { "type": "text", "id": "contact_email", "label": "Contact email", "default": "support@pachamana.com" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Send Message" },
    { "type": "header", "content": "Background" },
    { "type": "image_picker", "id": "bg_image", "label": "Background image" },
    { "type": "color", "id": "color_page_bg", "label": "Page background fallback", "default": "#7A5230" }
  ],
  "presets": [{ "name": "Contact Form" }]
}
{% endschema %}
