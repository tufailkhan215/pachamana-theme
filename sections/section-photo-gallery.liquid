<style>
  /* Photo gallery: horizontal carousel on ALL screen sizes */
  .section-photo-gallery #pt-plus-gallery-list {
    overflow: hidden;
  }
  .section-photo-gallery .gallery-list .tp-row.post-inner-loop {
    display: flex !important;
    flex-wrap: nowrap !important;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    gap: 16px;
    margin: 0 !important;
    padding: 8px 4px 20px !important;
    scrollbar-width: none;
  }
  .section-photo-gallery .gallery-list .tp-row.post-inner-loop::-webkit-scrollbar {
    display: none;
  }
  /* Desktop: show ~3 images at a time */
  .section-photo-gallery .gallery-list .tp-row.post-inner-loop .grid-item {
    flex: 0 0 auto !important;
    width: 30vw !important;
    max-width: 400px !important;
    min-width: 260px !important;
    min-height: 300px !important;
    height: 300px !important;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    float: none !important;
    position: relative !important;
    left: auto !important;
    top: auto !important;
  }
  .section-photo-gallery .gallery-list.list-isotope-metro .post-inner-loop .grid-item .gallery-list-content,
  .section-photo-gallery .gallery-list.list-isotope-metro .post-inner-loop .grid-item .gallery-bg-image-metro {
    min-height: 300px !important;
    height: 300px !important;
  }
  /* Mobile: show ~1 image at a time */
  @media (max-width: 768px) {
    .section-photo-gallery .gallery-list .tp-row.post-inner-loop .grid-item {
      width: 82vw !important;
      max-width: 320px !important;
      min-height: 220px !important;
      height: 220px !important;
    }
    .section-photo-gallery .gallery-list.list-isotope-metro .post-inner-loop .grid-item .gallery-list-content,
    .section-photo-gallery .gallery-list.list-isotope-metro .post-inner-loop .grid-item .gallery-bg-image-metro {
      min-height: 220px !important;
      height: 220px !important;
    }
  }
</style>
<script>
  /* Disable Isotope masonry on photo gallery — we use CSS carousel instead */
  document.addEventListener('DOMContentLoaded', function() {
    var galleryEl = document.querySelector('.section-photo-gallery #pt-plus-gallery-list');
    if (galleryEl) {
      galleryEl.removeAttribute('data-enable-isotope');
      galleryEl.setAttribute('data-enable-isotope', '0');
    }
  });
</script>
