{%- comment -%} Pacha Mana - Bundle page: Hero. Converted from build-your-bundle.html; every visible string, image and link is a setting. {%- endcomment -%}
{{ 'pm_landing.css' | asset_url | stylesheet_tag }}
<section class="pm-landing" style="position:relative;overflow:hidden;background:var(--gradient-sunrise);padding:clamp(48px,7vw,96px) 24px;">
<div style="position:absolute;inset:0;background-image:url('https://pachamana.com/cdn/shop/files/Pattern_Website.png?v=1769670221&amp;width=1200');background-size:520px auto;opacity:.05;pointer-events:none;"></div>
<div style="position:relative;max-width:1140px;margin:0 auto;display:flex;flex-wrap:wrap;gap:clamp(32px,5vw,64px);align-items:center;">
<div style="flex:1 1 440px;min-width:0;display:flex;flex-direction:column;gap:24px;">
<span class="pm-eyebrow pm-eyebrow--gold"><span class="pm-eyebrow-rule"></span>{{ section.settings.eyebrow | escape }}</span>
<h1 style="font-family:var(--font-display);text-transform:uppercase;font-weight:400;letter-spacing:var(--tracking-display);font-size:clamp(40px,6vw,68px);line-height:1.02;color:var(--text-strong);margin:0;text-wrap:balance;">{{ section.settings.heading | escape }}</h1>
<p style="font-size:clamp(17px,1.6vw,20px);line-height:1.65;margin:0;max-width:56ch;color:var(--text-body);text-wrap:pretty;">{{ section.settings.text | escape }}</p>
<ol style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:12px;">
{%- for block in section.blocks -%}{%- if block.type == 'item' -%}<li {{ block.shopify_attributes }} style="display:flex;gap:16px;align-items:baseline;"><span style="font-family:var(--font-display);color:var(--pm-gold-600);font-size:20px;letter-spacing:0.06em;min-width:30px;">{{ block.settings.label | escape }}</span><span style="font-size:17px;color:var(--text-strong);">{{ block.settings.label_2 | escape }}</span></li>{%- endif -%}{%- endfor -%}


</ol>
<div style="display:flex;flex-wrap:wrap;align-items:center;gap:20px;">
<a class="pm-btn pm-btn--primary pm-btn--lg" href="{{ section.settings.button_link | escape }}">{{ section.settings.button_label | escape }}</a>
<span style="font-size:15px;color:var(--text-strong);display:flex;gap:8px;align-items:center;">{{ section.settings.label }}</span>
</div>
</div>
<div style="flex:1 1 380px;min-width:0;position:relative;padding:0 0 24px 24px;">
<div style="height:clamp(340px,42vw,520px);border-radius:28px;overflow:hidden;box-shadow:var(--shadow-lg);background:var(--pm-tan-200);">
<img alt="{{ section.settings.image_alt_text | escape }}" src="{%- if section.settings.image != blank -%}{{ section.settings.image | image_url: width: 1400 }}{%- else -%}{{ section.settings.image_url | escape }}{%- endif -%}" style="width:100%;height:100%;object-fit:cover;display:block;min-height:100%;max-height:100%;"/>
</div>
<img alt="{{ section.settings.image_alt_text_2 | escape }}" src="{%- if section.settings.image_2 != blank -%}{{ section.settings.image_2 | image_url: width: 1600 }}{%- else -%}{{ section.settings.image_url_2 | escape }}{%- endif -%}" style="position:absolute;left:-6px;bottom:0;width:clamp(130px,17vw,210px);height:auto;filter:drop-shadow(0 6px 12px rgba(92,64,47,.18));pointer-events:none;"/>
</div>
</div>
</section>

{% schema %}
{
  "name": "Bundle: Hero",
  "tag": "div",
  "class": "pm-landing-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "button_link",
      "label": "Button link",
      "info": "A path like /pages/... or a full https:// address."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "html",
      "id": "label",
      "label": "Label",
      "info": "Keeps the design's inline styling. Edit the words, leave the tags."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_url",
      "label": "Image URL",
      "info": "Used when no image is picked above."
    },
    {
      "type": "text",
      "id": "image_alt_text",
      "label": "Image alt text",
      "info": "Leave blank for purely decorative images."
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image 2"
    },
    {
      "type": "text",
      "id": "image_url_2",
      "label": "Image URL 2",
      "info": "Used when no image is picked above."
    },
    {
      "type": "text",
      "id": "image_alt_text_2",
      "label": "Image alt text 2",
      "info": "Leave blank for purely decorative images."
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "text",
          "id": "label_2",
          "label": "Label 2"
        }
      ]
    }
  ],
  "max_blocks": 50,
  "presets": [
    {
      "name": "Bundle: Hero"
    }
  ]
}
{% endschema %}
