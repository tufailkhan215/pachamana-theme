<section class="pmw pmw-stockist-map" id="pmw-stockist-map-{{ section.id }}">
  {% render 'bulk-bg', section: section %}

  <div class="pmw-stockist-map__inner">
    <div class="pmw-stockist-map__head">
      {% if section.settings.eyebrow != blank %}
        <div class="pmw-stockist-map__eyebrow">{{ section.settings.eyebrow }}</div>
      {% endif %}

      {% if section.settings.headline != blank %}
        <h2 class="pmw-stockist-map__title">{{ section.settings.headline }}</h2>
      {% endif %}

      {% if section.settings.subhead != blank %}
        <p class="pmw-stockist-map__sub">{{ section.settings.subhead }}</p>
      {% endif %}
    </div>

    <div class="pmw-stockist-map__layout">
      <div class="pmw-stockist-map__map-card">
        <div class="pmw-stockist-map__map" data-stockist-map>
          {% if section.settings.map_image != blank %}
            <img
              class="pmw-stockist-map__map-img"
              src="{{ section.settings.map_image | image_url: width: 1800 }}"
              srcset="
                {{ section.settings.map_image | image_url: width: 700 }} 700w,
                {{ section.settings.map_image | image_url: width: 1100 }} 1100w,
                {{ section.settings.map_image | image_url: width: 1500 }} 1500w,
                {{ section.settings.map_image | image_url: width: 1800 }} 1800w
              "
              sizes="(max-width: 900px) 100vw, 650px"
              alt="{{ section.settings.map_alt | escape }}"
              loading="lazy"
              width="{{ section.settings.map_image.width }}"
              height="{{ section.settings.map_image.height }}"
            >
          {% else %}
            <div class="pmw-stockist-map__map-bg" aria-hidden="true">
              <svg class="pmw-stockist-map__sun" viewBox="0 0 220 120" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M110 120C110 59.2 159.2 10 220 10" stroke="rgba(226,171,67,.20)" stroke-width="12" stroke-linecap="round"/>
                <path d="M110 120C110 75.8 145.8 40 190 40" stroke="rgba(226,171,67,.20)" stroke-width="12" stroke-linecap="round"/>
                <path d="M110 120C110 92.4 132.4 70 160 70" stroke="rgba(226,171,67,.20)" stroke-width="12" stroke-linecap="round"/>
                <path d="M110 120C110 103.4 123.4 90 140 90" stroke="rgba(226,171,67,.20)" stroke-width="12" stroke-linecap="round"/>
                <path d="M110 120L110 18" stroke="rgba(226,171,67,.20)" stroke-width="12" stroke-linecap="round"/>
                <path d="M110 120L72 28" stroke="rgba(226,171,67,.20)" stroke-width="12" stroke-linecap="round"/>
                <path d="M110 120L38 52" stroke="rgba(226,171,67,.20)" stroke-width="12" stroke-linecap="round"/>
                <path d="M110 120L10 92" stroke="rgba(226,171,67,.20)" stroke-width="12" stroke-linecap="round"/>
              </svg>
            </div>
          {% endif %}

          {%- assign location_blocks = section.blocks | where: 'type', 'location' -%}

          {% for block in location_blocks %}
            {% assign pin_title = block.settings.name | default: 'Stockist' %}
            {% assign pin_region = block.settings.region | default: 'Stockist' %}

            <button
              type="button"
              class="pmw-stockist-map__pin"
              style="left: {{ block.settings.pin_x }}%; top: {{ block.settings.pin_y }}%;"
              data-stockist-pin
              data-location-id="stockist-{{ section.id }}-{{ block.id }}"
              data-region="{{ pin_region | escape }}"
              aria-label="Open {{ pin_title | escape }}"
              {{ block.shopify_attributes }}
            >
              <span class="pmw-stockist-map__pin-ring"></span>
              <span class="pmw-stockist-map__pin-dot"></span>
            </button>

            <div
              class="pmw-stockist-map__popup"
              id="stockist-{{ section.id }}-{{ block.id }}"
              data-stockist-popup
              data-region="{{ pin_region | escape }}"
              style="left: {{ block.settings.pin_x }}%; top: {{ block.settings.pin_y }}%;"
              hidden
            >
              <button type="button" class="pmw-stockist-map__popup-close" data-stockist-close aria-label="Close popup">
                ×
              </button>

              {% if block.settings.region != blank %}
                <div class="pmw-stockist-map__popup-region">{{ block.settings.region }}</div>
              {% endif %}

              <h3 class="pmw-stockist-map__popup-title">{{ pin_title }}</h3>

              {% if block.settings.city_state != blank %}
                <p class="pmw-stockist-map__popup-city">{{ block.settings.city_state }}</p>
              {% endif %}

              {% if block.settings.address != blank %}
                <p class="pmw-stockist-map__popup-address">{{ block.settings.address }}</p>
              {% endif %}

              {% if block.settings.description != blank %}
                <p class="pmw-stockist-map__popup-desc">{{ block.settings.description }}</p>
              {% endif %}

              <div class="pmw-stockist-map__popup-links">
                {% if block.settings.website_url != blank %}
                  <a href="{{ block.settings.website_url }}" target="_blank" rel="noopener">
                    Visit
                  </a>
                {% endif %}

                {% if block.settings.map_url != blank %}
                  <a href="{{ block.settings.map_url }}" target="_blank" rel="noopener">
                    Directions
                  </a>
                {% endif %}

                {% if block.settings.phone != blank %}
                  <a href="tel:{{ block.settings.phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' }}">
                    Call
                  </a>
                {% endif %}
              </div>
            </div>
          {% endfor %}

          {% if section.settings.map_label != blank %}
            <div class="pmw-stockist-map__map-label">
              {{ section.settings.map_label }}
            </div>
          {% endif %}
        </div>
      </div>

      <div class="pmw-stockist-map__side-card">
        {%- assign region_blocks = section.blocks | where: 'type', 'region' -%}

        {% if region_blocks.size > 0 %}
          <div class="pmw-stockist-map__regions">
            {% for block in region_blocks %}
              <button
                type="button"
                class="pmw-stockist-map__region"
                data-stockist-region
                data-region="{{ block.settings.region_name | escape }}"
                {{ block.shopify_attributes }}
              >
                <span class="pmw-stockist-map__region-name">{{ block.settings.region_name }}</span>
                <span class="pmw-stockist-map__region-count">{{ block.settings.partner_count }}</span>
              </button>
            {% endfor %}
          </div>
        {% else %}
          <div class="pmw-stockist-map__empty">
            Add region blocks to show partner counts here.
          </div>
        {% endif %}

        {% if section.settings.show_location_list %}
          <div class="pmw-stockist-map__locations-list">
            {% for block in location_blocks %}
              <button
                type="button"
                class="pmw-stockist-map__location-link"
                data-stockist-list-item
                data-location-id="stockist-{{ section.id }}-{{ block.id }}"
              >
                <span>{{ block.settings.name }}</span>
                {% if block.settings.city_state != blank %}
                  <em>{{ block.settings.city_state }}</em>
                {% endif %}
              </button>
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </div>

    {% if section.settings.bottom_copy != blank or section.settings.cta_label != blank %}
      <div class="pmw-stockist-map__footer">
        {% if section.settings.bottom_copy != blank %}
          <p>{{ section.settings.bottom_copy }}</p>
        {% endif %}

        {% if section.settings.cta_label != blank %}
          <a class="pmw-stockist-map__cta" href="{{ section.settings.cta_link | default: '/pages/store-locator' }}">
            {{ section.settings.cta_label }}
          </a>
        {% endif %}
      </div>
    {% endif %}
  </div>
</section>

<style>
  #pmw-stockist-map-{{ section.id }}.pmw-stockist-map {
    position: relative;
    overflow: hidden;
    padding: 0;
    background: #f9f2ef;
  }

  #pmw-stockist-map-{{ section.id }} .pmw-stockist-map__inner {
    position: relative;
    z-index: 2;
    max-width: 1180px;
    margin: 0 auto;
    padding: 96px 20px 88px;
  }

  #pmw-stockist-map-{{ section.id }} .pmw-stockist-map__head {
    margin-bottom: 48px;
  }

  #pmw-stockist-map-{{ section.id }} .pmw-stockist-map__eyebrow {
    display: block;
    margin-bottom: 14px;
    font-family: var(--font-display, Georgia, serif);
    font-size: 13px;
    line-height: 1;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--pm-gold-600, #ab7820);
    font-weight: 900;
  }

  #pmw-stockist-map-{{ section.id }} .pmw-stockist-map__title {
    margin: 0;
    max-width: 860px;
    font-family: var(--font-display, Georgia, serif);
    font-size: clamp(42px, 4.6vw, 62px);
    line-height: 0.98;
    letter-spacing: 0.055em;
    text-transform: uppercase;
    color: var(--page-text, #2b2521);
    font-weight: 900;
  }

  #pmw-stockist-map-{{ section.id }} .pmw-stockist-map__sub {
    max-width: 670px;
    margin: 18px 0 0;
    font-size: 17px;
    line-height: 1.7;
    color: var(--page-muted, #6e5a4c);
  }

  #pmw-stockist-map-{{ section.id }} .pmw-stockist-map__layout {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(320px, 0.9fr);
    gap: 34px;
    align-items: stretch;
  }

  #pmw-stockist-map-{{ section.id }} .pmw-stockist-map__map-card,
  #pmw-stockist-map-{{ section.id }} .pmw-stockist-map__side-card {
    border-radius: 20px;
  }

  #pmw-stockist-map-{{ section.id }} .pmw-stockist-map__map {
    position: relative;
    min-height: 380px;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--card-border, #ece0d3);
    border-radius: 20px;
    background:
      radial-gradient(circle at 32% 40%, rgba(255,255,255,.32), transparent 18%),
      linear-gradient(180deg, #fff5d9 0%, #f6d697 100%);
    box-shadow: 0 14px 34px rgba(56, 39, 29, 0.12);
  }

  #pmw-stockist-map-{{ section.id }} .pmw-stockist-map__map-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #pmw-stockist-map-{{ section.id }} .pmw-stockist-map__map-bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  #pmw-stockist-map-{{ section.id }} .pmw-stockist-map__sun {
    position: absolute;
    right: -4px;
    bottom: -4px;
    width: 230px;
    height: auto;
  }

  #pmw-stockist-map-{{ section.id }} .pmw-stockist-map__pin {
    position: absolute;
    z-index: 4;
    width: 28px;
    height: 28px;
    padding: 0;
    border: 0;
    background: transparent;
    transform: translate(-50%, -50%);
    cursor: pointer;
  }

  #pmw-stockist-map-{{ section.id }} .pmw-stockist-map__pin-ring {
    position: absolute;
    inset: 0;
    border-radius: 999px;
    background: rgba(226, 171, 67, 0.22);
    transform: scale(1);
    transition: transform 180ms ease, background 180ms ease;
  }

  #pmw-stockist-map-{{ section.id }} .pmw-stockist-map__pin-dot {
    position: absolute;
    inset: 7px;
    border-radius: 999px;
    background: var(--pm-sunshine-gold, #e2ab43);
    box-shadow: 0 5px 14px rgba(92, 64, 47, 0.22);
  }

  #pmw-stockist-map-{{ section.id }} .pmw-stockist-map__pin:hover .pmw-stockist-map__pin-ring,
  #pmw-stockist-map-{{ section.id }} .pmw-stockist-map__pin.is-active .pmw-stockist-map__pin-ring {
    transform: scale(1.25);
    background: rgba(226, 171, 67, 0.36);
  }

  #pmw-stockist-map-{{ section.id }} .pmw-stockist-map__pin.is-muted {
    opacity: 0.22;
  }

  #pmw-stockist-map-{{ section.id }} .pmw-stockist-map__popup {
    position: absolute;
    z-index: 8;
    width: min(280px, calc(100% - 28px));
    padding: 20px 20px 18px;
    border: 1px solid var(--card-border, #ece0d3);
    border-radius: 18px;
    background: #ffffff;
    box-shadow: 0 16px 36px rgba(56, 39, 29, 0.18);
    transform: translate(-50%, calc(-100% - 22px));
  }

  #pmw-stockist-map-{{ section.id }} .pmw-stockist-map__popup::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -9px;
    width: 18px;
    height: 18px;
    background: #ffffff;
    border-right: 1px solid var(--card-border, #ece0d3);
    border-bottom: 1px solid var(--card-border, #ece0d3);
    transform: translateX(-50%) rotate(45deg);
  }

  #pmw-stockist-map-{{ section.id }} .pmw-stockist-map__popup-close {
    position: absolute;
    top: 10px;
    right: 12px;
    width: 26px;
    height: 26px;
    border: 0;
    border-radius: 999px;
    background: #f9f2ef;
    color: var(--page-text, #2b2521);
    font-size: 20px;
    line-height: 1;
    cursor: pointer;
  }

  #pmw-stockist-map-{{ section.id }} .pmw-stockist-map__popup-region {
    margin: 0 32px 8px 0;
    font-family: var(--font-display, Georgia, serif);
    font-size: 10px;
    line-height: 1;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--pm-gold-600, #ab7820);
    font-weight: 900;
  }

  #pmw-stockist-map-{{ section.id }} .pmw-stockist-map__popup-title {
    margin: 0;
    padding-right: 20px;
    font-family: var(--font-display, Georgia, serif);
    font-size: 22px;
    line-height: 1.05;
    letter-spacing: 0.045em;
    text-transform: uppercase;
    color: var(--page-text, #2b2521);
    font-weight: 900;
  }

  #pmw-stockist-map-{{ section.id }} .pmw-stockist-map__popup-city {
    margin: 10px 0 0;
    font-size: 15px;
    line-height: 1.45;
    color: var(--pm-cacao-700, #38271d);
    font-weight: 700;
  }

  #pmw-stockist-map-{{ section.id }} .pmw-stockist-map__popup-address,
  #pmw-stockist-map-{{ section.id }} .pmw-stockist-map__popup-desc {
    margin: 7px 0 0;
    font-size: 14px;
    line-height: 1.55;
    color: var(--page-muted, #6e5a4c);
  }

  #pmw-stockist-map-{{ section.id }} .pmw-stockist-map__popup-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 14px;
  }

  #pmw-stockist-map-{{ section.id }} .pmw-stockist-map__popup-links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 32px;
    padding: 9px 13px 8px;
    border-radius: 999px;
    background: var(--pm-sunshine-gold, #e2ab43);
    color: var(--page-text, #2b2521);
    font-family: var(--font-display, Georgia, serif);
    font-size: 10px;
    line-height: 1;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 900;
    text-decoration: none;
  }

  #pmw-stockist-map-{{ section.id }} .pmw-stockist-map__popup-links a:hover {
    background: #cf962f;
    color: #ffffff;
    text-decoration: none;
  }

  #pmw-stockist-map-{{ section.id }} .pmw-stockist-map__map-label {
    position: absolute;
    left: 26px;
    bottom: 26px;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    max-width: calc(100% - 52px);
    min-height: 38px;
    padding: 10px 18px 9px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.74);
    color: var(--pm-cacao-700, #38271d);
    font-family: var(--font-display, Georgia, serif);
    font-size: 11px;
    line-height: 1.1;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 900;
    backdrop-filter: blur(8px);
  }

  #pmw-stockist-map-{{ section.id }} .pmw-stockist-map__side-card {
    min-height: 380px;
    padding: 30px 34px;
    background: #ffffff;
    border: 1px solid var(--card-border, #ece0d3);
    box-shadow: 0 14px 34px rgba(56, 39, 29, 0.12);
  }

  #pmw-stockist-map-{{ section.id }} .pmw-stockist-map__regions {
    display: grid;
  }

  #pmw-stockist-map-{{ section.id }} .pmw-stockist-map__region {
    appearance: none;
    -webkit-appearance: none;
    width: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 18px;
    align-items: center;
    padding: 22px 0;
    border: 0;
    border-bottom: 1px solid var(--card-border, #ece0d3);
    background: transparent;
    text-align: left;
    cursor: pointer;
  }

  #pmw-stockist-map-{{ section.id }} .pmw-stockist-map__region:first-child {
    padding-top: 0;
  }

  #pmw-stockist-map-{{ section.id }} .pmw-stockist-map__region.is-active .pmw-stockist-map__region-name,
  #pmw-stockist-map-{{ section.id }} .pmw-stockist-map__region:hover .pmw-stockist-map__region-name {
    color: var(--pm-gold-600, #ab7820);
  }

  #pmw-stockist-map-{{ section.id }} .pmw-stockist-map__region-name {
    font-family: var(--font-display, Georgia, serif);
    font-size: 20px;
    line-height: 1.1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--page-text, #2b2521);
    font-weight: 900;
    transition: color 180ms ease;
  }

  #pmw-stockist-map-{{ section.id }} .pmw-stockist-map__region-count {
    font-size: 16px;
    line-height: 1.2;
    color: var(--pm-cacao-700, #5c402f);
    white-space: nowrap;
  }

  #pmw-stockist-map-{{ section.id }} .pmw-stockist-map__locations-list {
    display: grid;
    gap: 8px;
    margin-top: 24px;
    padding-top: 24px;
  }

  #pmw-stockist-map-{{ section.id }} .pmw-stockist-map__location-link {
    appearance: none;
    -webkit-appearance: none;
    display: grid;
    gap: 4px;
    padding: 13px 14px;
    border: 1px solid var(--card-border, #ece0d3);
    border-radius: 14px;
    background: #fdf8f3;
    text-align: left;
    cursor: pointer;
  }

  #pmw-stockist-map-{{ section.id }} .pmw-stockist-map__location-link span {
    font-family: var(--font-display, Georgia, serif);
    font-size: 13px;
    line-height: 1.2;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--page-text, #2b2521);
    font-weight: 900;
  }

  #pmw-stockist-map-{{ section.id }} .pmw-stockist-map__location-link em {
    font-size: 13px;
    line-height: 1.3;
    color: var(--page-muted, #6e5a4c);
    font-style: normal;
  }

  #pmw-stockist-map-{{ section.id }} .pmw-stockist-map__location-link:hover {
    border-color: var(--pm-sunshine-gold, #e2ab43);
  }

  #pmw-stockist-map-{{ section.id }} .pmw-stockist-map__empty {
    color: var(--page-muted, #6e5a4c);
    font-size: 15px;
    line-height: 1.6;
  }

  #pmw-stockist-map-{{ section.id }} .pmw-stockist-map__footer {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 28px;
    margin-top: 34px;
  }

  #pmw-stockist-map-{{ section.id }} .pmw-stockist-map__footer p {
    max-width: 640px;
    margin: 0;
    font-size: 16px;
    line-height: 1.65;
    color: var(--page-muted, #6e5a4c);
  }

  #pmw-stockist-map-{{ section.id }} .pmw-stockist-map__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: 16px 32px 15px;
    border-radius: 999px;
    background: var(--pm-sunshine-gold, #e2ab43);
    color: var(--page-text, #2b2521);
    font-family: var(--font-display, Georgia, serif);
    font-size: 12px;
    line-height: 1;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 900;
    text-decoration: none;
    box-shadow: 0 12px 24px rgba(226, 171, 67, 0.22);
    white-space: nowrap;
  }

  #pmw-stockist-map-{{ section.id }} .pmw-stockist-map__cta:hover {
    background: #cf962f;
    color: #ffffff;
    text-decoration: none;
  }

  @media (max-width: 980px) {
    #pmw-stockist-map-{{ section.id }} .pmw-stockist-map__layout {
      grid-template-columns: 1fr;
    }

    #pmw-stockist-map-{{ section.id }} .pmw-stockist-map__map {
      min-height: 420px;
    }

    #pmw-stockist-map-{{ section.id }} .pmw-stockist-map__side-card {
      min-height: 0;
    }
  }

  @media (max-width: 768px) {
    #pmw-stockist-map-{{ section.id }} .pmw-stockist-map__inner {
      padding: 64px 20px;
    }

    #pmw-stockist-map-{{ section.id }} .pmw-stockist-map__head {
      margin-bottom: 34px;
    }

    #pmw-stockist-map-{{ section.id }} .pmw-stockist-map__title {
      font-size: clamp(34px, 12vw, 46px);
    }

    #pmw-stockist-map-{{ section.id }} .pmw-stockist-map__map {
      min-height: 380px;
    }

    #pmw-stockist-map-{{ section.id }} .pmw-stockist-map__popup {
      width: min(270px, calc(100% - 24px));
    }

    #pmw-stockist-map-{{ section.id }} .pmw-stockist-map__map-label {
      left: 18px;
      right: 18px;
      bottom: 18px;
      max-width: none;
      justify-content: center;
      text-align: center;
    }

    #pmw-stockist-map-{{ section.id }} .pmw-stockist-map__side-card {
      padding: 26px 24px;
    }

    #pmw-stockist-map-{{ section.id }} .pmw-stockist-map__footer {
      grid-template-columns: 1fr;
    }

    #pmw-stockist-map-{{ section.id }} .pmw-stockist-map__cta {
      width: 100%;
    }
  }

  @media (max-width: 480px) {
    #pmw-stockist-map-{{ section.id }} .pmw-stockist-map__map {
      min-height: 350px;
    }

    #pmw-stockist-map-{{ section.id }} .pmw-stockist-map__popup {
      left: 50% !important;
      top: 50% !important;
      transform: translate(-50%, -50%);
    }

    #pmw-stockist-map-{{ section.id }} .pmw-stockist-map__popup::after {
      display: none;
    }

    #pmw-stockist-map-{{ section.id }} .pmw-stockist-map__region {
      grid-template-columns: 1fr;
      gap: 8px;
    }
  }
</style>

<script>
  (function () {
    var section = document.getElementById('pmw-stockist-map-{{ section.id }}');
    if (!section) return;

    var pins = section.querySelectorAll('[data-stockist-pin]');
    var popups = section.querySelectorAll('[data-stockist-popup]');
    var closeButtons = section.querySelectorAll('[data-stockist-close]');
    var regionButtons = section.querySelectorAll('[data-stockist-region]');
    var listItems = section.querySelectorAll('[data-stockist-list-item]');

    function closePopups() {
      popups.forEach(function (popup) {
        popup.hidden = true;
      });

      pins.forEach(function (pin) {
        pin.classList.remove('is-active');
      });
    }

    function openPopup(id) {
      closePopups();

      var popup = section.querySelector('#' + CSS.escape(id));
      var pin = section.querySelector('[data-location-id="' + id + '"]');

      if (popup) {
        popup.hidden = false;
      }

      if (pin) {
        pin.classList.add('is-active');
      }
    }

    pins.forEach(function (pin) {
      pin.addEventListener('click', function (event) {
        event.preventDefault();
        event.stopPropagation();

        var id = pin.getAttribute('data-location-id');
        var popup = section.querySelector('#' + CSS.escape(id));

        if (popup && !popup.hidden) {
          closePopups();
        } else {
          openPopup(id);
        }
      });
    });

    closeButtons.forEach(function (button) {
      button.addEventListener('click', function (event) {
        event.preventDefault();
        event.stopPropagation();
        closePopups();
      });
    });

    listItems.forEach(function (item) {
      item.addEventListener('click', function () {
        var id = item.getAttribute('data-location-id');
        openPopup(id);

        var map = section.querySelector('[data-stockist-map]');
        if (map && window.innerWidth < 981) {
          map.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      });
    });

    regionButtons.forEach(function (button) {
      button.addEventListener('click', function () {
        var region = button.getAttribute('data-region');
        var alreadyActive = button.classList.contains('is-active');

        regionButtons.forEach(function (btn) {
          btn.classList.remove('is-active');
        });

        pins.forEach(function (pin) {
          pin.classList.remove('is-muted');
        });

        closePopups();

        if (alreadyActive) return;

        button.classList.add('is-active');

        pins.forEach(function (pin) {
          if (pin.getAttribute('data-region') !== region) {
            pin.classList.add('is-muted');
          }
        });

        var firstPin = section.querySelector('[data-stockist-pin][data-region="' + region.replace(/"/g, '\\"') + '"]');
        if (firstPin) {
          openPopup(firstPin.getAttribute('data-location-id'));
        }
      });
    });

    document.addEventListener('click', function (event) {
      if (!section.contains(event.target)) return;

      var clickedPopup = event.target.closest('[data-stockist-popup]');
      var clickedPin = event.target.closest('[data-stockist-pin]');
      var clickedRegion = event.target.closest('[data-stockist-region]');
      var clickedList = event.target.closest('[data-stockist-list-item]');

      if (!clickedPopup && !clickedPin && !clickedRegion && !clickedList) {
        closePopups();
      }
    });

    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape') {
        closePopups();
      }
    });
  })();
</script>

