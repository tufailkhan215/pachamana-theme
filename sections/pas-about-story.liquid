{%- liquid
  assign section_id = 'pas-' | append: section.id
  assign bg_style = section.settings.background_style
  assign show_title = section.settings.show_title
  assign section_title = section.settings.section_title
  assign pad_top = section.settings.padding_top
  assign pad_bottom = section.settings.padding_bottom
  assign bg_url = ''
  if bg_style == 'gold'
    assign bg_url = 'gold-fabric.png' | asset_url
  elsif bg_style == 'light-gold'
    assign bg_url = 'light-gold-fabric.png' | asset_url
  endif
-%}

<section
  id="{{ section_id }}"
  class="pas-section pas-bg-{{ bg_style }}"
  style="--pas-pt: {{ pad_top }}px; --pas-pb: {{ pad_bottom }}px;{% if bg_url != '' %} background-image: url('{{ bg_url }}');{% endif %}"
>
  <div class="pas-inner">
    {%- if show_title and section_title != blank -%}
      <div class="pas-header pas-rv">
        <h2 class="pas-page-title">{{ section_title }}</h2>
        <div class="pas-zigzag" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet" viewBox="0 0 120 26" fill="currentColor">
            <polygon points="0,14.4 0,21 11.5,12.4 21.3,20 30.4,11.1 40.3,20 51,12.4 60.6,20 69.6,11.1 79.3,20 90.1,12.4 99.6,20 109.7,11.1 120,21 120,14.4 109.7,5 99.6,13 90.1,5 79.3,14.5 71,5.7 60.6,12.4 51,5 40.3,14.5 31.1,5 21.3,13 11.5,5 "/>
          </svg>
        </div>
      </div>
    {%- endif -%}

    {%- for block in section.blocks -%}
      {%- liquid
        assign img_pos = block.settings.image_position | default: 'none'
        assign has_img = false
        if block.settings.image != blank
          assign has_img = true
        endif
      -%}

      <article
        class="pas-story pas-rv pas-img-{{ img_pos }}{% if has_img %} pas-has-img{% endif %}"
        {{ block.shopify_attributes }}
      >
        {%- if has_img and img_pos == 'top' -%}
          <div class="pas-story__media">
            <img
              src="{{ block.settings.image | image_url: width: 1200 }}"
              alt="{{ block.settings.image.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
            >
          </div>
        {%- endif -%}

        <div class="pas-story__grid">
          {%- if has_img and img_pos == 'left' -%}
            <div class="pas-story__media">
              <img
                src="{{ block.settings.image | image_url: width: 800 }}"
                alt="{{ block.settings.image.alt | escape }}"
                loading="lazy"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
              >
            </div>
          {%- endif -%}

          <div class="pas-story__text">
            {%- if block.settings.heading != blank -%}
              <h3 class="pas-story__heading">{{ block.settings.heading }}</h3>
            {%- endif -%}
            {%- if block.settings.content != blank -%}
              <div class="pas-story__body rte">{{ block.settings.content }}</div>
            {%- endif -%}
          </div>

          {%- if has_img and img_pos == 'right' -%}
            <div class="pas-story__media">
              <img
                src="{{ block.settings.image | image_url: width: 800 }}"
                alt="{{ block.settings.image.alt | escape }}"
                loading="lazy"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
              >
            </div>
          {%- endif -%}
        </div>

        {%- unless forloop.last -%}
          <div class="pas-zigzag pas-zigzag--divider" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet" viewBox="0 0 120 26" fill="currentColor">
              <polygon points="0,14.4 0,21 11.5,12.4 21.3,20 30.4,11.1 40.3,20 51,12.4 60.6,20 69.6,11.1 79.3,20 90.1,12.4 99.6,20 109.7,11.1 120,21 120,14.4 109.7,5 99.6,13 90.1,5 79.3,14.5 71,5.7 60.6,12.4 51,5 40.3,14.5 31.1,5 21.3,13 11.5,5 "/>
            </svg>
          </div>
        {%- endunless -%}
      </article>
    {%- endfor -%}
  </div>
</section>

{% stylesheet %}
.pas-section {
  position: relative;
  padding-top: var(--pas-pt, 80px);
  padding-bottom: var(--pas-pb, 80px);
  color: #3a2817;
}

.pas-bg-gold,
.pas-bg-light-gold {
  background-size: cover;
  background-position: center;
  background-repeat: repeat;
}

.pas-bg-none {
  background: transparent;
}

.pas-inner {
  max-width: 860px;
  margin: 0 auto;
  padding: 0 24px;
}

.pas-header {
  text-align: center;
  margin-bottom: 48px;
}

.pas-page-title {
  font-family: inherit;
  font-size: clamp(32px, 5vw, 56px);
  font-weight: 700;
  letter-spacing: 0.02em;
  text-transform: uppercase;
  margin: 0 0 20px;
  color: #3a2817;
}

.pas-zigzag {
  display: flex;
  justify-content: center;
  color: #3a2817;
  opacity: 0.7;
}

.pas-zigzag svg {
  width: 160px;
  height: 22px;
  display: block;
}

.pas-zigzag--divider {
  margin: 48px auto 48px;
}

.pas-story {
  margin-bottom: 0;
}

.pas-story__grid {
  display: block;
}

.pas-story.pas-has-img.pas-img-left .pas-story__grid,
.pas-story.pas-has-img.pas-img-right .pas-story__grid {
  display: grid;
  grid-template-columns: 1fr 1.3fr;
  gap: 36px;
  align-items: start;
}

.pas-story.pas-has-img.pas-img-right .pas-story__grid {
  grid-template-columns: 1.3fr 1fr;
}

.pas-story__media {
  margin-bottom: 24px;
}

.pas-story.pas-img-top .pas-story__media {
  max-width: 760px;
  margin: 0 auto 32px;
}

.pas-story__media img {
  width: 100%;
  height: auto;
  display: block;
  border-radius: 4px;
}

.pas-story__heading {
  font-family: inherit;
  font-size: clamp(26px, 4vw, 42px);
  font-weight: 700;
  letter-spacing: 0.02em;
  text-transform: uppercase;
  text-align: center;
  margin: 0 0 24px;
  color: #3a2817;
}

.pas-story.pas-has-img.pas-img-left .pas-story__heading,
.pas-story.pas-has-img.pas-img-right .pas-story__heading {
  text-align: left;
}

.pas-story__body {
  font-size: 16px;
  line-height: 1.75;
  color: #3a2817;
  text-align: center;
}

.pas-story.pas-has-img.pas-img-left .pas-story__body,
.pas-story.pas-has-img.pas-img-right .pas-story__body {
  text-align: left;
}

.pas-story__body p {
  margin: 0 0 16px;
}

.pas-story__body p:last-child {
  margin-bottom: 0;
}

/* Scroll reveal */
.pas-rv {
  opacity: 0;
  transform: translateY(24px);
  transition: opacity 0.8s cubic-bezier(.165,.84,.44,1), transform 0.8s cubic-bezier(.165,.84,.44,1);
}

.pas-rv.is-visible {
  opacity: 1;
  transform: translateY(0);
}

@media (prefers-reduced-motion: reduce) {
  .pas-rv {
    opacity: 1;
    transform: none;
    transition: none;
  }
}

@media (max-width: 749px) {
  .pas-story.pas-has-img.pas-img-left .pas-story__grid,
  .pas-story.pas-has-img.pas-img-right .pas-story__grid {
    grid-template-columns: 1fr;
    gap: 20px;
  }
  .pas-story__heading,
  .pas-story.pas-has-img.pas-img-left .pas-story__heading,
  .pas-story.pas-has-img.pas-img-right .pas-story__heading {
    text-align: center;
  }
  .pas-story__body,
  .pas-story.pas-has-img.pas-img-left .pas-story__body,
  .pas-story.pas-has-img.pas-img-right .pas-story__body {
    text-align: left;
  }
  .pas-zigzag--divider {
    margin: 36px auto;
  }
}
{% endstylesheet %}

<script>
(function() {
  var section = document.getElementById('{{ section_id }}');
  if (!section) return;
  if (!('IntersectionObserver' in window)) {
    section.querySelectorAll('.pas-rv').forEach(function(el){ el.classList.add('is-visible'); });
    return;
  }
  var io = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        io.unobserve(entry.target);
      }
    });
  }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
  section.querySelectorAll('.pas-rv').forEach(function(el){ io.observe(el); });
})();
</script>

{% schema %}
{
  "name": "About Story",
  "tag": "section",
  "class": "pas-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show section title",
      "default": true
    },
    {
      "type": "text",
      "id": "section_title",
      "label": "Section title"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "select",
      "id": "background_style",
      "label": "Background style",
      "options": [
        { "value": "gold", "label": "Gold fabric" },
        { "value": "light-gold", "label": "Light gold fabric" },
        { "value": "none", "label": "None" }
      ],
      "default": "gold"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "story",
      "name": "Story",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "select",
          "id": "image_position",
          "label": "Image position",
          "options": [
            { "value": "none", "label": "No image" },
            { "value": "top", "label": "Top" },
            { "value": "left", "label": "Left" },
            { "value": "right", "label": "Right" }
          ],
          "default": "none"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About Story",
      "blocks": [
        { "type": "story" }
      ]
    }
  ]
}
{% endschema %}
