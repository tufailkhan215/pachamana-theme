<section class="pmw pmw-sc-products" id="pmw-{{ section.id }}">
  {% render 'bulk-bg', section: section %}
  <div class="pmw__inner pmw-sc-products__inner">
    <div class="pmw-sc-products__head">
      {% if section.settings.eyebrow != blank %}<span class="pmw-eyebrow">{{ section.settings.eyebrow }}</span>{% endif %}
      <h2 class="pmw-sc-products__title">{{ section.settings.headline | newline_to_br }}</h2>
      {% if section.settings.subhead != blank %}<p class="pmw-sc-products__sub">{{ section.settings.subhead }}</p>{% endif %}
    </div>
    <div class="pmw-sc-products__grid">
      {% for block in section.blocks %}
        {% if block.type == 'product_card' %}
          <div class="pmw-sc-products__card" {{ block.shopify_attributes }}>
            <div class="pmw-sc-products__media">
              {% if block.settings.image != blank %}
                <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.name | escape }}" loading="lazy">
              {% else %}
                <span class="pmw-sc-products__placeholder">{{ block.settings.placeholder }}</span>
              {% endif %}
              {% if block.settings.badge != blank %}
                <span class="pmw-sc-products__badge">{{ block.settings.badge }}</span>
              {% endif %}
            </div>
            <div class="pmw-sc-products__body">
              <h3 class="pmw-sc-products__name">{{ block.settings.name }}</h3>
              <p class="pmw-sc-products__copy">{{ block.settings.description }}</p>
              <div class="pmw-sc-products__price-row">
                <span class="pmw-sc-products__price">{{ block.settings.price }}</span>
                <span class="pmw-sc-products__unit">{{ block.settings.unit }}</span>
              </div>
              <a href="{{ block.settings.cta_link | default: '#' }}" class="pmw-btn pmw-btn--primary pmw-btn--full">{{ block.settings.cta_label | default: 'Add To Cart' }}</a>
              {% if block.settings.sub_link_label != blank %}
                <a href="{{ block.settings.sub_link | default: '#' }}" class="pmw-sc-products__sub-link">{{ block.settings.sub_link_label }}</a>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<style>
  #pmw-{{ section.id }}.pmw-sc-products { padding: 0; }
  #pmw-{{ section.id }} .pmw-sc-products__inner { padding: 96px 64px; max-width: 1140px; margin: 0 auto; }
  #pmw-{{ section.id }} .pmw-sc-products__head { text-align: center; margin-bottom: 54px; }
  #pmw-{{ section.id }} .pmw-sc-products__title { margin: 14px 0 14px; font-size: 40px; line-height: 1.05; color: var(--pm-cacao-800); }
  #pmw-{{ section.id }} .pmw-sc-products__sub { margin: 0 auto; max-width: 560px; font-size: 17px; line-height: 1.7; color: var(--pm-cacao-500); }
  #pmw-{{ section.id }} .pmw-sc-products__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 24px; }
  #pmw-{{ section.id }} .pmw-sc-products__card { background: #ffffff; border: 1px solid var(--card-border); border-radius: 20px; overflow: hidden; box-shadow: 0 10px 30px rgba(92,64,47,.08); display: flex; flex-direction: column; }
  #pmw-{{ section.id }} .pmw-sc-products__media { position: relative; aspect-ratio: 1 / 1; background: linear-gradient(160deg, #fef2e0, #f7d79b); display: flex; align-items: center; justify-content: center; overflow: hidden; }
  #pmw-{{ section.id }} .pmw-sc-products__media img { width: 100%; height: 100%; object-fit: cover; }
  #pmw-{{ section.id }} .pmw-sc-products__placeholder { font-family: var(--font-display); font-size: 13px; letter-spacing: .12em; text-transform: uppercase; color: var(--pm-cacao-300); padding: 0 16px; text-align: center; }
  #pmw-{{ section.id }} .pmw-sc-products__badge { position: absolute; top: 14px; left: 14px; font-family: var(--font-display); text-transform: uppercase; letter-spacing: .08em; font-size: 10px; color: var(--pm-cacao-500); background: rgba(249,242,239,.92); padding: 6px 11px; border-radius: 99px; }
  #pmw-{{ section.id }} .pmw-sc-products__body { padding: 26px 24px 28px; display: flex; flex-direction: column; flex: 1; }
  #pmw-{{ section.id }} .pmw-sc-products__name { font-size: 19px; letter-spacing: .04em; color: var(--pm-cacao-800); margin-bottom: 6px; }
  #pmw-{{ section.id }} .pmw-sc-products__copy { margin: 0 0 18px; font-size: 14px; line-height: 1.6; color: var(--pm-cacao-500); flex: 1; }
  #pmw-{{ section.id }} .pmw-sc-products__price-row { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 18px; }
  #pmw-{{ section.id }} .pmw-sc-products__price { font-family: var(--font-display); font-size: 24px; color: var(--pm-cacao-800); }
  #pmw-{{ section.id }} .pmw-sc-products__unit { font-size: 12px; color: #9c8470; }
  #pmw-{{ section.id }} .pmw-sc-products__sub-link { display: block; text-align: center; margin-top: 10px; font-family: var(--font-display); text-transform: uppercase; letter-spacing: .08em; font-size: 12px; color: var(--pm-cacao-500); text-decoration: none; }
  @media (max-width: 768px) { #pmw-{{ section.id }} .pmw-sc-products__inner { padding: 64px 20px; } }
</style>

{% schema %}
{
  "name": "Safe Cacao — Products",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Background" },
    { "type": "select", "id": "bg_type", "label": "Background type", "default": "color",
      "options": [{"value":"color","label":"Color"},{"value":"image","label":"Image"}] },
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#fdf8f3" },
    { "type": "image_picker", "id": "bg_image", "label": "Background image" },
    { "type": "range", "id": "bg_opacity", "label": "Background opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "color", "id": "bg_overlay_color", "label": "Image overlay color", "default": "#000000" },
    { "type": "range", "id": "bg_overlay_opacity", "label": "Image overlay opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 0 },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Drink With Confidence" },
    { "type": "textarea", "id": "headline", "label": "Headline", "default": "Shop Cacao You\nCan Trust" },
    { "type": "textarea", "id": "subhead", "label": "Subhead", "default": "Same lab-tested, high-elevation Chuncho — in whatever form fits your ritual. Subscribe and save 15% on every reorder." }
  ],
  "blocks": [
    { "type": "product_card", "name": "Product card", "limit": 8, "settings": [
      { "type": "image_picker", "id": "image", "label": "Photo (optional)" },
      { "type": "text", "id": "placeholder", "label": "Placeholder text (when no photo)", "default": "Cacao photo" },
      { "type": "text", "id": "badge", "label": "Badge", "default": "Full Strength" },
      { "type": "text", "id": "name", "label": "Name", "default": "Ceremonial Paste" },
      { "type": "textarea", "id": "description", "label": "Description", "default": "100% pure, stone-ground heirloom paste — the full ceremonial dose. Brew slow, drink with intention." },
      { "type": "text", "id": "price", "label": "Price / shop label", "default": "Shop" },
      { "type": "text", "id": "unit", "label": "Unit / size", "default": "1 lb block" },
      { "type": "text", "id": "cta_label", "label": "Primary CTA", "default": "Add To Cart" },
      { "type": "url", "id": "cta_link", "label": "Primary CTA link" },
      { "type": "text", "id": "sub_link_label", "label": "Sub-link label", "default": "Subscribe & Save 15%" },
      { "type": "url", "id": "sub_link", "label": "Sub-link URL" }
    ]}
  ],
  "presets": [{
    "name": "Safe Cacao — Products",
    "blocks": [
      { "type": "product_card", "settings": { "placeholder": "Cacao paste photo", "badge": "Full Strength", "name": "Ceremonial Paste", "description": "100% pure, stone-ground heirloom paste — the full ceremonial dose. Brew slow, drink with intention.", "price": "Shop", "unit": "1 lb block" } },
      { "type": "product_card", "settings": { "placeholder": "Sampler photo", "badge": "Try It First", "name": "Single-Serving Sampler", "description": "Single-serve sizes to taste the difference before you commit — notes of dried cherry and warm earth.", "price": "Shop", "unit": "Sampler set" } },
      { "type": "product_card", "settings": { "placeholder": "Ground cacao photo", "badge": "Everyday", "name": "Ground Cacao", "description": "The same lab-tested Chuncho, ground for an easy daily cup at home, in the café, or in the studio.", "price": "Shop", "unit": "Resealable bag" } }
    ]
  }]
}
{% endschema %}
