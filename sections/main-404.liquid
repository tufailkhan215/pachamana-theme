{%- comment -%}
  404 page section
{%- endcomment -%}

<div class="page-404">
  <h1 class="page-404__title">404</h1>
  <p class="page-404__message">{{ 'general.404.title' | t | default: 'Page not found' }}</p>
  <p class="page-404__description">{{ 'general.404.subtext' | t | default: 'The page you are looking for does not exist.' }}</p>
  <a href="{{ routes.root_url }}" class="button">{{ 'general.404.link' | t | default: 'Continue shopping' }}</a>
</div>

