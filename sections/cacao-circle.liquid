<link href="https://fonts.googleapis.com/css2?family=Marcellus&family=Lora:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet"><style>
.cc-lp{--page:#f4e6cf;--body:#fbf1e1;--alt:#f4d5a4;--ink:#4a3324;--head:#5c402f;--muted:#7a5d48;
 --accent:#c18d1a;--label:#c53e15;--gold:#e2ab43;--cream:#fbefd9;
 --display:'Marcellus',Georgia,serif;--serif:'Lora',Georgia,serif;--sans:Helvetica,Arial,sans-serif;
 background:var(--body);color:var(--ink);font:400 18px/1.7 var(--serif);overflow-x:hidden;}
.cc-lp *{box-sizing:border-box;}
.cc-lp img{display:block;max-width:100%;height:auto;border:0;}
.cc-lp h1,.cc-lp h2,.cc-lp h3{font-family:var(--display);font-weight:400;text-transform:none;letter-spacing:normal;margin:0;}
.cc-lp p{margin:0;}
.cc-lp a{color:inherit;}
.cc-lp .wrap{max-width:1180px;margin:0 auto;padding:0 40px;}
.cc-lp .narrow{max-width:760px;margin-left:auto;margin-right:auto;}
.cc-lp .sec{padding:110px 0;}
.cc-lp .eyebrow{font:700 12px/1 var(--sans);letter-spacing:3px;text-transform:uppercase;color:var(--label);margin:0 0 16px;}
.cc-lp .h2{font-size:46px;line-height:1.1;color:var(--head);margin:0 0 22px;}
.cc-lp .lede{font-style:italic;color:var(--muted);font-size:19px;line-height:1.55;}
.cc-lp .center{text-align:center;}
.cc-lp .band{height:46px;background:url('https://cdn.shopify.com/s/files/1/0725/1188/1261/files/pm-pattern-band-2.png?v=1791949528') center/auto 100% repeat-x var(--head);}
.cc-lp .btn{display:inline-block;padding:19px 44px;border-radius:999px;background:var(--gold);color:#3d2a1d;
 font:700 14px/1 var(--sans);letter-spacing:1.6px;text-transform:uppercase;text-decoration:none;
 transition:transform .2s ease,box-shadow .2s ease,background .2s ease;}
.cc-lp .btn:hover{transform:translateY(-2px);box-shadow:0 10px 24px rgba(61,42,29,.22);background:#ebb853;}
.cc-lp .btn.ghost{background:transparent;color:var(--cream);box-shadow:inset 0 0 0 1.5px rgba(251,239,217,.7);}
.cc-lp .btn.ghost:hover{background:rgba(251,239,217,.12);box-shadow:inset 0 0 0 1.5px var(--cream);}
.cc-lp .txtlink{color:var(--head);text-decoration:underline;text-underline-offset:3px;}

.cc-lp .hero{position:relative;min-height:min(86vh,820px);display:flex;align-items:flex-end;
 background:#2a1c13 url('https://cdn.shopify.com/s/files/1/0725/1188/1261/files/cacao-sheny-leon-photography-maui-25.jpg?v=1766194163&width=2000') center 55%/cover no-repeat;color:#fff;}
.cc-lp .hero:before{content:"";position:absolute;inset:0;
 background:linear-gradient(90deg,rgba(29,20,14,.86) 0%,rgba(29,20,14,.58) 45%,rgba(29,20,14,.12) 80%),
 linear-gradient(0deg,rgba(29,20,14,.55) 0%,rgba(29,20,14,0) 45%);}
.cc-lp .hero .wrap{position:relative;width:100%;padding-bottom:96px;padding-top:140px;}
.cc-lp .pill{display:inline-block;padding:10px 18px;border:1px solid rgba(244,213,164,.6);border-radius:999px;
 font:700 11px/1 var(--sans);letter-spacing:2.6px;text-transform:uppercase;color:#f4d5a4;margin:0 0 26px;}
.cc-lp .hero h1{font-size:78px;line-height:1.02;color:#fff;max-width:680px;}
.cc-lp .hero h1 span{color:var(--gold);display:block;}
.cc-lp .hero .sub{margin:26px 0 0;max-width:560px;font:italic 400 22px/1.5 var(--serif);color:var(--cream);}
.cc-lp .hero .sub2{margin:14px 0 38px;max-width:540px;font:400 18px/1.6 var(--serif);color:#e9d8bd;}
.cc-lp .hero .btns{display:flex;gap:14px;flex-wrap:wrap;}

.cc-lp .facts{background:var(--head);color:var(--cream);}
.cc-lp .facts .wrap{display:grid;grid-template-columns:repeat(4,1fr);}
.cc-lp .fact{padding:30px 22px;text-align:center;border-left:1px solid rgba(226,171,67,.28);}
.cc-lp .fact:first-child{border-left:0;}
.cc-lp .fact b{display:block;font:400 24px/1.2 var(--display);color:var(--gold);margin:0 0 6px;}
.cc-lp .fact span{font:400 13px/1.4 var(--sans);letter-spacing:.4px;color:#e9d8bd;}

.cc-lp .steps{background:var(--page);}
.cc-lp .steps-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;margin:56px 0 54px;}
.cc-lp .step{background:var(--body);padding:40px 30px 36px;border-top:3px solid var(--gold);text-align:left;}
.cc-lp .step .n{font:400 56px/1 var(--display);color:var(--alt);margin:0 0 20px;}
.cc-lp .step h3{font-size:24px;line-height:1.2;color:var(--head);margin:0 0 10px;}
.cc-lp .step p{font-size:16.5px;line-height:1.65;}

.cc-lp .who{background:var(--body);}
.cc-lp .who .big{font:400 34px/1.3 var(--display);color:var(--head);margin:0 0 22px;}

.cc-lp .origin{display:grid;grid-template-columns:1fr 1fr;background:var(--page);}
.cc-lp .origin .txt{padding:110px 80px;align-self:center;max-width:640px;justify-self:end;}
.cc-lp .origin .ph{background:url('https://cdn.shopify.com/s/files/1/0725/1188/1261/files/pm-joel-farm-path-w1100.jpg?v=1794984332') center 35%/cover no-repeat;min-height:640px;}

.cc-lp .cup{background:var(--body);}
.cc-lp .cup .wrap{display:grid;grid-template-columns:1fr 1fr;align-items:stretch;}
.cc-lp .cup-card{background:var(--head);color:var(--cream);padding:64px 56px;position:relative;}
.cc-lp .cup-card:after{content:"";position:absolute;inset:10px;border:1px solid rgba(226,171,67,.55);pointer-events:none;}
.cc-lp .cup-card .eyebrow{color:var(--gold);}
.cc-lp .cup-card .h2{color:var(--cream);font-size:40px;}
.cc-lp .cup-card p+p{margin-top:16px;}
.cc-lp .cup-card a:not(.btn){color:var(--cream);text-decoration:underline;text-underline-offset:3px;}
.cc-lp .cup-card strong{color:var(--gold);font-weight:600;}
.cc-lp .cup-card .btn{position:relative;z-index:1;margin-top:30px;}
.cc-lp .health{background:var(--page);padding:64px 56px;}
.cc-lp .health .h2{font-size:34px;}
.cc-lp .health p{font-size:17px;line-height:1.7;}

.cc-lp .signup{background:var(--alt);scroll-margin-top:90px;}
.cc-lp .signup .box{max-width:620px;margin:0 auto;text-align:center;}
.cc-lp .signup .fine{margin:22px 0 0;font-size:15px;line-height:1.6;color:var(--muted);}
.cc-lp .signup .date{font:400 22px/1.4 var(--display);color:var(--head);margin:0 0 28px;}

.cc-lp .bar{display:none;}

@media (max-width:1000px){
 .cc-lp .steps-grid{grid-template-columns:repeat(2,1fr);}
 .cc-lp .origin .txt{padding:80px 48px;}
 .cc-lp .hero h1{font-size:64px;}
 .cc-lp .cup .wrap{grid-template-columns:1fr;}
}
@media (max-width:760px){
 .cc-lp{font-size:17px;}
 .cc-lp .wrap{padding:0 22px;}
 .cc-lp .sec{padding:72px 0;}
 .cc-lp .h2{font-size:34px;}
 .cc-lp .band{height:34px;}
 .cc-lp .hero{min-height:88vh;background-position:center 60%;}
 .cc-lp .hero:before{background:linear-gradient(0deg,rgba(29,20,14,.9) 0%,rgba(29,20,14,.62) 55%,rgba(29,20,14,.2) 100%);}
 .cc-lp .hero .wrap{padding-bottom:56px;}
 .cc-lp .hero h1{font-size:50px;}
 .cc-lp .hero .sub{font-size:19px;margin-top:20px;}
 .cc-lp .hero .sub2{font-size:17px;margin-bottom:30px;}
 .cc-lp .hero .btns .btn{flex:1 1 100%;text-align:center;}
 .cc-lp .facts .wrap{grid-template-columns:1fr 1fr;padding:0;}
 .cc-lp .fact{padding:22px 12px;border-left:0;border-top:1px solid rgba(226,171,67,.28);}
 .cc-lp .fact:nth-child(2n){border-left:1px solid rgba(226,171,67,.28);}
 .cc-lp .fact:nth-child(-n+2){border-top:0;}
 .cc-lp .fact b{font-size:19px;}
 .cc-lp .steps-grid{grid-template-columns:1fr;gap:16px;margin:36px 0 40px;}
 .cc-lp .step{padding:28px 24px;display:grid;grid-template-columns:58px 1fr;column-gap:8px;}
 .cc-lp .step .n{font-size:40px;grid-row:span 2;margin:0;}
 .cc-lp .who .big{font-size:26px;}
 .cc-lp .origin{grid-template-columns:1fr;}
 .cc-lp .origin .ph{min-height:320px;order:-1;}
 .cc-lp .origin .txt{padding:60px 22px;}
 .cc-lp .cup .wrap{padding:0;}
 .cc-lp .cup-card,.cc-lp .health{padding:52px 28px;}
 .cc-lp .cup-card .h2{font-size:32px;}
 .cc-lp .health .h2{font-size:28px;}
 .cc-lp .bar{display:block;position:fixed;left:0;right:0;bottom:0;z-index:50;padding:12px 16px calc(12px + env(safe-area-inset-bottom));
  background:rgba(58,40,29,.96);transform:translateY(110%);transition:transform .3s ease;}
 .cc-lp .bar.on{transform:none;}
 .cc-lp .bar .btn{display:block;text-align:center;padding:16px 20px;}
}
</style>
<div class="cc-lp">

<section class="hero"><div class="wrap">
 <span class="pill">Online &middot; one hour</span>
 <h1>The Cacao<span>Circle</span></h1>
 <p class="sub">A free online cacao circle, every full moon.</p>
 <p class="sub2">Bring a warm cup and an open heart. We&rsquo;ll sit together for an hour, wherever you are.</p>
 <div class="btns"><a class="btn" href="#save-my-spot">Save my spot</a><a class="btn ghost" href="#what-happens">What happens</a></div>
</div></section>

<div class="facts"><div class="wrap">
 <div class="fact"><b>{{ section.settings.circle_date | escape }}</b><span>next circle</span></div>
 <div class="fact"><b>6pm Pacific</b><span>9pm Eastern / 4pm Hawaii</span></div>
 <div class="fact"><b>60 minutes</b><span>on Google Meet</span></div>
 <div class="fact"><b>Free</b><span>no experience needed</span></div>
</div></div>

<section class="sec steps" id="what-happens"><div class="wrap center">
 <p class="eyebrow">One hour together</p><h2 class="h2">What happens</h2>
 <div class="steps-grid"><div class="step"><p class="n">01</p><div><h3>Arrive</h3><p>We arrive, cups in hand. Cameras are optional and nothing is recorded.</p></div></div><div class="step"><p class="n">02</p><div><h3>The farm</h3><p>Mark shares the story of the family farm we work with in Peru.</p></div></div><div class="step"><p class="n">03</p><div><h3>The first sip</h3><p>We take the first sip together, then sit with one simple question for the month.</p></div></div><div class="step"><p class="n">04</p><div><h3>Sit and share</h3><p>A short guided sit, and time to share if you want to. Listening is just as welcome.</p></div></div></div>
 <a class="btn" href="#save-my-spot">Save my spot</a>
</div></section>

<section class="sec who"><div class="wrap center"><div class="narrow">
 <p class="eyebrow">Who it&rsquo;s for</p>
 <p class="big">Anyone.</p>
 <p class="lede">Maybe you&rsquo;ve had cacao every morning for years, or maybe this will be your first cup. You don&rsquo;t need any experience, and you don&rsquo;t need to say a word.</p>
</div></div></section>

<div class="band"></div>

<section class="origin">
 <div class="txt"><p class="eyebrow">Your guide</p><h2 class="h2">Meet Mark</h2>
  <p>Mark Gregory is one of our founders. He fell in love with ceremonial cacao during his Peace Corps years in Peru, and in 2022 he went back to look for a farm, sending samples home to California until we found the right one: a multigenerational family farm in the Sacred Valley region just outside Cusco, in the ceja de selva, the &ldquo;eyebrow of the jungle.&rdquo; It&rsquo;s the farm we still work with today. Mark lives on Maui and will guide the circle from there.</p>
 </div>
 <div class="ph" role="img" aria-label="A farmer walking a path through the cacao trees in Peru"></div>
</section>

<section class="sec cup"><div class="wrap">
 <div class="cup-card">
  <p class="eyebrow">Before we start</p>
  <h2 class="h2">Your cup</h2>
  <p>Make your cacao just before we start. One cup is about 35 grams of paste or Pure Ground (one 1 oz packet plus a little more), dissolved in hot water (not boiling). It gives a gentle, steady lift, much gentler than coffee, without the jitters.</p>
  <p>Don&rsquo;t have any? The <a href="/products/single-serving-1oz-packets?utm_source=cacao-circle&amp;utm_medium=site&amp;utm_campaign=cacao-circle">1 oz packets</a> are an easy way to try it, and every batch is tested, with the heavy-metal results on our <a href="/pages/safe-cacao?utm_source=cacao-circle&amp;utm_medium=site&amp;utm_campaign=cacao-circle">Safe Cacao page</a>. <strong>Order by {{ section.settings.order_by | escape }}</strong> so it reaches you in time.</p>
  <a class="btn" href="/products/single-serving-1oz-packets?utm_source=cacao-circle&amp;utm_medium=site&amp;utm_campaign=cacao-circle">Get the 1 oz packets</a>
 </div>
 <div class="health">
  <p class="eyebrow">Please read</p><h2 class="h2">A note on health</h2>
  <p>Please talk with your doctor first if you are pregnant or nursing, have a heart condition or blood pressure concerns, or take antidepressants or other prescription medicine. Listen to your body and drink less if you&rsquo;re unsure.</p>
 </div>
</div></section>

<section class="sec signup" id="save-my-spot"><div class="wrap"><div class="box">
 <p class="eyebrow">Join us</p><h2 class="h2">Save my spot</h2>
 <p class="date">{{ section.settings.circle_date | escape }} &middot; 6pm Pacific / 9pm Eastern / 4pm Hawaii</p>
 <div class="klaviyo-form-{{ section.settings.form_id | escape }}"></div>
 <p class="fine">You&rsquo;ll get the link by email. We&rsquo;ll also send our newsletter, and you can unsubscribe anytime.</p>
</div></div></section>

