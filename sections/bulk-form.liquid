<section class="pmw pmw-form" id="pmw-{{ section.id }}">
  {% render 'bulk-bg', section: section %}
  <div class="pmw__inner pmw-form__inner">
    <div class="pmw-form__card">
      <div class="pmw-form__head">
        {% if section.settings.eyebrow != blank %}<div class="pmw-eyebrow">{{ section.settings.eyebrow }}</div>{% endif %}
        <h2 class="pmw-form__title">{{ section.settings.headline }}</h2>
        {% if section.settings.subhead != blank %}<p class="pmw-form__sub">{{ section.settings.subhead }}</p>{% endif %}
      </div>

      {% form 'contact', class: 'pmw-form__form' %}
        <input type="hidden" name="contact[subject]" value="Wholesale Application">
        <input type="hidden" name="contact[source]" value="bulk-page">

        {% if form.posted_successfully? %}
          <div class="pmw-form__success">
            <h3>{{ section.settings.success_title | default: "Thank you" }}</h3>
            <p>{{ section.settings.success_body | default: "We'll review your application and reply within 48 hours." }}</p>
          </div>
        {% else %}
          {% if form.errors %}
            <div class="pmw-form__errors">
              {% for field in form.errors %}<p>{{ form.errors.messages[field] }}</p>{% endfor %}
            </div>
          {% endif %}

          <div class="pmw-form__grid">
            <label class="pmw-form__field"><span>Business Name</span>
              <input type="text" name="contact[Business Name]" placeholder="Your business" required>
            </label>
            <label class="pmw-form__field"><span>Contact Name</span>
              <input type="text" name="contact[name]" placeholder="Your name" required>
            </label>
            <label class="pmw-form__field"><span>Email</span>
              <input type="email" name="contact[email]" placeholder="you@example.com" required>
            </label>
            <label class="pmw-form__field"><span>Phone</span>
              <input type="tel" name="contact[Phone]" placeholder="(555) 123-4567">
            </label>
            <label class="pmw-form__field"><span>Business Type</span>
              <select name="contact[Business Type]">
                <option value="">Select type</option>
                {%- for block in section.blocks -%}
                  {%- if block.type == 'biz_type' and block.settings.value != blank -%}
                    <option value="{{ block.settings.value | escape }}">{{ block.settings.value | escape }}</option>
                  {%- endif -%}
                {%- endfor -%}
              </select>
            </label>
            <label class="pmw-form__field"><span>Monthly Volume</span>
              <select name="contact[Monthly Volume]">
                <option value="">Select volume</option>
                {%- for block in section.blocks -%}
                  {%- if block.type == 'volume' and block.settings.value != blank -%}
                    <option value="{{ block.settings.value | escape }}">{{ block.settings.value | escape }}</option>
                  {%- endif -%}
                {%- endfor -%}
              </select>
            </label>
          </div>

          <label class="pmw-form__field pmw-form__field--full"><span>Anything else?</span>
            <textarea name="contact[body]" rows="3" placeholder="Tell us how you'd like to pour with us"></textarea>
          </label>

          {% if section.settings.show_newsletter %}
            <label class="pmw-form__check">
              <input type="checkbox" name="contact[Newsletter]" value="yes">
              <span>{{ section.settings.newsletter_label | default: "Send me the monthly cacao letter" }}</span>
            </label>
          {% endif %}

          <button type="submit" class="pmw-btn pmw-btn--primary pmw-btn--full pmw-form__submit">
            {{ section.settings.submit_label | default: "Submit Application" }}
          </button>
        {% endif %}
      {% endform %}
    </div>
  </div>
</section>

<style>
  #pmw-{{ section.id }}.pmw-form { padding: 92px 72px; }
  #pmw-{{ section.id }} .pmw-form__inner { max-width: 840px; margin: 0 auto; }
  #pmw-{{ section.id }} .pmw-form__card { background: var(--card-bg); border: 1px solid var(--card-border); border-radius: 24px; box-shadow: var(--card-shadow); padding: 56px; }
  #pmw-{{ section.id }} .pmw-form__head { text-align: center; margin-bottom: 36px; }
  #pmw-{{ section.id }} .pmw-form__title { font-size: 36px; margin: 14px 0 14px; }
  #pmw-{{ section.id }} .pmw-form__sub { font-size: 17px; line-height: 1.7; color: var(--page-muted); margin: 0; }
  #pmw-{{ section.id }} .pmw-form__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; }
  #pmw-{{ section.id }} .pmw-form__field { display: flex; flex-direction: column; gap: 7px; }
  #pmw-{{ section.id }} .pmw-form__field--full { margin-top: 22px; }
  #pmw-{{ section.id }} .pmw-form__field span { font-family: var(--font-display); text-transform: uppercase; letter-spacing: .08em; font-size: 12px; color: var(--page-text); }
  #pmw-{{ section.id }} .pmw-form__field input, #pmw-{{ section.id }} .pmw-form__field select, #pmw-{{ section.id }} .pmw-form__field textarea { background: #ffffff; border: 1.5px solid #ddc9b4; border-radius: 12px; padding: 13px 14px; font-family: var(--font-body); font-size: 15px; color: var(--pm-cacao-800); width: 100%; }
  #pmw-{{ section.id }} .pmw-form__field input:focus, #pmw-{{ section.id }} .pmw-form__field select:focus, #pmw-{{ section.id }} .pmw-form__field textarea:focus { outline: none; border-color: var(--pm-sunshine-gold); box-shadow: 0 0 0 3px rgba(226,171,67,.18); }
  #pmw-{{ section.id }} .pmw-form__check { display: flex; align-items: center; gap: 10px; margin: 24px 0 28px; font-size: 14px; color: var(--page-muted); }
  #pmw-{{ section.id }} .pmw-form__check input { accent-color: var(--pm-sunshine-gold); }
  #pmw-{{ section.id }} .pmw-form__submit { margin-top: 12px; padding: 18px 32px; font-size: 14px; }
  #pmw-{{ section.id }} .pmw-form__success { padding: 32px; background: var(--pm-gold-50); border-radius: 16px; text-align: center; }
  #pmw-{{ section.id }} .pmw-form__success h3 { font-size: 24px; margin-bottom: 8px; color: var(--pm-cacao-700); }
  #pmw-{{ section.id }} .pmw-form__success p { font-size: 16px; color: var(--page-muted); }
  #pmw-{{ section.id }} .pmw-form__errors { padding: 16px; background: #fbe9e7; color: #a23b29; border-radius: 12px; margin-bottom: 18px; font-size: 14px; }
  @media (max-width: 768px) {
    #pmw-{{ section.id }}.pmw-form { padding: 64px 20px; }
    #pmw-{{ section.id }} .pmw-form__card { padding: 32px 24px; }
    #pmw-{{ section.id }} .pmw-form__grid { grid-template-columns: 1fr; gap: 18px; }
  }
</style>

{% schema %}
{
  "name": "Bulk — Application Form",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Background" },
    { "type": "select", "id": "bg_type", "label": "Background type", "default": "color",
      "options": [{"value":"color","label":"Color"},{"value":"image","label":"Image"}] },
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#f9f2ef" },
    { "type": "image_picker", "id": "bg_image", "label": "Background image" },
    { "type": "range", "id": "bg_opacity", "label": "Background opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "color", "id": "bg_overlay_color", "label": "Image overlay color", "default": "#000000" },
    { "type": "range", "id": "bg_overlay_opacity", "label": "Image overlay opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 0 },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow (optional)" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "Apply For Wholesale" },
    { "type": "textarea", "id": "subhead", "label": "Subhead", "default": "Tell us about your business and we'll get back to you within 48 hours." },
    { "type": "header", "content": "Form behavior" },
    { "type": "checkbox", "id": "show_newsletter", "label": "Show newsletter opt-in", "default": true },
    { "type": "text", "id": "newsletter_label", "label": "Newsletter label", "default": "Send me the monthly cacao letter" },
    { "type": "text", "id": "submit_label", "label": "Submit button label", "default": "Submit Application" },
    { "type": "paragraph", "content": "Submissions go to your store notification email (Settings → Notifications)." },
    { "type": "header", "content": "Thank-you state" },
    { "type": "text", "id": "success_title", "label": "Success title", "default": "Thank you" },
    { "type": "textarea", "id": "success_body", "label": "Success body", "default": "We'll review your application and reply within 48 hours." }
  ],
  "blocks": [
    { "type": "biz_type", "name": "Business Type option", "limit": 12, "settings": [
      { "type": "text", "id": "value", "label": "Option value", "default": "Retail / wellness shop" }
    ]},
    { "type": "volume", "name": "Monthly Volume option", "limit": 12, "settings": [
      { "type": "text", "id": "value", "label": "Option value", "default": "1–2 cases / month" }
    ]}
  ],
  "presets": [{
    "name": "Bulk — Application Form",
    "blocks": [
      { "type": "biz_type", "settings": { "value": "Retail / wellness shop" } },
      { "type": "biz_type", "settings": { "value": "Café / coffee bar" } },
      { "type": "biz_type", "settings": { "value": "Ceremony facilitator" } },
      { "type": "biz_type", "settings": { "value": "Retreat / events" } },
      { "type": "biz_type", "settings": { "value": "Chocolate maker" } },
      { "type": "biz_type", "settings": { "value": "Bulk / refill store" } },
      { "type": "biz_type", "settings": { "value": "Other" } },
      { "type": "volume", "settings": { "value": "1–2 cases / month" } },
      { "type": "volume", "settings": { "value": "3–6 cases / month" } },
      { "type": "volume", "settings": { "value": "7–15 cases / month" } },
      { "type": "volume", "settings": { "value": "15+ cases / month" } }
    ]
  }]
}
{% endschema %}
