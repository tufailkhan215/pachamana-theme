{%- comment -%} Pacha Mana - Bundle page: What a cup gives you. Converted from build-your-bundle.html; every visible string, image and link is a setting. {%- endcomment -%}
{{ 'pm_landing.css' | asset_url | stylesheet_tag }}
<section class="pm-landing" style="padding:clamp(64px,8vw,112px) 24px;">
<div style="max-width:1140px;margin:0 auto;display:flex;flex-direction:column;gap:44px;">
<div style="display:flex;flex-direction:column;gap:14px;align-items:center;text-align:center;">
<span class="pm-eyebrow pm-eyebrow--gold">{{ section.settings.eyebrow | escape }}</span>
<h2 style="font-family:var(--font-display);text-transform:uppercase;font-weight:400;letter-spacing:var(--tracking-display);font-size:clamp(30px,4vw,44px);line-height:1.1;color:var(--text-strong);margin:0;">{{ section.settings.heading | escape }}</h2>
</div>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:20px;">
{%- for block in section.blocks -%}{%- if block.type == 'card' -%}<div {{ block.shopify_attributes }} style="background:#fff;border:1px solid var(--border-soft);border-radius:20px;padding:30px;box-shadow:var(--shadow-sm);display:flex;flex-direction:column;gap:12px;outline:1.5px dashed var(--pm-gold-300);outline-offset:-9px;"><h3 style="font-family:var(--font-display);text-transform:uppercase;font-weight:400;letter-spacing:0.06em;font-size:20px;color:var(--text-strong);margin:0;">{{ block.settings.title | escape }}</h3><p style="margin:0;font-size:15px;line-height:1.7;">{{ block.settings.text | escape }}</p></div>{%- endif -%}{%- endfor -%}



</div>
<p style="margin:0 auto;max-width:720px;text-align:center;font-size:14px;line-height:1.6;color:var(--pm-cacao-400);font-style:italic;">{{ section.settings.text | escape }}</p>
</div>
</section>

{% schema %}
{
  "name": "Bundle: What a cup gives ",
  "tag": "div",
  "class": "pm-landing-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Benefit",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "max_blocks": 50,
  "presets": [
    {
      "name": "Bundle: What a cup gives "
    }
  ]
}
{% endschema %}
