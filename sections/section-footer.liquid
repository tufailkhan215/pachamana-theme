{%- liquid
  assign footer_bg_image_url = blank
  if section.settings.background_image != blank
    assign footer_bg_image_url = section.settings.background_image | image_url: width: 2400
  else
    comment
      Fallback to current hardcoded default (theme asset)
    endcomment
    assign footer_bg_image_url = 'peruvian_geometric_textile_pattern_3.png' | asset_url
  endif

  assign footer_bg_color = section.settings.background_color | default: 'transparent'
  assign footer_bg_size = section.settings.background_size | default: 'cover'
  assign footer_bg_position = section.settings.background_position | default: 'center center'
  assign footer_bg_repeat = section.settings.background_repeat | default: 'no-repeat'
-%}

<style>
  /* Footer background (Theme Editor configurable) */
  .section-footer .elementor-element[data-id="4d8192a"]:not(.elementor-motion-effects-element-type-background),
  .section-footer .elementor-element[data-id="4d8192a"] > .elementor-motion-effects-container > .elementor-motion-effects-layer {
    background-color: {{ footer_bg_color }} !important;
    background-image: url("{{ footer_bg_image_url }}") !important;
    background-size: {{ footer_bg_size }} !important;
    background-position: {{ footer_bg_position }} !important;
    background-repeat: {{ footer_bg_repeat }} !important;
  }
</style>

