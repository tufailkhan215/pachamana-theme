				<div class="elementor-element elementor-element-7d8ba8c elementor-widget" data-id="7d8ba8c" data-element_type="widget">
				<div class="elementor-widget-container">
				  <style>
				    /* Scoped footer nav — completely isolated from Elementor nav CSS */
				    #sf-nav-{{ section.id }} {
				      list-style: none;
				      margin: 0;
				      padding: 0;
				      display: flex;
				      flex-direction: column;
				      align-items: center;
				      gap: 2px;
				    }
				    #sf-nav-{{ section.id }} li { width: 100%; text-align: center; }
				    #sf-nav-{{ section.id }} a.sf-top-link {
				      display: block;
				      padding: 7px 0;
				      text-decoration: none;
				      font-size: inherit;
				      color: inherit;
				      letter-spacing: inherit;
				      font-weight: inherit;
				      font-family: inherit;
				      text-transform: inherit;
				      transition: opacity 0.2s;
				    }
				    #sf-nav-{{ section.id }} a.sf-top-link:hover { opacity: 0.7; }
				    /* Sub-links: always visible, indented, smaller */
				    #sf-nav-{{ section.id }} ul.sf-sub {
				      list-style: none;
				      margin: 0 0 6px;
				      padding: 0;
				      display: flex;
				      flex-direction: column;
				      gap: 1px;
				    }
				    #sf-nav-{{ section.id }} ul.sf-sub a {
				      display: block;
				      padding: 4px 0;
				      text-decoration: none;
				      color: inherit;
				      font-family: inherit;
				      font-size: 0.78em;
				      letter-spacing: 0.08em;
				      opacity: 0.65;
				      text-transform: uppercase;
				      transition: opacity 0.2s;
				    }
				    #sf-nav-{{ section.id }} ul.sf-sub a:hover { opacity: 1; }
				    /* Thin divider between parent items that have children */
				    #sf-nav-{{ section.id }} li.sf-has-children { border-bottom: 1px solid rgba(255,255,255,0.08); padding-bottom: 4px; margin-bottom: 4px; }
				  </style>

				  {%- assign footer_menu = linklists[section.settings.footer_menu] -%}
				  {%- if footer_menu.links.size > 0 -%}
				    <nav aria-label="Footer navigation">
				      <ul id="sf-nav-{{ section.id }}">
				        {%- for link in footer_menu.links -%}
				          <li class="{% if link.links.size > 0 %}sf-has-children{% endif %}">
				            <a href="{{ link.url }}" class="sf-top-link"{% if link.active %} aria-current="page"{% endif %}>
				              {{ link.title }}
				            </a>
				            {%- if link.links.size > 0 -%}
				              <ul class="sf-sub">
				                {%- for child in link.links -%}
				                  <li>
				                    <a href="{{ child.url }}"{% if child.active %} aria-current="page"{% endif %}>
				                      {{ child.title }}
				                    </a>
				                  </li>
				                {%- endfor -%}
				              </ul>
				            {%- endif -%}
				          </li>
				        {%- endfor -%}
				      </ul>
				    </nav>
				  {%- else -%}
				    <p style="font-size:0.8rem;opacity:0.5;text-align:center;">Select a menu in Theme Editor → Footer → Navigation Menu</p>
				  {%- endif -%}
				</div>
