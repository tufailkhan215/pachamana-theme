<section class="background-motion-section">
  <div class="background-motion-section__inner">
    <div class="background-motion-section__media">
      {%- if section.settings.image != blank -%}
        <img
          fetchpriority="high"
          decoding="async"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
          class="background-motion-section__image"
          alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
          src="{{ section.settings.image | image_url: width: 800 }}"
          sizes="(max-width: 800px) 100vw, 800px"
        >
      {%- else -%}
        <img
          fetchpriority="high"
          decoding="async"
          width="800"
          height="457"
          class="background-motion-section__image"
          alt=""
          src="{{ 'PachaMana_Logos_RGB_Cacao_FullLogo_OverDark-1-e1706645290541.png' | asset_url }}"
          sizes="(max-width: 800px) 100vw, 800px"
        >
      {%- endif -%}
    </div>

    <div class="background-motion-section__content">
      <h2 class="background-motion-section__heading">
        {{ section.settings.heading | default: 'ceremony starts at the farm' }}
      </h2>

      <p class="background-motion-section__subheading">
        {{ section.settings.heading1 | default: 'Wild-harvested from indigenous farmers in Peru.' }}
      </p>
    </div>
  </div>
</section>

<style>
  .background-motion-section {
    position: relative;
    overflow: hidden;
    padding: 80px 20px;
    background: linear-gradient(180deg, #111 0%, #1b1b1b 100%);
    color: #fff;
  }

  .background-motion-section__inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px;
    align-items: center;
    text-align: center;
  }

  .background-motion-section__media {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .background-motion-section__image {
    max-width: 100%;
    height: auto;
    display: block;
    object-fit: contain;
  }

  .background-motion-section__content {
    max-width: 760px;
    margin: 0 auto;
  }

  .background-motion-section__heading {
    margin: 0;
    font-size: clamp(2rem, 4vw, 4rem);
    line-height: 1.05;
    font-weight: 700;
    text-transform: lowercase;
    letter-spacing: -0.03em;
  }

  .background-motion-section__subheading {
    margin: 14px 0 0;
    font-size: clamp(1rem, 1.6vw, 1.25rem);
    line-height: 1.6;
    opacity: 0.9;
  }

  @media (min-width: 900px) {
    .background-motion-section {
      padding: 110px 24px;
    }

    .background-motion-section__inner {
      grid-template-columns: minmax(320px, 460px) 1fr;
      text-align: left;
      gap: 48px;
    }

    .background-motion-section__content {
      margin: 0;
      justify-self: start;
    }

    .background-motion-section__media {
      justify-content: flex-start;
    }
  }
</style>

{% schema %}
{
  "name": "Background Motion",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Logo Image",
      "info": "Upload the main logo/image for this section"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading Text",
      "default": "ceremony starts at the farm"
    },
    {
      "type": "text",
      "id": "heading1",
      "label": "Sub Heading Text",
      "default": "Wild-harvested from indigenous farmers in Peru."
    }
  ],
  "presets": [
    {
      "name": "Background Motion"
    }
  ]
}
{% endschema %}
