{%- liquid
  assign section_id = section.id
  assign anchor_id = 'csf-' | append: section_id
-%}

<section
  id="{{ anchor_id }}"
  class="csf-section"
  data-csf-root
  data-csf-single-open="{{ section.settings.single_open }}"
  style="
    --csf-bg: {{ section.settings.bg_color }};
    --csf-panel-bg: {{ section.settings.panel_bg_color }};
    --csf-panel-border: {{ section.settings.panel_border_color }};
    --csf-heading: {{ section.settings.heading_color }};
    --csf-item-bg: {{ section.settings.item_bg_color }};
    --csf-item-text: {{ section.settings.item_text_color }};
    --csf-item-active-text: {{ section.settings.item_active_text_color }};
    --csf-answer-text: {{ section.settings.answer_color }};
    --csf-pad-top: {{ section.settings.padding_top }}px;
    --csf-pad-bottom: {{ section.settings.padding_bottom }}px;
    --csf-max-width: {{ section.settings.content_max_width }}px;
    --csf-heading-size: {{ section.settings.heading_size }}px;
    --csf-panel-radius: {{ section.settings.panel_radius }}px;
    --csf-item-radius: {{ section.settings.item_radius }}px;
    {% if section.settings.bg_image != blank %}
      --csf-bg-image: url('{{ section.settings.bg_image | image_url: width: 2400 }}');
    {% else %}
      --csf-bg-image: url('{{ 'chocolate-fabric.png' | asset_url }}');
    {% endif %}
    {% if section.settings.panel_image != blank %}
      --csf-panel-image: url('{{ section.settings.panel_image | image_url: width: 1800 }}');
    {% else %}
      --csf-panel-image: url('{{ 'gold-fabric.png' | asset_url }}');
    {% endif %}
  "
>
  <div class="csf-panel" data-csf-reveal>
    {%- if section.settings.heading != blank -%}
      <h2 class="csf-heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="csf-list" role="list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'faq_item' -%}
            {%- assign item_id = anchor_id | append: '-item-' | append: block.id -%}
            {%- assign panel_id = item_id | append: '-panel' -%}
            <li class="csf-item" data-csf-reveal {{ block.shopify_attributes }}>
              <button
                type="button"
                class="csf-question"
                aria-expanded="false"
                aria-controls="{{ panel_id }}"
                id="{{ item_id }}"
                data-csf-toggle
              >
                <span class="csf-question__icon" aria-hidden="true">+</span>
                <span class="csf-question__text">{{ block.settings.question }}</span>
              </button>
              <div
                class="csf-answer"
                id="{{ panel_id }}"
                role="region"
                aria-labelledby="{{ item_id }}"
                hidden
              >
                <div class="csf-answer__inner">
                  {{ block.settings.answer }}
                </div>
              </div>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}

    <div class="csf-footer-rule" aria-hidden="true"></div>
  </div>
</section>

{%- if section.blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          {%- if block.type == 'faq_item' -%}
            {
              "@type": "Question",
              "name": {{ block.settings.question | json }},
              "acceptedAnswer": {
                "@type": "Answer",
                "text": {{ block.settings.answer | strip_html | strip_newlines | json }}
              }
            }{%- unless forloop.last -%},{%- endunless -%}
          {%- endif -%}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% stylesheet %}
  .csf-section {
    background-color: var(--csf-bg, #3d2817);
    background-image: var(--csf-bg-image);
    background-size: auto;
    background-position: center;
    background-repeat: repeat;
    padding: var(--csf-pad-top, 80px) 24px var(--csf-pad-bottom, 80px);
    font-family: 'Barlow', 'Helvetica Neue', Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
    position: relative;
  }

  .csf-panel {
    max-width: var(--csf-max-width, 820px);
    margin: 0 auto;
    width: 100%;
    background-color: var(--csf-panel-bg, #9b6802);
    background-image: var(--csf-panel-image);
    background-size: cover;
    background-position: center;
    border: 2px solid var(--csf-panel-border, #e2ab43);
    border-radius: var(--csf-panel-radius, 36px);
    padding: 36px 36px 28px;
    box-shadow: 0 18px 48px rgba(0, 0, 0, 0.32);
    position: relative;
  }

  .csf-heading {
    font-family: 'OAXACA', Georgia, 'Times New Roman', serif;
    font-size: var(--csf-heading-size, 34px);
    line-height: 1.1;
    letter-spacing: 0.04em;
    color: var(--csf-heading, #3d2817);
    margin: 0 0 24px;
    text-align: center;
    font-weight: 700;
    text-transform: uppercase;
  }

  .csf-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .csf-item {
    background: var(--csf-item-bg, #5c402f);
    border-radius: var(--csf-item-radius, 6px);
    overflow: hidden;
    transition: box-shadow 280ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .csf-item:has(.csf-question[aria-expanded="true"]) {
    box-shadow: 0 0 0 2px var(--csf-panel-border, #e2ab43);
  }

  .csf-question {
    appearance: none;
    -webkit-appearance: none;
    background: transparent;
    border: 0;
    color: var(--csf-item-text, #e2ab43);
    width: 100%;
    padding: 14px 20px;
    display: flex;
    align-items: center;
    gap: 12px;
    cursor: pointer;
    font-family: 'OAXACA', Georgia, 'Times New Roman', serif;
    font-size: 14px;
    line-height: 1.3;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-align: left;
    transition: color 220ms ease;
  }

  .csf-question:focus-visible {
    outline: 2px solid var(--csf-panel-border, #e2ab43);
    outline-offset: -2px;
  }

  .csf-question[aria-expanded="true"] {
    color: var(--csf-item-active-text, #f9f2ef);
  }

  .csf-question__icon {
    flex: 0 0 auto;
    width: 16px;
    height: 16px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    font-weight: 400;
    line-height: 1;
    font-family: 'Barlow', sans-serif;
    transition: transform 260ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .csf-question[aria-expanded="true"] .csf-question__icon::before {
    content: '−';
  }

  .csf-question[aria-expanded="false"] .csf-question__icon::before {
    content: '+';
  }

  .csf-question__icon {
    font-size: 0;
  }

  .csf-question__icon::before {
    font-size: 18px;
  }

  .csf-question__text {
    flex: 1 1 auto;
  }

  .csf-answer {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 340ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .csf-answer[data-csf-open="true"] {
    grid-template-rows: 1fr;
  }

  .csf-answer[hidden] {
    display: none;
  }

  .csf-answer__inner {
    overflow: hidden;
    min-height: 0;
  }

  .csf-answer[data-csf-open="true"] .csf-answer__inner {
    padding: 2px 20px 18px;
  }

  .csf-answer__inner,
  .csf-answer__inner p {
    color: var(--csf-answer-text, #d4c5a9);
    font-family: 'Barlow', 'Helvetica Neue', Arial, sans-serif;
    font-size: 13px;
    line-height: 1.6;
    margin: 0 0 8px;
    font-weight: 500;
  }

  .csf-answer__inner p:last-child {
    margin-bottom: 0;
  }

  .csf-answer__inner ul,
  .csf-answer__inner ol {
    margin: 0 0 8px;
    padding-left: 20px;
  }

  .csf-answer__inner a {
    color: var(--csf-item-text, #e2ab43);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .csf-answer__inner strong {
    font-weight: 700;
    color: var(--csf-item-active-text, #f9f2ef);
  }

  .csf-footer-rule {
    margin: 22px auto 0;
    width: 100%;
    height: 1px;
    background-image: linear-gradient(
      to right,
      transparent 0,
      var(--csf-heading, #3d2817) 50%,
      transparent 100%
    );
    background-size: 6px 1px;
    background-repeat: repeat-x;
    opacity: 0.35;
  }

  [data-csf-reveal] {
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 520ms ease, transform 520ms cubic-bezier(0.2, 0.8, 0.2, 1);
    will-change: opacity, transform;
  }

  [data-csf-reveal].csf-is-visible {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .csf-item,
    .csf-question,
    .csf-question__icon,
    .csf-answer,
    [data-csf-reveal] {
      transition: none !important;
    }
    [data-csf-reveal] {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 640px) {
    .csf-section {
      padding-left: 16px;
      padding-right: 16px;
    }
    .csf-panel {
      padding: 24px 18px 20px;
      border-radius: calc(var(--csf-panel-radius, 36px) * 0.6);
    }
    .csf-heading {
      font-size: calc(var(--csf-heading-size, 34px) * 0.78);
      margin-bottom: 18px;
    }
    .csf-question {
      padding: 12px 14px;
      font-size: 12px;
      letter-spacing: 0.06em;
    }
    .csf-answer[data-csf-open="true"] .csf-answer__inner {
      padding: 2px 14px 14px;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function initAccordion(root) {
      if (root.dataset.csfInit === '1') return;
      root.dataset.csfInit = '1';

      var singleOpen = root.getAttribute('data-csf-single-open') === 'true';
      var toggles = root.querySelectorAll('[data-csf-toggle]');

      toggles.forEach(function (btn) {
        btn.addEventListener('click', function () {
          var expanded = btn.getAttribute('aria-expanded') === 'true';
          var panel = document.getElementById(btn.getAttribute('aria-controls'));
          if (!panel) return;

          if (singleOpen && !expanded) {
            toggles.forEach(function (other) {
              if (other === btn) return;
              if (other.getAttribute('aria-expanded') === 'true') {
                closePanel(other);
              }
            });
          }

          if (expanded) {
            closePanel(btn);
          } else {
            openPanel(btn, panel);
          }
        });
      });
    }

    function openPanel(btn, panel) {
      panel.hidden = false;
      void panel.offsetHeight;
      panel.setAttribute('data-csf-open', 'true');
      btn.setAttribute('aria-expanded', 'true');
    }

    function closePanel(btn) {
      var panel = document.getElementById(btn.getAttribute('aria-controls'));
      if (!panel) return;
      btn.setAttribute('aria-expanded', 'false');
      panel.removeAttribute('data-csf-open');
      if (reduceMotion) {
        panel.hidden = true;
        return;
      }
      var onEnd = function (e) {
        if (e.propertyName !== 'grid-template-rows') return;
        panel.hidden = true;
        panel.removeEventListener('transitionend', onEnd);
      };
      panel.addEventListener('transitionend', onEnd);
    }

    function initReveal(root) {
      var targets = root.querySelectorAll('[data-csf-reveal]');
      if (!targets.length) return;

      if (reduceMotion || !('IntersectionObserver' in window)) {
        targets.forEach(function (el) { el.classList.add('csf-is-visible'); });
        return;
      }

      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('csf-is-visible');
            io.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });

      targets.forEach(function (el, i) {
        el.style.transitionDelay = Math.min(i * 35, 320) + 'ms';
        io.observe(el);
      });
    }

    function boot() {
      document.querySelectorAll('[data-csf-root]').forEach(function (root) {
        initAccordion(root);
        initReveal(root);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', boot);
    } else {
      boot();
    }

    document.addEventListener('shopify:section:load', function (e) {
      var root = e.target.querySelector('[data-csf-root]');
      if (root) {
        initAccordion(root);
        initReveal(root);
      }
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "class": "cs-faq-section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "checkbox",
      "id": "single_open",
      "label": "Single open",
      "info": "Only one item open at a time.",
      "default": true
    },
    {
      "type": "header",
      "content": "Section background"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image",
      "info": "Defaults to chocolate-fabric.png."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#3d2817"
    },
    {
      "type": "header",
      "content": "Panel"
    },
    {
      "type": "image_picker",
      "id": "panel_image",
      "label": "Panel image",
      "info": "Defaults to gold-fabric.png."
    },
    {
      "type": "color",
      "id": "panel_bg_color",
      "label": "Panel fallback",
      "default": "#9b6802"
    },
    {
      "type": "color",
      "id": "panel_border_color",
      "label": "Panel border",
      "default": "#e2ab43"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#3d2817"
    },
    {
      "type": "range",
      "id": "panel_radius",
      "label": "Panel radius",
      "min": 0,
      "max": 60,
      "step": 2,
      "default": 36,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Item"
    },
    {
      "type": "color",
      "id": "item_bg_color",
      "label": "Item background",
      "default": "#5c402f"
    },
    {
      "type": "color",
      "id": "item_text_color",
      "label": "Question (closed)",
      "default": "#e2ab43"
    },
    {
      "type": "color",
      "id": "item_active_text_color",
      "label": "Question (open)",
      "default": "#f9f2ef"
    },
    {
      "type": "color",
      "id": "answer_color",
      "label": "Answer text",
      "default": "#d4c5a9"
    },
    {
      "type": "range",
      "id": "item_radius",
      "label": "Item radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "default": 6,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Max width",
      "min": 600,
      "max": 1400,
      "step": 20,
      "default": 820,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 22,
      "max": 56,
      "step": 2,
      "default": 34,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 10,
      "default": 80,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 10,
      "default": 80,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What is a serving size?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Share the answer here.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "faq_item" },
        { "type": "faq_item" },
        { "type": "faq_item" }
      ]
    }
  ]
}
{% endschema %}
