{%- style -%}
  #shopify-section-{{ section.id }} .section-faq,
  #shopify-section-{{ section.id }} .section-faq .e-con-inner,
  #shopify-section-{{ section.id }} .section-faq .e-con,
  #shopify-section-{{ section.id }} .section-faq .elementor-widget-container,
  #shopify-section-{{ section.id }} .section-faq .theplus-accordion-wrapper,
  #shopify-section-{{ section.id }} .section-faq .theplus-accordion-item,
  #shopify-section-{{ section.id }} .section-faq .elementor-tab-content {
    background: {{ section.settings.bg_color }};
  }
  #shopify-section-{{ section.id }} .section-faq {
    padding: 60px 0;
  }
  #shopify-section-{{ section.id }} .section-faq .heading-title {
    color: {{ section.settings.heading_color }};
  }
  #shopify-section-{{ section.id }} .section-faq .elementor-tab-title {
    color: {{ section.settings.text_color }};
  }
  #shopify-section-{{ section.id }} .section-faq .plus-content-editor,
  #shopify-section-{{ section.id }} .section-faq .plus-content-editor p {
    color: {{ section.settings.answer_color }};
  }
  #shopify-section-{{ section.id }} .section-faq .elementor-accordion-icon i {
    color: {{ section.settings.heading_color }};
  }
  #shopify-section-{{ section.id }} .section-faq .elementor-divider-separator {
    border-color: {{ section.settings.heading_color }};
  }
{%- endstyle -%}

