          "info": "Used when no image is picked above."
        },
        {
          "type": "text",
          "id": "image_alt_text_2",
          "label": "Image alt text 2",
          "info": "Leave blank for purely decorative images."
        },
        {
          "type": "image_picker",
          "id": "image_3",
          "label": "Image 3"
        },
        {
          "type": "text",
          "id": "image_url_3",
          "label": "Image URL 3",
          "info": "Used when no image is picked above."
        },
        {
          "type": "text",
          "id": "image_alt_text_3",
          "label": "Image alt text 3",
          "info": "Leave blank for purely decorative images."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "text",
          "id": "text_2",
          "label": "Text 2"
        },
        {
          "type": "text",
          "id": "text_3",
          "label": "Text 3"
        },
        {
          "type": "text",
          "id": "text_4",
          "label": "Text 4"
        },
        {
          "type": "text",
          "id": "text_5",
          "label": "Text 5"
        },
        {
          "type": "text",
          "id": "text_6",
          "label": "Text 6"
        },
        {
          "type": "text",
          "id": "text_7",
          "label": "Text 7"
        }
      ]
    }
  ],
  "max_blocks": 50,
  "presets": [
    {
      "name": "Start: The blends"
    }
  ]
}
{% endschema %}
