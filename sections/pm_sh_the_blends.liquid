{%- comment -%} Pacha Mana - Start page: The blends. Converted from start-here.html; every visible string, image and link is a setting. {%- endcomment -%}
{{ 'pm_landing.css' | asset_url | stylesheet_tag }}
<section class="pm-landing" style="position:relative;overflow:hidden;background:var(--pm-sandy-tan);padding:clamp(64px,8vw,112px) 20px;">
<div style="position:absolute;inset:0;background-image:url('https://pachamana.com/cdn/shop/files/Pattern_Website.png?v=1769670221&amp;width=1200');background-size:520px auto;opacity:.06;pointer-events:none;"></div>
<div style="position:relative;max-width:1140px;margin:0 auto;display:flex;flex-direction:column;gap:40px;">
<div style="display:flex;flex-direction:column;gap:14px;align-items:center;text-align:center;">
<span class="pm-eyebrow pm-eyebrow--cacao">{{ section.settings.eyebrow | escape }}</span>
<h2 style="font-family:var(--font-display);text-transform:uppercase;font-weight:400;letter-spacing:var(--tracking-display);font-size:clamp(30px,4vw,44px);line-height:1.1;color:var(--text-strong);margin:0;">{{ section.settings.heading | escape }}</h2>
<p style="margin:0;max-width:600px;font-size:17px;line-height:1.7;text-wrap:pretty;">{{ section.settings.text | escape }}</p>
</div>
<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:18px;">
{%- for block in section.blocks -%}{%- if block.type == 'card' -%}<div {{ block.shopify_attributes }} style="background:var(--pm-tan-50);border:1px solid var(--border-soft);border-radius:20px;overflow:hidden;box-shadow:var(--shadow-sm);display:flex;flex-direction:column;">
<div style="position:relative;aspect-ratio:1/1;background:#fff;"><img alt="{{ block.settings.image_alt_text | escape }}" src="{%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 800 }}{%- else -%}{{ block.settings.image_url | escape }}{%- endif -%}" style="width:100%;height:100%;object-fit:cover;display:block;min-height:100%;max-height:100%;"/>
{%- if block.settings.image_2 != blank or block.settings.image_url_2 != blank -%}<img alt="{{ block.settings.image_alt_text_2 | escape }}" src="{%- if block.settings.image_2 != blank -%}{{ block.settings.image_2 | image_url: width: 1600 }}{%- else -%}{{ block.settings.image_url_2 | escape }}{%- endif -%}" style="position:absolute;right:10px;bottom:10px;width:34%;height:auto;filter:drop-shadow(0 4px 8px rgba(92,64,47,.22));pointer-events:none;"/>{%- endif -%}
{%- if block.settings.image_3 != blank or block.settings.image_url_3 != blank -%}<img alt="{{ block.settings.image_alt_text_3 | escape }}" src="{%- if block.settings.image_3 != blank -%}{{ block.settings.image_3 | image_url: width: 1600 }}{%- else -%}{{ block.settings.image_url_3 | escape }}{%- endif -%}" style="position:absolute;right:30%;bottom:6px;width:24%;height:auto;filter:drop-shadow(0 4px 8px rgba(92,64,47,.22));pointer-events:none;"/>{%- endif -%}</div>
<div style="padding:20px 22px 24px;display:flex;flex-direction:column;gap:10px;">
<div style="display:flex;justify-content:space-between;align-items:baseline;gap:10px;"><h3 style="font-family:var(--font-display);text-transform:uppercase;font-weight:400;letter-spacing:0.06em;font-size:19px;color:var(--text-strong);margin:0;">{{ block.settings.title | escape }}</h3><span style="font-size:14px;font-weight:600;color:var(--pm-gold-700);flex:0 0 auto;">{{ block.settings.label | escape }}</span></div>
<p style="margin:0;font-size:15px;line-height:1.6;color:var(--text-strong);">{{ block.settings.text | escape }}</p>
<dl style="margin:0;display:grid;grid-template-columns:auto 1fr;gap:6px 12px;font-size:13px;line-height:1.5;border-top:1px solid var(--border-soft);padding-top:12px;">
<dt style="font-family:var(--font-display);text-transform:uppercase;letter-spacing:0.12em;font-size:11px;color:var(--pm-cacao-400);padding-top:2px;">{{ block.settings.text_2 | escape }}</dt><dd style="margin:0;">{{ block.settings.text_3 | escape }}</dd>
<dt style="font-family:var(--font-display);text-transform:uppercase;letter-spacing:0.12em;font-size:11px;color:var(--pm-cacao-400);padding-top:2px;">{{ block.settings.text_4 | escape }}</dt><dd style="margin:0;">{{ block.settings.text_5 | escape }}</dd>
<dt style="font-family:var(--font-display);text-transform:uppercase;letter-spacing:0.12em;font-size:11px;color:var(--pm-cacao-400);padding-top:2px;">{{ block.settings.text_6 | escape }}</dt><dd style="margin:0;font-style:italic;">{{ block.settings.text_7 | escape }}</dd>
</dl>
</div>
</div>{%- endif -%}{%- endfor -%}






</div>
<div style="display:flex;justify-content:center;"><a class="pm-btn pm-btn--primary pm-btn--lg" href="{{ section.settings.button_link | escape }}">{{ section.settings.button_label | escape }}</a></div>
</div>
</section>

{% schema %}
{
  "name": "Start: The blends",
  "tag": "div",
  "class": "pm-landing-section",
  "settings": [
    {
      "type": "text",
