          "info": "Leave blank for purely decorative images."
        },
        {
          "type": "image_picker",
          "id": "image_2",
          "label": "Image 2"
        },
        {
          "type": "text",
          "id": "image_url_2",
          "label": "Image URL 2",
          "info": "Used when no image is picked above."
        },
        {
          "type": "text",
          "id": "image_alt_text_2",
          "label": "Image alt text 2",
          "info": "Leave blank for purely decorative images."
        },
        {
          "type": "image_picker",
          "id": "image_3",
          "label": "Image 3"
        },
        {
          "type": "text",
          "id": "image_url_3",
          "label": "Image URL 3",
          "info": "Used when no image is picked above."
        },
        {
          "type": "text",
          "id": "image_alt_text_3",
          "label": "Image alt text 3",
          "info": "Leave blank for purely decorative images."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
