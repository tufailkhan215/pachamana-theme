          "label": "Text"
        },
        {
          "type": "text",
          "id": "text_2",
          "label": "Text 2"
        },
        {
          "type": "text",
          "id": "text_3",
          "label": "Text 3"
        },
        {
          "type": "text",
          "id": "text_4",
          "label": "Text 4"
        },
        {
          "type": "text",
          "id": "text_5",
          "label": "Text 5"
        },
        {
          "type": "text",
          "id": "text_6",
          "label": "Text 6"
        },
        {
          "type": "text",
          "id": "text_7",
          "label": "Text 7"
        }
      ]
    }
  ],
  "max_blocks": 50,
  "presets": [
    {
      "name": "Start: The blends"
    }
  ]
}
