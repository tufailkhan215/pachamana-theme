{%- comment -%} Pacha Mana - Bundle page: How to prepare. Converted from build-your-bundle.html; every visible string, image and link is a setting. {%- endcomment -%}
{{ 'pm_landing.css' | asset_url | stylesheet_tag }}
<section class="pm-landing" style="padding:clamp(64px,8vw,112px) 24px;">
<div style="max-width:1140px;margin:0 auto;display:flex;flex-direction:column;gap:44px;">
<div style="display:flex;flex-direction:column;gap:14px;align-items:center;text-align:center;">
<span class="pm-eyebrow pm-eyebrow--gold">{{ section.settings.eyebrow | escape }}</span>
<h2 style="font-family:var(--font-display);text-transform:uppercase;font-weight:400;letter-spacing:var(--tracking-display);font-size:clamp(30px,4vw,44px);line-height:1.1;color:var(--text-strong);margin:0;">{{ section.settings.heading | escape }}</h2>
</div>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:36px;">
{%- for block in section.blocks -%}{%- if block.type == 'card' -%}<div {{ block.shopify_attributes }} style="display:flex;flex-direction:column;gap:12px;border-top:2px solid var(--pm-gold-400);padding-top:20px;"><span style="font-family:var(--font-display);font-size:40px;color:var(--pm-gold-500);line-height:1;">{{ block.settings.label | escape }}</span><h3 style="font-family:var(--font-display);text-transform:uppercase;font-weight:400;letter-spacing:0.06em;font-size:22px;color:var(--text-strong);margin:0;">{{ block.settings.title | escape }}</h3><p style="margin:0;font-size:16px;line-height:1.7;">{{ block.settings.text | escape }}</p></div>{%- endif -%}{%- endfor -%}


</div>
</div>
</section>

{% schema %}
{
  "name": "Bundle: How to prepare",
  "tag": "div",
  "class": "pm-landing-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "max_blocks": 50,
  "presets": [
    {
      "name": "Bundle: How to prepare"
    }
  ]
}
{% endschema %}
