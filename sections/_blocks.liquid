{%- comment -%}
  Dynamic blocks section: uses content_for 'blocks' so theme blocks (ai_gen_block_*) render
  and the section can be reordered on the home page.
{%- endcomment -%}
<div class="shopify-section-blocks section-blocks-{{ section.id }}" id="shopify-section-{{ section.id }}" data-section-id="{{ section.id }}">
  {% content_for 'blocks' %}
</div>

{% schema %}
{
  "name": "Content block",
  "tag": "div",
  "class": "section-dynamic-blocks",
  "settings": [
    {
      "type": "text",
      "id": "section_label",
      "label": "Section label (for theme editor)",
      "default": "Content block"
    }
  ],
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Content block",
      "blocks": [
        {
          "type": "ai_gen_block_ee5b3bf"
        }
      ]
    }
  ]
}
{% endschema %}
