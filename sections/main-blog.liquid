  /* Blog Pagination Styles */
  .blog-pagination {
    margin: 40px 0;
    text-align: center;
  }

  .pagination-list {
    display: flex;
    justify-content: center;
    align-items: center;
    list-style: none;
    padding: 0;
    margin: 0;
    gap: 8px;
    flex-wrap: wrap;
  }

  .pagination-item {
    margin: 0;
    padding: 0;
  }

  .pagination-link,
  .pagination-link--current,
  .pagination-ellipsis {
    display: inline-block;
    padding: 10px 16px;
    min-width: 44px;
    text-align: center;
    text-decoration: none;
    border: 1px solid rgba(0, 0, 0, 0.2);
    border-radius: 4px;
    color: var(--e-global-color-secondary, #333);
    font-family: "Barlow", Sans-serif;
    font-size: 16px;
    transition: all 0.3s ease;
  }

  .pagination-link:hover {
    background-color: var(--e-global-color-5abf1e8, #f5f5f5);
    border-color: var(--e-global-color-5abf1e8, #d4a574);
  }

  .pagination-link--current {
    background-color: var(--e-global-color-secondary, #333);
    color: var(--e-global-color-5abf1e8, #fff);
    border-color: var(--e-global-color-secondary, #333);
    font-weight: 600;
    cursor: default;
  }

  .pagination-ellipsis {
    border: none;
    cursor: default;
    color: rgba(0, 0, 0, 0.5);
  }

  .pagination-link--prev,
  .pagination-link--next {
    font-weight: 500;
  }

  @media (max-width: 768px) {
    .pagination-link,
    .pagination-link--current,
    .pagination-ellipsis {
      padding: 8px 12px;
      min-width: 40px;
      font-size: 14px;
    }
  }
