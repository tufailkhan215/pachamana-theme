{%- comment -%} Pacha Mana — Learn guide: hero band. {%- endcomment -%}
{{ 'pm_learn.css' | asset_url | stylesheet_tag }}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap">

<section class="full-width pm-learn pm-learn-hero" id="pm-hero-{{ section.id }}">
  {%- if section.settings.leaf != blank -%}
    <img class="pm-learn-hero__leaf" src="{{ section.settings.leaf | image_url: width: 900 }}" alt="" loading="lazy" width="900" height="900">
  {%- elsif section.settings.leaf_url != blank -%}
    <img class="pm-learn-hero__leaf" src="{{ section.settings.leaf_url }}" alt="" loading="lazy">
  {%- endif -%}

  <div class="pm-learn-hero__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="pm-learn-hero__eyebrow"><span></span>{{ section.settings.eyebrow }}<span></span></p>
    {%- endif -%}
    {%- if section.settings.title != blank -%}
      <h1 class="pm-learn-hero__title">{{ section.settings.title }}</h1>
    {%- endif -%}
    {%- if section.settings.deck != blank -%}
      <p class="pm-learn-hero__deck">{{ section.settings.deck }}</p>
    {%- endif -%}
    {%- if section.settings.meta_read != blank or section.settings.meta_topic != blank -%}
      <p class="pm-learn-hero__meta">
        {%- if section.settings.meta_read != blank -%}<span>{{ section.settings.meta_read }}</span>{%- endif -%}
        {%- if section.settings.meta_read != blank and section.settings.meta_topic != blank -%}<i></i>{%- endif -%}
        {%- if section.settings.meta_topic != blank -%}<span>{{ section.settings.meta_topic }}</span>{%- endif -%}
      </p>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.pm-learn-hero { position: relative; overflow: hidden; background: var(--pm-sunrise); }
.pm-learn-hero__leaf {
  position: absolute; right: -50px; bottom: -40px; width: 34%;
  opacity: 0.10; pointer-events: none;
}
.pm-learn-hero__inner {
  max-width: 820px; margin: 0 auto; padding: 96px 40px 92px;
  text-align: center; position: relative; z-index: 2;
}
.pm-learn-hero__eyebrow {
  display: inline-flex; align-items: center; gap: 12px;
  font-family: var(--pm-fd); text-transform: uppercase; letter-spacing: 0.16em;
  font-size: 13px; color: var(--pm-gold-700); margin: 0 0 26px;
}
.pm-learn-hero__eyebrow span { width: 28px; height: 1px; background: var(--pm-gold-500); }
.pm-learn-hero__title {
  font-family: var(--pm-fd); text-transform: uppercase; font-weight: 400;
  font-size: clamp(34px, 6vw, 54px); line-height: 1.0; letter-spacing: 0.01em;
  color: var(--pm-cacao-700); margin: 0 0 24px;
}
.pm-learn-hero__deck {
  font-style: italic; font-size: 21px; line-height: 1.6;
  color: var(--pm-cacao-600); max-width: 34ch; margin: 0 auto 30px;
}
.pm-learn-hero__meta {
  display: inline-flex; align-items: center; gap: 20px; margin: 0;
  font-family: var(--pm-fd); text-transform: uppercase; letter-spacing: 0.12em;
  font-size: 12px; color: var(--pm-cacao-300);
}
.pm-learn-hero__meta i { width: 4px; height: 4px; border-radius: 50%; background: var(--pm-gold-500); }

@media screen and (max-width: 749px) {
  .pm-learn-hero__inner { padding: 64px 22px 60px; }
  .pm-learn-hero__deck { font-size: 18px; }
  .pm-learn-hero__meta { gap: 12px; font-size: 11px; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Learn: hero",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Series label" },
    { "type": "text", "id": "title", "label": "Title" },
    { "type": "textarea", "id": "deck", "label": "Standfirst" },
    { "type": "text", "id": "meta_read", "label": "Read time" },
    { "type": "text", "id": "meta_topic", "label": "Topic" },
    { "type": "image_picker", "id": "leaf", "label": "Watermark image" },
    { "type": "text", "id": "leaf_url", "label": "Watermark image URL" }
  ],
  "presets": [{ "name": "Learn: hero" }]
}
{% endschema %}
