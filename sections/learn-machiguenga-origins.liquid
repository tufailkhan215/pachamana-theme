      <p style="font-family: var(--font-body); font-size: 18px; line-height: 1.7; color: var(--pm-cacao-600); max-width: 48ch; margin: 0 auto 30px;">Explore our direct-trade Chuncho ceremonial cacao and support the farming families who have stewarded this lineage for generations.</p>
      <div style="display: flex; gap: 14px; justify-content: center; flex-wrap: wrap;">
        <x-import component-from-global-scope="PachaManaDesignSystem_9805b9.Button" variant="primary" size="lg">Shop Chuncho Cacao</x-import>
