{%- comment -%} Pacha Mana - Bundle page: Paste or ground. Converted from build-your-bundle.html; every visible string, image and link is a setting. {%- endcomment -%}
{{ 'pm_landing.css' | asset_url | stylesheet_tag }}
<section class="pm-landing" style="background:var(--pm-sandy-tan);padding:clamp(64px,8vw,112px) 24px;">
<div style="max-width:1140px;margin:0 auto;display:flex;flex-direction:column;gap:44px;">
<div style="display:flex;flex-direction:column;gap:14px;align-items:center;text-align:center;">
<span class="pm-eyebrow pm-eyebrow--cacao">{{ section.settings.eyebrow | escape }}</span>
<h2 style="font-family:var(--font-display);text-transform:uppercase;font-weight:400;letter-spacing:var(--tracking-display);font-size:clamp(30px,4vw,44px);line-height:1.1;color:var(--text-strong);margin:0;">{{ section.settings.heading | escape }}</h2>
<p style="margin:0;max-width:600px;font-size:17px;line-height:1.7;text-wrap:pretty;">{{ section.settings.text | escape }}</p>
</div>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:24px;">
{%- for block in section.blocks -%}{%- if block.type == 'card' -%}<div {{ block.shopify_attributes }} style="background:var(--pm-tan-50);border-radius:28px;overflow:hidden;box-shadow:var(--shadow-md);display:flex;flex-direction:column;">
<div style="position:relative;height:280px;background:#fff;"><img alt="{{ block.settings.image_alt_text | escape }}" src="{%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 800 }}{%- else -%}{{ block.settings.image_url | escape }}{%- endif -%}" style="width:100%;height:100%;object-fit:cover;display:block;min-height:100%;max-height:100%;"/><img alt="{{ block.settings.image_alt_text_2 | escape }}" src="{%- if block.settings.image_2 != blank -%}{{ block.settings.image_2 | image_url: width: 1600 }}{%- else -%}{{ block.settings.image_url_2 | escape }}{%- endif -%}" style="{% cycle "card_3_style": "position:absolute;right:12px;bottom:10px;width:120px;height:auto;filter:drop-shadow(0 4px 8px rgba(92,64,47,.22));", "position:absolute;right:12px;bottom:10px;width:130px;height:auto;filter:drop-shadow(0 4px 8px rgba(92,64,47,.22));" %}"/></div>
<div style="padding:28px;display:flex;flex-direction:column;gap:12px;">
<h3 style="font-family:var(--font-display);text-transform:uppercase;font-weight:400;letter-spacing:0.06em;font-size:24px;color:var(--text-strong);margin:0;">{{ block.settings.title | escape }}</h3>
<p style="margin:0;font-size:16px;line-height:1.7;">{{ block.settings.text | escape }}</p>
<p style="margin:0;font-size:15px;font-style:italic;color:var(--pm-gold-700);">{{ block.settings.text_2 | escape }}</p>
</div>
</div>{%- endif -%}{%- endfor -%}

</div>
</div>
</section>

{% schema %}
{
  "name": "Bundle: Paste or ground",
  "tag": "div",
  "class": "pm-landing-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Format",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_url",
          "label": "Image URL",
          "info": "Used when no image is picked above."
        },
        {
          "type": "text",
          "id": "image_alt_text",
          "label": "Image alt text",
          "info": "Leave blank for purely decorative images."
        },
        {
          "type": "image_picker",
          "id": "image_2",
          "label": "Image 2"
        },
        {
          "type": "text",
          "id": "image_url_2",
          "label": "Image URL 2",
          "info": "Used when no image is picked above."
        },
        {
          "type": "text",
          "id": "image_alt_text_2",
          "label": "Image alt text 2",
          "info": "Leave blank for purely decorative images."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "text",
          "id": "text_2",
          "label": "Text 2"
        }
      ]
    }
  ],
  "max_blocks": 50,
  "presets": [
    {
      "name": "Bundle: Paste or ground"
    }
  ]
}
{% endschema %}
