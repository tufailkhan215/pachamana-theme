													{% render 'icon-svg', icon_class: icon_class %}
												</span>
												<span class="elementor-icon-list-text">{{ icon_text }}</span>
											</li>
										{%- endif -%}
									{%- endif -%}
								{%- endfor -%}
							</ul>
						{%- endif -%}
					{%- endif -%}
