				<div class="elementor-element elementor-element-736e7e50 elementor-widget__width-inherit elementor-widget elementor-widget-woocommerce-product-images" data-id="736e7e50" data-element_type="widget" data-widget_type="woocommerce-product-images.default">
				<div class="elementor-widget-container">
					{%- if product.media.size > 0 -%}
						{%- comment -%} On load: show featured image (first image). On variant change: JS switches to variant image. {%- endcomment -%}
						{%- assign image_count = product.media.size -%}
						<div class="woocommerce-product-gallery woocommerce-product-gallery--with-images woocommerce-product-gallery--columns-4 images" data-columns="4" style="opacity: 1; transition: opacity 0.25s ease-in-out;">
							<a href="#" role="button" class="woocommerce-product-gallery__trigger" aria-haspopup="dialog" aria-controls="photoswipe-fullscreen-dialog" aria-label="View full-screen image gallery">
								<span aria-hidden="true"><img draggable="false" role="img" class="emoji" alt="≡🔍" src="https://s.w.org/images/core/emoji/17.0.2/svg/1f50d.svg"></span>
							</a>
							<div class="flex-viewport" style="overflow: hidden; position: relative; transition: none;">
								<div class="woocommerce-product-gallery__wrapper" style="transition-duration: 0s; transform: translate3d(0px, 0px, 0px);">
									{%- for media in product.media -%}
										{%- if media.media_type == 'image' -%}
											{%- assign is_first = forloop.first -%}
											{%- assign image_alt = media.alt | default: product.title | escape -%}
											{%- if forloop.index > 1 -%}
												{%- assign image_alt = image_alt | append: ' - Image ' | append: forloop.index -%}
											{%- endif -%}
											<div data-media-id="{{ media.id }}" data-thumb="{{ media | image_url: width: 100 }}" data-thumb-alt="{{ image_alt }}" class="woocommerce-product-gallery__image{% if is_first %} flex-active-slide{% endif %}" style="width: 33.3333%; margin-right: 0px; float: left; display: block; position: relative; overflow: hidden;">
												<a href="{{ media | image_url: width: 2048 }}">
													<img
														{% if is_first %}fetchpriority="high"{% else %}loading="lazy"{% endif %}
														width="{{ media.width | default: 600 }}"
														height="{{ media.height | default: 600 }}"
														src="{{ media | image_url: width: 600 }}"
														class="{% if is_first %}wp-post-image{% endif %}"
														alt="{{ image_alt }}"
														data-caption=""
														data-src="{{ media | image_url: width: 2048 }}"
														data-large_image="{{ media | image_url: width: 2048 }}"
														data-large_image_width="{{ media.width | default: 2048 }}"
														data-large_image_height="{{ media.height | default: 2048 }}"
														decoding="async"
														draggable="false"
													>
												</a>
												<img alt="" src="{{ media | image_url: width: 2048 }}" class="zoomImg" style="position: absolute; top: 0px; left: 0px; opacity: 0; width: {{ media.width | default: 2048 }}px; height: {{ media.height | default: 2048 }}px; border: none; max-width: none; max-height: none; z-index: 10;" aria-hidden="true">
											</div>
										{%- endif -%}
									{%- endfor -%}
								</div>
							</div>
							<ol class="flex-control-nav flex-control-thumbs">
								{%- for media in product.media -%}
									{%- if media.media_type == 'image' -%}
										{%- assign is_first_thumb = forloop.first -%}
										{%- assign image_alt = media.alt | default: product.title | escape -%}
										{%- if forloop.index > 1 -%}
											{%- assign image_alt = image_alt | append: ' - Image ' | append: forloop.index -%}
										{%- endif -%}
										<li>
											<img
												onload="this.width = this.naturalWidth; this.height = this.naturalHeight"
												src="{{ media | image_url: width: 100 }}"
												alt="{{ image_alt }}"
												class="{% if is_first_thumb %}flex-active{% endif %}"
												draggable="false"
												width="100"
												height="100"
											>
										</li>
									{%- endif -%}
								{%- endfor -%}
							</ol>
						</div>
						{%- comment -%} Variant → media ID mapping (for switching main image when variant changes) {%- endcomment -%}
						{%- liquid
							assign variant_image_pairs = ''
							assign pair_count = 0
							assign first_image_media_id = nil
							for media in product.media
								if media.media_type == 'image' and first_image_media_id == nil
									assign first_image_media_id = media.id
									break
								endif
							endfor
							for variant in product.variants
								assign media_id = nil
								if variant.featured_media != blank
									assign media_id = variant.featured_media.id
								elsif variant.featured_image != blank
									for media in product.media
										if media.media_type == 'image'
											if media.preview_image.id == variant.featured_image.id or media.id == variant.featured_image.id
												assign media_id = media.id
												break
											endif
										endif
									endfor
								endif
								if media_id == nil and first_image_media_id != nil
									assign media_id = first_image_media_id
								endif
								if media_id != nil
									if pair_count > 0
										assign variant_image_pairs = variant_image_pairs | append: ','
									endif
									assign variant_image_pairs = variant_image_pairs | append: '"' | append: variant.id | append: '":' | append: media_id
									assign pair_count = pair_count | plus: 1
								endif
							endfor
						-%}
						<script type="application/json" id="product-variant-images-{{ product.id }}">{"{{ product.id }}":{ {{ variant_image_pairs }} }}</script>
						<script>
							(function() {
								var el = document.getElementById('product-variant-images-{{ product.id }}');
								if (el) {
									try {
										var data = JSON.parse(el.textContent || '{}');
										window.PRODUCT_VARIANT_IMAGES = data["{{ product.id }}"] || {};
									} catch (e) {
										window.PRODUCT_VARIANT_IMAGES = {};
									}
								}
							})();
						</script>
					{%- endif -%}
				</div>
				</div>
				</div>
				</div>
