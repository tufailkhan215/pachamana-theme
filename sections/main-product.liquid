											{%- if related_product.price_varies -%}
												<span class="woocommerce-Price-amount amount" aria-hidden="true">
													<bdi>{{ related_product.price_min | money }}</bdi>
												</span>
												<span aria-hidden="true">–</span>
												<span class="woocommerce-Price-amount amount" aria-hidden="true">
													<bdi>{{ related_product.price_max | money }}</bdi>
												</span>
												<span class="screen-reader-text">Price range: {{ related_product.price_min | money }} through {{ related_product.price_max | money }}</span>
											{%- else -%}
												{%- if related_product.compare_at_price > related_product.price -%}
													<del aria-hidden="true">
														<span class="woocommerce-Price-amount amount">
															<bdi>{{ related_product.compare_at_price | money }}</bdi>
														</span>
													</del>
													<ins aria-hidden="true">
														<span class="woocommerce-Price-amount amount">
															<bdi>{{ related_product.price | money }}</bdi>
														</span>
													</ins>
												{%- else -%}
													<span class="woocommerce-Price-amount amount">
														<bdi>{{ related_product.price | money }}</bdi>
													</span>
												{%- endif -%}
											{%- endif -%}

										</p>
