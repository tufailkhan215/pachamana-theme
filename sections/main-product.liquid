		{%- comment -%} Get related products from the same collection {%- endcomment -%}
		{%- liquid
			assign related_products_array = blank
			assign related_count = 0
			assign max_related = 3
			
			comment
				First, try to get products from the same collection
			endcomment
			if product.collections.size > 0
				assign first_collection = product.collections.first
				for collection_product in first_collection.products limit: 10
					if collection_product.id != product.id
						if related_products_array == blank
							assign related_products_array = collection_product.handle
							assign related_count = 1
						else
							assign related_products_array = related_products_array | append: ',' | append: collection_product.handle
							assign related_count = related_count | plus: 1
						endif
						if related_count >= max_related
							break
						endif
					endif
				endfor
			endif
			
			comment
				If we don't have enough related products, supplement with products from all products
			endcomment
			if related_count < max_related
				for all_product in collections.all.products limit: 20
					assign is_duplicate = false
					if related_products_array != blank
						assign related_handles = related_products_array | split: ','
						for handle in related_handles
							if handle == all_product.handle
								assign is_duplicate = true
								break
							endif
						endfor
					endif
					if all_product.id != product.id and is_duplicate == false
						if related_products_array == blank
							assign related_products_array = all_product.handle
							assign related_count = 1
						else
							assign related_products_array = related_products_array | append: ',' | append: all_product.handle
							assign related_count = related_count | plus: 1
						endif
						if related_count >= max_related
							break
						endif
					endif
				endfor
			endif
		-%}
		{%- if related_products_array != blank -%}
			{%- assign related_handles = related_products_array | split: ',' -%}
			{%- for handle in related_handles limit: max_related -%}
				{%- assign related_product = all_products[handle] -%}
				{%- if related_product == blank -%}
					{%- for prod in collections.all.products -%}
						{%- if prod.handle == handle -%}
							{%- assign related_product = prod -%}
							{%- break -%}
						{%- endif -%}
					{%- endfor -%}
				{%- endif -%}
				{%- if related_product != blank and related_product.id != product.id -%}
					{%- liquid
						assign product_type_class = 'product-type-simple'
						if related_product.has_only_default_variant == false
							assign product_type_class = 'product-type-variable'
						endif
						
						assign stock_class = 'instock'
						unless related_product.available
							assign stock_class = 'outofstock'
						endunless
						
						assign thumbnail_class = ''
						if related_product.featured_image
							assign thumbnail_class = 'has-post-thumbnail'
						endif
						
						assign subscription_class = ''
						if related_product.metafields.custom.subscription_discount != blank or related_product.metafields.my_fields.subscription_discount != blank
							assign subscription_class = 'has-subscription-plans'
						endif
					-%}
					<div data-elementor-type="loop-item" data-elementor-id="292" class="elementor elementor-292 e-loop-item e-loop-item-{{ related_product.id }} post-{{ related_product.id }} product type-product status-publish {{ thumbnail_class }} {{ stock_class }} taxable shipping-taxable purchasable {{ product_type_class }} {{ subscription_class }}" data-elementor-post-type="elementor_library" data-custom-edit-handle="1">
						<div class="elementor-element elementor-element-a402c48 e-flex e-con-boxed e-con e-parent elementor-animation-fadeIn" data-id="a402c48" data-element_type="container" data-settings="{&quot;background_background&quot;:&quot;classic&quot;,&quot;animation&quot;:&quot;fadeIn&quot;}">
