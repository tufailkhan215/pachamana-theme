				<div class="elementor-element elementor-element-01eff30 elementor-icon-list--layout-traditional elementor-list-item-link-full_width elementor-widget elementor-widget-icon-list" data-id="01eff30" data-element_type="widget" data-widget_type="icon-list.default">
				<div class="elementor-widget-container">
					{%- comment -%} Dynamic Icon List from Metafield {%- endcomment -%}
					{%- liquid
						assign icon_list_metafield = blank
						assign has_metafield_items = false
						
						if product.metafields.custom.icon_list != blank
							assign icon_list_metafield = product.metafields.custom.icon_list
							
							if icon_list_metafield.value.size > 0
								assign has_metafield_items = true
							endif
						elsif product.metafields.my_fields.icon_list != blank
							assign icon_list_metafield = product.metafields.my_fields.icon_list
							if icon_list_metafield.value.size > 0
								assign has_metafield_items = true
							endif
						endif
					-%}
					{%- if has_metafield_items -%}
						{%- comment -%} Handle list metafield - loop through values {%- endcomment -%}
						{%- assign rendered_count = 0 -%}
						{%- for item in icon_list_metafield.value -%}
							{%- assign item_parts = item | split: '|' -%}
							{%- if item_parts.size >= 2 -%}
								{%- assign icon_class = item_parts[0] | strip -%}
								{%- assign icon_text = item_parts[1] | strip -%}
								{%- if icon_class != blank and icon_text != blank -%}
									{%- assign rendered_count = rendered_count | plus: 1 -%}
								{%- endif -%}
							{%- endif -%}
						{%- endfor -%}
