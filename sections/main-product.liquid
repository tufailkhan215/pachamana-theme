  .elementor-454 .elementor-element.elementor-element-f6b00ca:not(.elementor-motion-effects-element-type-background),
  .elementor-454 .elementor-element.elementor-element-f6b00ca > .elementor-motion-effects-container > .elementor-motion-effects-layer {
    background-image: url('{{ product_featured_image_url }}');
    background-position: center center;
    background-repeat: no-repeat;
    background-size: cover;
  }
</style>
{%- endif -%}

