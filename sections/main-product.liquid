{%- liquid
  comment
    Get product featured image URL for background
  endcomment
  assign product_featured_image_url = blank
  if product.featured_image != blank
    assign product_featured_image_url = product.featured_image | image_url: width: 1920
  endif
-%}

{%- if product_featured_image_url != blank -%}
