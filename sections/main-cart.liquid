		<div class="elementor-element elementor-element-9e3f199 e-flex e-con-boxed e-con e-child" data-id="9e3f199" data-element_type="container" data-settings="{&quot;background_background&quot;:&quot;classic&quot;}">
					<div class="e-con-inner">
				<div class="elementor-element elementor-element-7d143d1 elementor-widget elementor-widget-heading" data-id="7d143d1" data-element_type="widget" data-widget_type="heading.default">
				<div class="elementor-widget-container">
					<h2 class="elementor-heading-title elementor-size-default">{{ page.title }}</h2>
				</div>
				</div>
				<div class="elementor-element elementor-element-cdd93b1 elementor-widget-divider--separator-type-pattern elementor-widget-divider--no-spacing elementor-widget-divider--view-line elementor-widget elementor-widget-divider" data-id="cdd93b1" data-element_type="widget" data-widget_type="divider.default">
