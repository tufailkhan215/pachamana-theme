{%- comment -%}
  Pacha Mana - Start page: scrolling strip of brand promises.
  The item list is rendered twice (the second copy aria-hidden) so the marquee can
  loop seamlessly; editors only maintain one list of blocks.
{%- endcomment -%}
{{ 'pm_landing.css' | asset_url | stylesheet_tag }}
<div class="pm-landing" style="background:var(--pm-soft-black);color:var(--pm-pearl-white);overflow:hidden;padding:14px 0;border-top:1px solid var(--pm-cacao-600);">
  <div class="pm-marquee" style="display:flex;width:max-content;animation:pm-marquee {{ section.settings.speed }}s linear infinite;">
    {%- for copy in (1..2) -%}
      <div style="display:flex;flex:0 0 auto;"{% if copy == 2 %} aria-hidden="true"{% endif %}>
        {%- for block in section.blocks -%}
          <span style="display:flex;align-items:center;gap:22px;padding-right:22px;font-family:var(--font-display);text-transform:uppercase;letter-spacing:0.14em;font-size:13px;white-space:nowrap;"{% if copy == 1 %} {{ block.shopify_attributes }}{% endif %}>{{ block.settings.text | escape }}<span style="color:var(--pm-gold-400);">{{ section.settings.separator | escape }}</span></span>
        {%- endfor -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Start: Strip",
  "tag": "div",
  "class": "pm-landing-section",
  "settings": [
    { "type": "text", "id": "separator", "label": "Separator", "default": "✦" },
    { "type": "range", "id": "speed", "label": "Loop duration", "min": 20, "max": 120, "step": 5, "unit": "s", "default": 70 }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Promise",
      "settings": [
        { "type": "text", "id": "text", "label": "Text" }
      ]
    }
  ],
  "max_blocks": 30,
  "presets": [{ "name": "Start: Strip" }]
}
{% endschema %}
