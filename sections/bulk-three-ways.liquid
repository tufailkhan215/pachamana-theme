<section class="pmw pmw-3way" id="pmw-{{ section.id }}">
  {% render 'bulk-bg', section: section %}
  <div class="pmw__inner pmw-3way__inner">
    <div class="pmw-3way__head">
      {% if section.settings.eyebrow != blank %}<span class="pmw-eyebrow">{{ section.settings.eyebrow }}</span>{% endif %}
      <h2 class="pmw-3way__title">{{ section.settings.headline }}</h2>
      {% if section.settings.subhead != blank %}<p class="pmw-3way__sub">{{ section.settings.subhead }}</p>{% endif %}
    </div>
    <div class="pmw-3way__grid">
      {% for block in section.blocks %}
        {% if block.type == 'size_card' %}
          <div class="pmw-3way__card" {{ block.shopify_attributes }}>
            {% if block.settings.tag != blank %}<span class="pmw-3way__tag">{{ block.settings.tag }}</span>{% endif %}
            <div class="pmw-3way__size">{{ block.settings.size }}</div>
            <p class="pmw-3way__desc">{{ block.settings.description }}</p>
            <div class="pmw-3way__rule"></div>
            <div class="pmw-3way__price">{{ block.settings.price_label }}</div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<style>
  #pmw-{{ section.id }}.pmw-3way { padding: 0; }
  #pmw-{{ section.id }} .pmw-3way__inner { padding: 90px 64px; max-width: 1120px; margin: 0 auto; }
  #pmw-{{ section.id }} .pmw-3way__head { margin-bottom: 44px; }
  #pmw-{{ section.id }} .pmw-3way__title { margin: 14px 0 10px; font-size: 40px; }
  #pmw-{{ section.id }} .pmw-3way__sub { margin: 0; max-width: 580px; font-size: 17px; line-height: 1.7; color: var(--page-muted); }
  #pmw-{{ section.id }} .pmw-3way__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 22px; }
  #pmw-{{ section.id }} .pmw-3way__card { background: var(--card-bg); border: 1px solid var(--card-border); border-radius: 18px; box-shadow: var(--card-shadow); padding: 36px 32px; text-align: center; }
  #pmw-{{ section.id }} .pmw-3way__tag { display: inline-block; margin-bottom: 16px; background: var(--pm-sunshine-gold); color: var(--pm-cacao-700); font-family: var(--font-display); text-transform: uppercase; letter-spacing: .08em; font-size: 11px; padding: 5px 14px; border-radius: 999px; }
  #pmw-{{ section.id }} .pmw-3way__size { font-family: var(--font-display); text-transform: uppercase; letter-spacing: .04em; font-size: 34px; color: var(--page-text); line-height: 1; }
  #pmw-{{ section.id }} .pmw-3way__desc { margin: 14px 0 22px; font-size: 14px; line-height: 1.6; color: var(--page-muted); min-height: 44px; }
  #pmw-{{ section.id }} .pmw-3way__rule { height: 1px; background: var(--card-border); margin-bottom: 18px; }
  #pmw-{{ section.id }} .pmw-3way__price { font-family: var(--font-display); font-size: 22px; color: var(--page-muted); line-height: 1; }
  @media (max-width: 768px) { #pmw-{{ section.id }} .pmw-3way__inner { padding: 64px 20px; } }
</style>

{% schema %}
{
  "name": "Bulk — Three Sizes",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Background" },
    { "type": "select", "id": "bg_type", "label": "Background type", "default": "color",
      "options": [{"value":"color","label":"Color"},{"value":"image","label":"Image"}] },
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#f9f2ef" },
    { "type": "image_picker", "id": "bg_image", "label": "Background image" },
    { "type": "range", "id": "bg_opacity", "label": "Background opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "color", "id": "bg_overlay_color", "label": "Image overlay color", "default": "#000000" },
    { "type": "range", "id": "bg_overlay_opacity", "label": "Image overlay opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 0 },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Pick Your Size" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "Three Ways To Stock Up" },
    { "type": "textarea", "id": "subhead", "label": "Subhead", "default": "Start small or go all in — every size counts toward your volume discount." }
  ],
  "blocks": [
    { "type": "size_card", "name": "Size card", "limit": 6, "settings": [
      { "type": "text", "id": "tag", "label": "Tag", "default": "Half Pound" },
      { "type": "text", "id": "size", "label": "Size", "default": "8 oz" },
      { "type": "textarea", "id": "description", "label": "Description", "default": "A few weeks of daily cups, or a smaller circle. Counts toward your by-the-bag weight." },
      { "type": "text", "id": "price_label", "label": "Price label", "default": "Sold by the bag" }
    ]}
  ],
  "presets": [{
    "name": "Bulk — Three Sizes",
    "blocks": [
      { "type": "size_card", "settings": { "tag": "Half Pound", "size": "8 oz", "description": "A few weeks of daily cups, or a smaller circle. Counts toward your by-the-bag weight.", "price_label": "Sold by the bag" } },
      { "type": "size_card", "settings": { "tag": "Most Loved", "size": "1 lb", "description": "The everyday ceremonial size — the best balance of value and freshness.", "price_label": "Sold by the bag" } },
      { "type": "size_card", "settings": { "tag": "Bulk Bag", "size": "5 lb", "description": "For people who move through a lot of cacao — ground or paste, at the deepest standing discount.", "price_label": "$230 / bag" } }
    ]
  }]
}
{% endschema %}
