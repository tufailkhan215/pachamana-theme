  <script>
    (function() {
      'use strict';
      
      // Track which elements have been animated to prevent re-animation
      var animatedElements = new Set();
      
      // Trigger animation for an element
      function triggerAnimation(el, animation, delay) {
        // Skip if already animated
        if (animatedElements.has(el)) {
          return;
        }
        
        animatedElements.add(el);
        
        setTimeout(function() {
          // Remove invisible class
          el.classList.remove('elementor-invisible');
          
          // Add animation class if not already present
          if (animation && animation !== 'none') {
            var animationClass = 'elementor-animation-' + animation;
            if (!el.classList.contains(animationClass)) {
              el.classList.add(animationClass);
            }
          }
          
          // Trigger reflow to ensure animation starts
          el.offsetHeight;
        }, delay || 0);
      }
      
      // Initialize Elementor animations with Intersection Observer (scroll-triggered)
      function initElementorAnimations() {
        // Check if Intersection Observer is supported
        if (typeof IntersectionObserver === 'undefined') {
          // Fallback: animate all elements immediately
          var invisibleElements = document.querySelectorAll('.elementor-invisible');
          invisibleElements.forEach(function(el, index) {
            var settings = el.getAttribute('data-settings');
            var animation = 'fadeIn';
            var delay = 0;
            
            if (settings) {
              try {
                var parsed = JSON.parse(settings);
                animation = parsed._animation || parsed.animation || 'fadeIn';
                delay = parseInt(parsed._animation_delay || parsed.animation_delay || 0);
              } catch(e) {}
            }
            
            triggerAnimation(el, animation, delay + (index * 100));
          });
          return;
        }
        
        // Use Intersection Observer for scroll-triggered animations
        var observerOptions = {
          root: null,
          rootMargin: '0px',
          threshold: 0.1 // Trigger when 10% of element is visible
        };
        
        var observer = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              var el = entry.target;
              var settings = el.getAttribute('data-settings');
              var animation = 'fadeIn';
              var delay = 0;
              
              if (settings) {
                try {
                  var parsed = JSON.parse(settings);
                  animation = parsed._animation || parsed.animation || 'fadeIn';
                  delay = parseInt(parsed._animation_delay || parsed.animation_delay || 0);
                } catch(e) {}
              }
              
              triggerAnimation(el, animation, delay);
              
              // Stop observing once animated
              observer.unobserve(el);
            }
          });
        }, observerOptions);
        
        // Observe all invisible elements
        var invisibleElements = document.querySelectorAll('.elementor-invisible');
        invisibleElements.forEach(function(el) {
          observer.observe(el);
        });
        
        // Also observe elements with animation but no invisible class
        var elementsWithAnimation = document.querySelectorAll('[data-settings*="animation"]:not(.elementor-invisible)');
        elementsWithAnimation.forEach(function(el) {
          if (!animatedElements.has(el)) {
            observer.observe(el);
          }
        });
        
        // Fallback: If elements are already in viewport, animate them immediately
        setTimeout(function() {
          invisibleElements.forEach(function(el) {
            var rect = el.getBoundingClientRect();
            var isInViewport = rect.top < window.innerHeight && rect.bottom > 0;
            if (isInViewport && !animatedElements.has(el)) {
              var settings = el.getAttribute('data-settings');
              var animation = 'fadeIn';
              var delay = 0;
              
              if (settings) {
                try {
                  var parsed = JSON.parse(settings);
                  animation = parsed._animation || parsed.animation || 'fadeIn';
                  delay = parseInt(parsed._animation_delay || parsed.animation_delay || 0);
                } catch(e) {}
              }
              
              triggerAnimation(el, animation, delay);
              observer.unobserve(el);
            }
          });
        }, 100);
