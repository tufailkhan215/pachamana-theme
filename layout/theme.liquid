  {%- comment -%} Enhanced Animation Support - Handle elementor-invisible and trigger animations {%- endcomment -%}
  <script>
    (function() {
      'use strict';
      
      // Initialize Elementor animations
      function initElementorAnimations() {
        // Remove elementor-invisible class and trigger animations
        var invisibleElements = document.querySelectorAll('.elementor-invisible');
        
        invisibleElements.forEach(function(el, index) {
          // Get animation settings from data attribute
          var settings = el.getAttribute('data-settings');
          var animation = 'fadeIn'; // default
          var delay = 0;
          
          if (settings) {
            try {
              var parsed = JSON.parse(settings);
              if (parsed._animation) {
                animation = parsed._animation;
              }
              if (parsed._animation_delay) {
                delay = parseInt(parsed._animation_delay) || 0;
              }
            } catch(e) {
              // If parsing fails, use defaults
            }
          }
          
          // Calculate delay: base delay + animation delay + staggered delay
          var totalDelay = delay + (index * 100);
          
          setTimeout(function() {
            // Remove invisible class
            el.classList.remove('elementor-invisible');
            
            // Add animation class if not already present
            if (animation && !el.classList.contains('elementor-animation-' + animation)) {
              el.classList.add('elementor-animation-' + animation);
            }
            
            // Trigger reflow to ensure animation starts
            el.offsetHeight;
          }, totalDelay);
        });
      }
      
      // Initialize on DOM ready
