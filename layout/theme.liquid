                      }
                    }
                  }
                  if (!this.config.kit.activeBreakpoints) {
                    this.config.kit.activeBreakpoints = this.config.activeBreakpoints || activeBreakpointsArray;
                  }
                  if (!this.config.kit.active_breakpoints) {
                    this.config.kit.active_breakpoints = this.config.activeBreakpoints || activeBreakpointsArray;
                  }
                  // Call original method with proper context
                  if (originalMethod && typeof originalMethod === 'function') {
                    return originalMethod.apply(this, arguments);
                  }
                } catch(err) {
