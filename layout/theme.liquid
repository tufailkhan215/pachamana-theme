  {%- comment -%} Elementor Frontend Initialization and Background Image Support {%- endcomment -%}
  <script>
    (function() {
      'use strict';
      
      // Initialize Elementor Frontend after all scripts load
      var initAttempts = 0;
      var maxInitAttempts = 20; // Limit retry attempts
      var initComplete = false; // Prevent multiple initializations
      
      function initElementorFrontend() {
        // Prevent multiple initializations
        if (initComplete) return;
        
        // Check if elementorFrontend exists and is not null
        if (typeof window.elementorFrontend !== 'undefined' && window.elementorFrontend !== null && window.elementorFrontend) {
          try {
            // Initialize Elementor Frontend if not already initialized
            if (window.elementorFrontend.init && typeof window.elementorFrontend.init === 'function') {
              if (!window.elementorFrontend.isEditMode) {
                if (!window.elementorFrontend.config) {
                  window.elementorFrontend.config = window.elementorFrontendConfig || {};
                }
                // Call init if it hasn't been called
                try {
                  window.elementorFrontend.init();
                } catch(e) {
                  // Already initialized or error - this is fine, don't log
                }
              }
              // Trigger Elementor initialization events
              if (typeof jQuery !== 'undefined') {
                try {
                  jQuery(document).trigger('elementor/frontend/init');
                  jQuery(window).trigger('elementor/frontend/init');
                } catch(e) {
                  // jQuery might not be ready, that's okay
                }
              }
            }
            
            initComplete = true;
            
            // Apply background images and styles
            setTimeout(function() {
              applyBackgroundImagesFromCSS();
              applyElementorStyles();
              initMotionEffects();
            }, 500);
          } catch(e) {
            // Only log if it's a meaningful error (not null reference)
            if (e && e.message && !e.message.includes('null') && !e.message.includes('Cannot read properties of null')) {
              console.warn('Elementor Frontend initialization error:', e);
            }
            // Fallback: apply styles anyway
            initComplete = true;
            setTimeout(function() {
              applyBackgroundImagesFromCSS();
              applyElementorStyles();
            }, 1000);
          }
        } else {
          // Elementor not loaded yet, try again (with limit)
          initAttempts++;
          if (initAttempts < maxInitAttempts) {
            setTimeout(initElementorFrontend, 200);
          } else {
            // After max attempts, just apply styles without Elementor
            initComplete = true;
            setTimeout(function() {
              applyBackgroundImagesFromCSS();
              applyElementorStyles();
            }, 500);
          }
        }
      }
      
      // Apply Elementor styles from data-settings
      function applyElementorStyles() {
        var elements = document.querySelectorAll('.elementor-element[data-settings]');
        elements.forEach(function(el) {
          try {
            var settings = el.getAttribute('data-settings');
            if (settings) {
              var parsed = JSON.parse(settings);
              
              // Apply background styles if present
              if (parsed.background_background === 'classic' && parsed.background_image) {
                var bgUrl = parsed.background_image.url;
                if (bgUrl) {
                  var motionLayer = el.querySelector('.elementor-motion-effects-layer');
                  if (motionLayer) {
                    motionLayer.style.backgroundImage = 'url("' + bgUrl + '")';
                    motionLayer.style.backgroundSize = 'cover';
                    motionLayer.style.backgroundPosition = 'center center';
                  } else {
                    el.style.backgroundImage = 'url("' + bgUrl + '")';
                    el.style.backgroundSize = 'cover';
                    el.style.backgroundPosition = 'center center';
                  }
                }
              }
            }
          } catch(e) {
            // Skip if parsing fails
          }
        });
      }
      
      // Apply background images from CSS files - ensure they're visible
      function applyBackgroundImagesFromCSS() {
        // Ensure motion effects containers and layers exist
        var elementsWithMotion = document.querySelectorAll('.elementor-element[data-settings*="motion_fx"], .elementor-element[data-id="f74e63a"], .elementor-element[data-id="4d8192a"], .elementor-element[data-id="13691562"]');
        
        elementsWithMotion.forEach(function(el) {
          // Create motion effects container if it doesn't exist
          var motionContainer = el.querySelector('.elementor-motion-effects-container');
          if (!motionContainer && el.hasAttribute('data-settings')) {
            try {
              var settings = JSON.parse(el.getAttribute('data-settings'));
              if (settings.background_motion_fx_motion_fx_mouse || settings.background_background === 'classic') {
                motionContainer = document.createElement('div');
                motionContainer.className = 'elementor-motion-effects-container';
                el.style.position = 'relative';
                el.insertBefore(motionContainer, el.firstChild);
                
                var motionLayer = document.createElement('div');
                motionLayer.className = 'elementor-motion-effects-layer';
                motionContainer.appendChild(motionLayer);
              }
            } catch(e) {
              // Skip if parsing fails
            }
          }
          
          // Ensure background images from CSS are applied
          var computedStyle = window.getComputedStyle(el);
          var bgImage = computedStyle.backgroundImage;
          
          if (bgImage && bgImage !== 'none' && bgImage !== '') {
            var motionLayer = el.querySelector('.elementor-motion-effects-layer');
            if (motionLayer) {
              motionLayer.style.backgroundImage = bgImage;
              motionLayer.style.backgroundSize = computedStyle.backgroundSize || 'cover';
              motionLayer.style.backgroundPosition = computedStyle.backgroundPosition || 'center center';
              motionLayer.style.backgroundRepeat = computedStyle.backgroundRepeat || 'no-repeat';
            }
          }
        });
      }
      
      // Initialize motion effects
      function initMotionEffects() {
        if (typeof window.elementorFrontend !== 'undefined' && window.elementorFrontend.modules) {
          try {
            // Try to initialize motion effects module
            if (window.elementorFrontend.modules.motionEffects) {
              var motionElements = document.querySelectorAll('[data-settings*="motion_fx"]');
              motionElements.forEach(function(el) {
                try {
                  // Elementor should handle this, but ensure it's triggered
                  if (typeof jQuery !== 'undefined') {
                    jQuery(el).trigger('elementor/motion-effects/init');
                  }
                } catch(e) {
                  // Silently fail
                }
              });
            }
          } catch(e) {
            // Motion effects not available
          }
        }
      }
      
      // Initialize when DOM is ready
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function() {
          setTimeout(initElementorFrontend, 300);
          setTimeout(initElementorFrontend, 1000);
        });
      } else {
        setTimeout(initElementorFrontend, 300);
        setTimeout(initElementorFrontend, 1000);
      }
      
      // Ensure Elementor parent classes exist for CSS selectors
      function ensureElementorClasses() {
        // Header should have elementor-57 class
        var header = document.querySelector('.section-header, header.section-header');
        if (header && !header.classList.contains('elementor-57')) {
          header.classList.add('elementor', 'elementor-57', 'elementor-location-header');
        }
        
        // Footer should have elementor-191 class
        var footer = document.querySelector('.section-footer, footer.section-footer');
        if (footer && !footer.classList.contains('elementor-191')) {
          footer.classList.add('elementor', 'elementor-191', 'elementor-location-footer');
        }
        
        // Main content wrapper should have elementor-48 and elementor-63 classes
        // These are now added in the HTML structure, but verify they exist
        var elementor48 = document.querySelector('[data-elementor-id="48"]');
        if (elementor48 && !elementor48.classList.contains('elementor-48')) {
          elementor48.classList.add('elementor', 'elementor-48', 'elementor-location-single', 'post-63', 'page', 'type-page', 'status-publish', 'hentry');
        }
        
        var elementor63 = document.querySelector('[data-elementor-id="63"]');
        if (elementor63 && !elementor63.classList.contains('elementor-63')) {
          elementor63.classList.add('elementor', 'elementor-63');
        }
      }
      
      // Initialize when DOM is ready
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function() {
          ensureElementorClasses();
          setTimeout(initElementorFrontend, 300);
          setTimeout(initElementorFrontend, 1000);
        });
      } else {
        ensureElementorClasses();
        setTimeout(initElementorFrontend, 300);
        setTimeout(initElementorFrontend, 1000);
      }
      
      // Also initialize after window load
      window.addEventListener('load', function() {
        ensureElementorClasses();
        setTimeout(initElementorFrontend, 500);
        setTimeout(applyBackgroundImagesFromCSS, 1000);
        setTimeout(applyElementorStyles, 1500);
      });
    })();
  </script>
  
