  {%- comment -%} Accordion Fallback JS {%- endcomment -%}
  <script id="accordion-fallback-js">
    // Accordion functionality: visibility and click handlers
    (function() {
      function initAccordion() {
        if (typeof jQuery !== 'undefined') {
          jQuery(document).ready(function($) {
            // Initialize: Show items with active-default class
            $('.theplus-accordion-wrapper .plus-accordion-header.active-default, .theplus-accordion-wrapper .plus-accordion-content.active-default').each(function() {
              var $element = $(this);
              var $item = $element.closest('.theplus-accordion-item');
              var $header = $item.find('.plus-accordion-header').first();
              var $content = $item.find('.plus-accordion-content').first();
              if ($header.length && $content.length) {
                $header.addClass('active');
                $content.show();
              }
            });
            
            // Wait for accordion script to initialize, then check if items are still invisible
            setTimeout(function() {
              $('.theplus-accordion-wrapper.tp-stageraccr .theplus-accordion-item').each(function() {
                var $item = $(this);
                var opacity = parseFloat($item.css('opacity'));
                if (isNaN(opacity) || opacity === 0) {
                  $item.css({
                    'opacity': '1',
                    'transition': 'opacity 0.5s ease-in-out'
                  });
                }
              });
            }, 2000);
            
            // Add click handler for accordion functionality
            $(document).on('click', '.theplus-accordion-wrapper .plus-accordion-header', function(e) {
              e.preventDefault();
              e.stopPropagation();
              var $header = $(this);
              var $item = $header.closest('.theplus-accordion-item');
              var $content = $item.find('.plus-accordion-content');
              var $wrapper = $header.closest('.theplus-accordion-wrapper');
              var isActive = $header.hasClass('active');
              var accordionType = $wrapper.data('accordion-type') || 'accordion';
              
              // If accordion type (not toggle), close other items
              if (accordionType === 'accordion' && !isActive) {
                $wrapper.find('.plus-accordion-header.active').removeClass('active');
                $wrapper.find('.plus-accordion-content').not($content).slideUp(300).removeClass('active-default');
              }
              
              // Toggle current item
              if (isActive) {
                $header.removeClass('active');
                $content.slideUp(300).removeClass('active-default');
              } else {
                $header.addClass('active');
                $content.slideDown(300).addClass('active-default');
              }
            });
          });
        } else {
          // If jQuery isn't loaded, use vanilla JS
          document.addEventListener('DOMContentLoaded', function() {
            // Initialize: Show items with active-default class
            var defaultActive = document.querySelectorAll('.theplus-accordion-wrapper .plus-accordion-header.active-default, .theplus-accordion-wrapper .plus-accordion-content.active-default');
            defaultActive.forEach(function(element) {
              var item = element.closest('.theplus-accordion-item');
              if (item) {
                var header = item.querySelector('.plus-accordion-header');
                var content = item.querySelector('.plus-accordion-content');
                if (header && content) {
                  header.classList.add('active');
                  content.style.display = 'block';
                  content.classList.add('active-default');
                }
              }
            });
            
            setTimeout(function() {
              var items = document.querySelectorAll('.theplus-accordion-wrapper.tp-stageraccr .theplus-accordion-item');
              items.forEach(function(item) {
                var opacity = parseFloat(window.getComputedStyle(item).opacity);
                if (isNaN(opacity) || opacity === 0) {
                  item.style.opacity = '1';
                  item.style.transition = 'opacity 0.5s ease-in-out';
                }
              });
            }, 2000);
            
            // Add click handler for accordion functionality (vanilla JS)
            document.addEventListener('click', function(e) {
              var header = e.target.closest('.theplus-accordion-wrapper .plus-accordion-header');
              if (!header) return;
              
              e.preventDefault();
              e.stopPropagation();
              
              var item = header.closest('.theplus-accordion-item');
              var content = item.querySelector('.plus-accordion-content');
              var wrapper = header.closest('.theplus-accordion-wrapper');
              var isActive = header.classList.contains('active');
              var accordionType = wrapper.getAttribute('data-accordion-type') || 'accordion';
              
              // If accordion type (not toggle), close other items
              if (accordionType === 'accordion' && !isActive) {
                var activeHeaders = wrapper.querySelectorAll('.plus-accordion-header.active');
                activeHeaders.forEach(function(activeHeader) {
                  activeHeader.classList.remove('active');
                  var activeItem = activeHeader.closest('.theplus-accordion-item');
                  var activeContent = activeItem ? activeItem.querySelector('.plus-accordion-content') : null;
                  if (activeContent) {
                    activeContent.style.display = 'none';
                    activeContent.classList.remove('active-default');
                  }
                });
              }
              
              // Toggle current item
              if (isActive) {
                header.classList.remove('active');
                if (content) {
                  content.style.display = 'none';
                  content.classList.remove('active-default');
                }
              } else {
                header.classList.add('active');
                if (content) {
                  content.style.display = 'block';
                  content.classList.add('active-default');
                }
              }
            });
          });
        }
      }
      
      // Initialize immediately and also on DOM ready
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initAccordion);
      } else {
        initAccordion();
      }
    })();
  </script>

