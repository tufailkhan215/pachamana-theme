        },
        "post":{"id":63,"title":"{{ page.title | escape }}","excerpt":"","featuredImage":false}
      };
      
      // Set global config
      window.elementorFrontendConfig = config;
      var elementorFrontendConfig = config; // Legacy support
      
      // Elementor Pro Frontend Configuration (stub to prevent errors)
      window.ElementorProFrontendConfig = window.ElementorProFrontendConfig || {
        "urls": {
          "assets": "{{ 'assets' | asset_url }}"
        },
        "settings": {},
        "activeBreakpoints": activeBreakpointsArray
      };
      
      // Intercept Elementor Frontend initialization to ensure config is always available
      // This must run BEFORE Elementor JS loads
      var originalElementorFrontend = null;
      var elementorFrontendProxy = new Proxy({}, {
