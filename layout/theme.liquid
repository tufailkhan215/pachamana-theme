    (function() {
      var attempts = 0;
      var maxAttempts = 50;
      var checkInterval = setInterval(function() {
        attempts++;
        if (window.elementorFrontend && window.elementorFrontend.modules && window.elementorFrontend.modules.Frontend) {
          clearInterval(checkInterval);
          try {
            var Frontend = window.elementorFrontend.modules.Frontend;
            if (Frontend.prototype && Frontend.prototype.populateActiveBreakpointsConfig) {
              var originalMethod = Frontend.prototype.populateActiveBreakpointsConfig;
