                  if (!this.config.activeBreakpoints) {
                    this.config.activeBreakpoints = activeBreakpointsArray;
                  }
                  if (!this.config.kit) {
                    this.config.kit = {};
                    // Copy kit properties
                    var kitConfig = (window.elementorFrontendConfig && window.elementorFrontendConfig.kit) || config.kit || {};
                    for (var kitKey in kitConfig) {
