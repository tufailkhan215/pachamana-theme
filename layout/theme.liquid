  <style id='accordion-fallback-css'>
    /* Fallback: Ensure accordion items are visible if JS doesn't load */
    .theplus-accordion-wrapper.tp-stageraccr .theplus-accordion-item {
      opacity: 0;
      transition: opacity 0.3s ease-in-out;
    }
    /* Show items after a delay if JS hasn't animated them */
    .theplus-accordion-wrapper.tp-stageraccr .theplus-accordion-item {
      animation: accordion-fade-in 0.5s ease-in-out 1s forwards;
    }
    @keyframes accordion-fade-in {
      to { opacity: 1; }
    }
  </style>

  {%- comment -%} base.css not found, skipping {%- endcomment -%}
</head>

<body class="template-{{ template.name | handle }} elementor-default elementor-template-full-width elementor-kit-15 elementor-page">
  <a class="skip-to-content-link button visually-hidden" href="#MainContent">
    {{ "accessibility.skip_to_text" | t | default: "Skip to content" }}
  </a>

  {%- if settings.cart_type == 'notification' -%}
    {%- render 'cart-notification', color_scheme: settings.cart_notification_color_scheme, desktop_menu_type: section.settings.menu_type_desktop -%}
  {%- endif -%}

  {%- section 'section-header' -%}

  <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
    {%- comment -%} Wrap content in Elementor structure to match source HTML {%- endcomment -%}
    {%- if template.name == 'index' -%}
      <div data-elementor-type="single-page" data-elementor-id="48" class="elementor elementor-48 elementor-location-single post-63 page type-page status-publish hentry">
        <div class="plus_row_scroll_overflow elementor-element elementor-element-c259216 e-con-full e-flex e-con e-parent" data-id="c259216" data-element_type="container">
          <div class="elementor-element elementor-element-73ada70 elementor-widget elementor-widget-theme-post-content" data-id="73ada70" data-element_type="widget" data-widget_type="theme-post-content.default">
            <div class="elementor-widget-container">
              <div data-elementor-type="wp-page" data-elementor-id="63" class="elementor elementor-63">
                {{ content_for_layout }}
              </div>
            </div>
          </div>
        </div>
      </div>
    {%- else -%}
      {{ content_for_layout }}
    {%- endif -%}
  </main>

  {%- section 'section-footer' -%}

  <ul hidden>
    <li id="a11y-refresh-page-message">{{ 'accessibility.refresh_page' | t | default: 'Selecting a new language or country will refresh the page' }}</li>
    <li id="a11y-new-window-message">{{ 'accessibility.link_messages.new_window' | t | default: 'Opens in a new window' }}</li>
  </ul>

  <script>
    window.shopUrl = '{{ request.origin }}';
    window.routes = {
      cart_add_url: '{{ routes.cart_add_url }}',
      cart_change_url: '{{ routes.cart_change_url }}',
      cart_update_url: '{{ routes.cart_update_url }}',
      cart_url: '{{ routes.cart_url }}',
      predictive_search_url: '{{ routes.predictive_search_url }}'
    };

    window.cartStrings = {
      error: `{{ 'sections.cart.cart_error' | t | default: 'There was an error while updating your cart. Please try again.' }}`,
      quantityError: `{{ 'sections.cart.cart_quantity_error_html' | t: quantity: '[quantity]' | default: 'You can only add [quantity] of this item to your cart.' }}`
    }

    window.variantStrings = {
      addToCart: `{{ 'products.product.add_to_cart' | t | default: 'Add to cart' }}`,
      soldOut: `{{ 'products.product.sold_out' | t | default: 'Sold out' }}`,
      unavailable: `{{ 'products.product.unavailable' | t | default: 'Unavailable' }}`,
      unavailable_with_option: `{{ 'products.product.value_unavailable' | t: option_value: '[value]' | default: '[value] is unavailable' }}`,
    }

    window.accessibilityStrings = {
      imageAvailable: `{{ 'products.product.media.image_available' | t: index: '[index]' | default: 'Image [index]' }}`,
      shareSuccess: `{{ 'general.share.success_message' | t | default: 'Link copied to clipboard' }}`,
      pauseSlideshow: `{{ 'sections.slideshow.pause_slideshow' | t | default: 'Pause slideshow' }}`,
      playSlideshow: `{{ 'sections.slideshow.play_slideshow' | t | default: 'Play slideshow' }}`,
    }
  </script>

