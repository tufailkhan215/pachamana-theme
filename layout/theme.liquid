      // Also handle Elementor's built-in animation system
      function initElementorBuiltInAnimations() {
        if (typeof window.elementorFrontend !== 'undefined' && 
            window.elementorFrontend !== null && 
            window.elementorFrontend.hooks && 
            window.elementorFrontend.hooks !== null) {
          try {
            // Trigger Elementor's animation system
            if (typeof jQuery !== 'undefined') {
              jQuery(document).trigger('elementor/frontend/init');
              jQuery(window).trigger('elementor/frontend/init');
            }
          } catch(e) {
            // Silently fail
          }
        }
      }
      
      // Initialize on DOM ready
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function() {
          setTimeout(initElementorAnimations, 100);
          setTimeout(initElementorBuiltInAnimations, 300);
          setTimeout(initElementorAnimations, 500);
        });
      } else {
        setTimeout(initElementorAnimations, 100);
        setTimeout(initElementorBuiltInAnimations, 300);
        setTimeout(initElementorAnimations, 500);
      }
      
      // Also initialize after window load
      window.addEventListener('load', function() {
        setTimeout(initElementorAnimations, 200);
        setTimeout(initElementorBuiltInAnimations, 400);
      });
      
      // Initialize after Elementor frontend is ready
      if (typeof window.elementorFrontend !== 'undefined') {
        if (typeof jQuery !== 'undefined') {
          jQuery(document).on('elementor/frontend/init', function() {
            setTimeout(initElementorAnimations, 100);
          });
        }
      }
      
      // Fallback: Remove all invisible classes after 5 seconds (longer for scroll animations)
      setTimeout(function() {
        var allInvisible = document.querySelectorAll('.elementor-invisible');
        allInvisible.forEach(function(el) {
          if (!animatedElements.has(el)) {
            el.classList.remove('elementor-invisible');
            animatedElements.add(el);
          }
        });
      }, 5000);
    })();
