  {%- comment -%} Accordion Fallback JS {%- endcomment -%}
  <script id="accordion-fallback-js">
    // Accordion functionality: visibility and click handlers
    (function() {
      function initAccordion() {
        if (typeof jQuery !== 'undefined') {
          jQuery(document).ready(function($) {
            // Initialize: Show items with active-default class
            $('.theplus-accordion-wrapper .plus-accordion-header.active-default, .theplus-accordion-wrapper .plus-accordion-content.active-default').each(function() {
              var $element = $(this);
              var $item = $element.closest('.theplus-accordion-item');
              var $header = $item.find('.plus-accordion-header').first();
              var $content = $item.find('.plus-accordion-content').first();
              if ($header.length && $content.length) {
                $header.addClass('active');
                $content.show();
              }
            });
            
            // Wait for accordion script to initialize, then check if items are still invisible
            setTimeout(function() {
              $('.theplus-accordion-wrapper.tp-stageraccr .theplus-accordion-item').each(function() {
                var $item = $(this);
                var opacity = parseFloat($item.css('opacity'));
                if (isNaN(opacity) || opacity === 0) {
                  $item.css({
                    'opacity': '1',
                    'transition': 'opacity 0.5s ease-in-out'
                  });
                }
              });
            }, 2000);
            
            // Add click handler for accordion functionality
            $(document).on('click', '.theplus-accordion-wrapper .plus-accordion-header', function(e) {
              e.preventDefault();
              e.stopPropagation();
              var $header = $(this);
              var $item = $header.closest('.theplus-accordion-item');
              var $content = $item.find('.plus-accordion-content');
              var $wrapper = $header.closest('.theplus-accordion-wrapper');
              var isActive = $header.hasClass('active');
              var accordionType = $wrapper.data('accordion-type') || 'accordion';
              
              // If accordion type (not toggle), close other items
              if (accordionType === 'accordion' && !isActive) {
                $wrapper.find('.plus-accordion-header.active').removeClass('active');
                $wrapper.find('.plus-accordion-content').not($content).slideUp(300).removeClass('active-default');
              }
              
              // Toggle current item
              if (isActive) {
                $header.removeClass('active');
                $content.slideUp(300).removeClass('active-default');
              } else {
                $header.addClass('active');
                $content.slideDown(300).addClass('active-default');
              }
            });
          });
        } else {
          // If jQuery isn't loaded, use vanilla JS
          document.addEventListener('DOMContentLoaded', function() {
            // Initialize: Show items with active-default class
            var defaultActive = document.querySelectorAll('.theplus-accordion-wrapper .plus-accordion-header.active-default, .theplus-accordion-wrapper .plus-accordion-content.active-default');
            defaultActive.forEach(function(element) {
              var item = element.closest('.theplus-accordion-item');
              if (item) {
                var header = item.querySelector('.plus-accordion-header');
                var content = item.querySelector('.plus-accordion-content');
                if (header && content) {
                  header.classList.add('active');
                  content.style.display = 'block';
                  content.classList.add('active-default');
                }
              }
            });
            
            setTimeout(function() {
              var items = document.querySelectorAll('.theplus-accordion-wrapper.tp-stageraccr .theplus-accordion-item');
              items.forEach(function(item) {
                var opacity = parseFloat(window.getComputedStyle(item).opacity);
                if (isNaN(opacity) || opacity === 0) {
                  item.style.opacity = '1';
                  item.style.transition = 'opacity 0.5s ease-in-out';
                }
              });
            }, 2000);
            
            // Add click handler for accordion functionality (vanilla JS)
            document.addEventListener('click', function(e) {
              var header = e.target.closest('.theplus-accordion-wrapper .plus-accordion-header');
              if (!header) return;
              
              e.preventDefault();
              e.stopPropagation();
              
              var item = header.closest('.theplus-accordion-item');
              var content = item.querySelector('.plus-accordion-content');
              var wrapper = header.closest('.theplus-accordion-wrapper');
              var isActive = header.classList.contains('active');
              var accordionType = wrapper.getAttribute('data-accordion-type') || 'accordion';
              
              // If accordion type (not toggle), close other items
              if (accordionType === 'accordion' && !isActive) {
                var activeHeaders = wrapper.querySelectorAll('.plus-accordion-header.active');
                activeHeaders.forEach(function(activeHeader) {
                  activeHeader.classList.remove('active');
                  var activeItem = activeHeader.closest('.theplus-accordion-item');
                  var activeContent = activeItem ? activeItem.querySelector('.plus-accordion-content') : null;
                  if (activeContent) {
                    activeContent.style.display = 'none';
                    activeContent.classList.remove('active-default');
                  }
                });
              }
              
              // Toggle current item
              if (isActive) {
                header.classList.remove('active');
                if (content) {
                  content.style.display = 'none';
                  content.classList.remove('active-default');
                }
              } else {
                header.classList.add('active');
                if (content) {
                  content.style.display = 'block';
                  content.classList.add('active-default');
                }
              }
            });
          });
        }
      }
      
      // Initialize immediately and also on DOM ready
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initAccordion);
      } else {
        initAccordion();
      }
    })();
  </script>

  {%- comment -%} Gallery Metro Layout Support - Ensure visibility for plus-posts-metro-list script {%- endcomment -%}
  <script id="gallery-metro-support">
    (function() {
      function ensureGalleryVisibility() {
        // Ensure gallery containers are visible (plus-posts-metro-list.min.js will handle layout)
        var galleryLists = document.querySelectorAll('.list-isotope-metro[data-enable-isotope="1"]');
        
        galleryLists.forEach(function(galleryList) {
          var container = galleryList.querySelector('.post-inner-loop');
          if (!container) return;

          // Ensure gallery is visible
          galleryList.style.display = 'block';
          galleryList.style.visibility = 'visible';
          galleryList.style.opacity = '1';
          container.style.display = 'block';
          container.style.visibility = 'visible';

          // Make sure all grid items are visible
          var gridItems = container.querySelectorAll('.grid-item');
          gridItems.forEach(function(item) {
            item.style.visibility = 'visible';
            item.style.opacity = '1';
          });
        });
      }

      // Wait for jQuery and metro script to be ready
      function waitForMetroScript() {
        if (typeof jQuery === 'undefined' || typeof theplus_setup_packery_portfolio === 'undefined') {
          setTimeout(waitForMetroScript, 100);
          return;
        }

        // Ensure visibility - the metro script will handle layout
        ensureGalleryVisibility();

        // The plus-posts-metro-list.min.js automatically initializes on document ready
        // We just ensure visibility and let it do its work
        if (typeof jQuery !== 'undefined' && jQuery('.list-isotope-metro').length) {
          // Wait a bit for the script to initialize, then ensure visibility again
          setTimeout(function() {
            ensureGalleryVisibility();
          }, 500);
        }
      }

      // Initialize when DOM is ready
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function() {
          ensureGalleryVisibility();
          setTimeout(waitForMetroScript, 500);
        });
      } else {
        ensureGalleryVisibility();
        setTimeout(waitForMetroScript, 500);
      }

      // Also try after scripts load
      setTimeout(waitForMetroScript, 1000);
      setTimeout(waitForMetroScript, 2000);

      // Handle window resize - ensure visibility (metro script handles layout)
      window.addEventListener('resize', function() {
        ensureGalleryVisibility();
      });
    })();
  </script>

  {%- comment -%} Animated Headline Typing Animation {%- endcomment -%}
  <script id="animated-headline-typing">
    (function() {
      function initAnimatedHeadline() {
        var headlines = document.querySelectorAll('.elementor-headline-animation-type-typing.elementor-headline-letters');
        
        headlines.forEach(function(headline) {
          var wrapper = headline.querySelector('.elementor-headline-dynamic-wrapper');
          if (!wrapper) return;
          
          var textElements = wrapper.querySelectorAll('.elementor-headline-dynamic-text');
          if (textElements.length === 0) return;
          
          var currentIndex = 0;
          var isAnimating = false;
          var animationSpeed = 50; // milliseconds per letter
          var delayBetweenTexts = 1000; // milliseconds
          
          // Get settings from data attribute
          var widget = headline.closest('[data-settings]');
          var settings = {};
          if (widget) {
            try {
              var settingsStr = widget.getAttribute('data-settings');
              settings = JSON.parse(settingsStr.replace(/&quot;/g, '"'));
            } catch(e) {
              console.warn('Could not parse animated headline settings');
            }
          }
          
          if (settings.rotate_iteration_delay) {
            delayBetweenTexts = parseInt(settings.rotate_iteration_delay);
          }
          
          // Function to split text into letters
          function splitIntoLetters(text) {
            var letters = [];
            for (var i = 0; i < text.length; i++) {
              var char = text.charAt(i);
              if (char === ' ') {
                letters.push('&nbsp;');
              } else {
                letters.push(char);
              }
            }
            return letters;
          }
          
          // Function to create letter spans
          function createLetterSpans(text, isActive) {
            var letters = splitIntoLetters(text);
            var html = '';
            letters.forEach(function(letter, index) {
              var letterClass = isActive && index === 0 ? 'elementor-headline-animation-in' : '';
              html += '<span class="elementor-headline-dynamic-letter ' + letterClass + '">' + letter + '</span>';
            });
            return html;
          }
          
          // Initialize: split all texts into letters
          textElements.forEach(function(textEl, index) {
            var text = textEl.getAttribute('data-text') || textEl.textContent.trim();
            var isActive = textEl.classList.contains('elementor-headline-text-active');
            textEl.innerHTML = createLetterSpans(text, isActive);
            textEl.setAttribute('data-original-text', text);
          });
          
          // Function to show next text with typing animation
          function showNextText() {
            if (isAnimating) return;
            isAnimating = true;
            
            var currentTextEl = textElements[currentIndex];
            var nextIndex = (currentIndex + 1) % textElements.length;
            var nextTextEl = textElements[nextIndex];
            
            // Remove active class from current
            currentTextEl.classList.remove('elementor-headline-text-active');
            currentTextEl.classList.add('elementor-headline-text-inactive');
            
            // Hide current text letters
            var currentLetters = currentTextEl.querySelectorAll('.elementor-headline-dynamic-letter');
            currentLetters.forEach(function(letter) {
              letter.classList.remove('elementor-headline-animation-in');
            });
            
            // Show next text
            nextTextEl.classList.remove('elementor-headline-text-inactive');
            nextTextEl.classList.add('elementor-headline-text-active');
            
            // Animate typing effect
            var nextText = nextTextEl.getAttribute('data-original-text') || '';
            var nextLetters = nextTextEl.querySelectorAll('.elementor-headline-dynamic-letter');
            
            // Clear and rebuild if needed
            if (nextLetters.length === 0 || nextText !== (nextTextEl.getAttribute('data-original-text') || '')) {
              nextTextEl.innerHTML = createLetterSpans(nextText, false);
              nextLetters = nextTextEl.querySelectorAll('.elementor-headline-dynamic-letter');
            }
            
            // Animate letters appearing one by one
            nextLetters.forEach(function(letter, index) {
              setTimeout(function() {
                letter.classList.add('elementor-headline-animation-in');
              }, index * animationSpeed);
            });
            
            // Update current index
            currentIndex = nextIndex;
            
            // Continue animation after delay
            var totalAnimationTime = nextLetters.length * animationSpeed + delayBetweenTexts;
            setTimeout(function() {
              isAnimating = false;
              if (settings.loop === 'yes' || settings.loop === true) {
                showNextText();
              }
            }, totalAnimationTime);
          }
          
          // Start animation after initial delay
          setTimeout(function() {
            showNextText();
          }, delayBetweenTexts);
        });
      }
      
      // Initialize when DOM is ready
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initAnimatedHeadline);
      } else {
        initAnimatedHeadline();
      }
      
      // Also try after a delay for late-loading content
      setTimeout(initAnimatedHeadline, 500);
    })();
  </script>

  {%- comment -%} Navigation Menu Dropdown Functionality {%- endcomment -%}
  <script id="navigation-menu-dropdown">
    (function() {
      function initNavigationMenu() {
        // Desktop dropdown functionality - Handle both first-level and nested dropdown toggles
        var dropdownToggles = document.querySelectorAll('.plus-navigation-menu .dropdown-toggle');
        
        dropdownToggles.forEach(function(toggle) {
          toggle.addEventListener('click', function(e) {
            // Only prevent default if it's a click-based menu (menu-click class)
            var navInner = toggle.closest('.plus-navigation-inner');
            if (navInner && navInner.classList.contains('menu-click')) {
              e.preventDefault();
              e.stopPropagation(); // Prevent event from bubbling to parent dropdown
              
              var menuItem = toggle.closest('.menu-item');
              var dropdownMenu = menuItem ? menuItem.querySelector('.dropdown-menu') : null;
              
              if (dropdownMenu) {
                // Check if this is a nested submenu
                var isSubmenu = menuItem.classList.contains('dropdown-submenu');
                
                if (isSubmenu) {
                  // For submenus, only close other submenus at the same level
                  var parentDropdown = menuItem.closest('.dropdown-menu');
                  if (parentDropdown) {
                    var siblingSubmenus = parentDropdown.querySelectorAll('.dropdown-submenu > .dropdown-menu');
                    siblingSubmenus.forEach(function(sibling) {
                      if (sibling !== dropdownMenu && sibling.style.display === 'block') {
                        sibling.style.display = 'none';
                        var siblingItem = sibling.closest('.menu-item');
                        if (siblingItem) {
                          siblingItem.classList.remove('open');
                        }
                      }
                    });
                  }
                } else {
                  // For first-level dropdowns, close other first-level dropdowns only
                  // Don't close nested dropdowns if their parent is still open
                  var allFirstLevelDropdowns = document.querySelectorAll('.plus-navigation-menu > ul > .menu-item > .dropdown-menu');
                  allFirstLevelDropdowns.forEach(function(dropdown) {
                    if (dropdown !== dropdownMenu && dropdown.style.display === 'block') {
                      dropdown.style.display = 'none';
                      var otherMenuItem = dropdown.closest('.menu-item');
                      if (otherMenuItem) {
                        otherMenuItem.classList.remove('open');
                        // Also close any nested submenus within this dropdown
                        var nestedSubmenus = dropdown.querySelectorAll('.dropdown-submenu > .dropdown-menu');
                        nestedSubmenus.forEach(function(nested) {
                          nested.style.display = 'none';
                          var nestedItem = nested.closest('.menu-item');
                          if (nestedItem) {
                            nestedItem.classList.remove('open');
                          }
                        });
                      }
                    }
                  });
                }
                
                // Toggle current dropdown
                if (dropdownMenu.style.display === 'block') {
                  dropdownMenu.style.display = 'none';
                  menuItem.classList.remove('open');
                } else {
                  dropdownMenu.style.display = 'block';
                  menuItem.classList.add('open');
                }
              }
            }
          });
        });
        
        // Function to calculate mobile menu position and width based on screen resolution
        // Matches source site behavior where left and width are calculated dynamically
        function calculateMobileMenuPosition(mobileMenu) {
          if (!mobileMenu) return;
          
          var navWrap = mobileMenu.closest('.plus-navigation-wrap');
          if (!navWrap) return;
          
          // Get navigation container position
          var navWrapRect = navWrap.getBoundingClientRect();
          var viewportWidth = window.innerWidth || document.documentElement.clientWidth;
          
          // Calculate left position relative to navigation container
          // Can be negative if menu extends beyond container's left edge
          var left = navWrapRect.left;
          
          // Calculate width - typically viewport width, but adjust based on positioning
          // The width should account for the menu extending to the right edge of viewport
          var width = viewportWidth;
          
          // If menu starts before viewport (negative left), adjust
          if (left < 0) {
            // Menu extends beyond left edge, width should cover from left edge to right edge
            width = viewportWidth + Math.abs(left);
          } else {
            // Menu starts within viewport, width should cover from menu start to right edge
            width = viewportWidth - left;
          }
          
          // Ensure minimum width
          width = Math.max(width, viewportWidth);
          
          // Apply calculated styles - only the essential ones as per source site
          mobileMenu.style.boxSizing = 'border-box';
          mobileMenu.style.width = width + 'px';
          mobileMenu.style.left = -left + 'px';
          
        }
        
        // Mobile menu toggle - use event delegation to handle dynamically added elements
        document.addEventListener('click', function(e) {
          var mobileToggle = e.target.closest('.mobile-plus-toggle-menu');
          if (!mobileToggle) return;
          
          e.preventDefault();
          e.stopPropagation();
          
          var targetId = mobileToggle.getAttribute('data-target');
          var mobileMenu = targetId ? document.querySelector(targetId) : null;
          
          if (mobileMenu) {
            // Toggle collapsed class on button
            mobileToggle.classList.toggle('plus-collapsed');
            
            // Toggle mobile menu visibility
            var isOpen = mobileMenu.classList.contains('in');
            
            if (isOpen) {
              // Close menu
              mobileMenu.classList.remove('in');
              mobileMenu.classList.add('collapse');
              mobileMenu.style.display = 'none';
              mobileMenu.style.visibility = 'hidden';
              // Clear calculated styles
              mobileMenu.style.width = '';
              mobileMenu.style.left = '';
            } else {
              // Open menu - remove collapse, add in class
              mobileMenu.classList.remove('collapse');
              mobileMenu.classList.add('in');
               mobileMenu.style.display = 'flex';
              mobileMenu.style.visibility = 'visible';
              
              // Calculate and set dynamic position and width (as per source site)
              // Only set left, width, and display - other styles come from CSS
              calculateMobileMenuPosition(mobileMenu);
            }
          }
        });
        
        // Recalculate position on window resize
        var resizeTimeout;
        window.addEventListener('resize', function() {
          clearTimeout(resizeTimeout);
          resizeTimeout = setTimeout(function() {
            var openMenus = document.querySelectorAll('.plus-mobile-menu-content.in');
            openMenus.forEach(function(mobileMenu) {
              calculateMobileMenuPosition(mobileMenu);
            });
          }, 100);
        });
        
        // Mobile dropdown functionality - use event delegation for dynamically loaded content
        // Handle both first-level and nested submenu toggles
        document.addEventListener('click', function(e) {
          // Check if click is on a mobile dropdown toggle (including submenu items)
          var toggle = e.target.closest('.plus-mobile-menu .dropdown-toggle, .plus-mobile-menu .menu-item-has-children > a');
          if (!toggle) return;
          
          var menuItem = toggle.closest('.menu-item');
          var dropdownMenu = menuItem ? menuItem.querySelector('.dropdown-menu') : null;
          
          if (dropdownMenu) {
            e.preventDefault();
            e.stopPropagation();
            
            // Check if this is a nested submenu
            var isSubmenu = menuItem.classList.contains('dropdown-submenu');
            
            // Toggle current dropdown
            if (dropdownMenu.style.display === 'block') {
              dropdownMenu.style.display = 'none';
              menuItem.classList.remove('open');
            } else {
              if (isSubmenu) {
                // For submenus, only close other submenus at the same level
                var parentDropdown = menuItem.closest('.dropdown-menu');
                if (parentDropdown) {
                  var siblingSubmenus = parentDropdown.querySelectorAll('.dropdown-submenu > .dropdown-menu');
                  siblingSubmenus.forEach(function(sibling) {
                    if (sibling !== dropdownMenu && sibling.style.display === 'block') {
                      sibling.style.display = 'none';
                      var siblingItem = sibling.closest('.menu-item');
                      if (siblingItem) {
                        siblingItem.classList.remove('open');
                      }
                    }
                  });
                }
              } else {
                // For first-level dropdowns, close other first-level dropdowns at same level
                var parent = menuItem.parentElement;
                if (parent) {
                  var siblings = parent.querySelectorAll('.menu-item');
                  siblings.forEach(function(sibling) {
                    if (sibling !== menuItem) {
                      var siblingDropdown = sibling.querySelector('.dropdown-menu');
                      if (siblingDropdown) {
                        siblingDropdown.style.display = 'none';
                        sibling.classList.remove('open');
                      }
                    }
                  });
                }
              }
              
              dropdownMenu.style.display = 'block';
              menuItem.classList.add('open');
            }
          }
        });
        
        // Close dropdowns when clicking outside
        document.addEventListener('click', function(e) {
          if (!e.target.closest('.plus-navigation-menu') && !e.target.closest('.plus-mobile-menu')) {
            var allDropdowns = document.querySelectorAll('.plus-navigation-menu .dropdown-menu');
            allDropdowns.forEach(function(dropdown) {
              dropdown.style.display = 'none';
              var menuItem = dropdown.closest('.menu-item');
              if (menuItem) {
                menuItem.classList.remove('open');
              }
            });
          }
        });
        
        // Hover functionality for non-click menus (desktop only)
        // Only apply hover if NOT a click-based menu
        // Handle both first-level and nested menu items
        var navMenus = document.querySelectorAll('.plus-navigation-inner:not(.menu-click) .plus-navigation-menu');
        navMenus.forEach(function(navMenu) {
          var menuItems = navMenu.querySelectorAll('.menu-item-has-children');
          
          menuItems.forEach(function(menuItem) {
            // Remove any existing listeners first
            var newMenuItem = menuItem.cloneNode(true);
            menuItem.parentNode.replaceChild(newMenuItem, menuItem);
            
            newMenuItem.addEventListener('mouseenter', function() {
              var dropdownMenu = newMenuItem.querySelector('.dropdown-menu');
              if (dropdownMenu) {
                dropdownMenu.style.display = 'block';
                newMenuItem.classList.add('open');
              }
            });
            
            newMenuItem.addEventListener('mouseleave', function(e) {
              // Check if mouse is moving to a child submenu
              var relatedTarget = e.relatedTarget;
              if (relatedTarget && newMenuItem.contains(relatedTarget)) {
                return; // Don't close if moving to child
              }
              
              var dropdownMenu = newMenuItem.querySelector('.dropdown-menu');
              if (dropdownMenu) {
                dropdownMenu.style.display = 'none';
                newMenuItem.classList.remove('open');
              }
            });
          });
        });
        
        // Prevent hover effects on click-based menus
        var clickMenus = document.querySelectorAll('.plus-navigation-inner.menu-click .plus-navigation-menu .menu-item-has-children');
        clickMenus.forEach(function(menuItem) {
          menuItem.addEventListener('mouseenter', function(e) {
            // Only allow hover if item is already open (user clicked it)
            if (!menuItem.classList.contains('open')) {
              e.stopPropagation();
            }
          });
        });
      }
      
      // Initialize when DOM is ready
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initNavigationMenu);
      } else {
        initNavigationMenu();
      }
      
      // Also try after a delay for late-loading content
      setTimeout(initNavigationMenu, 500);
      setTimeout(initNavigationMenu, 1000);
      
    })();
  </script>

