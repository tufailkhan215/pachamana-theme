  {%- comment -%} Other CSS {%- endcomment -%}
  {{ 'sticky.min.css' | asset_url | stylesheet_tag }}
  {{ 'motion-fx.min.css' | asset_url | stylesheet_tag }}
  {{ 'shapes.min.css' | asset_url | stylesheet_tag }}
  {{ 'popup.min.css' | asset_url | stylesheet_tag }}
  {{ 'header-footer.min.css' | asset_url | stylesheet_tag }}
  {{ 'custom-apple-webkit.min.css' | asset_url | stylesheet_tag }}
  {{ 'post-15.css' | asset_url | stylesheet_tag }}
  {{ 'post-48.css' | asset_url | stylesheet_tag }}
  {{ 'post-57.css' | asset_url | stylesheet_tag }}
  {{ 'post-63.css' | asset_url | stylesheet_tag }}
  {{ 'post-191.css' | asset_url | stylesheet_tag }}
  {{ 'post-1197.css' | asset_url | stylesheet_tag }}
  {%- if template.name == 'article' -%}
    {{ 'post-906.css' | asset_url | stylesheet_tag }}
    {{ 'widget-post-navigation.min.css' | asset_url | stylesheet_tag }}
  {%- endif -%}
  {%- if template.name == 'blog' -%}
    {{ 'post-274.css' | asset_url | stylesheet_tag }}
  {%- endif -%}
  {%- if template.name == 'page' -%}
    {{ 'post-82.css' | asset_url | stylesheet_tag }}
  {%- endif -%}
  {%- comment -%} Load post-565.css for collection/product archive pages {%- endcomment -%}
  {%- if template.name == 'collection' or template.name == 'list-collections' -%}
    {{ 'post-565.css' | asset_url | stylesheet_tag }}
  {%- endif -%}
  {{ 'custom-pro-widget-nav-menu.min.css' | asset_url | stylesheet_tag }}
  {{ 'custom-pro-widget-woocommerce-menu-cart.min.css' | asset_url | stylesheet_tag }}
  {{ 'custom-pro-widget-woocommerce-product-add-to-cart.min.css' | asset_url | stylesheet_tag }}
  {{ 'custom-pro-widget-loop-grid.min.css' | asset_url | stylesheet_tag }}
  {{ 'custom-widget-icon-list.min.css' | asset_url | stylesheet_tag }}
  {{ 'widget-loop-common.min.css' | asset_url | stylesheet_tag }}
  {{ 'widget-menu-anchor.min.css' | asset_url | stylesheet_tag }}
  {{ 'widget-woocommerce-product-price.min.css' | asset_url | stylesheet_tag }}
  {{ 'all_widget.css' | asset_url | stylesheet_tag }}
  {{ 'rating_widget.css' | asset_url | stylesheet_tag }}
  {{ 'sidebar_widget.css' | asset_url | stylesheet_tag }}
  {{ 'review-fonts.css' | asset_url | stylesheet_tag }}
  {{ 'brands.css' | asset_url | stylesheet_tag }}
  {{ 'plus-temp-notice.css' | asset_url | stylesheet_tag }}
  {{ 'woocommerce-layout.css' | asset_url | stylesheet_tag }}
  {{ 'woocommerce-smallscreen.css' | asset_url | stylesheet_tag }}
  {{ 'woocommerce.css' | asset_url | stylesheet_tag }}
  {%- comment -%} Load post-454.css for product pages (after woocommerce.css to override) {%- endcomment -%}
  {%- if template.name == 'product' -%}
    {{ 'post-454.css' | asset_url | stylesheet_tag }}
    {{ 'photoswipe.min.css' | asset_url | stylesheet_tag }}
    {{ 'default-skin.min.css' | asset_url | stylesheet_tag }}
    {{ 'related-posts.css' | asset_url | stylesheet_tag }}
    {%- comment -%} PhotoSwipe JavaScript - Localized assets {%- endcomment -%}
    {%- comment -%} Passive event listener patch - Must load BEFORE PhotoSwipe to intercept event listeners {%- endcomment -%}
    <script src="{{ 'photoswipe-passive-patch.js' | asset_url }}"></script>
    <script src="{{ 'photoswipe.min.js' | asset_url }}" defer></script>
    <script src="{{ 'photoswipe-ui-default.min.js' | asset_url }}" defer></script>
    <script src="{{ 'photoswipe-init.js' | asset_url }}" defer></script>
    {%- comment -%} Product Gallery JavaScript - Handles slider, thumbnails, and zoom {%- endcomment -%}
    <script src="{{ 'product-gallery.js' | asset_url }}" defer></script>
    {%- comment -%} Product Form JavaScript - Handles add to cart form submission {%- endcomment -%}
    {%- comment -%} Load without defer to ensure it runs before form submission {%- endcomment -%}
    <script src="{{ 'product-form.js' | asset_url }}"></script>
  {%- endif -%}
  {{ 'woocommerce-notices.min.css' | asset_url | stylesheet_tag }}
  {{ 'wc-blocks.css' | asset_url | stylesheet_tag }}
  {{ 'upe-blocks.css' | asset_url | stylesheet_tag }}

  <style id='accordion-fallback-css'>
    /* Fallback: Ensure accordion items are visible if JS doesn't load */
    .theplus-accordion-wrapper.tp-stageraccr .theplus-accordion-item {
      opacity: 0;
      transition: opacity 0.3s ease-in-out;
    }
    /* Show items after a delay if JS hasn't animated them */
    .theplus-accordion-wrapper.tp-stageraccr .theplus-accordion-item {
      animation: accordion-fade-in 0.5s ease-in-out 1s forwards;
    }
    @keyframes accordion-fade-in {
      to { opacity: 1; }
    }
  </style>

  {%- comment -%} base.css not found, skipping {%- endcomment -%}
</head>

<body class="template-{{ template.name | handle }} elementor-default elementor-template-full-width elementor-kit-15 elementor-page woocommerce">
  

  {%- if settings.cart_type == 'notification' -%}
    {%- render 'cart-notification', color_scheme: settings.cart_notification_color_scheme -%}
  {%- endif -%}

  {%- section 'section-header' -%}

  {%- comment -%} Match source HTML structure: elementor-48 wrapper -> c259216 container -> 73ada70 widget -> elementor-widget-container -> elementor-63 {%- endcomment -%}
  {%- comment -%} Check for index template - template.name should be 'index' for homepage using index.json template {%- endcomment -%}
  {%- liquid
    assign is_index = false
    assign is_article = false
    
    comment
      Check multiple ways to detect index template:
      1. template.name == 'index' (standard way)
      2. template == 'index' (alternative)
      3. request.page_type == 'index' (fallback)
      4. Check if we're on the homepage route
    endcomment
    
    if template.name == 'index'
      assign is_index = true
    elsif template == 'index'
      assign is_index = true
    elsif request.page_type == 'index'
      assign is_index = true
    elsif template.directory == 'templates' and template.name == 'index'
      assign is_index = true
    endif
    
    comment
      Check for article template
    endcomment
    if template.name == 'article'
      assign is_article = true
    elsif template == 'article'
      assign is_article = true
    elsif request.page_type == 'article'
      assign is_article = true
    endif
  -%}
  {%- if is_index -%}
    {%- comment -%} 
      INDEX TEMPLATE DETECTED: 
      All sections from templates/index.json will be rendered inside elementor-63 wrapper via content_for_layout.
      Sections included: section-background-motion, section-animatied-title, section-image-with-text-button, 
      section-health-benifits, section-featured-products, section-text-images-grid, section-image-text-dynamicbg, 
      section-rescent-articles, section-photo-gallery, section-faq
    {%- endcomment -%}
    <div data-elementor-type="single-page" data-elementor-id="48" class="elementor elementor-48 elementor-location-single post-63 page type-page status-publish hentry">
      <div class="plus_row_scroll_overflow elementor-element elementor-element-c259216 e-con-full e-flex e-con e-parent" data-id="c259216" data-element_type="container">
        <div class="elementor-element elementor-element-73ada70 elementor-widget elementor-widget-theme-post-content" data-id="73ada70" data-element_type="widget" data-widget_type="theme-post-content.default">
          <div class="elementor-widget-container">
            <div data-elementor-type="wp-page" data-elementor-id="63" class="elementor elementor-63 elementor-motion-effects-parent">
              {{ content_for_layout }}
            </div>
          </div>
        </div>
      </div>
    </div>
  {%- elsif is_article -%}
    {%- comment -%} 
      ARTICLE TEMPLATE DETECTED: 
      Article pages use the same Elementor wrapper structure as homepage
      The main-article section will handle the content rendering
    {%- endcomment -%}
    <div data-elementor-type="single-page" data-elementor-id="48" class="elementor elementor-48 elementor-location-single post-{{ article.id }} post type-post status-publish format-standard hentry">
      <div class="plus_row_scroll_overflow elementor-element elementor-element-c259216 e-con-full e-flex e-con e-parent" data-id="c259216" data-element_type="container">
        <div class="elementor-element elementor-element-73ada70 elementor-widget elementor-widget-theme-post-content" data-id="73ada70" data-element_type="widget" data-widget_type="theme-post-content.default">
          <div class="elementor-widget-container">
            <div data-elementor-type="wp-page" data-elementor-id="63" class="elementor elementor-63 elementor-motion-effects-parent">
              {{ content_for_layout }}
            </div>
          </div>
        </div>
      </div>
    </div>
  {%- else -%}
  <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>
  {%- endif -%}
  {%- section 'section-footer' -%}
  {%- comment -%} Contact Popup - Only renders if enabled in theme settings {%- endcomment -%}
  {%- if settings.contact_popup_enabled -%}
    {%- section 'section-contact-popup' -%}
  {%- endif -%}
  <ul hidden>
    <li id="a11y-refresh-page-message">{{ 'accessibility.refresh_page' | t | default: 'Selecting a new language or country will refresh the page' }}</li>
    <li id="a11y-new-window-message">{{ 'accessibility.link_messages.new_window' | t | default: 'Opens in a new window' }}</li>
  </ul>

  <script>
    window.shopUrl = '{{ request.origin }}';
    window.routes = {
      cart_add_url: '{{ routes.cart_add_url }}',
      cart_change_url: '{{ routes.cart_change_url }}',
      cart_update_url: '{{ routes.cart_update_url }}',
      cart_url: '{{ routes.cart_url }}',
      predictive_search_url: '{{ routes.predictive_search_url }}'
    };

    window.cartStrings = {
      error: `{{ 'sections.cart.cart_error' | t | default: 'There was an error while updating your cart. Please try again.' }}`,
      quantityError: `{{ 'sections.cart.cart_quantity_error_html' | t: quantity: '[quantity]' | default: 'You can only add [quantity] of this item to your cart.' }}`
    }

    window.variantStrings = {
      addToCart: `{{ 'products.product.add_to_cart' | t | default: 'Add to cart' }}`,
      soldOut: `{{ 'products.product.sold_out' | t | default: 'Sold out' }}`,
      unavailable: `{{ 'products.product.unavailable' | t | default: 'Unavailable' }}`,
      unavailable_with_option: `{{ 'products.product.value_unavailable' | t: option_value: '[value]' | default: '[value] is unavailable' }}`,
    }

    window.accessibilityStrings = {
      imageAvailable: `{{ 'products.product.media.image_available' | t: index: '[index]' | default: 'Image [index]' }}`,
      shareSuccess: `{{ 'general.share.success_message' | t | default: 'Link copied to clipboard' }}`,
      pauseSlideshow: `{{ 'sections.slideshow.pause_slideshow' | t | default: 'Pause slideshow' }}`,
      playSlideshow: `{{ 'sections.slideshow.play_slideshow' | t | default: 'Play slideshow' }}`,
    }
  </script>

  <!-- All JavaScript Files -->
  {%- comment -%} Elementor Frontend Config (MUST be before Elementor JS) {%- endcomment -%}
  <script>
    // Elementor Frontend Configuration - must be available before Elementor JS loads
    (function() {
