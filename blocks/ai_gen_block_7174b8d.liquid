{% doc %}
  @prompt
    Add an "Add an ice pack" checkbox to the cart page. When checked, it should pass the selection as an order note or cart attribute so the merchant can see "Ice pack requested" on every order. The checkbox should be styled to match the existing theme and appear near the cart totals or checkout button.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-ice-pack-checkbox-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.padding }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    margin-bottom: 16px;
  }

  .ai-ice-pack-checkbox__wrapper-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
    cursor: pointer;
  }

  .ai-ice-pack-checkbox__input-{{ ai_gen_id }} {
    width: {{ block.settings.checkbox_size }}px;
    height: {{ block.settings.checkbox_size }}px;
    cursor: pointer;
    accent-color: {{ block.settings.checkbox_color }};
    flex-shrink: 0;
  }

  .ai-ice-pack-checkbox__label-{{ ai_gen_id }} {
    font-family: {{ block.settings.label_font.family }}, {{ block.settings.label_font.fallback_families }};
    font-weight: {{ block.settings.label_font.weight }};
    font-size: {{ block.settings.label_size }}px;
    color: {{ block.settings.label_color }};
    cursor: pointer;
    margin: 0;
    line-height: 1.4;
  }

  .ai-ice-pack-checkbox__icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    flex-shrink: 0;
    color: {{ block.settings.icon_color }};
  }
{% endstyle %}

<ice-pack-checkbox-{{ ai_gen_id }}
  class="ai-ice-pack-checkbox-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <label class="ai-ice-pack-checkbox__wrapper-{{ ai_gen_id }}">
    {% if block.settings.show_icon %}
      <svg
        class="ai-ice-pack-checkbox__icon-{{ ai_gen_id }}"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M12 2v20M2 12h20M6 6l12 12M6 18L18 6"></path>
      </svg>
    {% endif %}
    <input
      type="checkbox"
      class="ai-ice-pack-checkbox__input-{{ ai_gen_id }}"
      id="ice-pack-checkbox-{{ ai_gen_id }}"
      data-cart-attribute="ice_pack"
    >
    <span class="ai-ice-pack-checkbox__label-{{ ai_gen_id }}">
      {{ block.settings.checkbox_label }}
    </span>
  </label>
</ice-pack-checkbox-{{ ai_gen_id }}>

<script>
  (function() {
    class IcePackCheckbox{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.checkbox = null;
        this.attributeName = '{{ block.settings.attribute_name }}';
        this.attributeValue = '{{ block.settings.attribute_value }}';
      }

      connectedCallback() {
        this.checkbox = this.querySelector('.ai-ice-pack-checkbox__input-{{ ai_gen_id }}');
        if (!this.checkbox) return;

        this.loadSavedState();
        this.checkbox.addEventListener('change', this.handleCheckboxChange.bind(this));
      }

      loadSavedState() {
        fetch('/cart.js')
          .then(response => response.json())
          .then(cart => {
            if (cart.attributes && cart.attributes[this.attributeName]) {
              this.checkbox.checked = true;
            }
          })
          .catch(error => console.error('Error loading cart state:', error));
      }

      handleCheckboxChange(event) {
        const isChecked = event.target.checked;
        const attributes = {};
        
        if (isChecked) {
          attributes[this.attributeName] = this.attributeValue;
        } else {
          attributes[this.attributeName] = '';
        }

        fetch('/cart/update.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ attributes: attributes })
        })
        .then(response => response.json())
        .then(cart => {
          if (window.Shopify && window.Shopify.theme && window.Shopify.theme.cartUpdateCallbacks) {
            window.Shopify.theme.cartUpdateCallbacks.forEach(callback => callback(cart));
          }
          document.documentElement.dispatchEvent(new CustomEvent('cart:updated', {
            bubbles: true,
            detail: { cart: cart }
          }));
        })
        .catch(error => {
          console.error('Error updating cart attribute:', error);
          this.checkbox.checked = !isChecked;
        });
      }
    }

    customElements.define('ice-pack-checkbox-{{ ai_gen_id }}', IcePackCheckbox{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Ice pack checkbox",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "checkbox_label",
      "label": "Checkbox label",
      "default": "Add an ice pack to my order"
    },
    {
      "type": "text",
      "id": "attribute_name",
      "label": "Cart attribute name",
      "default": "Ice Pack",
      "info": "This will appear in your order details"
    },
    {
      "type": "text",
      "id": "attribute_value",
      "label": "Attribute value when checked",
      "default": "Ice pack requested",
      "info": "The value saved when checkbox is checked"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "checkbox",
      "id": "show_icon",
      "label": "Show ice pack icon",
      "default": true
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Padding",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#F5F0EB"
    },
    {
      "type": "header",
      "content": "Checkbox"
    },
    {
      "type": "range",
      "id": "checkbox_size",
      "label": "Checkbox size",
      "min": 16,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "color",
      "id": "checkbox_color",
      "label": "Checkbox color",
      "default": "#5C402F"
    },
    {
      "type": "header",
      "content": "Label"
    },
    {
      "type": "font_picker",
      "id": "label_font",
      "label": "Font",
      "default": "lora_n4"
    },
    {
      "type": "range",
      "id": "label_size",
      "label": "Font size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Icon"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 16,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#5C402F"
    }
  ],
  "presets": [
    {
      "name": "Ice pack checkbox"
    }
  ]
}
{% endschema %}
