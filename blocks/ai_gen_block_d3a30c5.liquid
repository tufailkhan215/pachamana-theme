{% doc %}
  @prompt
    Create an automatic photo carousel that scrolls through images every 3 seconds. The carousel should have a fixed vertical size and smoothly transition between photos.
    
    i need it to show 8 photos at a time and it scrolls to the left.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-carousel-container-{{ ai_gen_id }} {
    width: 100%;
    display: block;
    overflow: hidden;
    position: relative;
    height: {{ block.settings.carousel_height }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-carousel-track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.image_gap }}px;
    height: 100%;
    will-change: transform;
  }

  .ai-carousel-slide-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: calc((100% - ({{ block.settings.image_gap }}px * 7)) / 8);
    height: 100%;
    position: relative;
  }

  .ai-carousel-slide-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-carousel-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-carousel-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  @media screen and (max-width: 749px) {
    .ai-carousel-slide-{{ ai_gen_id }} {
      width: calc((100% - ({{ block.settings.image_gap }}px * 2)) / 3);
    }
  }
{% endstyle %}

<auto-carousel-{{ ai_gen_id }}
  class="ai-carousel-container-{{ ai_gen_id }}"
  data-scroll-speed="{{ block.settings.scroll_speed }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-carousel-track-{{ ai_gen_id }}">
    {% for i in (1..12) %}
      {% liquid
        assign image_key = 'image_' | append: i
        assign image = block.settings[image_key]
      %}
      <div class="ai-carousel-slide-{{ ai_gen_id }}">
        {% if image %}
          <img
            src="{{ image | image_url: width: 800 }}"
            alt="{{ image.alt | escape }}"
            loading="lazy"
            width="{{ image.width }}"
            height="{{ image.height }}"
          >
        {% else %}
          <div class="ai-carousel-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</auto-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class AutoCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.track = null;
        this.slides = [];
        this.scrollSpeed = 0;
        this.animationId = null;
        this.currentPosition = 0;
        this.slideWidth = 0;
        this.gap = 0;
      }

      connectedCallback() {
        this.track = this.querySelector('.ai-carousel-track-{{ ai_gen_id }}');
        this.slides = Array.from(this.querySelectorAll('.ai-carousel-slide-{{ ai_gen_id }}'));
        this.scrollSpeed = parseFloat(this.dataset.scrollSpeed) || 3;
        
        this.init();
      }

      init() {
        if (this.slides.length === 0) return;

        this.cloneSlides();
        this.calculateDimensions();
        this.startAutoScroll();
      }

      cloneSlides() {
        const clones = this.slides.map(slide => slide.cloneNode(true));
        clones.forEach(clone => this.track.appendChild(clone));
      }

      calculateDimensions() {
        const firstSlide = this.slides[0];
        const computedStyle = window.getComputedStyle(this.track);
        this.gap = parseFloat(computedStyle.gap) || 0;
        this.slideWidth = firstSlide.offsetWidth + this.gap;
      }

      startAutoScroll() {
        const animate = () => {
          this.currentPosition += this.scrollSpeed;
          
          const resetPoint = this.slideWidth * this.slides.length;
          
          if (this.currentPosition >= resetPoint) {
            this.currentPosition = 0;
          }
          
          this.track.style.transform = `translateX(-${this.currentPosition}px)`;
          this.animationId = requestAnimationFrame(animate);
        };
        
        this.animationId = requestAnimationFrame(animate);
      }

      disconnectedCallback() {
        if (this.animationId) {
          cancelAnimationFrame(this.animationId);
        }
      }
    }

    customElements.define('auto-carousel-{{ ai_gen_id }}', AutoCarousel{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Auto photo carousel",
  "settings": [
    {
      "type": "header",
      "content": "Carousel settings"
    },
    {
      "type": "range",
      "id": "carousel_height",
      "label": "Height",
      "min": 200,
      "max": 800,
      "step": 50,
      "unit": "px",
      "default": 400
    },
    {
      "type": "range",
      "id": "scroll_speed",
      "label": "Scroll speed",
      "min": 0.5,
      "max": 5,
      "step": 0.5,
      "default": 1
    },
    {
      "type": "range",
      "id": "image_gap",
      "label": "Gap between images",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "border_radius",
