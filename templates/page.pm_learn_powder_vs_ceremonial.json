      "settings": {
        "eyebrow": "The Cacao Guide · Part 04 of 10",
        "title": "Cacao Powder Vs Ceremonial Cacao",
        "deck": "Why the brown powder in your pantry and the paste in your ceremonial cup are not the same thing. Not even close.",
        "meta_read": "12 Min Read",
        "meta_topic": "Sourcing &amp; Process",
        "leaf_url": "https://cdn.shopify.com/s/files/1/0725/1188/1261/files/learn-img-a044820100.png?v=1785782948"
      }
    },
    "featured": {
      "type": "pm_learn_featured",
