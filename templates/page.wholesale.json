        "q1": {
          "type": "faq",
          "settings": {
            "question": "Is there a minimum order?",
            "answer": "<p>Wholesale partners are approved first, then start at a single case. Bulk price breaks for individuals apply automatically in cart — no minimum, no application.</p>"
          }
        },
        "q2": {
          "type": "faq",
          "settings": {
            "question": "How does shipping work?",
            "answer": "<p>Orders ship from Grass Valley, California, typically within 2–3 business days. Past 25 lb, freight ships at calculated rates — we'll set that up directly. Smaller orders are a flat rate at checkout.</p>"
          }
        },
        "q3": {
          "type": "faq",
          "settings": {
            "question": "How is wholesale pricing shared?",
            "answer": "<p>Once your application is approved and we confirm we're aligned partners, we send your tier price list. Pricing scales as your volume grows.</p>"
          }
        },
        "q4": {
          "type": "faq",
          "settings": {
            "question": "Do you offer marketing support?",
            "answer": "<p>Yes. Every partner receives shelf cards, origin stories, and brewing guides — plus lifestyle imagery for your channels.</p>"
          }
        }
