      "settings": {
        "eyebrow": "The shift",
        "heading": "Coffee borrows tomorrow's energy. Cacao gives you today's.",
        "text": "Caffeine hits the nervous system fast, and it leaves fast. Cacao's main stimulant is theobromine, which works more on circulation, and the bean's natural fat slows how quickly it all arrives. You feel it in the body as much as the mind.",
        "chart_description": "Felt energy over eight hours. Coffee spikes near one hour and crashes below baseline by three hours. Cacao rises gently, holds from two to five hours, and tapers by eight.",
        "chart_label": "Spike",
        "chart_label_2": "Crash",
        "chart_label_3": "Hold",
        "chart_label_4": "Rest",
        "chart_label_5": "felt energy",
        "caption": "Illustrative, not a measurement."
      }
    },
