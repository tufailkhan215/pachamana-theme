    "faq": {
      "type": "pm_sh_faq",
      "blocks": {
        "question_1": {
          "type": "question",
          "settings": {
            "question": "Does ceremonial cacao have caffeine?",
            "answer": "A little, far less than coffee. One cup has roughly a quarter of the caffeine of a cup of coffee. Cacao's main stimulant is theobromine, and the bean's natural fat slows how fast anything is absorbed, so the lift is gentler and longer."
          }
        },
        "question_2": {
          "type": "question",
          "settings": {
            "question": "Can it replace my coffee?",
            "answer": "Lots of people swap it fully, and others keep coffee as an occasional treat. Try swapping your second cup first, then the first. If you're sensitive to stimulants, start with a half serving and drink it before 2pm."
          }
        },
        "question_3": {
          "type": "question",
          "settings": {
            "question": "Isn't this just cocoa powder?",
            "answer": "No. Cocoa powder has most of its cacao butter pressed out. Ours is the whole bean with all 54% of its butter left in, so it melts into hot water and carries the minerals and theobromine with it. This is a much healthier form of cacao"
          }
        },
        "question_4": {
          "type": "question",
          "settings": {
            "question": "How does Subscribe & Save work?",
            "answer": "Pick your bundle, choose how often it arrives, and every bag is 15% off. You can skip, push or change your order from your account at anytime."
          }
        },
        "question_5": {
          "type": "question",
          "settings": {
            "question": "Is it tested?",
            "answer": "Yes. Every batch is tested for heavy metals, and the results are on our Safe Cacao page.\nhttps://pachamana.com/pages/safe-cacao"
          }
        },
        "question_6": {
          "type": "question",
          "settings": {
            "question": "Is it sweetened?",
            "answer": "Only the Maple blend, which is lightly sweetened with organic maple sugar. Everything else has no added sugar."
          }
        },
        "question_7": {
          "type": "question",
          "settings": {
            "question": "How many cups are in a bag?",
            "answer": "About 11 cups per 8 oz bag at 2 tablespoons (20 g) a cup."
          }
        },
        "question_8": {
          "type": "question",
          "settings": {
            "question": "What if I don't love it?",
            "answer": "Write to us within 30 days and we'll make it right."
          }
        }
      },
