        },
        "q_shipping": {
          "type": "faq",
          "settings": {
            "question": "How does shipping work?",
            "answer": "<p>Orders ship from Grass Valley, California, typically within 2–3 business days. We don't offer free shipping on bulk orders over 25 lb — those ship at calculated freight so you only pay the real cost. Smaller orders are charged a flat rate shown at checkout.</p>"
          }
        },
        "q_pricing": {
          "type": "faq",
          "settings": {
            "question": "How is wholesale pricing shared?",
            "answer": "<p>Once your application is approved and we confirm we're aligned partners, we send your tier price list. Pricing scales as your volume grows.</p>"
          }
        },
        "q_marketing": {
          "type": "faq",
          "settings": {
            "question": "Do you offer marketing support?",
            "answer": "<p>Yes. Every partner receives shelf cards, origin stories, and brewing guides — plus lifestyle imagery for your channels.</p>"
