    "how_to_prepare": {
      "type": "pm_bb_how_to_prepare",
      "settings": {
        "eyebrow": "Your first cup",
        "heading": "How to prepare"
      },
      "blocks": {
        "card_1": {
          "type": "card",
          "settings": {
            "label": "01",
            "title": "Measure.",
            "text": "Start with about 2 tablespoons (20 g) for a daily cup. Once you know how it sits with you, work up to a fuller ceremonial dose."
          }
        },
        "card_2": {
          "type": "card",
          "settings": {
            "label": "02",
            "title": "Warm.",
            "text": "Add 6 to 8 oz of hot water or plant milk, around 175°F. Keep it off a hard boil, because boiling water dulls the flavor."
          }
        },
        "card_3": {
          "type": "card",
          "settings": {
            "label": "03",
            "title": "Froth and sit.",
            "text": "Blend or froth for ten seconds, which is what makes the texture. Then set an intention and drink it slowly, away from your screen."
          }
        }
      },
      "block_order": [
        "card_1",
        "card_2",
        "card_3"
      ]
