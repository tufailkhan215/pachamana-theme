    "what_a_cup_gives_you": {
      "type": "pm_bb_what_a_cup_gives_you",
      "settings": {
        "eyebrow": "Why cacao",
        "heading": "What a cup gives you",
        "text": "Note: Cacao is contraindicated with SSRIs, SNRIs and NDRIs. If you take one of these, please talk with your doctor before drinking ceremonial doses."
      },
      "blocks": {
        "card_1": {
          "type": "card",
          "settings": {
            "title": "Steady energy.",
            "text": "Theobromine is a gentle stimulant with a long half-life. It lifts you without the jitters or the crash, which is why so many people use cacao to ease off coffee."
          }
        },
        "card_2": {
          "type": "card",
          "settings": {
            "title": "Lifted mood.",
            "text": "Cacao carries anandamide, phenylethylamine and the building blocks of serotonin and dopamine, along with compounds that help them linger."
          }
        },
        "card_3": {
          "type": "card",
          "settings": {
            "title": "Deep minerals.",
            "text": "Cacao is one of the richest natural sources of magnesium, and it brings iron, zinc, copper and manganese too. The cacao butter helps carry them in."
          }
        },
        "card_4": {
          "type": "card",
          "settings": {
            "title": "A slower morning.",
            "text": "Ceremony is simply attention: warming the cup, setting an intention, drinking without a screen. Ten minutes that change the shape of a day."
          }
        }
      },
      "block_order": [
        "card_1",
        "card_2",
        "card_3",
        "card_4"
      ]
    },
