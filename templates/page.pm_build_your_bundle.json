    "ayni": {
      "type": "pm_bb_ayni",
      "settings": {
        "image_url": "https://cdn.shopify.com/s/files/1/0725/1188/1261/files/cacao-tree.png?v=1790710030",
        "image_url_2": "/cdn/shop/files/IMG_0666.jpg?v=1766411732&width=1400",
        "image_alt_text_2": "The family farm in the Sacred Valley",
        "eyebrow": "Ayni",
        "heading": "Ceremony starts at the farm",
        "text": "<em>Ayni</em> is the Quechua word for sacred reciprocity, the understanding that what you take and what you give must stay in balance. It's one of the oldest agreements in the Andes, and it's the one we work by.",
        "text_2": "Our Chuncho comes from one multigenerational family farm in the Sacred Valley, just outside Cusco, in the ceja de selva where the Andes meet the jungle. They work hand in hand with the Quechua and Machiguenga farming families around them. It's wild-harvested heirloom Chuncho, grown regeneratively, bought direct, and traceable to the grove it came from."
      }
    },
    "faq": {
      "type": "pm_bb_faq",
      "settings": {
        "image_url": "https://cdn.shopify.com/s/files/1/0725/1188/1261/files/llama.png?v=1790710030",
        "heading": "FAQ"
      },
      "blocks": {
        "question_1": {
          "type": "question",
          "settings": {
            "question": "How is this different from cocoa powder?",
            "answer": "Cocoa powder has most of its cacao butter pressed out. Ours is the whole bean with all 54% of its butter left in, so it melts into a rich cup and carries the minerals and theobromine with it."
          }
        },
        "question_2": {
          "type": "question",
          "settings": {
            "question": "How does Subscribe & Save work?",
            "answer": "Every bag in your bundle is 15% off, delivered every 4, 6 or 8 weeks. There's a 3-month minimum, and after that you can skip, push or change your order from your account."
          }
        },
        "question_3": {
          "type": "question",
          "settings": {
            "question": "Will it keep me up at night?",
            "answer": "One cup has roughly a third of the caffeine of a cup of coffee, balanced by theobromine, which is slower and softer. Most people drink it before 2pm while they get used to it."
          }
        },
        "question_4": {
          "type": "question",
          "settings": {
            "question": "Which blend should a beginner pick?",
            "answer": "Maple Sweetened is the gentlest start. Pair it with Pure so you can taste what unsweetened Chuncho is like, then branch out."
          }
        },
        "question_5": {
          "type": "question",
          "settings": {
            "question": "Do I need special equipment?",
            "answer": "A small whisk works. An electric frother or blender works better, and ten seconds of blending is the difference between gritty and silky."
          }
        },
        "question_6": {
          "type": "question",
          "settings": {
            "question": "Is it tested for heavy metals?",
            "answer": "Yes. Every batch is third-party tested and the results are published on our Safe Cacao page."
          }
        },
        "question_7": {
          "type": "question",
          "settings": {
            "question": "What if I don't love it?",
            "answer": "Write to us within 30 days and we'll make it right."
          }
        },
        "question_8": {
          "type": "question",
          "settings": {
            "question": "When does the Ritual Guide arrive?",
            "answer": "It's emailed within a few minutes of your first order, with the recipes and a short walkthrough of a home ceremony."
          }
        }
      },
