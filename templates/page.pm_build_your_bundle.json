    "what_ceremonial_cacao_is": {
      "type": "pm_bb_what_ceremonial_cacao_is",
      "settings": {
        "eyebrow": "Start here",
        "heading": "What ceremonial cacao is"
      },
      "blocks": {
        "item_1": {
          "type": "item",
          "settings": {
            "text": "It's the whole cacao bean, fermented and stone-ground with its natural cacao butter left in, all 54% of it. That's the difference between a cup of ceremonial cacao and a scoop of cocoa powder."
          }
        },
        "item_2": {
          "type": "item",
          "settings": {
            "text": "Most people come to it looking for a gentler morning than coffee. What they stay for is the ten quiet minutes it asks of them."
          }
        }
      },
